amends "package://github.com/jdx/hk/releases/download/v1.53.0/hk@1.53.0#/Config.pkl"

// Pre-commit `cargo fmt` for the round-19 Rust spike, scoped to spike Rust.
//
// Why the spike-prefixed glob: this worktree's `.git` is a pointer into the
// MAIN repo's gitdir, so `hook.*`/`core.hooksPath` config is SHARED with `main`
// and every other worktree. Scoping every step to `spike/**/*.rs` makes the
// shared hook a no-op for non-spike/non-Rust commits (e.g. on `main`), keeping
// the blast radius minimal. The hook is NOT installed by these files alone;
// installing it writes shared git config — see the round-19 spike note before
// running `hk install`.
//
// Toolchain note: unlike the human's other Rust repos this does NOT use
// `cargo +nightly fmt`. The spike carries no toolchain pin — the global mise
// config supplies `stable` (msvc-hosted on Windows; linker via VS Build Tools;
// the previous spikes' per-dir gnu pin is tombstoned, do not resurrect it) — so
// plain `cargo fmt` is correct here. The `--manifest-path` lets the step run from
// the worktree-root repo top-level.
//
// No step spells `mise x --`: `HK_MISE=1` in mise.toml has hk resolve the mise
// environment per step itself, so the prefix bought only a nested mise process
// per step. That env var reaches the git hook because `mise run hk-install`
// installs with `--mise`.
// NO `workspace_indicator` on the cargo steps. Every crate carries a `Cargo.toml`, so an
// indicator makes hk treat each as its own workspace and run the step ONCE PER CRATE — and
// because these commands are workspace-global, that was 14 identical full-workspace runs of
// both fmt and clippy, serialized on cargo's build lock (measured, not theorized). One
// unindicated step covers the whole workspace in one invocation.
//
// INVIOLABLE INVARIANT: This file *must* be verified, falsifiably. Do not modify
// it without *verifying that you aren't silencing failures*. Test in both
// directions - manufacture changes that trip the failure-modes, and ensure the
// tooling blocks.
local linters = new Mapping<String, Step> {
    ["cargo_fmt"] {
        glob = "spike/**/*.rs"
        stage = "spike/**/*.rs"
        // `--all` is required for `cargo fmt` to parse `--manifest-path` here;
        // without it cargo fmt misreads the args and dumps help (verified).
        check = "cargo fmt --all --manifest-path spike/Cargo.toml --check"
        fix = "cargo fmt --all --manifest-path spike/Cargo.toml"
    }
    ["cargo_clippy"] {
        glob = "spike/**/*.rs"
        // The spike's warnings-are-failures gate lives HERE (pre-commit), never in
        // the manifest — mid-work builds shouldn't break on a toolchain bump.
        check = "cargo clippy --workspace --all-targets --manifest-path spike/Cargo.toml -- -D warnings"
    }
    ["cargo_deny"] {
        // The lockfile matters as much as the manifests: a dependency arrives there.
        glob = List("spike/**/Cargo.toml", "spike/Cargo.lock")
        // Offline checks only; `mise run audit` does the network-touching
        // advisories pass on demand.
        check = "cargo deny --manifest-path spike/Cargo.toml check licenses bans sources"
    }
    ["typos"] {
        glob = "spike/**"
        // `{{files}}`, not `spike`: scanning the whole tree to check three staged files is the
        // kind of cost that gets a hook bypassed. `spike/_typos.toml` is still found, because
        // typos discovers config by walking up from each file it is given.
        check = "typos {{files}}"
        fix = "typos --write-changes {{files}}"
    }
}

// Case corpora, pre-commit only — deliberately NOT in `linters`, which the `check`/`fix` hooks
// (and therefore `mise run check`, and therefore every gate) reuse. Tests belong to the gates;
// what belongs here is the subset a commit's own staged paths make relevant.
local corpora = new Mapping<String, Step> {
    ["loom-hygiene"] {
        glob = List("spike/crates/*/tests/*.loom", "spike/crates/*/tests/*/*.loom")
        // The hygiene tier and nothing more: parse, same-slug, render fixpoint. A whole-product
        // loom's transcript is proven by EXECUTING it, which is the `e2e` step below — so this
        // step's name may not promise the word "looms". The whole loom corpus is sub-second, so
        // scoping it would cost more than it saves.
        check = "cargo test -q -p dorc-cli --test looms --manifest-path spike/Cargo.toml"
        output_summary = "combined"
    }
    ["minispec"] {
        // The one corpus outside `spike/**`, so no `linters` step reaches it: a commit touching
        // only a law unit would otherwise draw no check at all. The binder's cheap tier is
        // filesystem-and-parsing only, so this stays inside the budget.
        glob = List("minispec/**", "spike/verify/**")
        check = "cargo run -q -p dorc-verify --manifest-path spike/Cargo.toml -- check"
        output_summary = "combined"
    }
    ["e2e"] {
        // Both shapes a whole-product case comes in: a case DIR, and a single-file `.loom`
        // carrying `run:`. The loom half is load-bearing and its absence was SILENT — hk prints
        // nothing at all for a glob-missed step, so a commit touching only a whole-product loom
        // drew a green `loom-hygiene` and no hint that the transcript tier never ran.
        //
        // Crate-scoped rather than `*/tests/*.loom`: every `run:`-bearing loom lives in
        // `crates/cli/tests/` (27 of 27), while `crates/aid/tests/` holds ~50 catalog looms this
        // runner mints no trial for, and widening would spawn the e2e binary for them to do
        // nothing. The scope's cost is that a `run:` loom homed elsewhere escapes this HOOK — it
        // still runs in every full suite, and the runner's floor now answers honestly rather than
        // aborting when such a path is hand-selected.
        glob = List("spike/crates/*/tests/*/**", "spike/crates/cli/tests/*.loom")
        // The runner takes PATHS and selects the cases they belong to (`split_path_selectors`),
        // because libtest's single substring filter cannot express a set and a hook knows files,
        // not trial names. Whole corpus ~6s, one case ~0.9s. A path naming nothing under any case
        // root is a loud failure there, never a green no-op; a path naming something the runner
        // drives no trial for — an `.rs` test's fixture dir, which this glob does reach — exits
        // clean with a note.
        check = "cargo test -q -p dorc-cli --test e2e --manifest-path spike/Cargo.toml -- {{files}}"
        env { ["DORC_E2E_QUIET"] = "1" }
        output_summary = "combined"
    }
}

hooks {
    // Budget: ~3-4s wall, and it holds only because every step is scoped to the staged paths.
    // Nothing unscoped belongs here — a hook that outgrows its budget gets `--no-verify`'d, and
    // then it protects nothing at all. The acceptance suites are `mise run gate:full*`.
    ["pre-commit"] {
        fix = true
        stash = "git"
        steps = (linters) {
            ["loom-hygiene"] = corpora["loom-hygiene"]
            ["minispec"] = corpora["minispec"]
            ["e2e"] = corpora["e2e"]
        }
    }
    // The gitlabels headliner gate. Separate from `linters` on purpose: it reads the MESSAGE,
    // not the tree, so it belongs to no glob and must run even on a commit touching no Rust.
    // Agent sessions skip `pre-commit` but NOT this — the trailer habit it refuses is theirs.
    // `sh` is safe HERE and nowhere else in this project: git runs hook commands through its own
    // bundled sh, so git's `usr/bin` is on PATH for everything downstream — verified by committing
    // from native PowerShell, where `sh`/`sed`/`awk` are otherwise all absent. A mise TASK gets no
    // such environment (see mise.toml). Don't "fix" this one; don't copy it into a task.
    ["commit-msg"] {
        steps {
            ["gitlabels"] {
                check = "sh .githooks/commit-msg {{commit_msg_file}}"
            }
        }
    }
    ["fix"] {
        fix = true
        steps = linters
    }
    ["check"] {
        steps = linters
    }
}
