-- STRAWMAN, non-normative: a conductor's exercise of the assay shape (notes/30Y) against a
-- made-up cut of Dorc's outcome algebra. Nothing here is Dorc's design; design decisions in
-- this directory were invented to reach a compiling model and bind nothing.
module words
open shared

-- one atom per distinct literal on any map line in the document, and per name a #= introduces
one sig apt_get, update, install, dash_y, nginx,
   cp, local_nginx_conf, nginx_conf, conf_backup,
   foobar, sync_certs, certs_dir,
   systemctl, enable, dash_dash_now,
   hork, tune, dash_dash_profile, web, append_hork_log, stderr_to_stdout,
   ufw, allow, port_443_tcp,
   pkg_index, dpkg_db, unit_state, ufw_rules extends Shword {}

-- no map line braces a word, so no class exists and no word is classed
fact { no class }
