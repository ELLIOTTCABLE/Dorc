---
arrangement: why-declines-payload
when-used: The quoted payload of a `declines` speaker row. Value: the author's decline class.
why: 28G strawman c-declined-unsound quotes the class beside the author's own tail text; the tail is readable only from a RUNTIME report record, so the static tier quotes the class and lets the as-written excerpt carry the author's words.
owns:
  - why-addressability-line
  - why-analysis-heading
  - why-analysis-opener-plain
  - why-as-written-locus
  - why-declines-derives-cannot-say-runs
  - why-declines-explanation
  - why-declines-join
  - why-declines-next-steps-opener
  - why-improvement-declined-unmodeled
  - why-improvements-heading
  - why-item-pointer
  - why-next-step-label
  - why-next-step-review
  - why-next-steps-heading
  - why-outcome-because-declined
  - why-outcome-contrastive
  - why-outcome-heading
  - why-participating-lines-closure
  - why-participating-lines-locus
  - why-receipt-book
  - why-receipt-dispositions-predicted
  - why-receipt-footer
  - why-receipt-header
  - why-receipt-oracles
  - why-receipt-plan-tally-by-proof
  - why-receipt-risk-profile
  - why-tier-word
  - why-outcome-word
edit-loop: edit a sentence in the transcript below, then run `mise run loom:compile -- why-declines-payload && mise run loom:promote -- why-declines-payload`. `mise run loom:vars -- --all why-declines-payload` lists this case's values; type {{name}} to insert or move one.
---
-- book.sh --
#!/bin/sh
# One site per decline class, so the whole occurrence-keyed family renders. Every tool named
# here is an inert stand-in; nothing in this case is ever executed.
sysctl vm.drop_caches
hork tune --profile web
wombat prompt --confirm
wombat wipe --all

-- sysctl.oracle.sh --
#!/usr/bin/env dorc-sh
# dorc-lang/v0.2
# A write-only trigger key: reading it back reports nothing about whether it fired, so no answer
# here could honestly license keeping the line out of the plan. Unanswerable for anyone, ever.
sysctl__is_converged() {
   key=$1
   case $key in
   vm.drop_caches|vm.compact_memory)
      printf 'decline unsound %s is a write-only trigger key\n' "$key" >>"${DREP_V1:-/dev/null}"
      return 2 ;;
   *) sysctl -n -- "$key" >/dev/null 2>&1 ;;
   esac
}

-- hork.oracle.sh --
#!/usr/bin/env dorc-sh
# dorc-lang/v0.2
# The author has not described this verb YET -- a "not yet", not a "not ever", so dorc may still
# suggest that somebody model it.
hork__is_converged() {
   verb=$1
   case $verb in
   tune)
      printf 'decline unmodeled %s carries no readable settled state yet\n' "$verb" >>"${DREP_V1:-/dev/null}"
      return 2 ;;
   *) return 2 ;;
   esac
}

-- wombat.oracle.sh --
#!/usr/bin/env dorc-sh
# dorc-lang/v0.2
# Two more classes on one tool: a check that would have to ask a human, and one whose own
# read-back is dangerous enough that the author refuses to ship it into a probe.
wombat__is_converged() {
   verb=$1
   case $verb in
   prompt)
      printf 'decline interactive %s cannot be answered without a human\n' "$verb" >>"${DREP_V1:-/dev/null}"
      return 2 ;;
   wipe)
      printf 'decline hazard %s cannot be read back safely\n' "$verb" >>"${DREP_V1:-/dev/null}"
      return 2 ;;
   *) return 2 ;;
   esac
}

