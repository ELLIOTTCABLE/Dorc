---
arrangement: why-reason-render-refused
owns:
  - why-surprises-heading
  - why-reason-guard-refused
  - why-reason-skipped-converged
edit-loop: edit a sentence in the transcript below, then run `mise run loom:compile -- why-reason-render-refused && mise run loom:promote -- why-reason-render-refused`. `mise run loom:vars -- --all why-reason-render-refused` lists this case's values; type {{name}} to insert or move one.
---
-- book.sh --
#!/bin/sh
# Both `hork add` lines are converged, and both carry a heredoc. A heredoc's AST span covers the
# `<<EOF` operator and not the body, so editing the command span would strand the body as stray
# artifact lines -- dorc refuses the edit and runs the line verbatim rather than ship a broken
# artifact. The first would have been removed outright; the second, past `wombat`'s wall, would
# have been guarded. Every tool named here is an inert corpus stand-in.
hork add nginx <<EOF
server
EOF
wombat sync --profile web
hork add redis <<EOF
cache
EOF

-- hork.oracle.sh --
#!/usr/bin/env dorc-sh
# dorc-lang/v0.2
hork__predict() {
   verb=$1; shift
   pkg : sm.dorc.Package = "$1"
   case $verb in
      add) hork --query "$pkg" >/dev/null 2>&1 : sm.dorc.Package:"$pkg"@installed ;;
   esac
}

hork__is_converged() {
   verb=$1; shift
   case $verb in
      add) hork --query -- "$1" ;;
      *) return 2 ;;
   esac
}

