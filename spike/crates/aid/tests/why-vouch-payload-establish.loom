---
arrangement: why-vouch-payload-establish
---
-- book.sh --
#!/bin/sh
# The firewall site survives a running package wall, so its why-chain carries the firewall vouch
# beside the package author's at-most claim. The two authors know nothing about each other; Dorc
# derives their disjointness. Every tool named here is an inert corpus stand-in.
apt-get install -y oldpkg
ufw allow 443/tcp

-- firewall.oracle.sh --
#!/usr/bin/env dorc-sh
# dorc-lang/v0.2
# Nothing here knows about packages; this vouch speaks only for firewall state.
ufw__predict() {
   verb=$1; shift
   rule : sm.dorc.Firewall = "$1"
   case $verb in
      allow) ufw status "$rule" >/dev/null 2>&1 : sm.dorc.Firewall:"$rule"@allowed ;;
   esac
}

ufw__is_converged() {
   verb=$1; shift
   case $verb in
      allow) ufw status "$1" >/dev/null 2>&1 ;;
      *) return 2 ;;
   esac
}

-- package.oracle.sh --
#!/usr/bin/env dorc-sh
# dorc-lang/v0.2
# The package model remains complete enough to describe either world-state of the upstream site.
apt_get__predict() {
   while [ "${1#-}" != "$1" ]; do shift; done
   verb=$1; shift
   while [ "${1#-}" != "$1" ]; do shift; done
   pkg : sm.dorc.Package = "$1"
   if [ "${2-}" = "" ]; then
      case $verb in
         install) dpkg-query -W "$pkg" >/dev/null 2>&1 : sm.dorc.Package:"$pkg"@installed ;;
      esac
   fi
}

apt_get__disturbs() {
   while [ "${1#-}" != "$1" ]; do shift; done
   verb=$1; shift
   while [ "${1#-}" != "$1" ]; do shift; done
   case $verb in
      install) printf '%s\n' "$1" : disturbs sm.dorc.Package ;;
   esac
}

apt_get__is_converged() {
   while [ "${1#-}" != "$1" ]; do shift; done
   verb=$1; shift
   while [ "${1#-}" != "$1" ]; do shift; done
   case $verb in
      install) dpkg-query -W "$1" >/dev/null 2>&1 ;;
      *) return 2 ;;
   esac
}

