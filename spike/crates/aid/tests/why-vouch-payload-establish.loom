-- book.sh --
#!/bin/sh
# The surviving site is an AGGREGATE: one call whose inlined body carries two establishes, erased
# together, so the survival chain quotes one vouch per erased establish rather than one for the
# site. `apt-get install` came back diverged and RUNS, walling the book above the call. Every tool
# named here is an inert corpus stand-in.
apt-get install -y oldpkg
open_https() { ufw allow 443/tcp; ufw allow 80/tcp; }
open_https

-- firewall.oracle.sh --
#!/usr/bin/env dorc-sh
# dorc-lang/v0.2
# Nothing here knows about packages: the disjointness the survival rests on is derived from the
# two kinds, never declared by either author.
ufw__predict() {
   verb=$1; shift
   rule : sm.dorc.Firewall = "$1"
   case $verb in
      allow) ufw status "$rule" >/dev/null 2>&1 : sm.dorc.Firewall:"$rule"@allowed ;;
   esac
}

ufw__is_converged() {
   verb=$1; shift
   case $verb in
      allow) ufw status "$1" >/dev/null 2>&1 ;;
      *) return 2 ;;
   esac
}

-- package.oracle.sh --
#!/usr/bin/env dorc-sh
# dorc-lang/v0.2
# The `disturbs` member below is the AT-MOST claim the whole survival hangs on.
apt_get__predict() {
   while [ "${1#-}" != "$1" ]; do shift; done
   verb=$1; shift
   while [ "${1#-}" != "$1" ]; do shift; done
   pkg : sm.dorc.Package = "$1"
   if [ "${2-}" = "" ]; then
      case $verb in
         install) dpkg-query -W "$pkg" >/dev/null 2>&1 : sm.dorc.Package:"$pkg"@installed ;;
      esac
   fi
}

apt_get__disturbs() {
   while [ "${1#-}" != "$1" ]; do shift; done
   verb=$1; shift
   while [ "${1#-}" != "$1" ]; do shift; done
   case $verb in
      install) printf '%s\n' "$1" : disturbs sm.dorc.Package ;;
   esac
}

apt_get__is_converged() {
   while [ "${1#-}" != "$1" ]; do shift; done
   verb=$1; shift
   while [ "${1#-}" != "$1" ]; do shift; done
   case $verb in
      install) dpkg-query -W "$1" >/dev/null 2>&1 ;;
      *) return 2 ;;
   esac
}

