---
code: resolver-provider-collision
when-fires: a resolver is keyed to a name matching a known COMMAND provider. cli/kinds.rs build_kind_resolvers. `{name}` = the colliding name.
why: corr-kind-keying §10: resolvers are keyed by KIND, not command — a likely mis-key (kept; the warning surfaces the risk).
---
-- book.sh --
#!/bin/sh
hork install nginx

-- hork.oracle.sh --
#!/usr/bin/env dorc-sh
# dorc-lang/v0.2
hork__predict() {
   pkg : sm.dorc.Package = "$1"
   hork --query "$pkg" >/dev/null 2>&1 : sm.dorc.Package:"$pkg"@installed
}

# Keyed by the COMMAND this file describes rather than by the kind it names entities of.
hork__resolve() {
   hork --canonical -- "$1"
}

-- replay --
$ dorc plan --book=book.sh -o hork.oracle.sh
warning[resolver-provider-collision]: `hork__resolve()` is keyed by a command
name, but a resolver belongs to a kind -- as written it mints identity for a
kind no coordinate can name (a likely mis-key).
      [ hork.oracle.sh:9:1
   9 | hork__resolve() {
     | \___________/

$ dorc-loom --this vars
case: resolver-provider-collision
{{name}} = "hork"
