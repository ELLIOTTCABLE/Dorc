---
arrangement: why-drift-analysis-suppressed
when-used: Stands in for the whole body of the zero-argument `dorc why` aggregate on a drifted replay -- the TRUST SPENT / SURPRISES / IMPROVEMENTS sections and every chain.
why: 28F rul-drift-replay-d1: those sections are re-derived through the kernel from the current book, so a drifted replay must suppress them rather than answer about the wrong bytes, and must say that it did.
owns:
  - why-receipt-book-drifted
  - why-receipt-plan-tally-unsplit
  - why-receipt-when-replayed
edit-loop: edit a sentence in the transcript below, then run `mise run loom:compile -- why-drift-analysis-suppressed && mise run loom:promote -- why-drift-analysis-suppressed`. `mise run loom:vars -- --all why-drift-analysis-suppressed` lists this case's values; type {{name}} to insert or move one.
---
-- book.sh --
#!/bin/sh
# The book AS IT IS NOW. Its digest is not the one the durable below recorded, which is the
# whole fixture: every source-keyed section of the report is answering about somebody else's
# bytes, so it is suppressed rather than re-derived.
apt-get install -y nginx
systemctl enable nginx

-- firewall.oracle.sh --
#!/usr/bin/env dorc-sh
# dorc-lang/v0.2
# Present only so the receipt has a real oracle INVENTORY to state: the degraded render reads the
# recorded oracle PATHS off the durable and never opens them.
ufw__predict() {
   verb=$1; shift
   rule : sm.dorc.Firewall = "$1"
   case $verb in
      allow) ufw status "$rule" >/dev/null 2>&1 : sm.dorc.Firewall:"$rule"@allowed ;;
   esac
}

-- .whylog --
dorc-whylog/2 nonce=dorc attempt=0 host=web1 target=width-one generation=width-one mode=whylog-replay started=1784944837000 @@dorc@@
book digest=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa path=book.sh @@dorc@@
oracle ordinal=0 digest=cccccccccccccccccccccccccccccccc path=firewall.oracle.sh @@dorc@@
argv value=dorc @@dorc@@
argv value=plan @@dorc@@
argv value=book.sh @@dorc@@
argv value=--risk-faultless-skips @@dorc@@
digest decision=bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb @@dorc@@
apply leaf=0 disposition=run predicted=1 @@dorc@@
apply leaf=1 disposition=replace predicted=1 @@dorc@@
apply leaf=2 disposition=guard predicted=1 @@dorc@@
results bytes=0 @@dorc@@
dorc-whylog-end/2 @@dorc@@

-- replay --
$ dorc why --last --whylog=.whylog
receipt: [unwritten: why-receipt-when-replayed], host web1
   book book.sh (digest aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa)
   [unwritten: why-receipt-book-drifted]
   oracles: firewall.oracle.sh
   risk-profile: --risk-faultless-skips
   plan: 1 ran, 1 guarded, 1 skipped
   [unwritten: why-receipt-dispositions-predicted]
   read top-down; every item is addressable: dorc why <line>

[unwritten: why-drift-analysis-suppressed]
