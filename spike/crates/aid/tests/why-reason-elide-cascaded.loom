-- book.sh --
#!/bin/sh
# The guard-then-install ladder, twice. Both packages are already installed, so both `dpkg -s`
# guards hold and neither install ever runs -- but the SECOND rung only becomes removable once
# the FIRST install is proven dead, because until then a write above it invalidated its guard.
# That second removal is a round-2 finding, and the report says so.
dpkg -s alpha >/dev/null 2>&1 || apt-get install -y alpha
dpkg -s beta >/dev/null 2>&1 || apt-get install -y beta

-- package.oracle.sh --
#!/usr/bin/env dorc-sh
# dorc-lang/v0.2
# The two halves of the idiom: a QUERY verb that only reads (`:?`) and a mutating verb that
# establishes (`:`). The fixpoint exists to notice that erasing the second makes the first's
# answer trustworthy again.
dpkg__predict() {
   case $1 in -s) shift ;; esac
   pkg : sm.dorc.PkgState = "$1"
   dpkg -s -- "$pkg" >/dev/null 2>&1 :? sm.dorc.PkgState:"$pkg"@installed
}

apt_get__predict() {
   while [ "${1#-}" != "$1" ]; do shift; done
   verb=$1; shift
   while [ "${1#-}" != "$1" ]; do shift; done
   pkg : sm.dorc.Package = "$1"
   if [ "${2-}" = "" ]; then
      case $verb in
         install) dpkg-query -W "$pkg" >/dev/null 2>&1 : sm.dorc.Package:"$pkg"@installed ;;
      esac
   fi
}

