---
code: reaches-provider-collision
when-fires: a reach-function is keyed to a name matching a known COMMAND provider. cli/kinds.rs build_kind_reaches. `{name}` = the colliding name.
why: 24G §4: reaches is keyed by KIND, not command — a likely mis-key.
---
-- book.sh --
#!/bin/sh
hork install nginx

-- hork.oracle.sh --
#!/usr/bin/env dorc-sh
# dorc-lang/v0.2
hork__predict() {
   pkg : sm.dorc.Package = "$1"
   hork --query "$pkg" >/dev/null 2>&1 : sm.dorc.Package:"$pkg"@installed
}

# Keyed by the COMMAND this file describes rather than by the kind whose disturbance it surveys.
hork__disturbance_reaches_only() {
   hork --contents -- "$1"    : disturbs sm.dorc.File
}

-- replay --
$ dorc plan --book=book.sh -o hork.oracle.sh
warning[reaches-provider-collision]: `hork__disturbance_reaches_only()` is keyed
by a command name, but a reach-function belongs to a kind -- as written it
widens a kind no coordinate can name (a likely mis-key).
      [ hork.oracle.sh:9:1
   9 | hork__disturbance_reaches_only() {
     | \____________________________/

$ dorc-loom --this vars
case: reaches-provider-collision
{{name}} = "hork"
