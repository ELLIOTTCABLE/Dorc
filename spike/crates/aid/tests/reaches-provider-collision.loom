---
code: reaches-provider-collision
when-fires: a reach-function is keyed to a name matching a known COMMAND provider. cli/main.rs. `{name}` = the colliding name.
why: 24G §4: reaches is keyed by KIND, not command — a likely mis-key.
edit-loop: edit a sentence in the transcript below, then run `mise run loom:compile -- reaches-provider-collision && mise run loom:promote -- reaches-provider-collision`; prove it stuck with `mise run test`, which is also what catches anything else the promotion moved. `mise run loom:vars -- --all reaches-provider-collision` lists this case's values; type {{name}} to insert or move one.
---
-- book.sh --
#!/bin/sh
hork install nginx

-- hork.oracle.sh --
#!/usr/bin/env dorc-sh
# dorc-lang/v0.2
hork__predict() {
   pkg : sm.dorc.Package = "$1"
   hork --query "$pkg" >/dev/null 2>&1 : sm.dorc.Package:"$pkg"@installed
}

# Keyed by the COMMAND this file describes rather than by the kind whose disturbance it surveys.
hork__disturbance_reaches_only() {
   hork --contents -- "$1"    : disturbs sm.dorc.File
}

-- replay --
$ dorc plan --book=book.sh -o hork.oracle.sh
warning[reaches-provider-collision]: sm reach-function 'hork.reaches()' is keyed
to a name matching a known COMMAND provider -- reaches is keyed by KIND, not
command (24G section 4); this expands a kind no coordinate may use (a likely
mis-key)
      [ hork.oracle.sh:9:1
   9 | hork__disturbance_reaches_only() {
     | \____________________________/
