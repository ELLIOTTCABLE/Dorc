-- book.sh --
#!/bin/sh
# TWO running walls, each spending its own author's at-most claim, and one converged firewall line
# surviving both of them. With more than one claim in the chain no single link can be blamed, so
# the remediation names the count rather than the claimant. Every tool here is an inert stand-in.
apt-get install -y oldpkg
hork sync --profile web
ufw allow 443/tcp

-- firewall.oracle.sh --
#!/usr/bin/env dorc-sh
# dorc-lang/v0.2
ufw__predict() {
   verb=$1; shift
   rule : sm.dorc.Firewall = "$1"
   case $verb in
      allow) ufw status "$rule" >/dev/null 2>&1 : sm.dorc.Firewall:"$rule"@allowed ;;
   esac
}

ufw__is_converged() {
   verb=$1; shift
   case $verb in
      allow) ufw status "$1" >/dev/null 2>&1 ;;
      *) return 2 ;;
   esac
}

-- package.oracle.sh --
#!/usr/bin/env dorc-sh
# dorc-lang/v0.2
apt_get__predict() {
   while [ "${1#-}" != "$1" ]; do shift; done
   verb=$1; shift
   while [ "${1#-}" != "$1" ]; do shift; done
   pkg : sm.dorc.Package = "$1"
   if [ "${2-}" = "" ]; then
      case $verb in
         install) dpkg-query -W "$pkg" >/dev/null 2>&1 : sm.dorc.Package:"$pkg"@installed ;;
      esac
   fi
}

apt_get__disturbs() {
   while [ "${1#-}" != "$1" ]; do shift; done
   verb=$1; shift
   while [ "${1#-}" != "$1" ]; do shift; done
   case $verb in
      install) printf '%s\n' "$1" : disturbs sm.dorc.Package ;;
   esac
}

apt_get__is_converged() {
   while [ "${1#-}" != "$1" ]; do shift; done
   verb=$1; shift
   while [ "${1#-}" != "$1" ]; do shift; done
   case $verb in
      install) dpkg-query -W "$1" >/dev/null 2>&1 ;;
      *) return 2 ;;
   esac
}

-- hork.oracle.sh --
#!/usr/bin/env dorc-sh
# dorc-lang/v0.2
hork__predict() {
   verb=$1; shift
   prof : sm.dorc.Profile = "$1"
   case $verb in
      sync) hork --query "$prof" >/dev/null 2>&1 : sm.dorc.Profile:"$prof"@synced ;;
   esac
}

hork__disturbs() {
   verb=$1; shift
   case $verb in
      # The comment lines above an emission are quoted with it, so the reader sees the author's
      # own reasoning beside the claim rather than a bare line torn out of a file.
      sync) printf '%s\n' "$1" : disturbs sm.dorc.Profile ;;
   esac
}

hork__is_converged() {
   verb=$1; shift
   case $verb in
      sync) hork --query -- "$1" ;;
      *) return 2 ;;
   esac
}

