---
arrangement: cli-plan-summary-line
envelope: stderr
owns:
  - cli-why-pointer-line
  - cli-decision-digest-line
---
-- webhost.sh --
#!/bin/sh
set -eu
apt-get update
cp ./nginx.conf /etc/nginx/nginx.conf
hork tune --profile web

-- replay --
$ dorc plan --book=webhost.sh
dorc: run `dorc why` for the per-site cause-chains, or `dorc why webhost.sh:N` to query a source line
dorc: plan-summary sites=4 elide=0 omit=0 guard=0 run=4 may-alias=0
dorc: decision-digest b6bfc6a87611c7194a1a5f161b5475e59b6f4185b5933aca0510517878188fe6

$ dorc-loom --this vars
case: cli-plan-summary-line
{{v0}} = "webhost.sh"
{{v1}} = "0"
{{v2}} = "0"
{{v3}} = "0"
{{v4}} = "4"
{{v5}} = "0"
