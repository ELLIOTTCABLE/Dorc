-- book.sh --
#!/bin/sh
# The one world where a line leaves the plan on an author's CLAIM rather than on a measurement.
# `apt-get install` came back diverged, so it RUNS -- a wall across the book. Its author's
# `disturbs` member claims that install touches at most the Package cell it names, the firewall
# fact below is a different kind entirely, and `--risk-faultless-skips` is the admin consenting
# to act on a claim nothing verifies. Every tool named here is an inert corpus stand-in.
apt-get install -y oldpkg
ufw allow 443/tcp

-- firewall.oracle.sh --
#!/usr/bin/env dorc-sh
# dorc-lang/v0.2
# Nothing here knows about packages: the disjointness the survival rests on is derived from the
# two kinds, never declared by either author.
ufw__predict() {
   verb=$1; shift
   rule : sm.dorc.Firewall = "$1"
   case $verb in
      allow) ufw status "$rule" >/dev/null 2>&1 : sm.dorc.Firewall:"$rule"@allowed ;;
   esac
}

ufw__is_converged() {
   verb=$1; shift
   case $verb in
      allow) ufw status "$1" >/dev/null 2>&1 ;;
      *) return 2 ;;
   esac
}

-- package.oracle.sh --
#!/usr/bin/env dorc-sh
# dorc-lang/v0.2
# The `disturbs` member below is the AT-MOST claim the whole survival hangs on: this author says
# an install touches the Package cell it names, and nothing else. Nothing checks that. Widening
# the member is the repair the chain's `fix:` row points at.
apt_get__predict() {
   while [ "${1#-}" != "$1" ]; do shift; done
   verb=$1; shift
   while [ "${1#-}" != "$1" ]; do shift; done
   pkg : sm.dorc.Package = "$1"
   if [ "${2-}" = "" ]; then
      case $verb in
         install) dpkg-query -W "$pkg" >/dev/null 2>&1 : sm.dorc.Package:"$pkg"@installed ;;
      esac
   fi
}

apt_get__disturbs() {
   while [ "${1#-}" != "$1" ]; do shift; done
   verb=$1; shift
   while [ "${1#-}" != "$1" ]; do shift; done
   case $verb in
      install) printf '%s\n' "$1" : disturbs sm.dorc.Package ;;
   esac
}

apt_get__is_converged() {
   while [ "${1#-}" != "$1" ]; do shift; done
   verb=$1; shift
   while [ "${1#-}" != "$1" ]; do shift; done
   case $verb in
      install) dpkg-query -W "$1" >/dev/null 2>&1 ;;
      *) return 2 ;;
   esac
}

