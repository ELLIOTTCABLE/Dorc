-- book.sh --
#!/bin/sh
# What unmodeled commands cost. `hork` and `wombat` have no oracle, so their effect is unknown;
# `apt-get` is described but diverged, so it honestly runs. Everything after them loses the
# elision license: the converged service line drops to the GUARD tier, its own bytes verbatim
# behind its oracle's check. The firewall line above the walls keeps its elision.
ufw allow 80/tcp
hork tune --profile web
systemctl start nginx
wombat sync --profile web
apt-get install -y nginx
systemctl enable nginx

-- firewall.oracle.sh --
#!/usr/bin/env dorc-sh
# dorc-lang/v0.2
ufw__predict() {
   verb=$1; shift
   rule : sm.dorc.Firewall = "$1"
   case $verb in
      allow) ufw status "$rule" >/dev/null 2>&1 : sm.dorc.Firewall:"$rule"@allowed ;;
   esac
}

ufw__is_converged() {
   verb=$1; shift
   case $verb in
      allow) ufw status "$1" >/dev/null 2>&1 ;;
      *) return 2 ;;
   esac
}

-- service.oracle.sh --
#!/usr/bin/env dorc-sh
# dorc-lang/v0.2
# The verdict member below is what ships as the guard body when a converged site sits past a
# wall: the author's own bytes, strip-only, and no engine-written sh anywhere.
systemctl__predict() {
   verb=$1; shift
   svc : sm.dorc.Service = "$1"
   case $verb in
      start)  systemctl is-active  -- "$svc" : sm.dorc.Service:"$svc"@active ;;
      enable) systemctl is-enabled -- "$svc" : sm.dorc.Service:"$svc"@enabled ;;
   esac
}

systemctl__is_converged() {
   verb=$1; shift
   case $verb in
      start)  systemctl is-active  -- "$1" ;;
      enable) systemctl is-enabled -- "$1" ;;
      *) return 2 ;;
   esac
}

-- package.oracle.sh --
#!/usr/bin/env dorc-sh
# dorc-lang/v0.2
# Described, so its install is an HONEST wall rather than an opaque one: dorc knows exactly what
# it establishes and knows the host disagrees, which is a different thing to tell the reader.
apt_get__predict() {
   while [ "${1#-}" != "$1" ]; do shift; done
   verb=$1; shift
   while [ "${1#-}" != "$1" ]; do shift; done
   pkg : sm.dorc.Package = "$1"
   if [ "${2-}" = "" ]; then
      case $verb in
         install) dpkg-query -W "$pkg" >/dev/null 2>&1 : sm.dorc.Package:"$pkg"@installed ;;
      esac
   fi
}

apt_get__is_converged() {
   while [ "${1#-}" != "$1" ]; do shift; done
   verb=$1; shift
   while [ "${1#-}" != "$1" ]; do shift; done
   case $verb in
      install) dpkg-query -W "$1" >/dev/null 2>&1 ;;
      *) return 2 ;;
   esac
}

