#!/bin/sh
# dorc probe (read-only): checks per-SITE convergence, mutates nothing.
# When run, emits one results-record per site on stdout (the return channel):
#   site <leafid> effect=<holds|absent|cant-tell> rc=<n>
# effect is derived from the probe command's rc (0=holds, 1=absent, else cant-tell);
# rc is the raw PROBE-command status (opaque to Dorc — the record is the out-of-band lane).

printf 'dorc-records/1 nonce=dorc attempt=1 host=localhost book=8a720b1dae6d20e8 sites=1 @@dorc@@\n'
# site 0: dorc-auto:kp@converged
kp__is_converged() {
   kp check "$1" "$2"
}
kp__is_converged 'ip_forward' '1'; _rc=$?; if [ "$_rc" -eq 0 ]; then _e=holds; elif [ "$_rc" -eq 1 ]; then _e=absent; else _e=cant-tell; fi; printf 'dorc site 0 effect=%s rc=%s @@dorc@@\n' "$_e" "$_rc"
# site:1 unresolvable-no-probe
printf 'dorc-records-end/1 nonce=dorc @@dorc@@\n'
#!/bin/sh
# dorc apply: the book, with already-converged/dead lines elided (value-preserving stand-in).

#!/bin/sh
# 27C §4(a) carry NEGATIVE (27O): ambient kp elides; the chroot-wrapped policyctl STRADDLER has (A)
# but fails (B) — its verdict reads an fs-view-dependent file unmarked — so the carry walls, site runs.
# kp ip_forward 1   # dorc: elided (already converged / dead branch)
chroot /mnt policyctl swappiness 10
