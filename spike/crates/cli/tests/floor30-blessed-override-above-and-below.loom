-- book.sh --
#!/bin/sh
# floor30-blessed-override-above-and-below — the definition-fixtures battery's positional shape
# (`28Q` §8 stage-i: ground truth minted before the conversion that will consume it).
#
# `28K` §2 visibility-is-full-positional makes every site-keyed act answer from the definition live
# AT the site, and `28K` §1 reads an outer-frame rebind as a blessing rather than a conflict. Both
# rest on shell behaviour this file measures rather than assumes: a later redefinition needs no
# ceremony — it simply wins from its own line down — `unset -f` removes the binding outright, and a
# re-source restores it.
#
# Four measurements: the base body above the override, the override's body below it, the name after
# `unset -f` (absent, so the `||` tail speaks), and the base body again after a re-source. Engine
# agreement over these cells activates at the definition-factoring conversion; the answers committed
# here are the shells' own.
. ./base.sh
hork__is_converged
. ./override.sh
hork__is_converged
unset -f hork__is_converged
hork__is_converged 2>/dev/null || printf 'gone\n'
. ./base.sh
hork__is_converged

-- base.sh --
hork__is_converged() { printf 'base\n' ;}

-- override.sh --
hork__is_converged() { printf 'override\n' ;}

-- expected.emitted --
base
override
gone
base

-- expected.ran --

-- replay --
