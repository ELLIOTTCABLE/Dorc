-- book.sh --
#!/bin/sh
# floor30-deep-stack-binds-at-invocation — the definition-fixtures battery's late-binding shape
# (`28Q` §8 stage-i: ground truth minted before the conversion that will consume it).
#
# sh binds a function name at the CALL, never at the frame where the calling body was defined, and a
# chain three levels deep is where that stops being obvious: `chain.sh` is sourced ONCE, above every
# override, yet what its innermost link runs keeps changing underneath it. A conversion that
# resolved a body at definition time — or cached the chain's answer after the first call — would
# elide against the wrong author's text, and no golden of the chain's own bytes would show it.
#
# Four measurements: the chain reaching the base leaf, reaching the override after a re-source, the
# base leaf again inside a region that re-sourced it, and the override once more once that region
# closed. Engine agreement over these cells activates at the definition-factoring conversion; the
# answers committed here are the shells' own.
. ./chain.sh
. ./inner-base.sh
hork__is_converged
. ./inner-override.sh
hork__is_converged
( . ./inner-base.sh; hork__is_converged )
hork__is_converged

-- chain.sh --
hork__is_converged() { _hork_middle ;}
_hork_middle() { _hork_inner ;}

-- inner-base.sh --
_hork_inner() { printf 'base\n' ;}

-- inner-override.sh --
_hork_inner() { printf 'override\n' ;}

-- expected.emitted --
base
override
base
override

-- expected.ran --

-- replay --
