-- book.sh --
#!/bin/sh
# Ground truth: through a three-level chain, the body reached is the one live at the CALL, never the one live where the chain was defined.
. ./chain.sh
. ./inner-base.sh
hork__is_converged
. ./inner-override.sh
hork__is_converged
( . ./inner-base.sh; hork__is_converged )
hork__is_converged

-- chain.sh --
hork__is_converged() { _hork_middle ;}
_hork_middle() { _hork_inner ;}

-- inner-base.sh --
_hork_inner() { printf 'base\n' ;}

-- inner-override.sh --
_hork_inner() { printf 'override\n' ;}

-- expected.emitted --
base
override
base
override

-- expected.ran --

-- replay --
$ dorc --book=book.sh
#!/bin/sh
# dorc probe (read-only): checks per-SITE convergence, mutates nothing.
# When run, emits one results-record per site on stdout (the return channel):
#   site <leafid> effect=<holds|absent|cant-tell> rc=<n>
# effect is derived from the probe command's rc (0=holds, 1=absent, else cant-tell);
# rc is the raw PROBE-command status (opaque to Dorc -- the record is the out-of-band lane).

printf 'dorc-records/1 nonce=dorc attempt=1 host=localhost book=d1278b6f8f68e54dd3dd33f5dfc0a7100f3eabdf6f67eeae52f5498fd637e667 sites=0 @@dorc@@\n'
# site:0 unresolvable-no-probe
# site:1 unresolvable-no-probe
# site:2 unresolvable-no-probe
# site:3 unresolvable-no-probe
# site:4 unresolvable-no-probe
# site:5 unresolvable-no-probe
# site:6 unresolvable-no-probe
# site:7 unresolvable-no-probe
printf 'dorc-records-end/1 nonce=dorc @@dorc@@\n'
#!/bin/sh
# dorc apply: the book, with already-converged/dead lines elided (value-preserving stand-in).

#!/bin/sh
# Ground truth: through a three-level chain, the body reached is the one live at the CALL, never the one live where the chain was defined.
. ./chain.sh
. ./inner-base.sh
hork__is_converged
. ./inner-override.sh
hork__is_converged
( . ./inner-base.sh; hork__is_converged )
hork__is_converged
