-- book.sh --
#!/bin/sh
# dorc-lang/v0.2
# pin28-wrapped-vouch-withholds-above-its-definition — the B half of the wrapped seat's positional
# pair (`28P:tc-wrapped-vouch-seat-has-no-positional-gate`; `28K` §2
# rul-visibility-is-full-positional). The SAME two statements as
# pin28-wrapped-vouch-answers-at-a-live-site, in the other order.
#
# `build_wrapped_vouches` is the sixth resolution seat and was the last one resolving whole-unit
# without asking whether its winner is the definition live AT the site: bitem3 fixed its scan
# direction (it was first-definition-wins, the inverse of sh's answer) and left custody honest
# about WHOSE judgment speaks and silent about WHERE. It now withholds on disagreement, through the
# same one custody crossing every other seat compares over — withhold, never re-resolve, because
# resolving a site's identity through one file while reading another file's cells measures one cell
# and keys the record to another.
#
# A shell running this book top-to-bottom has no `hork__is_converged` at the site, so Dorc answers
# nothing there: no check ships, no vouch mints, and the line runs verbatim. Moving those four
# lines above it is the remediation, which is what `role-defined-below-its-sites` says.
sudo hork install wombat
hork__is_converged() {
   : safe-across user
   hork query -- "$2"
}

-- sudo.oracle.sh --
# dorc-lang/v0.2
# A coherent sudo wrapper (273 + 27C §3): predict env-scrubs + execs the guest; lend_map maps user
# and full-lends fs-view + netns (enumerate-every-dimension); the entry form re-runs sudo `-n`
# (non-interactive by construction). Authoring `sudo__enter` IS the traversal vouch.
sudo__predict() {
   while [ "${1#-}" != "$1" ]; do case "$1" in -u) shift 2 ;; *) shift ;; esac; done
   env -i HOME=/root "$@"
}
sudo__lend_map() {
   target=root
   while [ "${1#-}" != "$1" ]; do case "$1" in -u) target="$2"; shift 2 ;; *) shift ;; esac; done
   printf '%s\n' "$target" : lends user
   : lends fs-view
   : lends netns
   "$@"
}
sudo__enter() {
   sudo -n "$@"
}

-- probe-results.txt --
# EMPTY, and that is the measurement: the twin's identical site ships a check and reports
# converged, and this one ships none at all, so there is no answer for a license to read.

-- mocks/.log --
# newline-safe argv logger for the inert mock shims (slice-4). Sourced by each shim via
# `. "${0%/*}/.log"` (the shim's own dir); a DOTFILE so gate-5/gate-6's `ls`-derived shimset
# never lists it. Shims run under PATH=mocks-only ⇒ BUILTINS ONLY (no sed/awk).
#
# GRAMMAR (what expected.ran goldens carry): one `ran: <name> <arg>…` line per invocation; each
# arg is encoded — a literal backslash as `\\`, an embedded newline as the two chars `\n`. The
# two passes run in THIS order (backslash first) so a newline's encoded `\n` backslash is not
# re-doubled.
_dorc_logged() {
  _dl_out="ran: ${0##*/}"
  for _dl_a in "$@"; do
    _dl_o=""                                          # pass 1: \ -> \\
    while case $_dl_a in *\\*) true ;; *) false ;; esac; do
      _dl_o="$_dl_o${_dl_a%%\\*}\\\\"; _dl_a=${_dl_a#*\\}
    done
    _dl_a="$_dl_o$_dl_a"
    _dl_o=""                                          # pass 2: newline -> \n
    while case $_dl_a in *"$_DL_NL"*) true ;; *) false ;; esac; do
      _dl_o="$_dl_o${_dl_a%%"$_DL_NL"*}\\n"; _dl_a=${_dl_a#*"$_DL_NL"}
    done
    _dl_out="$_dl_out $_dl_o$_dl_a"
  done
  printf '%s\n' "$_dl_out" >>"$DORC_LOG"
}
_DL_NL='
'

-- mocks/hork --
#!/bin/sh
# INERT strawman mock (never a real mutator): logs its argv for the run-set, mutates nothing.
. "${0%/*}/.log"; _dorc_logged "$@"
exit 0

-- mocks/sudo --
#!/bin/sh
# INERT mock: `sudo -n <guest>` (27C probe entry) would EXEC the guest, but the guest here is a
# shell FUNCTION, so this shape logs and exits 0 instead. The run-log is the whole observable.
. "${0%/*}/.log"; _dorc_logged "$@"
exit 0

