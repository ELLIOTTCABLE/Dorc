-- book.sh --
#!/bin/sh
# contest28-polyfill-guard-defers-to-the-oracle (`28M` §9, the decidable-condition fold) — the
# P1 cell of `28O:res-polyfill-binding-tops-pending-fold`, end to end.
#
# A polite author's define-if-absent default, loaded AFTER a real oracle for the same tool. Under
# plain sh the guard simply does not fire and the loaded oracle answers; before the fold the
# analyzer could not read that, joined the family to ⊤, and the polite file quietly poisoned the
# family it had deferred to — no probe, no vouch, no elision, silently.
#
# The condition is decidable-FALSE at its own position (`command -v <role name>` is contracted to
# function-definedness within the unit, `28M:rul-command-v-reads-fn-definedness`), so the guarded
# arm's edge is masked dead and the loaded definition survives intact — the lattice `28K` §3
# promised, read rather than abstained from.
#
# The site GUARDS rather than elides, and that is honest: the guard's own `command -v` line is an
# unmodeled command that really runs, so it walls (`opaque-poison-is-the-product`). What the fold
# delivers is that the family answers AT ALL — before it, the whole family joined to ⊤ and the
# site ran raw with no check at all.
#
# ANTI-MASKING: the two bodies invoke DIFFERENT commands, so `expected.ran` alone distinguishes
# which one won. `foobar guard-fallback` appearing anywhere below means the dead arm licensed.
if ! command -v foobar__is_converged >/dev/null 2>&1; then
   foobar__is_converged() {
      foobar guard-fallback --certs "$2"
   }
fi
foobar sync-certs /etc/nginx/certs

-- foobar.oracle.sh --
foobar__is_converged() {
   verb="$1"; shift
   case "$verb" in
   sync-certs) foobar status --certs-current -- "$1" ;;
   *) return 2 ;;
   esac
}

-- probe-results.txt --
# site 1 = `foobar sync-certs …`, answered by the ORACLE's definition — the guard never fired.
# rc 0 ⇒ converged; past the wall the unmodeled `command -v` raises, that mints a guard.
site 1 effect=holds rc=0

-- mocks/.log --
# newline-safe argv logger for the inert mock shims (slice-4). Sourced by each shim via
# `. "${0%/*}/.log"` (the shim's own dir); a DOTFILE so gate-5/gate-6's `ls`-derived shimset
# never lists it. Shims run under PATH=mocks-only ⇒ BUILTINS ONLY (no sed/awk).
_dorc_logged() {
  _dl_out="ran: ${0##*/}"
  for _dl_a in "$@"; do
    _dl_o=""                                          # pass 1: \ -> \\
    while case $_dl_a in *\\*) true ;; *) false ;; esac; do
      _dl_o="$_dl_o${_dl_a%%\\*}\\\\"; _dl_a=${_dl_a#*\\}
    done
    _dl_a="$_dl_o$_dl_a"
    _dl_o=""                                          # pass 2: newline -> \n
    while case $_dl_a in *"$_DL_NL"*) true ;; *) false ;; esac; do
      _dl_o="$_dl_o${_dl_a%%"$_DL_NL"*}\\n"; _dl_a=${_dl_a#*"$_DL_NL"}
    done
    _dl_out="$_dl_out $_dl_o$_dl_a"
  done
  printf '%s\n' "$_dl_out" >>"$DORC_LOG"
}
_DL_NL='
'

-- mocks/foobar --
#!/bin/sh
# INERT mock: logs that it ran, mutates NOTHING, exits 0.
. "${0%/*}/.log"; _dorc_logged "$@"
exit 0

-- expected.ran --
ran: foobar status --certs-current -- /etc/nginx/certs

-- replay --
$ dorc --book=book.sh --pre-source foobar.oracle.sh --results - < probe-results.txt
reserved: warning[reserved-namespace-squat]: Book function
`foobar__is_converged` sits in the `__is_converged` namespace reserved for
oracle functions; Dorc treats it as ordinary shell and runs it verbatim, but a
shipped oracle preamble defining the same name would collide with it. Rename it
to stay clear of `*__is_converged`.
      [ book.sh:23:4
   23 |    foobar__is_converged() {
      |    \__________________/
#!/bin/sh
# dorc probe (read-only): checks per-SITE convergence, mutates nothing.
# When run, emits one results-record per site on stdout (the return channel):
#   site <leafid> effect=<holds|absent|cant-tell> rc=<n>
# effect is derived from the probe command's rc (0=holds, 1=absent, else cant-tell);
# rc is the raw PROBE-command status (opaque to Dorc -- the record is the out-of-band lane).

printf 'dorc-records/1 nonce=dorc attempt=1 host=localhost book=be7a2cb3f36c458250b02c6f97dbd6264996ed875e0f8ac87348bffe1d0f2097 sites=1 @@dorc@@\n'
# site 1: dorc-auto:foobar@converged
foobar__is_converged() {
   verb="$1"; shift
   case "$verb" in
   sync-certs) foobar status --certs-current -- "$1" ;;
   *) return 2 ;;
   esac
}
foobar__is_converged 'sync-certs' '/etc/nginx/certs'; _rc=$?; if [ "$_rc" -eq 0 ]; then _e=holds; elif [ "$_rc" -eq 1 ]; then _e=absent; else _e=cant-tell; fi; printf 'dorc site 1 effect=%s rc=%s @@dorc@@\n' "$_e" "$_rc"
# site:0 unresolvable-no-probe
printf 'dorc-records-end/1 nonce=dorc @@dorc@@\n'
classify: note[cmdsub-operand-top]: operand 3 is an unresolvable positional
parameter (`$@`/`$*`/`$N`), so Dorc cannot know its value until the command runs
on the host -- there is nothing to resolve and no read-only probe to check. Dorc
elides a command only when it can prove the command's effect is already in
place, so this one is left to run on every apply.
      [ book.sh:24:37
   24 |       foobar guard-fallback --certs "$2"
      |                                     \__/

   = repair:  Give the operand a value Dorc can resolve statically -- a literal,
              or a variable assigned from one -- so Dorc can probe it and elide
              the command once it has converged. If the value must stay dynamic,
              load an oracle that vouches for this command's convergence, and
              Dorc will guard the command instead of running it every time.
probe: note[site-unresolvable]: sm 1 site run unprobed (no read-only check could
be shipped): `command -v foobar__is_converged >/dev/null 2>&1` -- run `dorc why`
for the per-site detail (the apply runs each anyway, to stay safe)
      [ book.sh:22:6
   22 | if ! command -v foobar__is_converged >/dev/null 2>&1; then
      |      \_____________________________________________/

   = help:  sm site runs `command -v foobar__is_converged >/dev/null 2>&1`
why: ran because operand 3 is a command-substitution `$(...)` or runtime-dynamic value -- its value couldn't be resolved (first seen at 24:7 `foobar guard-fallback --certs "$2"`); so dorc runs it, to stay safe (when unsure, run). to skip it, make the operand a literal Dorc can resolve+probe [resolve-dynamism]
why: site 1 guard [dorc-auto:foobar] -- licensed by the dorc-auto:foobar oracle's vouch (at foobar.oracle.sh:4) that it is already satisfied; the original bytes survive and the check re-runs live at apply (to stay safe)
hint: 'command' (line 22) is unmodeled: it is the first wall -- an oracle vouching its convergence would elide it when converged, and un-wall 1 downstream site
dorc: run `dorc why` for the per-site cause-chains, or `dorc why book.sh:N` to query a source line
#!/bin/sh
# dorc apply: the book, with already-converged/dead lines elided (value-preserving stand-in).

# dorc guard preamble: the vouching oracle's own verdict body, shipped strip-only
# (dialect annotations removed, nothing else changed -- rul-ternary-verdict: the
# authored bytes verbatim, no engine-synthesized sh).
foobar__is_converged() {
   verb="$1"; shift
   case "$verb" in
   sync-certs) foobar status --certs-current -- "$1" ;;
   *) return 2 ;;
   esac
}

# dorc: end of lifted material; the book follows, in its authored order.

#!/bin/sh
# contest28-polyfill-guard-defers-to-the-oracle (`28M` §9, the decidable-condition fold) — the
# P1 cell of `28O:res-polyfill-binding-tops-pending-fold`, end to end.
#
# A polite author's define-if-absent default, loaded AFTER a real oracle for the same tool. Under
# plain sh the guard simply does not fire and the loaded oracle answers; before the fold the
# analyzer could not read that, joined the family to ⊤, and the polite file quietly poisoned the
# family it had deferred to — no probe, no vouch, no elision, silently.
#
# The condition is decidable-FALSE at its own position (`command -v <role name>` is contracted to
# function-definedness within the unit, `28M:rul-command-v-reads-fn-definedness`), so the guarded
# arm's edge is masked dead and the loaded definition survives intact — the lattice `28K` §3
# promised, read rather than abstained from.
#
# The site GUARDS rather than elides, and that is honest: the guard's own `command -v` line is an
# unmodeled command that really runs, so it walls (`opaque-poison-is-the-product`). What the fold
# delivers is that the family answers AT ALL — before it, the whole family joined to ⊤ and the
# site ran raw with no check at all.
#
# ANTI-MASKING: the two bodies invoke DIFFERENT commands, so `expected.ran` alone distinguishes
# which one won. `foobar guard-fallback` appearing anywhere below means the dead arm licensed.
if ! command -v foobar__is_converged >/dev/null 2>&1; then
   foobar__is_converged() {
      foobar guard-fallback --certs "$2"
   }
fi
( foobar__is_converged sync-certs /etc/nginx/certs ) || foobar sync-certs /etc/nginx/certs   # dorc: guard [dorc-auto:foobar converged-vouch; probe: holds]
