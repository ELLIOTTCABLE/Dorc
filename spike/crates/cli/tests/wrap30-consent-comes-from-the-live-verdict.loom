-- book.sh --
#!/bin/sh
# dorc-lang/v0.2
# wrap30-consent-comes-from-the-live-verdict (`308:rul-wrapper-lane-joins-the-conversion`) — the
# CONSENT CHIMERA, closed.
#
# `27C`'s entry consent is double-ended: the author's per-function `: safe-across <dim>` mark times
# the admin's dial. The mark is a claim about ONE BODY — "this body's effects are read-only by
# design" — so it can only speak for the body that actually executes in the shifted context.
#
# Here the oracle's marked body is blessed away (`unset -f`, `28K` §1's whole blessing vocabulary)
# and this book's own unmarked body is what the frame names at the site. The lane used to take the
# tolerance vouch first-file-wins, so the FIRST author's mark licensed entering the root context to
# run the SECOND author's body — a consent nobody gave. The book author typed no mark, so the site
# degrades and runs.
#
# ANTI-MASKING: the two bodies invoke DIFFERENT check commands, so if a check ever ships the probe
# artifact says whose. `hork query` is the oracle's; `hork inspect` is this book's.
unset -f hork__is_converged
hork__is_converged() {
   hork inspect -- "$2"
}
sudo hork install wombat

-- hork.oracle.sh --
# dorc-lang/v0.2
# The FIRST author, who did vouch context-tolerance. Blessed away above, so this mark speaks for
# nothing at the site below it.
hork__is_converged() {
   : safe-across user
   hork query -- "$2"
}

-- sudo.oracle.sh --
# dorc-lang/v0.2
# The coherent sudo wrapper of pin28-wrapped-vouch-answers-at-a-live-site, byte-for-byte.
sudo__predict() {
   while [ "${1#-}" != "$1" ]; do case "$1" in -u) shift 2 ;; *) shift ;; esac; done
   env -i HOME=/root "$@"
}
sudo__lend_map() {
   target=root
   while [ "${1#-}" != "$1" ]; do case "$1" in -u) target="$2"; shift 2 ;; *) shift ;; esac; done
   printf '%s\n' "$target" : lends user
   : lends fs-view
   : lends netns
   "$@"
}
sudo__enter() {
   sudo -n "$@"
}

