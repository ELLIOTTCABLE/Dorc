-- book.sh --
#!/bin/sh
# dorc-lang/v0.2
# pin28-wrapped-vouch-answers-at-a-live-site — the A half of the wrapped seat's positional pair
# (`28P:tc-wrapped-vouch-seat-has-no-positional-gate`). Its twin,
# pin28-wrapped-vouch-withholds-above-its-definition, is the SAME two statements in the other
# order, and that is the only difference between an elided line and a line that runs.
#
# A wrapped site's argv[0] is the WRAPPER word, so the ordinary vouch builder cannot key on it and
# `build_wrapped_vouches` mints from the INNER verdict over the peeled argv. Here the definition
# precedes its site, so a shell running this book top-to-bottom would have it live at that line —
# and it is the definition entitled to speak there.
#
# The pair is TWO cases rather than one book with a site on each side, because the un-licensed site
# runs, and a running site is a wall: everything below it would guard rather than elide for a
# reason that has nothing to do with what is being pinned.
hork__is_converged() {
   : safe-across user
   hork query -- "$2"
}
sudo hork install wombat

-- sudo.oracle.sh --
# dorc-lang/v0.2
# A coherent sudo wrapper (273 + 27C §3): predict env-scrubs + execs the guest; lend_map maps user
# and full-lends fs-view + netns (enumerate-every-dimension); the entry form re-runs sudo `-n`
# (non-interactive by construction). Authoring `sudo__enter` IS the traversal vouch.
sudo__predict() {
   while [ "${1#-}" != "$1" ]; do case "$1" in -u) shift 2 ;; *) shift ;; esac; done
   env -i HOME=/root "$@"
}
sudo__lend_map() {
   target=root
   while [ "${1#-}" != "$1" ]; do case "$1" in -u) target="$2"; shift 2 ;; *) shift ;; esac; done
   printf '%s\n' "$target" : lends user
   : lends fs-view
   : lends netns
   "$@"
}
sudo__enter() {
   sudo -n "$@"
}

-- probe-results.txt --
# The site IS probed, in the root context the wrapper denotes, and reports converged.
site 0 effect=holds rc=0

-- mocks/.log --
# newline-safe argv logger for the inert mock shims (slice-4). Sourced by each shim via
# `. "${0%/*}/.log"` (the shim's own dir); a DOTFILE so gate-5/gate-6's `ls`-derived shimset
# never lists it. Shims run under PATH=mocks-only ⇒ BUILTINS ONLY (no sed/awk).
#
# GRAMMAR (what expected.ran goldens carry): one `ran: <name> <arg>…` line per invocation; each
# arg is encoded — a literal backslash as `\\`, an embedded newline as the two chars `\n`. The
# two passes run in THIS order (backslash first) so a newline's encoded `\n` backslash is not
# re-doubled.
_dorc_logged() {
  _dl_out="ran: ${0##*/}"
  for _dl_a in "$@"; do
    _dl_o=""                                          # pass 1: \ -> \\
    while case $_dl_a in *\\*) true ;; *) false ;; esac; do
      _dl_o="$_dl_o${_dl_a%%\\*}\\\\"; _dl_a=${_dl_a#*\\}
    done
    _dl_a="$_dl_o$_dl_a"
    _dl_o=""                                          # pass 2: newline -> \n
    while case $_dl_a in *"$_DL_NL"*) true ;; *) false ;; esac; do
      _dl_o="$_dl_o${_dl_a%%"$_DL_NL"*}\\n"; _dl_a=${_dl_a#*"$_DL_NL"}
    done
    _dl_out="$_dl_out $_dl_o$_dl_a"
  done
  printf '%s\n' "$_dl_out" >>"$DORC_LOG"
}
_DL_NL='
'

-- mocks/hork --
#!/bin/sh
# INERT strawman mock (never a real mutator): logs its argv for the run-set, mutates nothing.
. "${0%/*}/.log"; _dorc_logged "$@"
exit 0

-- mocks/sudo --
#!/bin/sh
# INERT mock: `sudo -n <guest>` (27C probe entry) would EXEC the guest, but the guest here is a
# shell FUNCTION, so this shape logs and exits 0 instead. The run-log is the whole observable.
. "${0%/*}/.log"; _dorc_logged "$@"
exit 0

