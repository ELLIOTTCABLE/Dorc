-- book.sh --
# fix-ladder-middle-absent-stops-cascade (`26H` §4 W-C, the boundary): the ladder with the MIDDLE
# guard reporting absent. Rung 1 folds and its install is erased; rung 2's install is LIVE, so it
# still invalidates below it. Rung 3's guard measured holds (rc 0, recorded) and would substitute
# to `true` if the cascade reached it — it renders VERBATIM instead, which is the boundary: the
# cascade must stop at the live mutator, not run past it.
set -e
dpkg -s alpha >/dev/null 2>&1 || apt-get install -y alpha
dpkg -s beta >/dev/null 2>&1 || apt-get install -y beta
dpkg -s gamma >/dev/null 2>&1

-- package.oracle.sh --
#!/usr/bin/env dorc-sh
# dorc-lang/v0.2
# minimal package oracle (apt/dpkg), lifted statically by dorc.
apt_get__predict() {
   while [ "${1#-}" != "$1" ]; do shift; done
   verb=$1; shift
   while [ "${1#-}" != "$1" ]; do shift; done
   pkg : sm.dorc.Package = "$1"
   if [ "${2-}" = "" ]; then
      case $verb in
         install) dpkg-query -W "$pkg" >/dev/null 2>&1 : sm.dorc.Package:"$pkg"@installed ;;
         purge) dpkg-query -W "$pkg" >/dev/null 2>&1 :! sm.dorc.Package:"$pkg"@installed ;;
      esac
   fi
}

-- pkgstate.oracle.sh --
#!/usr/bin/env dorc-sh
# dorc-lang/v0.2
# package-status QUERY oracle (the DESIGN `dpkg -s nginx || apt-get install` idiom).
dpkg__predict() {
   case $1 in -s) shift ;; esac
   pkg : sm.dorc.PkgState = "$1"
   dpkg -s -- "$pkg" >/dev/null 2>&1 :? sm.dorc.PkgState:"$pkg"@installed
}

-- probe-results.txt --
# probe-results (`26H` §4 W-C, the boundary). Site 1 holds ⇒ rung 1 folds and its install (site 2)
# is erased. Site 3 reports ABSENT ⇒ rung 2's install (site 4) is live and stays an invalidator, so
# site 5's guard never becomes valid: its rc is measured and recorded here, and stays WITHHELD,
# exactly as an honest mutator above a guard demands. `set -e` is site 0 (MustRun, no record).
site 1 effect=holds rc=0
site 2 effect=holds
site 3 effect=absent rc=1
site 4 effect=absent
site 5 effect=holds rc=0

-- mocks/.log --
# newline-safe argv logger for the inert mock shims (slice-4). Sourced by each shim via
# `. "${0%/*}/.log"` (the shim's own dir); a DOTFILE so gate-5/gate-6's `ls`-derived shimset
# never lists it. Replaces the old inline `printf 'ran: %s %s\n' "${0##*/}" "$*"` — an arg with
# an embedded NEWLINE would split the `ran:` line and silently break every line-based compare
# (exec_check, gate-5, gate-6). Shims run under PATH=mocks-only ⇒ BUILTINS ONLY (no sed/awk).
#
# GRAMMAR (what expected.ran goldens carry): one `ran: <name> <arg>…` line per invocation; each
# arg is encoded — a literal backslash as `\\`, an embedded newline as the two chars `\n`. The
# two passes run in THIS order (backslash first) so a newline's encoded `\n` backslash is not
# re-doubled. A newline-free, backslash-free argv encodes to itself ⇒ byte-identical to the old
# format (per-arg space-join == the old `"$*"` join) ⇒ zero golden churn.
_dorc_logged() {
  _dl_out="ran: ${0##*/}"
  for _dl_a in "$@"; do
    _dl_o=""                                          # pass 1: \ -> \\
    while case $_dl_a in *\\*) true ;; *) false ;; esac; do
      _dl_o="$_dl_o${_dl_a%%\\*}\\\\"; _dl_a=${_dl_a#*\\}
    done
    _dl_a="$_dl_o$_dl_a"
    _dl_o=""                                          # pass 2: newline -> \n
    while case $_dl_a in *"$_DL_NL"*) true ;; *) false ;; esac; do
      _dl_o="$_dl_o${_dl_a%%"$_DL_NL"*}\\n"; _dl_a=${_dl_a#*"$_DL_NL"}
    done
    _dl_out="$_dl_out $_dl_o$_dl_a"
  done
  printf '%s\n' "$_dl_out" >>"$DORC_LOG"
}
_DL_NL='
'

-- mocks/apt-get --
#!/bin/sh
# INERT shim for `apt-get` — rung 2's install RUNS here (its guard reported absent), which is
# the whole point: a live mutator still walls the guard below it. Rungs 1 and 3 must not appear.
. "${0%/*}/.log"; _dorc_logged "$@"
exit 0

-- mocks/dpkg --
#!/bin/sh
# INERT shim for `dpkg` — the pkgstate guard. alpha and gamma are installed, beta is NOT: the
# middle guard fails, so rung 2's install is genuinely live and must invalidate rung 3 below it.
. "${0%/*}/.log"; _dorc_logged "$@"
pkg=$2; [ "$pkg" = "--" ] && pkg=$3
case $pkg in
  alpha|gamma) exit 0 ;;
  *) exit 1 ;;
esac

-- mocks/dpkg-query --
#!/bin/sh
# INERT shim for `dpkg-query` — the install-establish probe, consistent with the guard host:
# alpha and gamma installed, beta absent.
. "${0%/*}/.log"; _dorc_logged "$@"
case $2 in
  beta) exit 1 ;;
  *) exit 0 ;;
esac

-- expected.ran --
ran: apt-get install -y beta
ran: dpkg -s gamma

-- replay --
$ dorc --book=book.sh --pre-source package.oracle.sh --pre-source pkgstate.oracle.sh --results - < probe-results.txt
#!/bin/sh
# dorc probe (read-only): checks per-SITE convergence, mutates nothing.
# When run, emits one results-record per site on stdout (the return channel):
#   site <leafid> effect=<holds|absent|cant-tell> rc=<n>
# effect is derived from the probe command's rc (0=holds, 1=absent, else cant-tell);
# rc is the raw PROBE-command status (opaque to Dorc -- the record is the out-of-band lane).

printf 'dorc-records/1 nonce=dorc attempt=1 host=localhost book=26e5a4af65a6f4968f5a0ecb2812b74aec0f48c0aee2c5e68f516749ae172fd9 sites=5 @@dorc@@\n'
# site 1: sm.dorc.PkgState:alpha@installed
dpkg__predict() {
   case $1 in -s) shift ;; esac
   pkg="$1"
   dpkg -s -- "$pkg" >/dev/null 2>&1
}
dpkg__predict '-s' 'alpha'; _rc=$?; if [ "$_rc" -eq 0 ]; then _e=holds; elif [ "$_rc" -eq 1 ]; then _e=absent; else _e=cant-tell; fi; printf 'dorc site 1 effect=%s rc=%s @@dorc@@\n' "$_e" "$_rc"
# site 2: sm.dorc.Package:alpha@installed
apt_get__predict() {
   while [ "${1#-}" != "$1" ]; do shift; done
   verb=$1; shift
   while [ "${1#-}" != "$1" ]; do shift; done
   pkg="$1"
   if [ "${2-}" = "" ]; then
      case $verb in
         install) dpkg-query -W "$pkg" >/dev/null 2>&1 ;;
         purge) dpkg-query -W "$pkg" >/dev/null 2>&1 ;;
      esac
   fi
}
apt_get__predict 'install' '-y' 'alpha'; _rc=$?; if [ "$_rc" -eq 0 ]; then _e=holds; elif [ "$_rc" -eq 1 ]; then _e=absent; else _e=cant-tell; fi; printf 'dorc site 2 effect=%s rc=%s @@dorc@@\n' "$_e" "$_rc"
# site 3: sm.dorc.PkgState:beta@installed
dpkg__predict '-s' 'beta'; _rc=$?; if [ "$_rc" -eq 0 ]; then _e=holds; elif [ "$_rc" -eq 1 ]; then _e=absent; else _e=cant-tell; fi; printf 'dorc site 3 effect=%s rc=%s @@dorc@@\n' "$_e" "$_rc"
# site 4: sm.dorc.Package:beta@installed
apt_get__predict 'install' '-y' 'beta'; _rc=$?; if [ "$_rc" -eq 0 ]; then _e=holds; elif [ "$_rc" -eq 1 ]; then _e=absent; else _e=cant-tell; fi; printf 'dorc site 4 effect=%s rc=%s @@dorc@@\n' "$_e" "$_rc"
# site 5: sm.dorc.PkgState:gamma@installed
dpkg__predict '-s' 'gamma'; _rc=$?; if [ "$_rc" -eq 0 ]; then _e=holds; elif [ "$_rc" -eq 1 ]; then _e=absent; else _e=cant-tell; fi; printf 'dorc site 5 effect=%s rc=%s @@dorc@@\n' "$_e" "$_rc"
# site:0 unresolvable-no-probe
printf 'dorc-records-end/1 nonce=dorc @@dorc@@\n'
dorc: run `dorc why` for the per-site cause-chains, or `dorc why book.sh:N` to query a source line
#!/bin/sh
# dorc apply: the book, with already-converged/dead lines elided (value-preserving stand-in).

# fix-ladder-middle-absent-stops-cascade (`26H` §4 W-C, the boundary): the ladder with the MIDDLE
# guard reporting absent. Rung 1 folds and its install is erased; rung 2's install is LIVE, so it
# still invalidates below it. Rung 3's guard measured holds (rc 0, recorded) and would substitute
# to `true` if the cascade reached it — it renders VERBATIM instead, which is the boundary: the
# cascade must stop at the live mutator, not run past it.
set -e
true || :   # dorc: elided [dpkg -s alpha >/dev/null 2>&1; apt-get install -y alpha] (already converged / dead branch)
false || apt-get install -y beta   # dorc: elided [dpkg -s beta >/dev/null 2>&1] (already converged / dead branch)
dpkg -s gamma >/dev/null 2>&1
dorc: plan-summary sites=6 elide=2 omit=1 guard=0 run=3 may-alias=0
dorc: decision-digest 7dcb2d4c085abfabac26f7a9d53cc3b2113206f1cbdbb63c3c0e2b5b5a602543
