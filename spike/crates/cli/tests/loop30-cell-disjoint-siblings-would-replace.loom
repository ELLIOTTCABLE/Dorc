-- book.sh --
#!/bin/sh
# A cell-disjoint sibling of `loop30-direct-and-called-mutators-share-a-loop-body`: byte-identical
# CFG, oracles, mocks, and convergence facts, and DESCRIPTIVE of what the engine emits today
# (`FORFEITS:forfeit-cell-blind-self-reach-walls-loop-siblings`).
#
# CFG shape: a top-level `for` over two literal words; its body holds one direct command leaf AND
# one call whose spliced body holds one command leaf (the region). All four cells converged; the two
# families are cell-disjoint (`lib*` versus bare).
#
# WHAT RUNS TODAY: the region's own per-member establishes reach the direct mutator back over the
# loop's edge, and self-reach (`Reach::is_pristine`) is CELL-BLIND — it cannot see that `lib$pkg` and
# `$pkg` never alias — so disjointness buys nothing and the direct mutator's running walls the shared
# `install_pkg` region down to GUARD (`30Qa:fnd-self-reach-is-cell-blind-across-the-back-edge`). A
# runtime check therefore ships at apply-time, and BOTH the direct mutator and the guarded region
# run — all four commands are in the run-set (`expected.ran`, this case).
#
# THE WIDENING: a cell-AWARE self-reach (`30Qa:tc-self-reach-cell-blind-widening`, flagged not built)
# would see the direct mutator's establish and the region's read/establish as provably-disjoint
# cells, so the region's self-reach would stay pristine and the shared definition would take full
# elision (Replace) rather than Guard — leaving the direct mutator the only line in the run-set.
install_pkg() {
   apt-get install -y "$1"
}

for pkg in nginx curl; do
   apt-get install -y "lib$pkg"
   install_pkg "$pkg"
done

-- pkgindex-predict.oracle.sh --
#!/usr/bin/env dorc-sh
# dorc-lang/v0.2
apt_get__predict() {
   while [ "${1#-}" != "$1" ]; do shift; done
   verb=$1; shift
   while [ "${1#-}" != "$1" ]; do shift; done
   pkg : sm.dorc.Package = "$1"
   if [ "${2-}" = "" ]; then
      case $verb in
         install) dpkg-query -W "$pkg" >/dev/null 2>&1 : sm.dorc.Package:"$pkg"@installed ;;
      esac
   fi
}

-- pkgindex-verdict.oracle.sh --
#!/usr/bin/env dorc-sh
# dorc-lang/v0.2
apt_get__is_converged() {
   while [ "${1#-}" != "$1" ]; do shift; done
   verb=$1; shift
   while [ "${1#-}" != "$1" ]; do shift; done
   case $verb in
      install) aptcheck -q -- "$1" ;;
      *) return 2 ;;
   esac
}

-- probe-results.txt --
# Leaf 0 is the DIRECT in-loop mutator: its sub-index is the r21 member index (libnginx, libcurl).
# Leaf 1 is the CALL: its sub-index is member-major over (body-site, member) — one body site, so
# member 0 then member 1 (nginx, curl). All four converged.
site 0.0 effect=holds rc=0
site 0.1 effect=holds rc=0
site 1.0 effect=holds rc=0
site 1.1 effect=holds rc=0

-- mocks/.log --
_dorc_logged() {
   _dl_out="ran: ${0##*/}"
   for _dl_arg in "$@"; do _dl_out="$_dl_out $_dl_arg"; done
   printf '%s\n' "$_dl_out" >>"$DORC_LOG"
}

-- mocks/apt-get --
#!/bin/sh
. "${0%/*}/.log"; _dorc_logged "$@"
exit 0

-- mocks/aptcheck --
#!/bin/sh
. "${0%/*}/.log"; _dorc_logged "$@"
exit 0

-- mocks/dpkg-query --
#!/bin/sh
. "${0%/*}/.log"; _dorc_logged "$@"
exit 0

-- expected.ran --
ran: apt-get install -y libnginx
ran: aptcheck -q -- nginx
ran: apt-get install -y libcurl
ran: aptcheck -q -- curl

-- replay --
$ dorc --book=book.sh --pre-source pkgindex-predict.oracle.sh --pre-source pkgindex-verdict.oracle.sh --results - < probe-results.txt
#!/bin/sh
# dorc probe (read-only): checks per-SITE convergence, mutates nothing.
# When run, emits one results-record per site on stdout (the return channel):
#   site <leafid> effect=<holds|absent|cant-tell> rc=<n>
# effect is derived from the probe command's rc (0=holds, 1=absent, else cant-tell);
# rc is the raw PROBE-command status (opaque to Dorc -- the record is the out-of-band lane).

printf 'dorc-records/1 nonce=dorc attempt=1 host=localhost book=a718d5e3a4459197c6ea87db0935913324e707b0c8d6c2239a23e62a18bbcb50 sites=4 @@dorc@@\n'
# site 0.0: sm.dorc.Package:libnginx@installed
apt_get__is_converged() {
   while [ "${1#-}" != "$1" ]; do shift; done
   verb=$1; shift
   while [ "${1#-}" != "$1" ]; do shift; done
   case $verb in
      install) aptcheck -q -- "$1" ;;
      *) return 2 ;;
   esac
}
apt_get__is_converged 'install' '-y' 'libnginx'; _rc=$?; if [ "$_rc" -eq 0 ]; then _e=holds; elif [ "$_rc" -eq 1 ]; then _e=absent; else _e=cant-tell; fi; printf 'dorc site 0.0 effect=%s rc=%s @@dorc@@\n' "$_e" "$_rc"
# site 0.1: sm.dorc.Package:libcurl@installed
apt_get__is_converged 'install' '-y' 'libcurl'; _rc=$?; if [ "$_rc" -eq 0 ]; then _e=holds; elif [ "$_rc" -eq 1 ]; then _e=absent; else _e=cant-tell; fi; printf 'dorc site 0.1 effect=%s rc=%s @@dorc@@\n' "$_e" "$_rc"
# site 1.0: sm.dorc.Package:nginx@installed
apt_get__is_converged 'install' '-y' 'nginx'; _rc=$?; if [ "$_rc" -eq 0 ]; then _e=holds; elif [ "$_rc" -eq 1 ]; then _e=absent; else _e=cant-tell; fi; printf 'dorc site 1.0 effect=%s rc=%s @@dorc@@\n' "$_e" "$_rc"
# site 1.1: sm.dorc.Package:curl@installed
apt_get__is_converged 'install' '-y' 'curl'; _rc=$?; if [ "$_rc" -eq 0 ]; then _e=holds; elif [ "$_rc" -eq 1 ]; then _e=absent; else _e=cant-tell; fi; printf 'dorc site 1.1 effect=%s rc=%s @@dorc@@\n' "$_e" "$_rc"
printf 'dorc-records-end/1 nonce=dorc @@dorc@@\n'
classify: note[cmdsub-operand-top]: operand 3 is an unresolvable positional
parameter (`$@`/`$*`/`$N`), so Dorc cannot know its value until the command runs
on the host -- there is nothing to resolve and no read-only probe to check. Dorc
elides a command only when it can prove the command's effect is already in
place, so this one is left to run on every apply.
      [ book.sh:22:23
   22 |    apt-get install -y "$1"
      |                       \__/

   = repair:  Give the operand a value Dorc can resolve statically -- a literal,
              or a variable assigned from one -- so Dorc can probe it and elide
              the command once it has converged. If the value must stay dynamic,
              load an oracle that vouches for this command's convergence, and
              Dorc will guard the command instead of running it every time.
why: ran because operand 3 is a command-substitution `$(...)` or runtime-dynamic value -- its value couldn't be resolved (first seen at 22:4 `apt-get install -y "$1"`); so dorc runs it, to stay safe (when unsure, run). to skip it, make the operand a literal Dorc can resolve+probe [resolve-dynamism]
dorc: run `dorc why` for the per-site cause-chains, or `dorc why book.sh:N` to query a source line
#!/bin/sh
# dorc apply: the book, with already-converged/dead lines elided (value-preserving stand-in).

# dorc guard preamble: the vouching oracle's own verdict body, shipped strip-only
# (dialect annotations removed, nothing else changed -- rul-ternary-verdict: the
# authored bytes verbatim, no engine-synthesized sh).
apt_get__is_converged() {
   while [ "${1#-}" != "$1" ]; do shift; done
   verb=$1; shift
   while [ "${1#-}" != "$1" ]; do shift; done
   case $verb in
      install) aptcheck -q -- "$1" ;;
      *) return 2 ;;
   esac
}

# dorc: end of lifted material; the book follows, in its authored order.

#!/bin/sh
# A cell-disjoint sibling of `loop30-direct-and-called-mutators-share-a-loop-body`: byte-identical
# CFG, oracles, mocks, and convergence facts, and DESCRIPTIVE of what the engine emits today
# (`FORFEITS:forfeit-cell-blind-self-reach-walls-loop-siblings`).
#
# CFG shape: a top-level `for` over two literal words; its body holds one direct command leaf AND
# one call whose spliced body holds one command leaf (the region). All four cells converged; the two
# families are cell-disjoint (`lib*` versus bare).
#
# WHAT RUNS TODAY: the region's own per-member establishes reach the direct mutator back over the
# loop's edge, and self-reach (`Reach::is_pristine`) is CELL-BLIND — it cannot see that `lib$pkg` and
# `$pkg` never alias — so disjointness buys nothing and the direct mutator's running walls the shared
# `install_pkg` region down to GUARD (`30Qa:fnd-self-reach-is-cell-blind-across-the-back-edge`). A
# runtime check therefore ships at apply-time, and BOTH the direct mutator and the guarded region
# run — all four commands are in the run-set (`expected.ran`, this case).
#
# THE WIDENING: a cell-AWARE self-reach (`30Qa:tc-self-reach-cell-blind-widening`, flagged not built)
# would see the direct mutator's establish and the region's read/establish as provably-disjoint
# cells, so the region's self-reach would stay pristine and the shared definition would take full
# elision (Replace) rather than Guard — leaving the direct mutator the only line in the run-set.
install_pkg() {
   ( apt_get__is_converged install -y "$1" ) || apt-get install -y "$1"   # dorc: guard [sm.dorc.Package converged-vouch; probe: holds]
}

for pkg in nginx curl; do
   apt-get install -y "lib$pkg"
   install_pkg "$pkg"
done
