-- book.sh --
#!/bin/sh
# wrapper-dual-peel-incoherent-fails-fast (273 §5): the loaded wrapper oracle's __predict and
# __lend_map peel to DIFFERENT tail positions (predict shifts the verb, lend_map does not) — static
# incoherence ⇒ dorc fast-fails (exit 11, EXIT_WRAPPER_INCOHERENT). The artifact still ships; the
# book's own `hork setup` site is unrelated and walls (unmodeled). Pins the fail-fast is loud + the
# artifact is emitted (declarations-genuinely-contradict, pre-network).
hork setup

-- w.oracle.sh --
# dorc-lang/v0.2
# An INCOHERENT wrapper (273 §5): predict consumes the verb before "$@" (tail depth 1); lend_map
# reaches "$@" immediately (tail depth 0). Their guests would start at different tokens ⇒ fail-fast.
w__predict() { verb=$1; shift; env "$@"; }
w__lend_map() { : lends user; : lends fs-view; : lends netns; "$@"; }

-- probe-results.txt --
# hork walls (unmodeled); no probe site. The fail-fast is oracle-level, book-independent.

-- mocks/.log --
# newline-safe argv logger for the inert mock shims (slice-4). Sourced by each shim via
# `. "${0%/*}/.log"` (the shim's own dir); a DOTFILE so gate-5/gate-6's `ls`-derived shimset
# never lists it. Replaces the old inline `printf 'ran: %s %s\n' "${0##*/}" "$*"` — an arg with
# an embedded NEWLINE would split the `ran:` line and silently break every line-based compare
# (exec_check, gate-5, gate-6). Shims run under PATH=mocks-only ⇒ BUILTINS ONLY (no sed/awk).
#
# GRAMMAR (what expected.ran goldens carry): one `ran: <name> <arg>…` line per invocation; each
# arg is encoded — a literal backslash as `\\`, an embedded newline as the two chars `\n`. The
# two passes run in THIS order (backslash first) so a newline's encoded `\n` backslash is not
# re-doubled. A newline-free, backslash-free argv encodes to itself ⇒ byte-identical to the old
# format (per-arg space-join == the old `"$*"` join) ⇒ zero golden churn.
_dorc_logged() {
  _dl_out="ran: ${0##*/}"
  for _dl_a in "$@"; do
    _dl_o=""                                          # pass 1: \ -> \\
    while case $_dl_a in *\\*) true ;; *) false ;; esac; do
      _dl_o="$_dl_o${_dl_a%%\\*}\\\\"; _dl_a=${_dl_a#*\\}
    done
    _dl_a="$_dl_o$_dl_a"
    _dl_o=""                                          # pass 2: newline -> \n
    while case $_dl_a in *"$_DL_NL"*) true ;; *) false ;; esac; do
      _dl_o="$_dl_o${_dl_a%%"$_DL_NL"*}\\n"; _dl_a=${_dl_a#*"$_DL_NL"}
    done
    _dl_out="$_dl_out $_dl_o$_dl_a"
  done
  printf '%s\n' "$_dl_out" >>"$DORC_LOG"
}
_DL_NL='
'

-- mocks/hork --
#!/bin/sh
# INERT strawman mock (never a real mutator): logs its argv for the run-set, mutates nothing.
. "${0%/*}/.log"; _dorc_logged "$@"
exit 0

-- expected.ran --
ran: hork setup

-- replay --
$ dorc --book=book.sh --pre-source w.oracle.sh --results - < probe-results.txt
wrapper: error[wrapper-peel-incoherent]: Wrapper `w`'s `__predict` and
`__lend_map` disagree on where the guest begins: `__predict` reaches `"$@"`
after 1 argv token(s), `__lend_map` after 0, so the guest would start at a
different token depending on which member dispatched, and Dorc stops before
contacting any host. Fix whichever argparse is wrong so both members peel to the
same tail.
      [ :1:1
   1 | 
