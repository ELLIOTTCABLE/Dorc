-- book.sh --
#!/bin/sh
# floor30-atlas-errexit-dot-last-command-fails — QUESTION: under caller errexit, a sourced file whose
# LAST command fails. Guarded (`. ./f || …`) the whole `.` is an errexit-exempt operand; bare, it is
# not. What status does the guarded form catch, and does the bare form end the script?
#
# Why the inclusion design needs it: `.` is ONE command, so a `||` covers the whole child, while
# inlined bytes are N commands and the `||` covers only the last of them.
# `floor30-inline-dot-boundary` measures that split for a MID-file failure; this measures it for the
# file's own TRAILING status, which is what a dependency ending in a bare test actually produces.
set -e
. ./tailfail.sh || printf 'book: guarded caught status=[%s]\n' "$?"
printf 'book-after-guarded\n'
. ./tailfail.sh
printf 'book-after-bare\n'

-- tailfail.sh --
printf 'file-ran\n'
false

-- expected.emitted --
file-ran

-- expected.ran --

-- replay --
$ dorc --book=book.sh --results -
#!/bin/sh
# dorc probe (read-only): checks per-SITE convergence, mutates nothing.
# When run, emits one results-record per site on stdout (the return channel):
#   site <leafid> effect=<holds|absent|cant-tell> rc=<n>
# effect is derived from the probe command's rc (0=holds, 1=absent, else cant-tell);
# rc is the raw PROBE-command status (opaque to Dorc -- the record is the out-of-band lane).

printf 'dorc-records/1 nonce=dorc attempt=1 host=localhost book=4b403e0ae9ea488ec9e4e2e69ce82b9ab9ba43e55a0f963cfef846a487e8ea19 sites=0 @@dorc@@\n'
# site:0 unresolvable-no-probe
# site:1 unresolvable-no-probe
# site:2 unresolvable-no-probe
# site:3 unresolvable-no-probe
# site:4 unresolvable-no-probe
# site:5 unresolvable-no-probe
printf 'dorc-records-end/1 nonce=dorc @@dorc@@\n'
#!/bin/sh
# dorc apply: the book, with already-converged/dead lines elided (value-preserving stand-in).

#!/bin/sh
# floor30-atlas-errexit-dot-last-command-fails — QUESTION: under caller errexit, a sourced file whose
# LAST command fails. Guarded (`. ./f || …`) the whole `.` is an errexit-exempt operand; bare, it is
# not. What status does the guarded form catch, and does the bare form end the script?
#
# Why the inclusion design needs it: `.` is ONE command, so a `||` covers the whole child, while
# inlined bytes are N commands and the `||` covers only the last of them.
# `floor30-inline-dot-boundary` measures that split for a MID-file failure; this measures it for the
# file's own TRAILING status, which is what a dependency ending in a bare test actually produces.
set -e
. ./tailfail.sh || printf 'book: guarded caught status=[%s]\n' "$?"
printf 'book-after-guarded\n'
. ./tailfail.sh
printf 'book-after-bare\n'
