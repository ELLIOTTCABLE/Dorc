-- book.sh --
#!/bin/sh
# THE DIVERGENT-MEMBERS VALVE (`30L` sections 4.5 and 7) — the member cousin of
# `region30-drifted-route-guards-the-shared-region`, where the two disagreeing routes were two
# CALLS. Here they are two ITERATIONS of one call, which is the whole reason the iteration axis
# exists: nothing in the CFG tells them apart.
#
# CFG shape: a top-level `for` over two literal words; its body holds one call; the spliced body
# holds one command leaf. One region, one lowered `cfg_node`, two member routes overlaid on it.
#
# nginx is installed; curl is not. No universal Replace exists, so Guard absorbs it — and the
# guard's argv is the SOURCE-level `install -y "$1"`, never either member's resolved operand
# (`30L:rul-no-specialized-shell`). That is load-bearing here in a way it is not for twin calls:
# `$1` re-binds on every iteration of the loop, so a member-0 literal baked into shared source
# would check nginx while curl installed.
install_pkg() {
   apt-get install -y "$1"
}

for pkg in nginx curl; do
   install_pkg "$pkg"
done

-- pkgindex-predict.oracle.sh --
#!/usr/bin/env dorc-sh
# dorc-lang/v0.2
apt_get__predict() {
   while [ "${1#-}" != "$1" ]; do shift; done
   verb=$1; shift
   while [ "${1#-}" != "$1" ]; do shift; done
   pkg : sm.dorc.Package = "$1"
   if [ "${2-}" = "" ]; then
      case $verb in
         install) dpkg-query -W "$pkg" >/dev/null 2>&1 : sm.dorc.Package:"$pkg"@installed ;;
      esac
   fi
}

-- pkgindex-verdict.oracle.sh --
#!/usr/bin/env dorc-sh
# dorc-lang/v0.2
apt_get__is_converged() {
   while [ "${1#-}" != "$1" ]; do shift; done
   verb=$1; shift
   while [ "${1#-}" != "$1" ]; do shift; done
   case $verb in
      install) aptcheck -q -- "$1" ;;
      *) return 2 ;;
   esac
}

-- probe-results.txt --
# Member 0 (nginx) is installed; member 1 (curl) is not. The members disagree, so the universal
# Replace fails and the parametric guard absorbs it — the runtime dispatch happens per iteration,
# inside sh, in the author's own bytes (`30L` section 4.5).
site 0.0 effect=holds rc=0
site 0.1 effect=absent rc=1

-- mocks/.log --
_dorc_logged() {
   _dl_out="ran: ${0##*/}"
   for _dl_arg in "$@"; do _dl_out="$_dl_out $_dl_arg"; done
   printf '%s\n' "$_dl_out" >>"$DORC_LOG"
}

-- mocks/apt-get --
#!/bin/sh
. "${0%/*}/.log"; _dorc_logged "$@"
exit 0

-- mocks/aptcheck --
#!/bin/sh
. "${0%/*}/.log"; _dorc_logged "$@"
case ${3-} in curl) exit 1 ;; esac
exit 0

-- mocks/dpkg-query --
#!/bin/sh
. "${0%/*}/.log"; _dorc_logged "$@"
exit 0

-- expected.ran --
ran: aptcheck -q -- nginx
ran: aptcheck -q -- curl
ran: apt-get install -y curl

-- replay --
$ dorc --book=book.sh --pre-source pkgindex-predict.oracle.sh --pre-source pkgindex-verdict.oracle.sh --results - < probe-results.txt
#!/bin/sh
# dorc probe (read-only): checks per-SITE convergence, mutates nothing.
# When run, emits one results-record per site on stdout (the return channel):
#   site <leafid> effect=<holds|absent|cant-tell> rc=<n>
# effect is derived from the probe command's rc (0=holds, 1=absent, else cant-tell);
# rc is the raw PROBE-command status (opaque to Dorc -- the record is the out-of-band lane).

printf 'dorc-records/1 nonce=dorc attempt=1 host=localhost book=992bf16ea50ebc4fff227883a833c382f501301378d400af915ecf1d2d3404c1 sites=2 @@dorc@@\n'
# site 0.0: sm.dorc.Package:nginx@installed
apt_get__is_converged() {
   while [ "${1#-}" != "$1" ]; do shift; done
   verb=$1; shift
   while [ "${1#-}" != "$1" ]; do shift; done
   case $verb in
      install) aptcheck -q -- "$1" ;;
      *) return 2 ;;
   esac
}
apt_get__is_converged 'install' '-y' 'nginx'; _rc=$?; if [ "$_rc" -eq 0 ]; then _e=holds; elif [ "$_rc" -eq 1 ]; then _e=absent; else _e=cant-tell; fi; printf 'dorc site 0.0 effect=%s rc=%s @@dorc@@\n' "$_e" "$_rc"
# site 0.1: sm.dorc.Package:curl@installed
apt_get__is_converged 'install' '-y' 'curl'; _rc=$?; if [ "$_rc" -eq 0 ]; then _e=holds; elif [ "$_rc" -eq 1 ]; then _e=absent; else _e=cant-tell; fi; printf 'dorc site 0.1 effect=%s rc=%s @@dorc@@\n' "$_e" "$_rc"
printf 'dorc-records-end/1 nonce=dorc @@dorc@@\n'
classify: note[cmdsub-operand-top]: operand 3 is an unresolvable positional
parameter (`$@`/`$*`/`$N`), so Dorc cannot know its value until the command runs
on the host -- there is nothing to resolve and no read-only probe to check. Dorc
elides a command only when it can prove the command's effect is already in
place, so this one is left to run on every apply.
      [ book.sh:16:23
   16 |    apt-get install -y "$1"
      |                       \__/

   = repair:  Give the operand a value Dorc can resolve statically -- a literal,
              or a variable assigned from one -- so Dorc can probe it and elide
              the command once it has converged. If the value must stay dynamic,
              load an oracle that vouches for this command's convergence, and
              Dorc will guard the command instead of running it every time.
why: ran because operand 3 is a command-substitution `$(...)` or runtime-dynamic value -- its value couldn't be resolved (first seen at 16:4 `apt-get install -y "$1"`); so dorc runs it, to stay safe (when unsure, run). to skip it, make the operand a literal Dorc can resolve+probe [resolve-dynamism]
dorc: run `dorc why` for the per-site cause-chains, or `dorc why book.sh:N` to query a source line
#!/bin/sh
# dorc apply: the book, with already-converged/dead lines elided (value-preserving stand-in).

# dorc guard preamble: the vouching oracle's own verdict body, shipped strip-only
# (dialect annotations removed, nothing else changed -- rul-ternary-verdict: the
# authored bytes verbatim, no engine-synthesized sh).
apt_get__is_converged() {
   while [ "${1#-}" != "$1" ]; do shift; done
   verb=$1; shift
   while [ "${1#-}" != "$1" ]; do shift; done
   case $verb in
      install) aptcheck -q -- "$1" ;;
      *) return 2 ;;
   esac
}

# dorc: end of lifted material; the book follows, in its authored order.

#!/bin/sh
# THE DIVERGENT-MEMBERS VALVE (`30L` sections 4.5 and 7) — the member cousin of
# `region30-drifted-route-guards-the-shared-region`, where the two disagreeing routes were two
# CALLS. Here they are two ITERATIONS of one call, which is the whole reason the iteration axis
# exists: nothing in the CFG tells them apart.
#
# CFG shape: a top-level `for` over two literal words; its body holds one call; the spliced body
# holds one command leaf. One region, one lowered `cfg_node`, two member routes overlaid on it.
#
# nginx is installed; curl is not. No universal Replace exists, so Guard absorbs it — and the
# guard's argv is the SOURCE-level `install -y "$1"`, never either member's resolved operand
# (`30L:rul-no-specialized-shell`). That is load-bearing here in a way it is not for twin calls:
# `$1` re-binds on every iteration of the loop, so a member-0 literal baked into shared source
# would check nginx while curl installed.
install_pkg() {
   ( apt_get__is_converged install -y "$1" ) || apt-get install -y "$1"   # dorc: guard [sm.dorc.Package converged-vouch; probe: cant-tell]
}

for pkg in nginx curl; do
   install_pkg "$pkg"
done
