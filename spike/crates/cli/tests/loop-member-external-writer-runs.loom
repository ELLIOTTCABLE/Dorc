-- package.oracle.sh --
#!/usr/bin/env dorc-sh
# dorc-lang/v0.2
# minimal package oracle (apt/dpkg), lifted statically by dorc.
apt_get__predict() {
   while [ "${1#-}" != "$1" ]; do shift; done
   verb=$1; shift
   while [ "${1#-}" != "$1" ]; do shift; done
   pkg : sm.dorc.Package = "$1"
   if [ "${2-}" = "" ]; then
      case $verb in
         install) dpkg-query -W "$pkg" >/dev/null 2>&1 : sm.dorc.Package:"$pkg"@installed ;;
         purge) dpkg-query -W "$pkg" >/dev/null 2>&1 :! sm.dorc.Package:"$pkg"@installed ;;
      esac
   fi
}

-- probe-results.txt --
# probe-results: site-keyed records (task-D1 WIRE; task-L2 item-4 member sub-keys). Grammar:
#   site <leafid>[.<member-idx>] effect=<holds|absent|cant-tell>
# The loop body install is leaf 1 (the pre-loop purge is leaf 0, unresolvable-no-probe — a Kill).
# BOTH members report `holds` (the bait): site 1.0 = nginx, site 1.1 = curl, both converged.
# Yet the apply RUNS them — the pre-loop purge of curl breaks self-reach, so convergence
# alone does not license. (Establish-class ⇒ rc firewalled, omitted; exit-0 dpkg-query shim
# reproduces these for gate-1 parity.)
site 1.0 effect=holds
site 1.1 effect=holds

-- mocks/.log --
# newline-safe argv logger for the inert mock shims (slice-4). Sourced by each shim via
# `. "${0%/*}/.log"` (the shim's own dir); a DOTFILE so gate-5/gate-6's `ls`-derived shimset
# never lists it. Replaces the old inline `printf 'ran: %s %s\n' "${0##*/}" "$*"` — an arg with
# an embedded NEWLINE would split the `ran:` line and silently break every line-based compare
# (exec_check, gate-5, gate-6). Shims run under PATH=mocks-only ⇒ BUILTINS ONLY (no sed/awk).
#
# GRAMMAR (what expected.ran goldens carry): one `ran: <name> <arg>…` line per invocation; each
# arg is encoded — a literal backslash as `\\`, an embedded newline as the two chars `\n`. The
# two passes run in THIS order (backslash first) so a newline's encoded `\n` backslash is not
# re-doubled. A newline-free, backslash-free argv encodes to itself ⇒ byte-identical to the old
# format (per-arg space-join == the old `"$*"` join) ⇒ zero golden churn.
_dorc_logged() {
  _dl_out="ran: ${0##*/}"
  for _dl_a in "$@"; do
    _dl_o=""                                          # pass 1: \ -> \\
    while case $_dl_a in *\\*) true ;; *) false ;; esac; do
      _dl_o="$_dl_o${_dl_a%%\\*}\\\\"; _dl_a=${_dl_a#*\\}
    done
    _dl_a="$_dl_o$_dl_a"
    _dl_o=""                                          # pass 2: newline -> \n
    while case $_dl_a in *"$_DL_NL"*) true ;; *) false ;; esac; do
      _dl_o="$_dl_o${_dl_a%%"$_DL_NL"*}\\n"; _dl_a=${_dl_a#*"$_DL_NL"}
    done
    _dl_out="$_dl_out $_dl_o$_dl_a"
  done
  printf '%s\n' "$_dl_out" >>"$DORC_LOG"
}
_DL_NL='
'

-- mocks/apt-get --
#!/bin/sh
# INERT mock (ap-2 exec harness): logs that it ran, mutates NOTHING, exits 0. Under
# PATH=mocks-only this shim is the only thing that runs (the pre-loop purge AND the loop
# installs all hit it), so executing a rendered apply is provably safe.
. "${0%/*}/.log"; _dorc_logged "$@"
exit 0

-- mocks/dpkg-query --
#!/bin/sh
# INERT probe shim (gate-1 parity): the probe runs `dpkg-query -W <pkg>` once per member.
# This shim exits 0 for EVERY package ⇒ BOTH members report `holds` (converged) — the BAIT.
# Convergence alone must NOT license the elision here: the pre-loop purge of curl breaks
# self-reach, so the apply runs despite these converged records. Mutates nothing; logs for
# symmetry.
. "${0%/*}/.log"; _dorc_logged "$@"
exit 0

-- expected.ran --
ran: apt-get purge -y curl
ran: apt-get install -y nginx
ran: apt-get install -y curl

-- replay --
$ dorc --book=book.sh --pre-source package.oracle.sh --results - < probe-results.txt
#!/bin/sh
# dorc probe (read-only): checks per-SITE convergence, mutates nothing.
# When run, emits one results-record per site on stdout (the return channel):
#   site <leafid> effect=<holds|absent|cant-tell> rc=<n>
# effect is derived from the probe command's rc (0=holds, 1=absent, else cant-tell);
# rc is the raw PROBE-command status (opaque to Dorc -- the record is the out-of-band lane).

printf 'dorc-records/1 nonce=dorc attempt=1 host=localhost book=7c84dc7d279688718fa4f5bc3df0543528da38ae0cb6706c54ffdef6e7917667 sites=2 @@dorc@@\n'
# site 1.0: sm.dorc.Package:nginx@installed
apt_get__predict() {
   while [ "${1#-}" != "$1" ]; do shift; done
   verb=$1; shift
   while [ "${1#-}" != "$1" ]; do shift; done
   pkg="$1"
   if [ "${2-}" = "" ]; then
      case $verb in
         install) dpkg-query -W "$pkg" >/dev/null 2>&1 ;;
         purge) dpkg-query -W "$pkg" >/dev/null 2>&1 ;;
      esac
   fi
}
apt_get__predict 'install' '-y' 'nginx'; _rc=$?; if [ "$_rc" -eq 0 ]; then _e=holds; elif [ "$_rc" -eq 1 ]; then _e=absent; else _e=cant-tell; fi; printf 'dorc site 1.0 effect=%s rc=%s @@dorc@@\n' "$_e" "$_rc"
# site 1.1: sm.dorc.Package:curl@installed
apt_get__predict 'install' '-y' 'curl'; _rc=$?; if [ "$_rc" -eq 0 ]; then _e=holds; elif [ "$_rc" -eq 1 ]; then _e=absent; else _e=cant-tell; fi; printf 'dorc site 1.1 effect=%s rc=%s @@dorc@@\n' "$_e" "$_rc"
# site:0 unresolvable-no-probe
printf 'dorc-records-end/1 nonce=dorc @@dorc@@\n'
probe: note[site-unresolvable]: sm 1 site run unprobed (no read-only check could
be shipped): `apt-get purge -y curl` -- run `dorc why` for the per-site detail
(the apply runs each anyway, to stay safe)
