-- book.sh --
# exec-shimmed-query-fold (task-P/item-3, 20I find-2): the `dpkg -s X || apt-get install X`
set -e
dpkg -s nginx >/dev/null 2>&1 || apt-get install -y nginx

-- package.oracle.sh --
#!/usr/bin/env dorc-sh
# dorc-lang/v0.2
# minimal package oracle (apt/dpkg), lifted statically by dorc.
apt_get__predict() {
   while [ "${1#-}" != "$1" ]; do shift; done
   verb=$1; shift
   while [ "${1#-}" != "$1" ]; do shift; done
   pkg : sm.dorc.Package = "$1"
   if [ "${2-}" = "" ]; then
      case $verb in
         install) dpkg-query -W "$pkg" >/dev/null 2>&1 : sm.dorc.Package:"$pkg"@installed ;;
         purge) dpkg-query -W "$pkg" >/dev/null 2>&1 :! sm.dorc.Package:"$pkg"@installed ;;
      esac
   fi
}

-- pkgstate.oracle.sh --
#!/usr/bin/env dorc-sh
# dorc-lang/v0.2
# package-status QUERY oracle (the DESIGN `dpkg -s nginx || apt-get install` idiom).
dpkg__predict() {
   case $1 in -s) shift ;; esac
   pkg : sm.dorc.PkgState = "$1"
   dpkg -s -- "$pkg" >/dev/null 2>&1 :? sm.dorc.PkgState:"$pkg"@installed
}

-- probe-results.txt --
# probe-results: site-keyed records (task-P/item-3). site 1 = the pkgstate Query guard
# `dpkg -s nginx` — a VALID Query (only `set -e` upstream, target-state-pure), so its OWN
# rc=0 IS fold-usable (the fold reads it ⇒ the `|| install` branch is dead). site 2 = the
# package install establish — its rc is the probe-command's (firewalled, never fold-usable),
# so the fixture omits it (effect-only parity, item-4). HOST: nginx installed (both holds).
# (`set -e` is site 0 — Pure/MustRun, unresolvable, no record.)
site 1 effect=holds rc=0
site 2 effect=holds

-- mocks/.log --
# newline-safe argv logger for the inert mock shims (slice-4). Sourced by each shim via
# `. "${0%/*}/.log"` (the shim's own dir); a DOTFILE so gate-5/gate-6's `ls`-derived shimset
# never lists it. Replaces the old inline `printf 'ran: %s %s\n' "${0##*/}" "$*"` — an arg with
# an embedded NEWLINE would split the `ran:` line and silently break every line-based compare
# (exec_check, gate-5, gate-6). Shims run under PATH=mocks-only ⇒ BUILTINS ONLY (no sed/awk).
#
# GRAMMAR (what expected.ran goldens carry): one `ran: <name> <arg>…` line per invocation; each
# arg is encoded — a literal backslash as `\\`, an embedded newline as the two chars `\n`. The
# two passes run in THIS order (backslash first) so a newline's encoded `\n` backslash is not
# re-doubled. A newline-free, backslash-free argv encodes to itself ⇒ byte-identical to the old
# format (per-arg space-join == the old `"$*"` join) ⇒ zero golden churn.
_dorc_logged() {
  _dl_out="ran: ${0##*/}"
  for _dl_a in "$@"; do
    _dl_o=""                                          # pass 1: \ -> \\
    while case $_dl_a in *\\*) true ;; *) false ;; esac; do
      _dl_o="$_dl_o${_dl_a%%\\*}\\\\"; _dl_a=${_dl_a#*\\}
    done
    _dl_a="$_dl_o$_dl_a"
    _dl_o=""                                          # pass 2: newline -> \n
    while case $_dl_a in *"$_DL_NL"*) true ;; *) false ;; esac; do
      _dl_o="$_dl_o${_dl_a%%"$_DL_NL"*}\\n"; _dl_a=${_dl_a#*"$_DL_NL"}
    done
    _dl_out="$_dl_out $_dl_o$_dl_a"
  done
  printf '%s\n' "$_dl_out" >>"$DORC_LOG"
}
_DL_NL='
'

-- mocks/apt-get --
#!/bin/sh
# INERT shim for `apt-get` — the apply mutator (`apt-get install -y nginx`). On this host
# the fold OMITS it (the guard holds ⇒ the `||` branch is dead), so it must NOT appear in
# the apply run-set; it logs only if it (wrongly) runs. (The BARE book — gate-5 ground truth
# — short-circuits past it too, since `dpkg -s nginx` exits 0.)
. "${0%/*}/.log"; _dorc_logged "$@"
exit 0

-- mocks/dpkg --
#!/bin/sh
# INERT shim for `dpkg` — used BOTH as the apply's verbatim Query guard (`dpkg -s nginx`,
# run for real in the BARE book) AND as the pkgstate kind's probe (`dpkg -s <pkg>`; $1=-s,
# $2=the package). The mock host has nginx INSTALLED, so `dpkg -s nginx` exits 0 ⇒ the
# pkgstate guard holds (site 1 ⇒ holds rc=0), the fold reads rc 0, and the `||` install is
# dead. Read-only; logs the argv for the run-set.
. "${0%/*}/.log"; _dorc_logged "$@"
# R3: the probe ships `dpkg -s -- <pkg>` (the stripped check body); the book's own guard
# ships `dpkg -s <pkg>` — skip the `-s` flag + optional `--` separator to read the operand.
pkg=$2; [ "$pkg" = "--" ] && pkg=$3
case $pkg in
  nginx) exit 0 ;;  # nginx installed ⇒ holds (the valid guard, folded + substituted to `true`)
  *)     exit 1 ;;
esac

-- mocks/dpkg-query --
#!/bin/sh
# INERT shim for `dpkg-query` — the package kind's install probe (`dpkg-query -W nginx`).
# The mock host has nginx installed, so it exits 0 ⇒ the install's establish probe reports
# holds (site 2 ⇒ holds rc=0). (The install is OMITTED by the fold regardless of its own
# verdict — the fold reads the GUARD's rc — but the probe still ships this check, so it
# needs a shim for gate-1 parity; the host is consistent: nginx installed both ways.)
. "${0%/*}/.log"; _dorc_logged "$@"
exit 0

