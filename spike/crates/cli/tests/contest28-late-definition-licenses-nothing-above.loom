-- book.sh --
#!/bin/sh
# contest28-late-definition-licenses-nothing-above (`28K` §2 rul-visibility-is-full-positional,
# ACKED spike-tier 2026-07-31) — THE sharpened consequence cell, end to end.
#
# ONE in-book verdict definition, TWO sites of the same command, one on each side of it. A shell
# executing this book top-to-bottom has no `foobar__is_converged` at the FIRST site and has one at
# the SECOND, so Dorc answers nothing at the first — it ships no check (`site:0
# unresolvable-no-probe`), inserts no guard, and runs verbatim — and answers at the second.
#
# The second GUARDS rather than elides, and that is the honest outcome rather than a weaker pin:
# the first site is an unmodeled establish that really runs, so it walls (`opaque-poison-is-the-
# product`) and no downstream elision survives it without the survival flag. The vouch still
# holds, so the guard is minted from the book's own verdict body — the definition live at THAT
# line, which is the whole property under test.
#
# The apply artifact carries NO guard preamble, and that is the SECOND property (`28K` §4): the
# pinned definition is the book's own, already sitting where its author put it, so copying it above
# the book would ship two same-named funcdefs — the shape `oracle/src/reserved.rs` refuses by
# another route. Nothing is re-derived at runtime; exactly one funcdef binds that name here.
foobar sync-certs /etc/nginx/certs
foobar__is_converged() {
   foobar status --certs-current -- "$2"
}
# `role-defined-below-its-sites` fires on the definition above (declared in the frontmatter): one
# site lost its answer, and moving those four lines to the top of the book is the remediation.
foobar sync-certs /etc/nginx/other

-- probe-results.txt --
# Only the BELOW site is probed at all: the above one ships no check, because no definition is
# live at its line. rc 0 ⇒ converged ⇒ its guard is minted.
site 1 effect=holds rc=0

-- mocks/.log --
# newline-safe argv logger for the inert mock shims (slice-4). Sourced by each shim via
# `. "${0%/*}/.log"` (the shim's own dir); a DOTFILE so gate-5/gate-6's `ls`-derived shimset
# never lists it. Shims run under PATH=mocks-only ⇒ BUILTINS ONLY (no sed/awk).
_dorc_logged() {
  _dl_out="ran: ${0##*/}"
  for _dl_a in "$@"; do
    _dl_o=""                                          # pass 1: \ -> \\
    while case $_dl_a in *\\*) true ;; *) false ;; esac; do
      _dl_o="$_dl_o${_dl_a%%\\*}\\\\"; _dl_a=${_dl_a#*\\}
    done
    _dl_a="$_dl_o$_dl_a"
    _dl_o=""                                          # pass 2: newline -> \n
    while case $_dl_a in *"$_DL_NL"*) true ;; *) false ;; esac; do
      _dl_o="$_dl_o${_dl_a%%"$_DL_NL"*}\\n"; _dl_a=${_dl_a#*"$_DL_NL"}
    done
    _dl_out="$_dl_out $_dl_o$_dl_a"
  done
  printf '%s\n' "$_dl_out" >>"$DORC_LOG"
}
_DL_NL='
'

-- mocks/foobar --
#!/bin/sh
# INERT mock. It answers for BOTH roles here: the probe's `foobar status …` (rc 0 ⇒ converged)
# and the un-elided first site's own `foobar sync-certs …`, which really does run. Mutates
# nothing either way — the run-log is the whole observable.
. "${0%/*}/.log"; _dorc_logged "$@"
exit 0

-- expected.ran --
ran: foobar sync-certs /etc/nginx/certs
ran: foobar status --certs-current -- /etc/nginx/other

-- replay --
$ dorc --book=book.sh --results - < probe-results.txt
reserved: warning[reserved-namespace-squat]: Book function
`foobar__is_converged` sits in the `__is_converged` namespace reserved for
oracle functions; Dorc treats it as ordinary shell and runs it verbatim, but a
shipped oracle preamble defining the same name would collide with it. Rename it
to stay clear of `*__is_converged`.
      [ book.sh:21:1
   21 | foobar__is_converged() {
      | \__________________/
loading: note[role-defined-below-its-sites]: `foobar__is_converged` is defined
below 2 of its family's sites, and a definition licenses nothing above itself,
so those sites run as if it were absent -- moving it above them is one
cut-and-paste.
      [ book.sh:21:1
   21 | foobar__is_converged() {
      | \__________________/
#!/bin/sh
# dorc probe (read-only): checks per-SITE convergence, mutates nothing.
# When run, emits one results-record per site on stdout (the return channel):
#   site <leafid> effect=<holds|absent|cant-tell> rc=<n>
# effect is derived from the probe command's rc (0=holds, 1=absent, else cant-tell);
# rc is the raw PROBE-command status (opaque to Dorc -- the record is the out-of-band lane).

printf 'dorc-records/1 nonce=dorc attempt=1 host=localhost book=13ed8845e21db62d9d5aa258b1c07e5cb7f4d38126cf90ed81e753366dc52225 sites=1 @@dorc@@\n'
# site 1: dorc-auto:foobar@converged
foobar__is_converged() {
   foobar status --certs-current -- "$2"
}
foobar__is_converged 'sync-certs' '/etc/nginx/other'; _rc=$?; if [ "$_rc" -eq 0 ]; then _e=holds; elif [ "$_rc" -eq 1 ]; then _e=absent; else _e=cant-tell; fi; printf 'dorc site 1 effect=%s rc=%s @@dorc@@\n' "$_e" "$_rc"
# site:0 unresolvable-no-probe
printf 'dorc-records-end/1 nonce=dorc @@dorc@@\n'
classify: note[cmdsub-operand-top]: operand 4 is an unresolvable positional
parameter (`$@`/`$*`/`$N`), so Dorc cannot know its value until the command runs
on the host -- there is nothing to resolve and no read-only probe to check. Dorc
elides a command only when it can prove the command's effect is already in
place, so this one is left to run on every apply.
      [ book.sh:22:37
   22 |    foobar status --certs-current -- "$2"
      |                                     \__/

   = repair:  Give the operand a value Dorc can resolve statically -- a literal,
              or a variable assigned from one -- so Dorc can probe it and elide
              the command once it has converged. If the value must stay dynamic,
              load an oracle that vouches for this command's convergence, and
              Dorc will guard the command instead of running it every time.
probe: note[site-unresolvable]: sm 1 site run unprobed (no read-only check could
be shipped): `foobar sync-certs /etc/nginx/certs` -- run `dorc why` for the
per-site detail (the apply runs each anyway, to stay safe)
      [ book.sh:20:1
   20 | foobar sync-certs /etc/nginx/certs
      | \________________________________/

   = help:  sm site runs `foobar sync-certs /etc/nginx/certs`
why: ran because operand 4 is a command-substitution `$(...)` or runtime-dynamic value -- its value couldn't be resolved (first seen at 22:4 `foobar status --certs-current -- "$2"`); so dorc runs it, to stay safe (when unsure, run). to skip it, make the operand a literal Dorc can resolve+probe [resolve-dynamism]
why: site 1 guard [dorc-auto:foobar] -- licensed by the dorc-auto:foobar oracle's vouch (at book.sh:22) that it is already satisfied; the original bytes survive and the check re-runs live at apply (to stay safe)
hint: 'foobar' (line 20) is unmodeled: it is the first wall -- an oracle vouching its convergence would elide it when converged, and un-wall 1 downstream site
dorc: run `dorc why` for the per-site cause-chains, or `dorc why book.sh:N` to query a source line
#!/bin/sh
# dorc apply: the book, with already-converged/dead lines elided (value-preserving stand-in).

#!/bin/sh
# contest28-late-definition-licenses-nothing-above (`28K` §2 rul-visibility-is-full-positional,
# ACKED spike-tier 2026-07-31) — THE sharpened consequence cell, end to end.
#
# ONE in-book verdict definition, TWO sites of the same command, one on each side of it. A shell
# executing this book top-to-bottom has no `foobar__is_converged` at the FIRST site and has one at
# the SECOND, so Dorc answers nothing at the first — it ships no check (`site:0
# unresolvable-no-probe`), inserts no guard, and runs verbatim — and answers at the second.
#
# The second GUARDS rather than elides, and that is the honest outcome rather than a weaker pin:
# the first site is an unmodeled establish that really runs, so it walls (`opaque-poison-is-the-
# product`) and no downstream elision survives it without the survival flag. The vouch still
# holds, so the guard is minted from the book's own verdict body — the definition live at THAT
# line, which is the whole property under test.
#
# The apply artifact carries NO guard preamble, and that is the SECOND property (`28K` §4): the
# pinned definition is the book's own, already sitting where its author put it, so copying it above
# the book would ship two same-named funcdefs — the shape `oracle/src/reserved.rs` refuses by
# another route. Nothing is re-derived at runtime; exactly one funcdef binds that name here.
foobar sync-certs /etc/nginx/certs
foobar__is_converged() {
   foobar status --certs-current -- "$2"
}
# `role-defined-below-its-sites` fires on the definition above (declared in the frontmatter): one
# site lost its answer, and moving those four lines to the top of the book is the remediation.
( foobar__is_converged sync-certs /etc/nginx/other ) || foobar sync-certs /etc/nginx/other   # dorc: guard [dorc-auto:foobar converged-vouch; probe: holds]
dorc: plan-summary sites=2 elide=0 omit=0 guard=1 run=1 may-alias=0
dorc: decision-digest 8dd3f79559f1679a89e79f3d3483058cab6ea18bc9c24dadeca106082a0c7998
