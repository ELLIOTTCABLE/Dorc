---
run: round-trip
fixpoint: executed
expect-why:
  - declines [unsound] && sysctl.oracle.sh:8
---
-- book.sh --
#!/bin/sh
# report27-decline-static-classed (`27W` tier-2): the book statically calls a sysctl write-only
# trigger key. The oracle's is_converged declines it with a `decline unsound …` emission on the
# reached arm; the static argv threads to that arm, so the class + emitting-arm file:line surface
# at PLAN time (the tier-2 `authored_reason`). No vouch ⇒ the site RUNS.
sysctl vm.drop_caches

-- sysctl.oracle.sh --
# sysctl oracle (`27W:rul-strawman-tool-set`): a MARKERLESS verdict function. Its declining arms
# emit a `decline <class> …` line to the versioned report sink (total off-Dorc via the
# `:-/dev/null` default). vm.drop_caches is a write-only trigger key — unprobeable by construction.
sysctl__is_converged() {
   key=$1
   case $key in
   vm.drop_caches|vm.compact_memory)
      printf 'decline unsound %s is a write-only trigger key\n' "$key" >>"${DREP_V1:-/dev/null}"
      return 2 ;;
   *) sysctl -n -- "$key" >/dev/null 2>&1 ;;
   esac
}

-- probe-results.txt --
dorc-records/1 nonce=dorc attempt=1 host=localhost book=9f7c569c72f3cbe4 sites=0 @@dorc@@
dorc-records-end/1 nonce=dorc @@dorc@@

-- mocks/.log --
# newline-safe argv logger for the inert mock shims (slice-4). Sourced by each shim via
# `. "${0%/*}/.log"` (the shim's own dir); a DOTFILE so gate-5/gate-6's `ls`-derived shimset
# never lists it. Replaces the old inline `printf 'ran: %s %s\n' "${0##*/}" "$*"` — an arg with
# an embedded NEWLINE would split the `ran:` line and silently break every line-based compare
# (exec_check, gate-5, gate-6). Shims run under PATH=mocks-only ⇒ BUILTINS ONLY (no sed/awk).
#
# GRAMMAR (what expected.ran goldens carry): one `ran: <name> <arg>…` line per invocation; each
# arg is encoded — a literal backslash as `\\`, an embedded newline as the two chars `\n`. The
# two passes run in THIS order (backslash first) so a newline's encoded `\n` backslash is not
# re-doubled. A newline-free, backslash-free argv encodes to itself ⇒ byte-identical to the old
# format (per-arg space-join == the old `"$*"` join) ⇒ zero golden churn.
_dorc_logged() {
  _dl_out="ran: ${0##*/}"
  for _dl_a in "$@"; do
    _dl_o=""                                          # pass 1: \ -> \\
    while case $_dl_a in *\\*) true ;; *) false ;; esac; do
      _dl_o="$_dl_o${_dl_a%%\\*}\\\\"; _dl_a=${_dl_a#*\\}
    done
    _dl_a="$_dl_o$_dl_a"
    _dl_o=""                                          # pass 2: newline -> \n
    while case $_dl_a in *"$_DL_NL"*) true ;; *) false ;; esac; do
      _dl_o="$_dl_o${_dl_a%%"$_DL_NL"*}\\n"; _dl_a=${_dl_a#*"$_DL_NL"}
    done
    _dl_out="$_dl_out $_dl_o$_dl_a"
  done
  printf '%s\n' "$_dl_out" >>"$DORC_LOG"
}
_DL_NL='
'

-- mocks/sysctl --
#!/bin/sh
# INERT mock: the book runs `sysctl vm.drop_caches` (the decline means no elision — it RUNS).
# In the probe, the reached arm only `printf`s to the report sink + `return 2` (no external
# command), so this mock is invoked ONLY by the apply. Mutates nothing.
. "${0%/*}/.log"; _dorc_logged "$@"
exit 0

-- expected.ran --
ran: sysctl vm.drop_caches

-- replay --
$ dorc --book=book.sh --pre-source sysctl.oracle.sh < probe-results.txt
#!/bin/sh
# dorc probe (read-only): checks per-SITE convergence, mutates nothing.
# When run, emits one results-record per site on stdout (the return channel):
#   site <leafid> effect=<holds|absent|cant-tell> rc=<n>
# effect is derived from the probe command's rc (0=holds, 1=absent, else cant-tell);
# rc is the raw PROBE-command status (opaque to Dorc -- the record is the out-of-band lane).

printf 'dorc-records/1 nonce=dorc attempt=1 host=localhost book=ca23687f49760296e278132ecad73b98742b5b248b042f3ef7195946fce34f5c sites=0 @@dorc@@\n'
# site:0 unresolvable-no-probe
printf 'dorc-records-end/1 nonce=dorc @@dorc@@\n'
#!/bin/sh
# dorc apply: the book, with already-converged/dead lines elided (value-preserving stand-in).

#!/bin/sh
# report27-decline-static-classed (`27W` tier-2): the book statically calls a sysctl write-only
# trigger key. The oracle's is_converged declines it with a `decline unsound …` emission on the
# reached arm; the static argv threads to that arm, so the class + emitting-arm file:line surface
# at PLAN time (the tier-2 `authored_reason`). No vouch ⇒ the site RUNS.
sysctl vm.drop_caches
