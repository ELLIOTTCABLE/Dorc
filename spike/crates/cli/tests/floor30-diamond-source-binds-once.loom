-- book.sh --
#!/bin/sh
# floor30-diamond-source-binds-once — ground truth for the diamond rule (`28Q` §2; the closed pin
# `pin-closure-membership-and-diamond`, human-typed 2026-08-17: diamond loading is effectively
# allowed, keyed to resolution-identity, and differing bytes refuse).
#
# The engine may only dedup a twice-sourced file if a real shell's second `.` of the same bytes
# changes nothing. It does not merely "not error": the file's declarations are re-applied
# identically, and each entry keeps its OWN declaration besides. Both halves are measured here,
# because a dedup that silently dropped an entry's own names would look exactly like a pass.
. ./entry-a.sh
. ./entry-b.sh
_shared_say
_a_say
_b_say

-- entry-a.sh --
. ./shared.sh
_a_say() { printf 'a\n' ;}

-- entry-b.sh --
. ./shared.sh
_b_say() { printf 'b\n' ;}

-- shared.sh --
_shared_say() { printf 'shared\n' ;}

-- expected.emitted --
shared
a
b

-- expected.ran --

-- replay --
$ dorc --book=book.sh --results -
#!/bin/sh
# dorc probe (read-only): checks per-SITE convergence, mutates nothing.
# When run, emits one results-record per site on stdout (the return channel):
#   site <leafid> effect=<holds|absent|cant-tell> rc=<n>
# effect is derived from the probe command's rc (0=holds, 1=absent, else cant-tell);
# rc is the raw PROBE-command status (opaque to Dorc -- the record is the out-of-band lane).

printf 'dorc-records/1 nonce=dorc attempt=1 host=localhost book=82b38ea2f4a4c0a34a5284d969106529d099b341e4feb5717b83eefe990feb57 sites=0 @@dorc@@\n'
# site:0 unresolvable-no-probe
# site:1 unresolvable-no-probe
# site:2 unresolvable-no-probe
# site:3 unresolvable-no-probe
# site:4 unresolvable-no-probe
printf 'dorc-records-end/1 nonce=dorc @@dorc@@\n'
#!/bin/sh
# dorc apply: the book, with already-converged/dead lines elided (value-preserving stand-in).

#!/bin/sh
# floor30-diamond-source-binds-once — ground truth for the diamond rule (`28Q` §2; the closed pin
# `pin-closure-membership-and-diamond`, human-typed 2026-08-17: diamond loading is effectively
# allowed, keyed to resolution-identity, and differing bytes refuse).
#
# The engine may only dedup a twice-sourced file if a real shell's second `.` of the same bytes
# changes nothing. It does not merely "not error": the file's declarations are re-applied
# identically, and each entry keeps its OWN declaration besides. Both halves are measured here,
# because a dedup that silently dropped an entry's own names would look exactly like a pass.
. ./entry-a.sh
. ./entry-b.sh
_shared_say
_a_say
_b_say
