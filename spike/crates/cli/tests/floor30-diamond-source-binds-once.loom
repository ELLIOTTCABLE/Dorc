-- book.sh --
#!/bin/sh
# floor30-diamond-source-binds-once — ground truth for the diamond rule (`28Q` §2; the closed pin
# `pin-closure-membership-and-diamond`, human-typed 2026-08-17: diamond loading is effectively
# allowed, keyed to resolution-identity, and differing bytes refuse).
#
# The engine may only dedup a twice-sourced file if a real shell's second `.` of the same bytes
# changes nothing. It does not merely "not error": the file's declarations are re-applied
# identically, and each entry keeps its OWN declaration besides. Both halves are measured here,
# because a dedup that silently dropped an entry's own names would look exactly like a pass.
. ./entry-a.sh
. ./entry-b.sh
_shared_say
_a_say
_b_say

-- entry-a.sh --
. ./shared.sh
_a_say() { printf 'a\n' ;}

-- entry-b.sh --
. ./shared.sh
_b_say() { printf 'b\n' ;}

-- shared.sh --
_shared_say() { printf 'shared\n' ;}

-- expected.emitted --
shared
a
b

-- expected.ran --

-- replay --
$ dorc --book=book.sh --results -
