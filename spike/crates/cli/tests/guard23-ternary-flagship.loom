-- book.sh --
# guard23-ternary-flagship (rul-ternary-verdict; the {elide, guard, run} verdict map on one
apt-get install -y nginx
hork wombat
apt-get install -y curl
apt-get install -y vim

-- package.oracle.sh --
#!/usr/bin/env dorc-sh
# dorc-lang/v0.2
# guard23 flagship package oracle: predict() resolves the entity; authoring is_converged()
apt_get__predict() {
   while [ "${1#-}" != "$1" ]; do shift; done
   verb=$1; shift
   while [ "${1#-}" != "$1" ]; do shift; done
   pkg : sm.dorc.Package = "$1"
   if [ "${2-}" = "" ]; then
      case $verb in
         install) dpkg-query -W "$pkg" >/dev/null 2>&1 : sm.dorc.Package:"$pkg"@installed ;;
         purge) dpkg-query -W "$pkg" >/dev/null 2>&1 :! sm.dorc.Package:"$pkg"@installed ;;
      esac
   fi
}

apt_get__is_converged() {
   while [ "${1#-}" != "$1" ]; do shift; done
   verb=$1; shift
   while [ "${1#-}" != "$1" ]; do shift; done
   case $verb in
      install) dpkg-query -W "$1" >/dev/null 2>&1 ;;
   esac
}

-- probe-results.txt --
# probe-results: site-keyed records (task-D1 WIRE). Grammar:
#   site <leafid> effect=<holds|absent|cant-tell>
# site 0 = package:nginx#installed, BEFORE the wall: holds ⇒ elide-licensed (as at HEAD).
# sites 2/3 sit PAST the hork wall. At HEAD their probes never ship, so these two records
# are consumed by nothing (half of the xfail); under the guard tier the vouched sites keep
# their read-only probes so the witness has its verdict and the plan its prediction.
# site 2 holds ⇒ guard minted; site 3 absent ⇒ diverged ⇒ plain run, no guard.
site 0 effect=holds
site 2 effect=holds
site 3 effect=absent

-- mocks/.log --
# newline-safe argv logger for the inert mock shims (slice-4). Sourced by each shim via
# `. "${0%/*}/.log"` (the shim's own dir); a DOTFILE so gate-5/gate-6's `ls`-derived shimset
# never lists it. Replaces the old inline `printf 'ran: %s %s\n' "${0##*/}" "$*"` — an arg with
# an embedded NEWLINE would split the `ran:` line and silently break every line-based compare
# (exec_check, gate-5, gate-6). Shims run under PATH=mocks-only ⇒ BUILTINS ONLY (no sed/awk).
#
# GRAMMAR (what expected.ran goldens carry): one `ran: <name> <arg>…` line per invocation; each
# arg is encoded — a literal backslash as `\\`, an embedded newline as the two chars `\n`. The
# two passes run in THIS order (backslash first) so a newline's encoded `\n` backslash is not
# re-doubled. A newline-free, backslash-free argv encodes to itself ⇒ byte-identical to the old
# format (per-arg space-join == the old `"$*"` join) ⇒ zero golden churn.
_dorc_logged() {
  _dl_out="ran: ${0##*/}"
  for _dl_a in "$@"; do
    _dl_o=""                                          # pass 1: \ -> \\
    while case $_dl_a in *\\*) true ;; *) false ;; esac; do
      _dl_o="$_dl_o${_dl_a%%\\*}\\\\"; _dl_a=${_dl_a#*\\}
    done
    _dl_a="$_dl_o$_dl_a"
    _dl_o=""                                          # pass 2: newline -> \n
    while case $_dl_a in *"$_DL_NL"*) true ;; *) false ;; esac; do
      _dl_o="$_dl_o${_dl_a%%"$_DL_NL"*}\\n"; _dl_a=${_dl_a#*"$_DL_NL"}
    done
    _dl_out="$_dl_out $_dl_o$_dl_a"
  done
  printf '%s\n' "$_dl_out" >>"$DORC_LOG"
}
_DL_NL='
'

-- mocks/apt-get --
#!/bin/sh
# INERT mock (ap-2 exec harness): logs that it ran, mutates NOTHING, exits 0. The
# book calls the real name; under the harness's PATH=mocks-only this shim is the only
# thing that runs, so executing a rendered apply is provably safe.
. "${0%/*}/.log"; _dorc_logged "$@"
exit 0

-- mocks/dpkg-query --
#!/bin/sh
# INERT probe shim for `dpkg-query -W <pkg>` (the package kind's probe) — the flagship
# host: nginx and curl installed (rc 0 ⇒ holds), vim ABSENT (rc 1 ⇒ absent). Read-only;
# logs argv. Under the guard tier this same body re-runs at apply as site 2's guard.
. "${0%/*}/.log"; _dorc_logged "$@"
case $* in
  *vim*) exit 1 ;;
esac
exit 0

-- mocks/hork --
#!/bin/sh
# INERT mock (ap-2 exec harness): logs that it ran, mutates NOTHING, exits 0. The
# book calls the real name; under the harness's PATH=mocks-only this shim is the only
# thing that runs, so executing a rendered apply is provably safe.
. "${0%/*}/.log"; _dorc_logged "$@"
exit 0

-- expected.ran --
ran: hork wombat
ran: dpkg-query -W curl
ran: apt-get install -y vim

-- replay --
$ dorc --book=book.sh -o package.oracle.sh < probe-results.txt
#!/bin/sh
# dorc probe (read-only): checks per-SITE convergence, mutates nothing.
# When run, emits one results-record per site on stdout (the return channel):
#   site <leafid> effect=<holds|absent|cant-tell> rc=<n>
# effect is derived from the probe command's rc (0=holds, 1=absent, else cant-tell);
# rc is the raw PROBE-command status (opaque to Dorc — the record is the out-of-band lane).

printf 'dorc-records/1 nonce=dorc attempt=1 host=localhost book=e8f53c2e67bba00a sites=3 @@dorc@@\n'
# site 0: sm.dorc.Package:nginx@installed
apt_get__predict() {
   while [ "${1#-}" != "$1" ]; do shift; done
   verb=$1; shift
   while [ "${1#-}" != "$1" ]; do shift; done
   pkg="$1"
   if [ "${2-}" = "" ]; then
      case $verb in
         install) dpkg-query -W "$pkg" >/dev/null 2>&1 ;;
         purge) dpkg-query -W "$pkg" >/dev/null 2>&1 ;;
      esac
   fi
}
apt_get__predict 'install' '-y' 'nginx'; _rc=$?; if [ "$_rc" -eq 0 ]; then _e=holds; elif [ "$_rc" -eq 1 ]; then _e=absent; else _e=cant-tell; fi; printf 'dorc site 0 effect=%s rc=%s @@dorc@@\n' "$_e" "$_rc"
# site 2: sm.dorc.Package:curl@installed
apt_get__predict 'install' '-y' 'curl'; _rc=$?; if [ "$_rc" -eq 0 ]; then _e=holds; elif [ "$_rc" -eq 1 ]; then _e=absent; else _e=cant-tell; fi; printf 'dorc site 2 effect=%s rc=%s @@dorc@@\n' "$_e" "$_rc"
# site 3: sm.dorc.Package:vim@installed
apt_get__predict 'install' '-y' 'vim'; _rc=$?; if [ "$_rc" -eq 0 ]; then _e=holds; elif [ "$_rc" -eq 1 ]; then _e=absent; else _e=cant-tell; fi; printf 'dorc site 3 effect=%s rc=%s @@dorc@@\n' "$_e" "$_rc"
# site:1 unresolvable-no-probe
printf 'dorc-records-end/1 nonce=dorc @@dorc@@\n'
#!/bin/sh
# dorc apply: the book, with already-converged/dead lines elided (value-preserving stand-in).

# dorc guard preamble: the vouching oracle's own verdict body, shipped strip-only
# (dialect annotations removed, nothing else changed -- rul-ternary-verdict: the
# authored bytes verbatim, no engine-synthesized sh).
apt_get__is_converged() {
   while [ "${1#-}" != "$1" ]; do shift; done
   verb=$1; shift
   while [ "${1#-}" != "$1" ]; do shift; done
   case $verb in
      install) dpkg-query -W "$1" >/dev/null 2>&1 ;;
   esac
}

# guard23-ternary-flagship (rul-ternary-verdict; the {elide, guard, run} verdict map on one
# apt-get install -y nginx   # dorc: elided (already converged / dead branch)
hork wombat
( apt_get__is_converged install -y curl ) || apt-get install -y curl   # dorc: guard [sm.dorc.Package converged-vouch; probe: holds]
apt-get install -y vim
