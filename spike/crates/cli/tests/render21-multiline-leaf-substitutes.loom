-- book.sh --
# render21-multiline-leaf-substitutes (arch-1, note 214 d-6 — the NEWLY-EXPRESSIBLE multi-line
apt-get install -y "multi
line"
systemctl reload nginx

-- package.oracle.sh --
#!/usr/bin/env dorc-sh
# dorc-lang/v0.2
# minimal package oracle (apt/dpkg), lifted statically by dorc.
apt_get__predict() {
   while [ "${1#-}" != "$1" ]; do shift; done
   verb=$1; shift
   while [ "${1#-}" != "$1" ]; do shift; done
   pkg : sm.dorc.Package = "$1"
   if [ "${2-}" = "" ]; then
      case $verb in
         install) dpkg-query -W "$pkg" >/dev/null 2>&1 : sm.dorc.Package:"$pkg"@installed ;;
         purge) dpkg-query -W "$pkg" >/dev/null 2>&1 :! sm.dorc.Package:"$pkg"@installed ;;
      esac
   fi
}

apt_get__is_converged() {
   while [ "${1#-}" != "$1" ]; do shift; done
   verb=$1; shift
   while [ "${1#-}" != "$1" ]; do shift; done
   case $verb in
      install) dpkg-query -W "$1" >/dev/null 2>&1 ;;
      *) return 2 ;;
   esac
}

-- probe-results.txt --
# probe-results: site 0 is the multi-line install (`apt-get install -y "multi\nline"`, an
# EstablishAmbient on the oddly-named package); holds ⇒ converged ⇒ the leaf-exact render
# substitutes its (two-line) span with `true`. The unoracled `systemctl reload` is a Run leaf
# (no record). The dpkg-query probe is invoked with the newline-bearing operand single-quoted.
site 0 effect=holds

-- mocks/.log --
# newline-safe argv logger for the inert mock shims (slice-4). Sourced by each shim via
# `. "${0%/*}/.log"` (the shim's own dir); a DOTFILE so gate-5/gate-6's `ls`-derived shimset
# never lists it. Replaces the old inline `printf 'ran: %s %s\n' "${0##*/}" "$*"` — an arg with
# an embedded NEWLINE would split the `ran:` line and silently break every line-based compare
# (exec_check, gate-5, gate-6). Shims run under PATH=mocks-only ⇒ BUILTINS ONLY (no sed/awk).
#
# GRAMMAR (what expected.ran goldens carry): one `ran: <name> <arg>…` line per invocation; each
# arg is encoded — a literal backslash as `\\`, an embedded newline as the two chars `\n`. The
# two passes run in THIS order (backslash first) so a newline's encoded `\n` backslash is not
# re-doubled. A newline-free, backslash-free argv encodes to itself ⇒ byte-identical to the old
# format (per-arg space-join == the old `"$*"` join) ⇒ zero golden churn.
_dorc_logged() {
  _dl_out="ran: ${0##*/}"
  for _dl_a in "$@"; do
    _dl_o=""                                          # pass 1: \ -> \\
    while case $_dl_a in *\\*) true ;; *) false ;; esac; do
      _dl_o="$_dl_o${_dl_a%%\\*}\\\\"; _dl_a=${_dl_a#*\\}
    done
    _dl_a="$_dl_o$_dl_a"
    _dl_o=""                                          # pass 2: newline -> \n
    while case $_dl_a in *"$_DL_NL"*) true ;; *) false ;; esac; do
      _dl_o="$_dl_o${_dl_a%%"$_DL_NL"*}\\n"; _dl_a=${_dl_a#*"$_DL_NL"}
    done
    _dl_out="$_dl_out $_dl_o$_dl_a"
  done
  printf '%s\n' "$_dl_out" >>"$DORC_LOG"
}
_DL_NL='
'

-- mocks/apt-get --
#!/bin/sh
# INERT shim for `apt-get` — the apply mutator (`apt-get install -y nginx`). On this host
# the fold OMITS it (the guard holds ⇒ the `||` branch is dead), so it must NOT appear in
# the apply run-set; it logs only if it (wrongly) runs. (The BARE book — gate-5 ground truth
# — short-circuits past it too, since `dpkg -s nginx` exits 0.)
. "${0%/*}/.log"; _dorc_logged "$@"
exit 0

-- mocks/dpkg-query --
#!/bin/sh
# INERT shim for `dpkg-query` — the package kind's install probe (`dpkg-query -W nginx`).
# The mock host has nginx installed, so it exits 0 ⇒ the install's establish probe reports
# holds (site 2 ⇒ holds rc=0). (The install is OMITTED by the fold regardless of its own
# verdict — the fold reads the GUARD's rc — but the probe still ships this check, so it
# needs a shim for gate-1 parity; the host is consistent: nginx installed both ways.)
. "${0%/*}/.log"; _dorc_logged "$@"
exit 0

-- mocks/systemctl --
#!/bin/sh
# INERT shim for `systemctl` — an unoracled run leaf (it shares no oracle, so it runs). Logs
# its argv for the run-set.
. "${0%/*}/.log"; _dorc_logged "$@"
exit 0

-- expected.ran --
ran: systemctl reload nginx

-- replay --
$ dorc --book=book.sh -o package.oracle.sh < probe-results.txt
#!/bin/sh
# dorc probe (read-only): checks per-SITE convergence, mutates nothing.
# When run, emits one results-record per site on stdout (the return channel):
#   site <leafid> effect=<holds|absent|cant-tell> rc=<n>
# effect is derived from the probe command's rc (0=holds, 1=absent, else cant-tell);
# rc is the raw PROBE-command status (opaque to Dorc -- the record is the out-of-band lane).

printf 'dorc-records/1 nonce=dorc attempt=1 host=localhost book=8eb8582d3ea2b899f0f6c67f7999968eec9cca0ac51c2f01e76602131259a7df sites=1 @@dorc@@\n'
# site 0: sm.dorc.Package:multi
line@installed
apt_get__is_converged() {
   while [ "${1#-}" != "$1" ]; do shift; done
   verb=$1; shift
   while [ "${1#-}" != "$1" ]; do shift; done
   case $verb in
      install) dpkg-query -W "$1" >/dev/null 2>&1 ;;
      *) return 2 ;;
   esac
}
apt_get__is_converged 'install' '-y' 'multi
line'; _rc=$?; if [ "$_rc" -eq 0 ]; then _e=holds; elif [ "$_rc" -eq 1 ]; then _e=absent; else _e=cant-tell; fi; printf 'dorc site 0 effect=%s rc=%s @@dorc@@\n' "$_e" "$_rc"
# site:1 unresolvable-no-probe
printf 'dorc-records-end/1 nonce=dorc @@dorc@@\n'
#!/bin/sh
# dorc apply: the book, with already-converged/dead lines elided (value-preserving stand-in).

# render21-multiline-leaf-substitutes (arch-1, note 214 d-6 — the NEWLY-EXPRESSIBLE multi-line
true   # dorc: elided [apt-get install -y "multi line"] (already converged / dead branch)
systemctl reload nginx
