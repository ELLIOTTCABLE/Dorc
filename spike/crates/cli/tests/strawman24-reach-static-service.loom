#!/bin/sh
# dorc probe (read-only): checks per-SITE convergence, mutates nothing.
# When run, emits one results-record per site on stdout (the return channel):
#   site <leafid> effect=<holds|absent|cant-tell> rc=<n>
# effect is derived from the probe command's rc (0=holds, 1=absent, else cant-tell);
# rc is the raw PROBE-command status (opaque to Dorc -- the record is the out-of-band lane).

printf 'dorc-records/1 nonce=dorc attempt=1 host=localhost book=39dad881107a64e4ee5f578ac8e5d9a382884530eba53f7558615d1f358b6020 sites=2 @@dorc@@\n'
# site 0: sm.dorc.Package:nginx@tuned
hork__predict() {
   verb=$1; shift
   pkg="$1"
   case $verb in tune) dpkg-query -W "$pkg" >/dev/null 2>&1 ;; esac
}
hork__predict 'tune' 'nginx'; _rc=$?; if [ "$_rc" -eq 0 ]; then _e=holds; elif [ "$_rc" -eq 1 ]; then _e=absent; else _e=cant-tell; fi; printf 'dorc site 0 effect=%s rc=%s @@dorc@@\n' "$_e" "$_rc"
# site 1: sm.dorc.Service:nginx@enabled
enablesvc__is_converged() {
   systemctl is-enabled -- "$1" >/dev/null 2>&1
}
enablesvc__is_converged 'nginx'; _rc=$?; if [ "$_rc" -eq 0 ]; then _e=holds; elif [ "$_rc" -eq 1 ]; then _e=absent; else _e=cant-tell; fi; printf 'dorc site 1 effect=%s rc=%s @@dorc@@\n' "$_e" "$_rc"
printf 'dorc-records-end/1 nonce=dorc @@dorc@@\n'
why: site 1 runs -- poisoned via sm.dorc.Package.reaches() (a reach-expanded coordinate hit its backing; the wall drags it cross-author)
why: site 1 guard [sm.dorc.Service] -- licensed by the sm.dorc.Service oracle's vouch (at service.oracle.sh:23) that it is already satisfied; the original bytes survive and the check re-runs live at apply (to stay safe)
dorc: run `dorc why` for the per-site cause-chains, or `dorc why book.sh:N` to query a source line
#!/bin/sh
# dorc apply: the book, with already-converged/dead lines elided (value-preserving stand-in).

# dorc guard preamble: the vouching oracle's own verdict body, shipped strip-only
# (dialect annotations removed, nothing else changed -- rul-ternary-verdict: the
# authored bytes verbatim, no engine-synthesized sh).
enablesvc__is_converged() {
   systemctl is-enabled -- "$1" >/dev/null 2>&1
}

# dorc: end of lifted material; the book follows, in its authored order.

hork tune nginx
( enablesvc__is_converged nginx ) || enablesvc nginx   # dorc: guard [sm.dorc.Service converged-vouch; probe: holds]
dorc: plan-summary sites=2 elide=0 omit=0 guard=1 run=1 may-alias=0
