-- book.sh --
#!/bin/sh
# dorc-lang/v0.2
# pin30-wrapped-case-bodied-in-book-verdict — the canonical case-bodied verdict, sited in a BOOK above its wrapped site, answers nothing there. MEASURED, not expected: this rode stage-i as an expected-to-flip diagnostic and did NOT flip, so `28Q` §1's asserted cause (oracle-only vectors at the wrapped seat) is REFUTED — `build_wrapped_analysis` already took the source-wide vectors before that lane began, and the wrapper-lane conversion did not move it either.
# THE LEAD, from the corpus rather than from a hypothesis: pin28-wrapped-vouch-answers-at-a-live-site is the SAME world with the SAME sudo oracle and an in-book verdict at the same wrapped site, and it ships its check and elides. The only difference is the verdict body's SHAPE — straight-line there, case-with-decline-arm here — so the discriminator is body shape, not vector membership. The chase is banked; the behaviour is conservative (the site runs), so this is value-loss, never a license bug.
# `28Q` §8 STAGE-0 also did not flip it, and the re-cut refutes two more candidates: the wrapped ship seat now prefers a vouching verdict over any predict and nothing moved, and this consent mark is top-level, so `tolerated_on_path` lifts it identically to pin28's for every verb. Two candidate seats remain: `evaluate_verdict`'s tracer over a case body at the PEELED argv, and `peel_book_chain`.
hork__is_converged() {
   : safe-across user
   case "$1" in
   install) hork query -- "$2" ;;
   *) return 2 ;;
   esac
}
sudo hork install wombat

-- sudo.oracle.sh --
# dorc-lang/v0.2
# The coherent sudo wrapper of pin28-wrapped-vouch-answers-at-a-live-site, byte-for-byte: only the verdict body differs between the two cases.
sudo__predict() {
   while [ "${1#-}" != "$1" ]; do case "$1" in -u) shift 2 ;; *) shift ;; esac; done
   env -i HOME=/root "$@"
}
sudo__lend_map() {
   target=root
   while [ "${1#-}" != "$1" ]; do case "$1" in -u) target="$2"; shift 2 ;; *) shift ;; esac; done
   printf '%s\n' "$target" : lends user
   : lends fs-view
   : lends netns
   "$@"
}
sudo__enter() {
   sudo -n "$@"
}

