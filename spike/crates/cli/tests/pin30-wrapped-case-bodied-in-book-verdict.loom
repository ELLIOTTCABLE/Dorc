#!/bin/sh
# dorc-lang/v0.2
# EXPECTED-TO-FLIP at stage-i: the canonical case-bodied verdict, sited in a BOOK above its wrapped site, answers nothing there today.
hork__is_converged() {
   : safe-across user
   case "$1" in
   install) hork query -- "$2" ;;
   *) return 2 ;;
