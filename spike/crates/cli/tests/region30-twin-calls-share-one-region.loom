-- book.sh --
#!/bin/sh
# ONE authored region, TWO invocations, and the shared decision is universal over both
# (`30L:rul-shared-region-needs-universal-must`). Both operands are already installed, so every
# route agrees and the DERIVED whole-helper answer follows: each CALL independently replaces once
# its own position is fresh, and the inert definition keeps its AUTHORED TEXT
# (`30L:pin-whole-helper-derived-only`, §8) rather than acquiring stand-ins nothing reaches.
#
# The second call is fresh only in a LATER settlement round, once the first is proven not to
# execute — the grow-only ledger doing its job, not a special case.
install_pkg() {
   apt-get install -y "$1"
}

install_pkg nginx
install_pkg curl

-- pkgindex-predict.oracle.sh --
#!/usr/bin/env dorc-sh
# dorc-lang/v0.2
apt_get__predict() {
   while [ "${1#-}" != "$1" ]; do shift; done
   verb=$1; shift
   while [ "${1#-}" != "$1" ]; do shift; done
   pkg : sm.dorc.Package = "$1"
   if [ "${2-}" = "" ]; then
      case $verb in
         install) dpkg-query -W "$pkg" >/dev/null 2>&1 : sm.dorc.Package:"$pkg"@installed ;;
      esac
   fi
}

-- pkgindex-verdict.oracle.sh --
#!/usr/bin/env dorc-sh
# dorc-lang/v0.2
apt_get__is_converged() {
   while [ "${1#-}" != "$1" ]; do shift; done
   verb=$1; shift
   while [ "${1#-}" != "$1" ]; do shift; done
   case $verb in
      install) aptcheck -q -- "$1" ;;
      *) return 2 ;;
   esac
}

-- probe-results.txt --
# Both operands are already installed, so BOTH routes of the one authored region agree.
site 0.0 effect=holds rc=0
site 1.0 effect=holds rc=0

-- mocks/.log --
_dorc_logged() {
   _dl_out="ran: ${0##*/}"
   for _dl_arg in "$@"; do _dl_out="$_dl_out $_dl_arg"; done
   printf '%s\n' "$_dl_out" >>"$DORC_LOG"
}

-- mocks/apt-get --
#!/bin/sh
. "${0%/*}/.log"; _dorc_logged "$@"
exit 0

-- mocks/aptcheck --
#!/bin/sh
. "${0%/*}/.log"; _dorc_logged "$@"
exit 0

-- mocks/dpkg-query --
#!/bin/sh
. "${0%/*}/.log"; _dorc_logged "$@"
exit 0

