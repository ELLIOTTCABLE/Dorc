#!/bin/sh
# dorc apply: the book, with already-converged/dead lines elided (value-preserving stand-in).

#!/bin/sh
# subshell fallback source boundary under `set -e` (`30I` specimen 2)
set -e
SM_ORACLE_ROOT=.

. './base.dorc-bundle.sh'
(
   unset -f sm_pick
   [ "${sm_fallback_loaded-}" = 'sm.fallback/v1' ] || . './fallback.dorc-bundle.sh'
   sm_pick inside
)
sm_pick outside
