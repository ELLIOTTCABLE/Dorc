-- book.sh --
#!/bin/sh
# floor30-atlas-errexit-set-inside-sourced-file — QUESTION: a sourced file turns errexit ON. Is it
# still on for the CALLER after the `.` returns?
#
# Why the inclusion design needs it: `set -e` is one flat shell option with no scope, so a dependency
# that sets it changes the failure semantics of every book line BELOW the load — whether the load is
# an authored `.` or bytes an artifact absorbed in its place. If it persists, the inclusion lowering
# inherits an obligation it has no vocabulary for today; if it does not, one whole class of worry is
# closed by measurement rather than by argument.
printf 'book-before\n'
. ./setter.sh
printf 'book-after-dot\n'
false
printf 'book-survived-a-false\n'

-- setter.sh --
printf 'file-setting-errexit\n'
set -e

-- expected.emitted --
book-before
file-setting-errexit
book-after-dot

-- expected.ran --

-- replay --
$ dorc --book=book.sh --results -
#!/bin/sh
# dorc probe (read-only): checks per-SITE convergence, mutates nothing.
# When run, emits one results-record per site on stdout (the return channel):
#   site <leafid> effect=<holds|absent|cant-tell> rc=<n>
# effect is derived from the probe command's rc (0=holds, 1=absent, else cant-tell);
# rc is the raw PROBE-command status (opaque to Dorc -- the record is the out-of-band lane).

printf 'dorc-records/1 nonce=dorc attempt=1 host=localhost book=89e48a7846116e6a50f1ea5f2b5f9da3bbcd52dac4f76fe247ad5d07adb92efd sites=0 @@dorc@@\n'
# site:0 unresolvable-no-probe
# site:1 unresolvable-no-probe
# site:2 unresolvable-no-probe
# site:3 unresolvable-no-probe
# site:4 unresolvable-no-probe
printf 'dorc-records-end/1 nonce=dorc @@dorc@@\n'
#!/bin/sh
# dorc apply: the book, with already-converged/dead lines elided (value-preserving stand-in).

#!/bin/sh
# floor30-atlas-errexit-set-inside-sourced-file — QUESTION: a sourced file turns errexit ON. Is it
# still on for the CALLER after the `.` returns?
#
# Why the inclusion design needs it: `set -e` is one flat shell option with no scope, so a dependency
# that sets it changes the failure semantics of every book line BELOW the load — whether the load is
# an authored `.` or bytes an artifact absorbed in its place. If it persists, the inclusion lowering
# inherits an obligation it has no vocabulary for today; if it does not, one whole class of worry is
# closed by measurement rather than by argument.
printf 'book-before\n'
. ./setter.sh
printf 'book-after-dot\n'
false
printf 'book-survived-a-false\n'
