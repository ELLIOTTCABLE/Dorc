#!/bin/sh
# dorc probe (read-only): checks per-SITE convergence, mutates nothing.
# When run, emits one results-record per site on stdout (the return channel):
#   site <leafid> effect=<holds|absent|cant-tell> rc=<n>
# effect is derived from the probe command's rc (0=holds, 1=absent, else cant-tell);
# rc is the raw PROBE-command status (opaque to Dorc -- the record is the out-of-band lane).

printf 'dorc-records/1 nonce=dorc attempt=1 host=localhost book=84ebb8bcc0082d3b713dbd272f4ac64e67776802de571595065292cbdb3c7c62 sites=0 @@dorc@@\n'
# site:0 unresolvable-no-probe
# site:1 unresolvable-no-probe
# site:2 unresolvable-no-probe
printf 'dorc-records-end/1 nonce=dorc @@dorc@@\n'
#!/bin/sh
# dorc apply: the book, with already-converged/dead lines elided (value-preserving stand-in).

#!/bin/sh
# TARGET (`30P:law-no-unsoundness-below-a-blind-act`, the nothing-shipped clause): a book that
# moves the working directory to somewhere Dorc cannot name, then sources its own sibling package
# RELATIVELY. The operand is a plain literal and the controller reads the file, so the AUTHOR named
# the target — but which file that operand resolves to on the host is now unknown, and a copy of a
# file Dorc cannot prove the author's own line will read is engine selection.
#
# So: the `.` line survives verbatim (no re-point, no paste), the package's bytes are carried by no
# form, and the reader is told which line above cost them the dependency. The `hork tune` site
# below binds nothing from the package either — cwd-⊤ costs the load its authority as well as its
# carriage — so it runs.
cd "$SITE_ROOT"

. ./hork.dorc.sh

hork tune web
