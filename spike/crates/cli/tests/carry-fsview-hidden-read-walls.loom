-- book.sh --
#!/bin/sh
# 27C §4(a) carry NEGATIVE (27O): ambient kp elides; the chroot-wrapped policyctl STRADDLER has (A)
# but fails (B) — its verdict reads an fs-view-dependent file unmarked — so the carry walls, site runs.
kp ip_forward 1
chroot /mnt policyctl swappiness 10

-- chroot.oracle.sh --
# dorc-lang/v0.2
# chroot: fs-view wrapper, NO __enter form ⇒ entry degrades to the carry fallback (27C §4(a)).
chroot__predict() {
   shift
   "$@"
}
chroot__lend_map() {
   printf '%s\n' "$1"   : lends fs-view
   : lends user
   : lends netns
   shift
   "$@"
}

-- kp.oracle.sh --
# dorc-lang/v0.2
# kp verdict reads ONLY the marked KernelParam cell + argv (read-set-closed, 27C §4(a)-(B)).
kp__is_converged() {
   kp check "$1" "$2"   : sm.dorc.KernelParam:"$1"
}
sm_dorc_KernelParam__state_stored_only_in() {
   printf 'kernel-sysctls\n'   : stored-in kernel
   : undivided-by-transit-across fs-view
}

-- policyctl.oracle.sh --
# dorc-lang/v0.2
# policyctl STRADDLER (27Xb counterexample): compares against `$(cat /etc/policy)`, an unmarked
# fs-view-dependent read ⇒ (B) not read-set-closed ⇒ carry walls.
policyctl__is_converged() {
   want="$(cat /etc/policy)"
   policyctl check "$1" "$want"   : sm.dorc.KernelParam:"$1"
}

