#!/bin/sh
# dorc probe (read-only): checks per-SITE convergence, mutates nothing.
# When run, emits one results-record per site on stdout (the return channel):
#   site <leafid> effect=<holds|absent|cant-tell> rc=<n>
# effect is derived from the probe command's rc (0=holds, 1=absent, else cant-tell);
# rc is the raw PROBE-command status (opaque to Dorc — the record is the out-of-band lane).

printf 'dorc-records/1 nonce=dorc attempt=1 host=localhost book=796e6aeb86b988d4 sites=0 @@dorc@@\n'
# site:0 skip-unresolvable
printf 'dorc-records-end/1 nonce=dorc @@dorc@@\n'
#!/bin/sh
# dorc apply: the book, with already-converged/dead lines elided (value-preserving stand-in).

#!/bin/sh
# wrapper-entry-form-coheres (27C §3): a sudo wrapper oracle authoring predict + lend_map + the
# `__enter` form (`sudo -n "$@"`, non-interactive by construction). All three lift clean and cohere
# (fold-entry: the trivial re-pass entry delegates to the real tool ⇒ no argv-flow divergence). The
# escalation-policy disclosure names the entry-capable wrapper. The wrapped site STILL walls — the
# book-side entry-composed probe is the deferred integration; loading a valid entry oracle mints no
# elision (zero new trust). Byte-identical to the peel-coheres case (the entry form is invisible
# until the pipeline consumes it).
sudo hork setup
