#!/bin/sh
# dorc apply: the book, with already-converged/dead lines elided (value-preserving stand-in).

#!/bin/sh
# contest28-top-licenses-nothing (`28K` rider-1 `⊤-licenses-nothing`) — the mechanical pin under
# ruling (ii). A half-defining branch leaves the binding ⊤: the environment cannot say whether the
# book's definition or the loaded oracle's is live, and an unprovable binding mints NO license at
# any seat — no vouch, no guard, no elision, and no probe ship. The site simply runs.
#
# This is the whole soundness argument for letting the shadow refusal UNDER-fire (a shape it
# cannot prove goes uncomplained-about): an under-caught shadow can grant nothing, because there
# is nothing ⊤ grants. Nothing here complains, deliberately — ⊤ never complains.
#
# The condition is a live filesystem test on purpose, so the cell survives the decidable-condition
# fold banked at `28O:res-polyfill-binding-tops-pending-fold`: that fold folds decidable
# `command -v` conditions, and this one stays undecidable forever.
if [ -f /etc/dorc/prefer-local-foobar ]; then
   foobar__is_converged() {
      foobar status --certs-current -- "$2"
   }
fi
foobar sync-certs /etc/nginx/certs
