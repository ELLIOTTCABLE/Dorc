-- book.sh --
#!/bin/sh
# floor30-sibling-frames-hold-three-bodies — the definition-fixtures battery's activation shape
# (`28Q` §8 stage-i: ground truth minted before the conversion that will consume it).
#
# This is the cell the hash-munge activation exists for: three MUTUALLY UNREACHABLE frames hold
# three live bodies for ONE name inside a single run, which no flat per-name definition table can
# spell — the winner has to become per-frame. `28K` §2 visibility-is-full-positional withholds here
# today rather than answering, and the conversion's job is to answer instead of withholding.
#
# Three measurements: variant-a inside the first region, variant-b inside the second (which is what
# proves the first region's binding did not leak sideways), and the base body once both closed.
# Engine agreement over these cells activates at the definition-factoring conversion; the answers
# committed here are the shells' own.
. ./base.sh
( . ./variant-a.sh; hork__is_converged )
( . ./variant-b.sh; hork__is_converged )
hork__is_converged

-- base.sh --
hork__is_converged() { printf 'base\n' ;}

-- variant-a.sh --
hork__is_converged() { printf 'variant-a\n' ;}

-- variant-b.sh --
hork__is_converged() { printf 'variant-b\n' ;}

-- expected.emitted --
variant-a
variant-b
base

-- expected.ran --

