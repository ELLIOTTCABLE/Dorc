-- book.sh --
#!/bin/sh
# wrapper-entry-form-coheres (27C §3): a sudo wrapper oracle authoring predict + lend_map + the
# `__enter` form (`sudo -n "$@"`, non-interactive by construction). All three lift clean and cohere
# (fold-entry: the trivial re-pass entry delegates to the real tool ⇒ no argv-flow divergence). The
# escalation-policy disclosure names the entry-capable wrapper. The wrapped site STILL walls — the
# book-side entry-composed probe is the deferred integration; loading a valid entry oracle mints no
# elision (zero new trust). Byte-identical to the peel-coheres case (the entry form is invisible
# until the pipeline consumes it).
sudo hork setup

-- sudo.oracle.sh --
# dorc-lang/v0.2
# A COHERENT sudo wrapper (273 + 27C §3): predict env-scrubs then execs the guest; lend_map answers
# user (mapped) / fs-view (full); the entry form re-runs sudo non-interactively (`-n`), passing the
# guest verbatim. Authoring `sudo__enter` IS the traversal vouch (authoring-is-vouching): the author
# answers for the entry's self-effects (the auth-log line — 27C:rul-probe-mutation-ownership-split).
sudo__predict() {
   while [ "${1#-}" != "$1" ]; do shift; done
   env -i TERM="${TERM-}" HOME=/root "$@"
}
sudo__lend_map() {
   while [ "${1#-}" != "$1" ]; do shift; done
   printf '%s\n' root : lends user
   : lends fs-view
   "$@"
}
sudo__enter() {
   sudo -n "$@"
}

