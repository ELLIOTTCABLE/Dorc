-- book.sh --
#!/bin/sh
# floor30-atlas-sourced-file-state-persists — QUESTION: `unset -f`, `cd`, and `trap … EXIT` performed
# at the top level of a sourced file — is each one visible to the CALLER after the `.` returns?
#
# Why the inclusion design needs it: each is a different KIND of shell state, and the engine models
# them unevenly. `unset -f` is already a first-class binding fact
# (`lvalue-builtin-flags-are-spelled-not-guessed`); a `cd` moves the coordinate every later relative
# `.` operand resolves against, which `30I` §3.2 names as owed work; and a `trap … EXIT` installed by
# a dependency runs code at a moment no CFG edge models (`region-openers-are-demanded-not-defaulted`
# calls that out for `trap` already). If the `.` really is one flat environment, all three persist —
# and each one that does is an obligation the inclusion lowering inherits verbatim.
#
# The cwd cell COMPARES rather than prints: the harness runs from a throwaway scratch directory, so
# emitting a path would commit bytes that change every run. `readonly` is deliberately NOT here — it
# can end the script outright, so it has its own case.
victim() { printf 'victim-alive\n' ;}
book_pwd=$PWD
. ./stateful.sh
if command -v victim >/dev/null 2>&1; then
   printf 'book: unset-f=[still-defined]\n'
else
   printf 'book: unset-f=[removed]\n'
fi
if [ "$PWD" = "$book_pwd" ]; then
   printf 'book: cd=[caller-cwd-unchanged]\n'
else
   printf 'book: cd=[caller-cwd-changed]\n'
fi
printf 'book-tail\n'

-- stateful.sh --
printf 'file-start\n'
unset -f victim
trap 'printf "trap: EXIT-fired\n"' EXIT
cd /
printf 'file-end\n'

-- expected.emitted --
file-start
file-end
book: unset-f=[removed]
book: cd=[caller-cwd-changed]
book-tail
trap: EXIT-fired

-- expected.ran --

-- replay --
$ dorc --book=book.sh --results -
#!/bin/sh
# dorc probe (read-only): checks per-SITE convergence, mutates nothing.
# When run, emits one results-record per site on stdout (the return channel):
#   site <leafid> effect=<holds|absent|cant-tell> rc=<n>
# effect is derived from the probe command's rc (0=holds, 1=absent, else cant-tell);
# rc is the raw PROBE-command status (opaque to Dorc -- the record is the out-of-band lane).

printf 'dorc-records/1 nonce=dorc attempt=1 host=localhost book=59470abc22359eedd02628d82187bcde966a6f297c5b82b6a737f11d67a6c797 sites=0 @@dorc@@\n'
# site:0 unresolvable-no-probe
# site:1 unresolvable-no-probe
# site:2 unresolvable-no-probe
# site:3 unresolvable-no-probe
# site:4 unresolvable-no-probe
# site:5 unresolvable-no-probe
# site:6 unresolvable-no-probe
# site:7 unresolvable-no-probe
# site:8 unresolvable-no-probe
printf 'dorc-records-end/1 nonce=dorc @@dorc@@\n'
#!/bin/sh
# dorc apply: the book, with already-converged/dead lines elided (value-preserving stand-in).

