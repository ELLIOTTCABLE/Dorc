---
---
-- book.sh --
#!/bin/sh
# book-owned location; two entrypoints share one guarded dependency (`30I` specimen 1)
SM_ORACLE_ROOT=.

. "$SM_ORACLE_ROOT/alpha.dorc.sh"
. "$SM_ORACLE_ROOT/beta.dorc.sh"

alpha_book_step first
beta_book_step second

-- alpha.dorc.sh --
# dorc-lang/v0.2
if [ "${sm_common_loaded-}" != 'sm.common/v1' ]; then
   . "$SM_ORACLE_ROOT/common.dorc.sh"
fi

alpha_book_step() {
   sm_common_query alpha "$1"
}

-- beta.dorc.sh --
# dorc-lang/v0.2
if [ "${sm_common_loaded-}" != 'sm.common/v1' ]; then
   . "$SM_ORACLE_ROOT/common.dorc.sh"
fi

beta_book_step() {
   sm_common_query beta "$1"
}

-- common.dorc.sh --
# dorc-lang/v0.2
sm_common_query() {
   common "$@"
}

sm_common_loaded='sm.common/v1'

-- probe-results.txt --

-- mocks/.log --
_dorc_logged() {
   _dl_out="ran: ${0##*/}"
   for _dl_arg do _dl_out="$_dl_out $_dl_arg"; done
   printf '%s\n' "$_dl_out" >>"$DORC_LOG"
}

-- mocks/common --
#!/bin/sh
. "${0%/*}/.log"
_dorc_logged "$@"

-- expected.ran --
ran: common alpha first
ran: common beta second

-- replay --
$ dorc --book=book.sh --artifact-dir=$ARTIFACT_DIR --results - < probe-results.txt
cfg: warning[cfg-errexit-unknown]: Dorc could not tell whether `set -e` is in
effect at one or more commands (a non-literal `set` argument, or paths that
disagree), so it plans as though each might abort the book on failure -- the
cautious reading; it can cost elisions, never correctness.
#!/bin/sh
# dorc probe (read-only): checks per-SITE convergence, mutates nothing.
# When run, emits one results-record per site on stdout (the return channel):
#   site <leafid> effect=<holds|absent|cant-tell> rc=<n>
# effect is derived from the probe command's rc (0=holds, 1=absent, else cant-tell);
# rc is the raw PROBE-command status (opaque to Dorc -- the record is the out-of-band lane).

printf 'dorc-records/1 nonce=dorc attempt=1 host=localhost book=059be2debb78a7873e4b68384f14b969e0b776bd7e80e32514a22ea6e22e16cf sites=0 @@dorc@@\n'
# site:0 unresolvable-no-probe
# site:1 unresolvable-no-probe
# site:2 unresolvable-no-probe
# site:3 unresolvable-no-probe
# site:4 unresolvable-no-probe
printf 'dorc-records-end/1 nonce=dorc @@dorc@@\n'
probe: note[site-unresolvable]: sm 4 sites run unprobed (no read-only check
could be shipped): `. "$SM_ORACLE_ROOT/alpha.dorc.sh"`, `.
"$SM_ORACLE_ROOT/beta.dorc.sh"`, `alpha_book_step first`, `beta_book_step
second` -- run `dorc why` for the per-site detail (the apply runs each anyway,
to stay safe)
      [ book.sh:5:1
   5 | . "$SM_ORACLE_ROOT/alpha.dorc.sh"
     | \_______________________________/

   = help:  sm site runs `. "$SM_ORACLE_ROOT/alpha.dorc.sh"`
hint: '.' (line 5) is unmodeled: it is the first wall -- an oracle vouching its convergence would elide it when converged; 3 more unmodeled walls -- dorc why
dorc: run `dorc why` for the per-site cause-chains, or `dorc why book.sh:N` to query a source line
emission: note[plan-import-rewritten]: [unwritten: plan-import-rewritten]
      [ book.sh:5:3
   5 | . "$SM_ORACLE_ROOT/alpha.dorc.sh"
     |   \_____________________________/
emission: note[plan-import-rewritten]: [unwritten: plan-import-rewritten]
      [ book.sh:6:3
   6 | . "$SM_ORACLE_ROOT/beta.dorc.sh"
     |   \____________________________/
#!/bin/sh
# dorc apply: the book, with already-converged/dead lines elided (value-preserving stand-in).

#!/bin/sh
# book-owned location; two entrypoints share one guarded dependency (`30I` specimen 1)
SM_ORACLE_ROOT=.

. './alpha.dorc-bundle.sh'
. './beta.dorc-bundle.sh'

alpha_book_step first
beta_book_step second
dorc: plan-summary sites=5 elide=0 omit=0 guard=0 run=5 may-alias=0
dorc: decision-digest bce91ae05c5eb3946977d3729e5fd06a93724b9fa0cc0f1a7fb748b554c07a9d
