-- book.sh --
# door1-and-form-runs (door-1 && POLE, charter 20V §4 / note 215): the `&&` companion-pole
set -e
dpkg -s nginx >/dev/null 2>&1 && { systemctl reload nginx; }

-- pkgstate.oracle.sh --
#!/usr/bin/env dorc-sh
# dorc-lang/v0.2
# package-status QUERY oracle (the DESIGN `dpkg -s nginx || apt-get install` idiom).
dpkg__predict() {
   case $1 in -s) shift ;; esac
   pkg : sm.dorc.PkgState = "$1"
   dpkg -s -- "$pkg" >/dev/null 2>&1 :? sm.dorc.PkgState:"$pkg"@installed
}

-- probe-results.txt --
# probe-results: site 1 is the `dpkg -s nginx` pkgstate Query guard; holds ⇒ rc 0. For
# `&&`, a SUCCEEDING guard proceeds ⇒ the `{ systemctl reload nginx; }` block is LIVE and
# runs. The guard's Query rc is fold-usable (substitutes to `true`); the block stays live.
site 1 effect=holds rc=0

-- mocks/.log --
# newline-safe argv logger for the inert mock shims (slice-4). Sourced by each shim via
# `. "${0%/*}/.log"` (the shim's own dir); a DOTFILE so gate-5/gate-6's `ls`-derived shimset
# never lists it. Replaces the old inline `printf 'ran: %s %s\n' "${0##*/}" "$*"` — an arg with
# an embedded NEWLINE would split the `ran:` line and silently break every line-based compare
# (exec_check, gate-5, gate-6). Shims run under PATH=mocks-only ⇒ BUILTINS ONLY (no sed/awk).
#
# GRAMMAR (what expected.ran goldens carry): one `ran: <name> <arg>…` line per invocation; each
# arg is encoded — a literal backslash as `\\`, an embedded newline as the two chars `\n`. The
# two passes run in THIS order (backslash first) so a newline's encoded `\n` backslash is not
# re-doubled. A newline-free, backslash-free argv encodes to itself ⇒ byte-identical to the old
# format (per-arg space-join == the old `"$*"` join) ⇒ zero golden churn.
_dorc_logged() {
  _dl_out="ran: ${0##*/}"
  for _dl_a in "$@"; do
    _dl_o=""                                          # pass 1: \ -> \\
    while case $_dl_a in *\\*) true ;; *) false ;; esac; do
      _dl_o="$_dl_o${_dl_a%%\\*}\\\\"; _dl_a=${_dl_a#*\\}
    done
    _dl_a="$_dl_o$_dl_a"
    _dl_o=""                                          # pass 2: newline -> \n
    while case $_dl_a in *"$_DL_NL"*) true ;; *) false ;; esac; do
      _dl_o="$_dl_o${_dl_a%%"$_DL_NL"*}\\n"; _dl_a=${_dl_a#*"$_DL_NL"}
    done
    _dl_out="$_dl_out $_dl_o$_dl_a"
  done
  printf '%s\n' "$_dl_out" >>"$DORC_LOG"
}
_DL_NL='
'

-- mocks/dpkg --
#!/bin/sh
# INERT shim for `dpkg` — the pkgstate kind's probe (`dpkg -s <pkg>`; $1=-s, $2=pkg) AND
# the apply's verbatim Query guard when it runs. The mock host has nginx INSTALLED (the
# guard holds, rc 0), so the `|| { … }` block is dead and elides. Read-only; logs argv.
. "${0%/*}/.log"; _dorc_logged "$@"
# R3: the probe ships `dpkg -s -- <pkg>` (the stripped check body); the book's own guard
# ships `dpkg -s <pkg>` — skip the `-s` flag + optional `--` separator to read the operand.
pkg=$2; [ "$pkg" = "--" ] && pkg=$3
case $pkg in
  nginx) exit 0 ;;  # installed ⇒ holds ⇒ the guard substitutes to `true`, block dead
  *)     exit 1 ;;  # anything else absent
esac

-- mocks/systemctl --
#!/bin/sh
# INERT mock: logs argv, mutates nothing, exits 0. RUNS here (the && block is live — guard held).
. "${0%/*}/.log"; _dorc_logged "$@"
exit 0

-- expected.ran --
ran: systemctl reload nginx

-- replay --
$ dorc --book=book.sh --pre-source pkgstate.oracle.sh --results - < probe-results.txt
#!/bin/sh
# dorc probe (read-only): checks per-SITE convergence, mutates nothing.
# When run, emits one results-record per site on stdout (the return channel):
#   site <leafid> effect=<holds|absent|cant-tell> rc=<n>
# effect is derived from the probe command's rc (0=holds, 1=absent, else cant-tell);
# rc is the raw PROBE-command status (opaque to Dorc -- the record is the out-of-band lane).

printf 'dorc-records/1 nonce=dorc attempt=1 host=localhost book=5f34a6c30a4fb87b6698dc2506195d50b81a075c227ba4d67cb4a955e73a46f1 sites=1 @@dorc@@\n'
# site 1: sm.dorc.PkgState:nginx@installed
dpkg__predict() {
   case $1 in -s) shift ;; esac
   pkg="$1"
   dpkg -s -- "$pkg" >/dev/null 2>&1
}
dpkg__predict '-s' 'nginx'; _rc=$?; if [ "$_rc" -eq 0 ]; then _e=holds; elif [ "$_rc" -eq 1 ]; then _e=absent; else _e=cant-tell; fi; printf 'dorc site 1 effect=%s rc=%s @@dorc@@\n' "$_e" "$_rc"
# site:0 unresolvable-no-probe
# site:2 unresolvable-no-probe
printf 'dorc-records-end/1 nonce=dorc @@dorc@@\n'
probe: note[site-unresolvable]: sm 1 site run unprobed (no read-only check could
be shipped): `systemctl reload nginx` -- run `dorc why` for the per-site detail
(the apply runs each anyway, to stay safe)
      [ book.sh:3:36
   3 | dpkg -s nginx >/dev/null 2>&1 && { systemctl reload nginx; }
     |                                    \____________________/

   = help:  sm site runs `systemctl reload nginx`
hint: 'systemctl' (line 3) is unmodeled: it is the first wall -- an oracle vouching its convergence would elide it when converged
dorc: run `dorc why` for the per-site cause-chains, or `dorc why book.sh:N` to query a source line
#!/bin/sh
# dorc apply: the book, with already-converged/dead lines elided (value-preserving stand-in).

# door1-and-form-runs (door-1 && POLE, charter 20V §4 / note 215): the `&&` companion-pole
set -e
true && { systemctl reload nginx; }   # dorc: elided [dpkg -s nginx >/dev/null 2>&1] (already converged / dead branch)
dorc: plan-summary sites=3 elide=1 omit=0 guard=0 run=2 may-alias=0
dorc: decision-digest 5f0080484ee86d31d3609ce1a6d3c38635cbed7987d33d4eaa839c0256f72131
