      [ book.sh:5:3
   5 | . "$SM_ORACLE_ROOT/entry.dorc.sh"
     |   \_____________________________/
emission: note[plan-import-rewritten]: [unwritten: plan-import-rewritten]
      [ book.sh:9:6
   9 |    . "$SM_ORACLE_ROOT/entry.dorc.sh"
     |      \_____________________________/
#!/bin/sh
# dorc apply: the book, with already-converged/dead lines elided (value-preserving stand-in).

#!/bin/sh
# one entrypoint at two positions and in two function frames (`30I` specimen 3)
SM_ORACLE_ROOT=.

. './entry.dorc-bundle.sh'
package_step ambient
(
   sm_pick() { common high "$@"; }
   . './entry.dorc-bundle.sh'
   package_step regional
)
package_step after
dorc: plan-summary sites=6 elide=0 omit=0 guard=0 run=6 may-alias=0
dorc: decision-digest 02ef69212cd82ef75232671ea3a02b56ae9ad0114a7850a0ef5b8c4b1941c461
