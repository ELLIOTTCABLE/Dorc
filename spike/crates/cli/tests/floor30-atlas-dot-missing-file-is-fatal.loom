-- book.sh --
#!/bin/sh
# floor30-atlas-dot-missing-file-is-fatal — QUESTION: with errexit OFF, `. ./nope.sh` naming a file
# that does not exist. `.` is a POSIX SPECIAL builtin, whose failure is specified to end a
# non-interactive shell — so does the script continue? And is `. ./nope.sh || true` catchable, or
# still fatal?
#
# Why the inclusion design needs it: this is the runtime consequence of an unmatched source glob
# (`p-x-glob-load-no-match-aborts`), of a dependency the artifact failed to place, and of any load
# whose operand resolved to a name the target does not have. If a failed `.` is unconditionally
# fatal, then everything after such a load is unreachable rather than merely unbound, and the
# engine's model of the tail is wrong in the more dangerous direction.
#
# Cells in rising order of destructiveness: guarded first, so its answer survives whatever the bare
# one does. Neither operand names a file this case ships.
printf 'book-before\n'
. ./nope.sh || printf 'book: guarded caught status=[%s]\n' "$?"
printf 'book-after-guarded\n'
. ./alsonope.sh
printf 'book-after-bare\n'

-- expected.emitted --
book-before

-- expected.ran --

-- replay --
