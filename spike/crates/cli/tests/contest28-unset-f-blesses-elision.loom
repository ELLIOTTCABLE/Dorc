-- book.sh --
#!/bin/sh
# contest28-unset-f-blesses-elision (`28K` §1) — CELL 2, the blessed twin of
# contest28-cross-unit-shadow-runs. The same two definitions of one role function, with one
# `unset -f` textually between them: the book's definition now lands in a FREE slot, so nothing
# was silently overridden, the family keeps its licenses, and the converged site elides.
#
# That single line is the whole blessing vocabulary at v0 (`28K` §9 rat-blessing-vocabulary-v0).
unset -f foobar__is_converged
foobar__is_converged() {
   foobar status --certs-current -- "$2"
}
foobar sync-certs /etc/nginx/certs

-- foobar.oracle.sh --
foobar__is_converged() {
   verb="$1"; shift
   case "$verb" in
   sync-certs) foobar status --certs-current -- "$1" ;;
   *) return 2 ;;
   esac
}

-- probe-results.txt --
# site 1 = `foobar sync-certs …`, answered by the BOOK's definition (sh's last-wins, blessed by
# the `unset -f` above it). rc 0 ⇒ converged ⇒ elides.
site 1 effect=holds rc=0

-- mocks/.log --
# newline-safe argv logger for the inert mock shims (slice-4). Sourced by each shim via
# `. "${0%/*}/.log"` (the shim's own dir); a DOTFILE so gate-5/gate-6's `ls`-derived shimset
# never lists it. Shims run under PATH=mocks-only ⇒ BUILTINS ONLY (no sed/awk).
_dorc_logged() {
  _dl_out="ran: ${0##*/}"
  for _dl_a in "$@"; do
    _dl_o=""                                          # pass 1: \ -> \\
    while case $_dl_a in *\\*) true ;; *) false ;; esac; do
      _dl_o="$_dl_o${_dl_a%%\\*}\\\\"; _dl_a=${_dl_a#*\\}
    done
    _dl_a="$_dl_o$_dl_a"
    _dl_o=""                                          # pass 2: newline -> \n
    while case $_dl_a in *"$_DL_NL"*) true ;; *) false ;; esac; do
      _dl_o="$_dl_o${_dl_a%%"$_DL_NL"*}\\n"; _dl_a=${_dl_a#*"$_DL_NL"}
    done
    _dl_out="$_dl_out $_dl_o$_dl_a"
  done
  printf '%s\n' "$_dl_out" >>"$DORC_LOG"
}
_DL_NL='
'

-- mocks/foobar --
#!/bin/sh
# INERT mock: the verdict body's `foobar status …` answers rc 0 (converged). The book's
# `sync-certs` mutation is never invoked, because the site elides. Mutates nothing.
. "${0%/*}/.log"; _dorc_logged "$@"
exit 0

