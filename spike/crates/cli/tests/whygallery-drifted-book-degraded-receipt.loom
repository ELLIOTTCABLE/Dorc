---
run: round-trip
fixpoint: executed
---
-- book.sh --
# whygallery-drifted-book-degraded-receipt (`28F:rul-drift-replay-d1`) — the 03:40 morning where
# the admin already EDITED the book before asking why. The committed `.whylog` below is the 02:00
# cron run's receipt; the book it recorded is not the book in this directory (its recorded digest
# is deliberately unreachable), so the replay is drifted and answers degraded rather than refusing.
# Every tool named here is an INERT mock; nothing mutates.
apt-get install -y nginx
systemctl enable nginx
ufw allow 443/tcp

-- firewall.oracle.sh --
#!/usr/bin/env dorc-sh
# dorc-lang/v0.2
# Present so the drifted receipt has a real oracle INVENTORY to state: the degraded render reads
# the recorded oracle paths off the durable, and the replay loader reads each one off disk before
# it can compare digests at all.
ufw__predict() {
   verb=$1; shift
   rule : sm.dorc.Firewall = "$1"
   case $verb in
      allow) ufw status "$rule" >/dev/null 2>&1 : sm.dorc.Firewall:"$rule"@allowed ;;
   esac
}

-- probe-results.txt --
# probe-results: site-keyed records (task-D1 WIRE). Grammar:
#   site <leafid> effect=<holds|absent|cant-tell> [rc=<n>]
# Empty on purpose: block 0 is scaffolding, not the assertion. The drifted replay in block 1 never
# reaches the probe lane at all — it returns above the pipeline, which is the whole point.

-- .whylog --
dorc-whylog/2 nonce=dorc attempt=0 host=web1 target=width-one generation=width-one mode=whylog-replay started=1784944837000 @@dorc@@
book digest=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa path=book.sh @@dorc@@
oracle ordinal=0 digest=cccccccccccccccccccccccccccccccc path=firewall.oracle.sh @@dorc@@
argv value=dorc @@dorc@@
argv value=plan @@dorc@@
argv value=book.sh @@dorc@@
argv value=--risk-faultless-skips @@dorc@@
digest decision=bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb @@dorc@@
apply leaf=0 disposition=run predicted=1 @@dorc@@
apply leaf=1 disposition=replace predicted=1 @@dorc@@
apply leaf=2 disposition=guard predicted=1 @@dorc@@
results bytes=0 @@dorc@@
dorc-whylog-end/2 @@dorc@@

-- mocks/.log --
# newline-safe argv logger for the inert mock shims (slice-4). Sourced by each shim via
# `. "${0%/*}/.log"` (the shim's own dir); a DOTFILE so gate-5/gate-6's `ls`-derived shimset
# never lists it. Shims run under PATH=mocks-only ⇒ BUILTINS ONLY (no sed/awk).
_dorc_logged() {
  _dl_out="ran: ${0##*/}"
  for _dl_a in "$@"; do
    _dl_o=""                                          # pass 1: \ -> \\
    while case $_dl_a in *\\*) true ;; *) false ;; esac; do
      _dl_o="$_dl_o${_dl_a%%\\*}\\\\"; _dl_a=${_dl_a#*\\}
    done
    _dl_a="$_dl_o$_dl_a"
    _dl_o=""                                          # pass 2: newline -> \n
    while case $_dl_a in *"$_DL_NL"*) true ;; *) false ;; esac; do
      _dl_o="$_dl_o${_dl_a%%"$_DL_NL"*}\\n"; _dl_a=${_dl_a#*"$_DL_NL"}
    done
    _dl_out="$_dl_out $_dl_o$_dl_a"
  done
  printf '%s\n' "$_dl_out" >>"$DORC_LOG"
}
_DL_NL='
'

-- mocks/apt-get --
#!/bin/sh
# INERT strawman mock (never a real mutator): logs its argv for the run-set, mutates nothing.
. "${0%/*}/.log"; _dorc_logged "$@"
exit 0

-- mocks/systemctl --
#!/bin/sh
# INERT strawman mock (never a real mutator): logs its argv for the run-set, mutates nothing.
. "${0%/*}/.log"; _dorc_logged "$@"
exit 0

-- mocks/ufw --
#!/bin/sh
# INERT strawman mock (never a real mutator): logs its argv for the run-set, mutates nothing.
. "${0%/*}/.log"; _dorc_logged "$@"
exit 0

-- expected.ran --
ran: apt-get install -y nginx
ran: systemctl enable nginx
ran: ufw allow 443/tcp

-- replay --
$ dorc --book=book.sh -o firewall.oracle.sh < probe-results.txt
#!/bin/sh
# dorc probe (read-only): checks per-SITE convergence, mutates nothing.
# When run, emits one results-record per site on stdout (the return channel):
#   site <leafid> effect=<holds|absent|cant-tell> rc=<n>
# effect is derived from the probe command's rc (0=holds, 1=absent, else cant-tell);
# rc is the raw PROBE-command status (opaque to Dorc -- the record is the out-of-band lane).

printf 'dorc-records/1 nonce=dorc attempt=1 host=localhost book=50b1679c38c81a2e515338fbba6e404ab6504ee085f90a3a5f0e0299ee4b43c4 sites=0 @@dorc@@\n'
# site:0 unresolvable-no-probe
# site:1 unresolvable-no-probe
# site:2 unresolvable-no-probe
printf 'dorc-records-end/1 nonce=dorc @@dorc@@\n'
#!/bin/sh
# dorc apply: the book, with already-converged/dead lines elided (value-preserving stand-in).

# whygallery-drifted-book-degraded-receipt (`28F:rul-drift-replay-d1`) — the 03:40 morning where
# the admin already EDITED the book before asking why. The committed `.whylog` below is the 02:00
# cron run's receipt; the book it recorded is not the book in this directory (its recorded digest
# is deliberately unreachable), so the replay is drifted and answers degraded rather than refusing.
# Every tool named here is an INERT mock; nothing mutates.
apt-get install -y nginx
systemctl enable nginx
ufw allow 443/tcp

