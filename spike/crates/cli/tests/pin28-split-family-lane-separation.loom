-- book.sh --
#!/bin/sh
# pin28-split-family-lane-separation (`28M` §8, COMMISSIONED beside the custody pin) — the W-B
# lane-separation pins (`verdict-lane-is-site-keyed`, `ship-seam-reads-the-lane-not-the-kind`)
# exercised as a STEADY-STATE configuration rather than as a regression guard.
#
# `28M` §8's `fnd-split-family-composes-unrefused` is what makes this a standing world: a family
# whose live members come from DIFFERENT units with no shadowed name triggers no contest and unions
# with zero ceremony. So `apt_get__predict` is one author's, `apt_get__is_converged` is another's,
# and the site below has a perfectly resolvable predict AND a reached verdict vouch.
#
# WHAT IT MEASURES, under `28Q` §4 `rul-verdict-primacy-at-the-ship-seat`: the VERDICT body ships and
# its rc is the `effect=holds` that licenses the elision, so the transcript below invokes
# `apt_get__is_converged` (`aptcheck`) and never `apt_get__predict` (`dpkg-query`). The elide is a
# MONOLOGUE — body, rc, and vouch are all author two's — which is what retired
# `28P:tc-split-family-elides-on-two-authors` at the license tier. Before the re-cut the verdict lane
# was reached only as a fallback, so author one's body measured under author two's permission.
#
# The CELL is still author one's declaration (`sm.dorc.Package:nginx@installed`, unchanged in the
# site comment): primacy moves the measuring body, never the cell, so nothing downstream loses an
# invalidation. That split — author two's judgment over author one's coordinate — is §4's
# acknowledged cross-author residue, and it is the sparing tier's, where the fence already stands.
#
# There is deliberately NO contest and no diagnostic: the two files declare DIFFERENT members of one
# family, so no name is shadowed and nothing is withheld. That silence is part of the pin — this is
# the composition the design permits, not the collision it refuses.
apt-get install -y nginx

-- pkgindex-predict.oracle.sh --
#!/usr/bin/env dorc-sh
# dorc-lang/v0.2
# AUTHOR ONE: the read-only model. Owns `predict` for this family and nothing else.
apt_get__predict() {
   while [ "${1#-}" != "$1" ]; do shift; done
   verb=$1; shift
   while [ "${1#-}" != "$1" ]; do shift; done
   pkg : sm.dorc.Package = "$1"
   if [ "${2-}" = "" ]; then
      case $verb in
         install) dpkg-query -W "$pkg" >/dev/null 2>&1 : sm.dorc.Package:"$pkg"@installed ;;
      esac
   fi
}

-- pkgindex-verdict.oracle.sh --
#!/usr/bin/env dorc-sh
# dorc-lang/v0.2
# AUTHOR TWO: the convergence judgment. Owns `is_converged` for the SAME family, in a different
# file, with no name in common with author one — so sh shadows nothing and Dorc refuses nothing.
# Its body is deliberately DISTINGUISHABLE from the predict's (`aptcheck`, not `dpkg-query`), so the
# transcript says which author's bytes shipped rather than leaving it to be argued.
apt_get__is_converged() {
   while [ "${1#-}" != "$1" ]; do shift; done
   verb=$1; shift
   while [ "${1#-}" != "$1" ]; do shift; done
   case $verb in
      install) aptcheck -q -- "$1" ;;
      *) return 2 ;;
   esac
}

-- probe-results.txt --
# The site is converged ⇒ with the vouch reached, it elides.
site 0 effect=holds rc=0

-- mocks/.log --
# newline-safe argv logger for the inert mock shims (slice-4). Sourced by each shim via
# `. "${0%/*}/.log"` (the shim's own dir); a DOTFILE so gate-5/gate-6's `ls`-derived shimset
# never lists it. Shims run under PATH=mocks-only ⇒ BUILTINS ONLY (no sed/awk).
_dorc_logged() {
  _dl_out="ran: ${0##*/}"
  for _dl_a in "$@"; do
    _dl_o=""                                          # pass 1: \ -> \\
    while case $_dl_a in *\\*) true ;; *) false ;; esac; do
      _dl_o="$_dl_o${_dl_a%%\\*}\\\\"; _dl_a=${_dl_a#*\\}
    done
    _dl_a="$_dl_o$_dl_a"
    _dl_o=""                                          # pass 2: newline -> \n
    while case $_dl_a in *"$_DL_NL"*) true ;; *) false ;; esac; do
      _dl_o="$_dl_o${_dl_a%%"$_DL_NL"*}\\n"; _dl_a=${_dl_a#*"$_DL_NL"}
    done
    _dl_out="$_dl_out $_dl_o$_dl_a"
  done
  printf '%s\n' "$_dl_out" >>"$DORC_LOG"
}
_DL_NL='
'

-- mocks/apt-get --
#!/bin/sh
# INERT strawman mock (never a real mutator): logs its argv for the run-set, mutates nothing.
. "${0%/*}/.log"; _dorc_logged "$@"
exit 0

-- mocks/aptcheck --
#!/bin/sh
# INERT probe shim — the VERDICT author's check, and the discriminator this case turns on: under
# verdict primacy this is the body the probe ships, so the transcript names it rather than the
# predict's tool.
. "${0%/*}/.log"; _dorc_logged "$@"
exit 0

-- mocks/dpkg-query --
#!/bin/sh
# INERT probe shim — the PREDICT author's check. Kept shimmed so its absence from the transcript is
# a decision rather than an rc 127: author one's model still declares the cell, it just no longer
# measures it.
. "${0%/*}/.log"; _dorc_logged "$@"
exit 0

