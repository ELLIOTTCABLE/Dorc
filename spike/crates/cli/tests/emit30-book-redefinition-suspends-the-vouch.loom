---
run: round-trip
fixpoint: executed
expect-diagnostic:
  - vouched-composition-not-present
---
-- book.sh --
#!/bin/sh
# emit30-book-redefinition-suspends-the-vouch (`28R:rul-mixed-custody-suspends-vouch`) — the ANCESTOR
# arm of the composite predicate, and the one with the sharpest hazard behind it.
#
# The admin redefines the helper the wombat oracle's verdict body depends on. Their definition is
# theirs: it is never rewritten, never copied, and runs exactly as written. What it costs is the
# ORACLE's license, and the reason is positional — at apply the guard preamble sits ABOVE this book,
# so from the line below onward `_wombat_dest` is the admin's body.
#
# What that would have been without the suspension is worth stating, because it is not a value
# question. At PROBE time the shipped check carries the oracle's own helper, so it measures honestly.
# At APPLY time the guard would invoke the same funcname against the ADMIN's body — unvouched code,
# possibly mutating, running inside a check that exists to decide whether to mutate. Probe and apply
# would be measuring two different compositions under one name. So the vouch does not attach at all:
# no elide, no guard, `wombat sync` runs.
#
# What to read in the transcript: `sites=0`, and an apply that is the book byte for byte.
_wombat_dest() {
   printf 'always converged\n'
}

wombat sync a.conf

-- wombat.oracle.sh --
# dorc-lang/v0.2
# The engineer's own composition: a verdict body plus the helper it was written against.
_wombat_dest() {
   wombat cmp -- "$1" "/etc/wombat/$1"
}

wombat__is_converged() {
   _wombat_dest "$2"
}

-- replay --
$ dorc --book=book.sh -o wombat.oracle.sh
#!/bin/sh
# dorc probe (read-only): checks per-SITE convergence, mutates nothing.
# When run, emits one results-record per site on stdout (the return channel):
#   site <leafid> effect=<holds|absent|cant-tell> rc=<n>
# effect is derived from the probe command's rc (0=holds, 1=absent, else cant-tell);
# rc is the raw PROBE-command status (opaque to Dorc -- the record is the out-of-band lane).

printf 'dorc-records/1 nonce=dorc attempt=1 host=localhost book=a382ebc2680a875448f562995a690eabe40e756336b5b7b07a3abe1f8c19a5db sites=0 @@dorc@@\n'
# site:0 unresolvable-no-probe
printf 'dorc-records-end/1 nonce=dorc @@dorc@@\n'
#!/bin/sh
# dorc apply: the book, with already-converged/dead lines elided (value-preserving stand-in).

