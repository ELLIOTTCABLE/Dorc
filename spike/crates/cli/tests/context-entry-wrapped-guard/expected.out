#!/bin/sh
# dorc probe (read-only): checks per-SITE convergence, mutates nothing.
# When run, emits one results-record per site on stdout (the return channel):
#   site <leafid> effect=<holds|absent|cant-tell> rc=<n>
# effect is derived from the probe command's rc (0=holds, 1=absent, else cant-tell);
# rc is the raw PROBE-command status (opaque to Dorc — the record is the out-of-band lane).

printf 'dorc-records/1 nonce=dorc attempt=1 host=localhost book=78e1f742219aeaee sites=1 @@dorc@@\n'
# site 1: dorc-auto:hork@converged
sudo__enter() {
   sudo -n "$@"
}
hork__is_converged() {
   :
   case "$1" in
   install) hork query "$2" ;;
   *) return 2 ;;
   esac
}
sudo__enter hork__is_converged 'install' 'frob'; _rc=$?; if [ "$_rc" -eq 0 ]; then _e=holds; elif [ "$_rc" -eq 1 ]; then _e=absent; else _e=cant-tell; fi; printf 'dorc site 1 effect=%s rc=%s @@dorc@@\n' "$_e" "$_rc"
# site:0 skip-unresolvable
printf 'dorc-records-end/1 nonce=dorc @@dorc@@\n'
#!/bin/sh
# dorc apply: the book, with already-converged/dead lines elided (value-preserving stand-in).

# dorc guard preamble: the vouching oracle's own verdict body, shipped strip-only
# (dialect annotations removed, nothing else changed -- rul-ternary-verdict: the
# authored bytes verbatim, no engine-synthesized sh).
sudo__enter() {
   sudo -n "$@"
}
hork__is_converged() {
   :
   case "$1" in
   install) hork query "$2" ;;
   *) return 2 ;;
   esac
}

#!/bin/sh
# 27C §5 in-context GUARD (27O rider): the unmodeled horkwall wall poisons the wrapped establish to
# EstablishWritten, so a reached wrapped vouch + converged probe mint the entry-composed guard shape
# `( sudo__enter hork__is_converged … ) || sudo hork install frob` (27N scaffold, exercised).
horkwall poke
( sudo__enter hork__is_converged install frob ) || sudo hork install frob   # dorc: guard [dorc-auto:hork converged-vouch; probe: holds]
