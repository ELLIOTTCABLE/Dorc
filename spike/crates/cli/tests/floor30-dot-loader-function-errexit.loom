#!/bin/sh
# dorc apply: the book, with already-converged/dead lines elided (value-preserving stand-in).

#!/bin/sh
# dot vs loader-function boundary under errexit (`30I:pin-one-file-root-bundle`)
set -e

(
   unset SM_CHILD_LOADED sm_child_value
   . ./child.sh; sm_dot_first=$?
   . ./child.sh; sm_dot_second=$?
   command -v sm_child_fn >/dev/null 2>&1 && sm_dot_function=yes
   printf 'dot first=%s second=%s value=%s function=%s\n' \
      "$sm_dot_first" "$sm_dot_second" "$sm_child_value" "$sm_dot_function"
) || printf 'dot boundary=%s\n' "$?"

sm_dorc_load_child() {
   if [ "${SM_CHILD_LOADED-}" = 1 ]; then return 0; fi
   SM_CHILD_LOADED=1
   sm_child_value=ready
   sm_child_fn() { :; }
   false
}

(
   unset SM_CHILD_LOADED sm_child_value
   sm_dorc_load_child; sm_fn_first=$?
   sm_dorc_load_child; sm_fn_second=$?
   command -v sm_child_fn >/dev/null 2>&1 && sm_fn_function=yes
   printf 'function first=%s second=%s value=%s function=%s\n' \
      "$sm_fn_first" "$sm_fn_second" "$sm_child_value" "$sm_fn_function"
) || printf 'function boundary=%s\n' "$?"
