#!/bin/sh
# dorc probe (read-only): checks per-SITE convergence, mutates nothing.
# When run, emits one results-record per site on stdout (the return channel):
#   site <leafid> effect=<holds|absent|cant-tell> rc=<n>
# effect is derived from the probe command's rc (0=holds, 1=absent, else cant-tell);
# rc is the raw PROBE-command status (opaque to Dorc -- the record is the out-of-band lane).

printf 'dorc-records/1 nonce=dorc attempt=1 host=localhost book=5999fb88ce739161e97ec01edc36db428d917761f3b2bb6739b75ca62974cdfc sites=0 @@dorc@@\n'
# site:0 unresolvable-no-probe
# site:1 unresolvable-no-probe
# site:2 unresolvable-no-probe
# site:3 unresolvable-no-probe
# site:4 unresolvable-no-probe
# site:5 unresolvable-no-probe
# site:6 unresolvable-no-probe
# site:7 unresolvable-no-probe
# site:8 unresolvable-no-probe
# site:9 unresolvable-no-probe
# site:10 unresolvable-no-probe
# site:12 unresolvable-no-probe
# site:14 unresolvable-no-probe
# site:15 unresolvable-no-probe
# site:16 unresolvable-no-probe
# site:17 unresolvable-no-probe
# site:18 unresolvable-no-probe
printf 'dorc-records-end/1 nonce=dorc @@dorc@@\n'
classify: note[cmdsub-operand-top]: the command word is an unquoted field-split
/ glob / tilde expansion, so Dorc cannot know its value until the command runs
on the host -- there is nothing to resolve and no read-only probe to check. Dorc
elides a command only when it can prove the command's effect is already in
place, so this one is left to run on every apply.
      [ book.sh:15:7
   15 |    if [ "${SM_CHILD_LOADED-}" = 1 ]; then return 0; fi
      |       ^

   = repair:  Give the operand a value Dorc can resolve statically -- a literal,
              or a variable assigned from one -- so Dorc can probe it and elide
              the command once it has converged. If the value must stay dynamic,
              load an oracle that vouches for this command's convergence, and
              Dorc will guard the command instead of running it every time.
