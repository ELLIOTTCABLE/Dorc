# dot vs loader-function boundary under errexit (`30I:pin-one-file-root-bundle`)
set -e

(
   unset SM_CHILD_LOADED sm_child_value
   . ./child.sh; sm_dot_first=$?
   . ./child.sh; sm_dot_second=$?
   command -v sm_child_fn >/dev/null 2>&1 && sm_dot_function=yes
