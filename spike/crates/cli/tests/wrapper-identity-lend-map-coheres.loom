#!/bin/sh
# dorc probe (read-only): checks per-SITE convergence, mutates nothing.
# When run, emits one results-record per site on stdout (the return channel):
#   site <leafid> effect=<holds|absent|cant-tell> rc=<n>
# effect is derived from the probe command's rc (0=holds, 1=absent, else cant-tell);
# rc is the raw PROBE-command status (opaque to Dorc -- the record is the out-of-band lane).

printf 'dorc-records/1 nonce=dorc attempt=1 host=localhost book=83b0f6ad97d852d38d152523ecd364de9a8afcb789c8602da462e19f25aafa63 sites=0 @@dorc@@\n'
# site:0 unresolvable-no-probe
printf 'dorc-records-end/1 nonce=dorc @@dorc@@\n'
probe: note[site-unresolvable]: sm 1 site run unprobed (no read-only check could
be shipped): `nice hork tune` -- run `dorc why` for the per-site detail (the
apply runs each anyway, to stay safe)
      [ book.sh:6:1
   6 | nice hork tune
     | \____________/

   = help:  sm site runs `nice hork tune`
hint: 'nice' (line 6) is unmodeled: it is the first wall -- an oracle vouching its convergence would elide it when converged
dorc: run `dorc why` for the per-site cause-chains, or `dorc why book.sh:N` to query a source line
#!/bin/sh
# dorc apply: the book, with already-converged/dead lines elided (value-preserving stand-in).

#!/bin/sh
# wrapper-identity-lend-map-coheres (273 §8 identity wrappers): a `nice` oracle — bare-"$@" predict
# (peel-transparent, claims nothing on env) + an all-full-lend lend_map (every dimension the same
# world). It lifts clean and coheres (the identity wrapper's inner sits in HostDefault). The
# wrapped site still walls (peel not yet consumed) — zero new trust.
nice hork tune
dorc: plan-summary sites=1 elide=0 omit=0 guard=0 run=1 may-alias=0
dorc: decision-digest 8c3ec88dcf0f7ff66f1865f71e0744d75c72473fcf0c7a223b9883497973a532
