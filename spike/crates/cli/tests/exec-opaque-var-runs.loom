-- package.oracle.sh --
#!/usr/bin/env dorc-sh
# dorc-lang/v0.2
# minimal package oracle (apt/dpkg), lifted statically by dorc.
apt_get__predict() {
   while [ "${1#-}" != "$1" ]; do shift; done
   verb=$1; shift
   while [ "${1#-}" != "$1" ]; do shift; done
   pkg : sm.dorc.Package = "$1"
   if [ "${2-}" = "" ]; then
      case $verb in
         install) dpkg-query -W "$pkg" >/dev/null 2>&1 : sm.dorc.Package:"$pkg"@installed ;;
         purge) dpkg-query -W "$pkg" >/dev/null 2>&1 :! sm.dorc.Package:"$pkg"@installed ;;
      esac
   fi
}

-- probe-results.txt --
# probe-results: site-keyed records (task-D1 WIRE). Grammar:
#   site <leafid> effect=<holds|absent|cant-tell>
# (the records the rendered probe emits; effect from the probe command rc).
# (site-unresolvable: package:nginx#installed — no probe invocation, runs)

-- mocks/.log --
# newline-safe argv logger for the inert mock shims (slice-4). Sourced by each shim via
# `. "${0%/*}/.log"` (the shim's own dir); a DOTFILE so gate-5/gate-6's `ls`-derived shimset
# never lists it. Replaces the old inline `printf 'ran: %s %s\n' "${0##*/}" "$*"` — an arg with
# an embedded NEWLINE would split the `ran:` line and silently break every line-based compare
# (exec_check, gate-5, gate-6). Shims run under PATH=mocks-only ⇒ BUILTINS ONLY (no sed/awk).
#
# GRAMMAR (what expected.ran goldens carry): one `ran: <name> <arg>…` line per invocation; each
# arg is encoded — a literal backslash as `\\`, an embedded newline as the two chars `\n`. The
# two passes run in THIS order (backslash first) so a newline's encoded `\n` backslash is not
# re-doubled. A newline-free, backslash-free argv encodes to itself ⇒ byte-identical to the old
# format (per-arg space-join == the old `"$*"` join) ⇒ zero golden churn.
_dorc_logged() {
  _dl_out="ran: ${0##*/}"
  for _dl_a in "$@"; do
    _dl_o=""                                          # pass 1: \ -> \\
    while case $_dl_a in *\\*) true ;; *) false ;; esac; do
      _dl_o="$_dl_o${_dl_a%%\\*}\\\\"; _dl_a=${_dl_a#*\\}
    done
    _dl_a="$_dl_o$_dl_a"
    _dl_o=""                                          # pass 2: newline -> \n
    while case $_dl_a in *"$_DL_NL"*) true ;; *) false ;; esac; do
      _dl_o="$_dl_o${_dl_a%%"$_DL_NL"*}\\n"; _dl_a=${_dl_a#*"$_DL_NL"}
    done
    _dl_out="$_dl_out $_dl_o$_dl_a"
  done
  printf '%s\n' "$_dl_out" >>"$DORC_LOG"
}
_DL_NL='
'

-- mocks/apt-get --
#!/bin/sh
# INERT mock (ap-2 exec harness): logs that it ran, mutates NOTHING, exits 0. The
# book calls the real name; under the harness's PATH=mocks-only this shim is the only
# thing that runs, so executing a rendered apply is provably safe. `${0##*/}` (not
# `basename`) reads the invoked name with no external command (PATH is mocks-only).
. "${0%/*}/.log"; _dorc_logged "$@"
exit 0

-- mocks/cat --
#!/bin/sh
# INERT mock (ap-2 exec harness): logs that it ran, mutates NOTHING. Emits a fixed
# package name on stdout so the book's `PKG=$(cat /etc/pkg)` binds a RUNTIME value —
# statically the value-plane sees a command-substitution RHS ⇒ ⊤ (this case's point).
. "${0%/*}/.log"; _dorc_logged "$@"
printf 'nginx\n'
exit 0

-- expected.ran --
ran: cat /etc/pkg
ran: apt-get install -y nginx

-- replay --
$ dorc --book=book.sh --pre-source package.oracle.sh --results - < probe-results.txt
#!/bin/sh
# dorc probe (read-only): checks per-SITE convergence, mutates nothing.
# When run, emits one results-record per site on stdout (the return channel):
#   site <leafid> effect=<holds|absent|cant-tell> rc=<n>
# effect is derived from the probe command's rc (0=holds, 1=absent, else cant-tell);
# rc is the raw PROBE-command status (opaque to Dorc -- the record is the out-of-band lane).

printf 'dorc-records/1 nonce=dorc attempt=1 host=localhost book=1144cb843e3356e9e9eb8eaf471bbe8a2288359fe2222bea1348a2b75b705ef0 sites=0 @@dorc@@\n'
# site:0 unresolvable-no-probe
# site:1 unresolvable-no-probe
printf 'dorc-records-end/1 nonce=dorc @@dorc@@\n'
classify: note[cmdsub-operand-top]: operand 3 is a runtime-dynamic variable
value (unset or branch-conflicted), so Dorc cannot know its value until the
command runs on the host -- there is nothing to resolve and no read-only probe
to check. Dorc elides a command only when it can prove the command's effect is
already in place, so this one is left to run on every apply.
      [ book.sh:3:20
   3 | apt-get install -y "$PKG"
     |                    \____/

   = repair:  Give the operand a value Dorc can resolve statically -- a literal,
              or a variable assigned from one -- so Dorc can probe it and elide
              the command once it has converged. If the value must stay dynamic,
              load an oracle that vouches for this command's convergence, and
              Dorc will guard the command instead of running it every time.
classify: note[cmdsub-inner-nonleaf]: Dorc cannot elide `cat /etc/pkg` on its
own: it runs inside a `$(...)` substitution as part of evaluating its enclosing
line, so it runs whenever that line does.
      [ book.sh:1:1
   1 | # exec-opaque-var-runs (round-20, replaces the old exec-opaque-var after task-W): the
     | \__________/
probe: note[site-unresolvable]: sm 1 site run unprobed (no read-only check could
be shipped): `apt-get install -y "$PKG"` -- run `dorc why` for the per-site
detail (the apply runs each anyway, to stay safe)
      [ book.sh:3:1
   3 | apt-get install -y "$PKG"
     | \_______________________/

   = help:  sm site runs `apt-get install -y "$PKG"`
why: ran because operand 3 is a command-substitution `$(...)` or runtime-dynamic value -- its value couldn't be resolved (first seen at 3:1 `apt-get install -y "$PKG"`); so dorc runs it, to stay safe (when unsure, run). to skip it, make the operand a literal Dorc can resolve+probe [resolve-dynamism]
hint: 'apt-get' (line 3) is unmodeled: it is the first wall -- an oracle vouching its convergence would elide it when converged
dorc: run `dorc why` for the per-site cause-chains, or `dorc why book.sh:N` to query a source line
#!/bin/sh
# dorc apply: the book, with already-converged/dead lines elided (value-preserving stand-in).

# exec-opaque-var-runs (round-20, replaces the old exec-opaque-var after task-W): the
PKG=$(cat /etc/pkg)
apt-get install -y "$PKG"
