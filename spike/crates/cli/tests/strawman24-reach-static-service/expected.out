#!/bin/sh
# dorc probe (read-only): checks per-SITE convergence, mutates nothing.
# When run, emits one results-record per site on stdout (the return channel):
#   site <leafid> effect=<holds|absent|cant-tell> rc=<n>
# effect is derived from the probe command's rc (0=holds, 1=absent, else cant-tell);
# rc is the raw PROBE-command status (opaque to Dorc — the record is the out-of-band lane).

printf 'dorc-records/1 nonce=dorc attempt=1 host=localhost book=39dad881107a64e4ee5f578ac8e5d9a382884530eba53f7558615d1f358b6020 sites=2 @@dorc@@\n'
# site 0: sm.dorc.Package:nginx@tuned
hork__predict() {
   verb=$1; shift
   pkg="$1"
   case $verb in tune) dpkg-query -W "$pkg" >/dev/null 2>&1 ;; esac
}
hork__predict 'tune' 'nginx'; _rc=$?; if [ "$_rc" -eq 0 ]; then _e=holds; elif [ "$_rc" -eq 1 ]; then _e=absent; else _e=cant-tell; fi; printf 'dorc site 0 effect=%s rc=%s @@dorc@@\n' "$_e" "$_rc"
# site 1: sm.dorc.Service:nginx@enabled
enablesvc__predict() {
   svc="$1"
   systemctl is-enabled -- "$1" >/dev/null 2>&1
}
enablesvc__predict 'nginx'; _rc=$?; if [ "$_rc" -eq 0 ]; then _e=holds; elif [ "$_rc" -eq 1 ]; then _e=absent; else _e=cant-tell; fi; printf 'dorc site 1 effect=%s rc=%s @@dorc@@\n' "$_e" "$_rc"
printf 'dorc-records-end/1 nonce=dorc @@dorc@@\n'
#!/bin/sh
# dorc apply: the book, with already-converged/dead lines elided (value-preserving stand-in).

hork tune nginx
enablesvc nginx
