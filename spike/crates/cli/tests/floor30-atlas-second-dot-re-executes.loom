---
run: round-trip
fixpoint: executed
---
-- book.sh --
#!/bin/sh
# floor30-atlas-second-dot-re-executes — QUESTION (added mechanic): does a second `.` of the same
# file RE-RUN its top-level commands, or is a load remembered?
#
# Why the inclusion design needs it, and why it is not on the conductor's list:
# `28Q:pin-closure-membership-and-diamond` permits diamond dedup keyed to resolution identity, and
# `floor30-diamond-source-binds-once` measures that both entries' NAMES survive a shared dependency.
# Neither asks whether the shared file's top-level SIDE EFFECTS happen once or twice — and dedup is
# only sound for a file whose re-execution is idempotent. A counter is the smallest thing that can
# tell those apart, and an include guard is exactly what an author writes when it cannot.
#
# The guarded half is measured beside it, because that is the shape `rul-include-guards-are-load-semantics`
# calls mandatory language surface: if the shells really do re-run, the guard is the whole reason a
# second `.` is survivable.
counter=0
. ./bumper.sh
. ./bumper.sh
printf 'unguarded: counter=[%s]\n' "$counter"
guarded_counter=0
. ./guarded.sh
. ./guarded.sh
printf 'guarded: counter=[%s] sentinel=[%s]\n' "$guarded_counter" "${guarded_loaded-unset}"
printf 'book-tail\n'

-- bumper.sh --
counter=$((counter + 1))
printf 'bumper-ran counter=[%s]\n' "$counter"

-- guarded.sh --
if [ "${guarded_loaded-}" = 'v1' ]; then
   printf 'guarded-file: reused\n'
   return 0
fi
guarded_loaded=v1
guarded_counter=$((guarded_counter + 1))
printf 'guarded-file: loaded counter=[%s]\n' "$guarded_counter"

-- expected.emitted --
bumper-ran counter=[1]
bumper-ran counter=[2]
unguarded: counter=[2]
guarded-file: loaded counter=[1]
guarded-file: reused
guarded: counter=[1] sentinel=[v1]
book-tail

-- expected.ran --

-- replay --
$ dorc --book=book.sh --results -
#!/bin/sh
# dorc probe (read-only): checks per-SITE convergence, mutates nothing.
# When run, emits one results-record per site on stdout (the return channel):
#   site <leafid> effect=<holds|absent|cant-tell> rc=<n>
# effect is derived from the probe command's rc (0=holds, 1=absent, else cant-tell);
# rc is the raw PROBE-command status (opaque to Dorc -- the record is the out-of-band lane).

printf 'dorc-records/1 nonce=dorc attempt=1 host=localhost book=20c15284f079912fefe494c4dcaa819be1d70148d5275620b36b122db0df0c1b sites=0 @@dorc@@\n'
# site:0 unresolvable-no-probe
# site:1 unresolvable-no-probe
# site:2 unresolvable-no-probe
# site:3 unresolvable-no-probe
# site:4 unresolvable-no-probe
# site:5 unresolvable-no-probe
# site:6 unresolvable-no-probe
# site:7 unresolvable-no-probe
# site:8 unresolvable-no-probe
printf 'dorc-records-end/1 nonce=dorc @@dorc@@\n'
#!/bin/sh
# dorc apply: the book, with already-converged/dead lines elided (value-preserving stand-in).

