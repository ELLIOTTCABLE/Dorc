-- book.sh --
#!/bin/sh
# dorc-lang/v0.2
# wrap30-regional-wrapper-decline-walls (`308:rul-wrapper-lane-joins-the-conversion`) — an
# engineer's explicit in-frame decline licenses nothing it should not.
#
# A subshell definition is `28K` §1's sanctioned regional-preference idiom: it shadows nothing
# permanently, dies at the `)`, and draws no contest. Inside these parens the live `sudo__predict`
# declines every argv (`return 2`), which is ordinary control flow and the author's whole vocabulary
# for "do not model this here". The wrapper lane used to consult one ambient first-loaded model for
# every site, so the decline was bypassed and the site peeled, entered, and could elide anyway.
#
# The peel test now runs on the definition the frame NAMES, so a declining body makes `sudo` no
# wrapper at this site and the line runs on its own bytes.
#
# ONE site, on pin28-wrapped-vouch-answers-at-a-live-site's own precedent: a trailing control site
# after the `)` would be walled by THIS site running, so it would guard rather than elide for a
# reason that has nothing to do with what is being pinned. That case IS the control — same wrapper
# oracle, same inner verdict, no regional decline, and it enters and elides.
(
sudo__predict() {
   return 2
}
sudo hork install wombat
)

-- hork.oracle.sh --
# dorc-lang/v0.2
hork__is_converged() {
   : safe-across user
   hork query -- "$2"
}

-- sudo.oracle.sh --
# dorc-lang/v0.2
# The coherent sudo wrapper of pin28-wrapped-vouch-answers-at-a-live-site, byte-for-byte.
sudo__predict() {
   while [ "${1#-}" != "$1" ]; do case "$1" in -u) shift 2 ;; *) shift ;; esac; done
   env -i HOME=/root "$@"
}
sudo__lend_map() {
   target=root
   while [ "${1#-}" != "$1" ]; do case "$1" in -u) target="$2"; shift 2 ;; *) shift ;; esac; done
   printf '%s\n' "$target" : lends user
   : lends fs-view
   : lends netns
   "$@"
}
sudo__enter() {
   sudo -n "$@"
}

-- probe-results.txt --
# EMPTY, and the emptiness is the assertion: the frame-live body declines, so `sudo` is no wrapper
# here, no check ships, and the probe produces no record. The day this site ships one, gate-1 goes
# red against this file.

-- mocks/.log --
# newline-safe argv logger for the inert mock shims (slice-4). Sourced by each shim via
# `. "${0%/*}/.log"` (the shim's own dir); a DOTFILE so gate-5/gate-6's `ls`-derived shimset
# never lists it. Shims run under PATH=mocks-only ⇒ BUILTINS ONLY (no sed/awk).
_dorc_logged() {
  _dl_out="ran: ${0##*/}"
  for _dl_a in "$@"; do
    _dl_o=""                                          # pass 1: \ -> \\
    while case $_dl_a in *\\*) true ;; *) false ;; esac; do
      _dl_o="$_dl_o${_dl_a%%\\*}\\\\"; _dl_a=${_dl_a#*\\}
    done
    _dl_a="$_dl_o$_dl_a"
    _dl_o=""                                          # pass 2: newline -> \n
    while case $_dl_a in *"$_DL_NL"*) true ;; *) false ;; esac; do
      _dl_o="$_dl_o${_dl_a%%"$_DL_NL"*}\\n"; _dl_a=${_dl_a#*"$_DL_NL"}
    done
    _dl_out="$_dl_out $_dl_o$_dl_a"
  done
  printf '%s\n' "$_dl_out" >>"$DORC_LOG"
}
_DL_NL='
'

-- mocks/hork --
#!/bin/sh
# INERT strawman mock (never a real mutator): logs its argv for the run-set, mutates nothing.
. "${0%/*}/.log"; _dorc_logged "$@"
exit 0

-- mocks/sudo --
#!/bin/sh
# INERT mock: logs its argv and exits 0; nothing is exec'd.
. "${0%/*}/.log"; _dorc_logged "$@"
exit 0

-- expected.ran --
ran: sudo hork install wombat

