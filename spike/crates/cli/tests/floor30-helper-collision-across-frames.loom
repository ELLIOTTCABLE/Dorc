-- book.sh --
#!/bin/sh
# floor30-helper-collision-across-frames — the definition-fixtures battery's helper shape
# (`28Q` §8 stage-i: ground truth minted before the conversion that will consume it).
#
# `28K` §4 one-helper-index-two-lanes ships a role body together with the helpers it reaches, which
# presumes a helper NAME resolves to one body. It does not: one name holds different live bodies in
# different frames, and the collision is reached INDIRECTLY — the role body's own text never
# changes, so nothing at the call site shows which helper it will run. That is precisely the shape a
# helper index keyed by name alone answers wrongly, and silently.
#
# Three measurements: the role reaching the base helper, the same role inside a region that
# re-sourced a different helper, and the base helper again once the region closed. Engine agreement
# over these cells activates at the definition-factoring conversion; the answers committed here are
# the shells' own.
. ./role.sh
. ./helper-base.sh
hork__is_converged
( . ./helper-variant.sh; hork__is_converged )
hork__is_converged

-- role.sh --
hork__is_converged() { _hork_say ;}

-- helper-base.sh --
_hork_say() { printf 'base\n' ;}

-- helper-variant.sh --
_hork_say() { printf 'variant\n' ;}

-- expected.emitted --
base
variant
base

-- expected.ran --

-- replay --
$ dorc --book=book.sh --results -
#!/bin/sh
# dorc probe (read-only): checks per-SITE convergence, mutates nothing.
# When run, emits one results-record per site on stdout (the return channel):
#   site <leafid> effect=<holds|absent|cant-tell> rc=<n>
# effect is derived from the probe command's rc (0=holds, 1=absent, else cant-tell);
# rc is the raw PROBE-command status (opaque to Dorc -- the record is the out-of-band lane).

printf 'dorc-records/1 nonce=dorc attempt=1 host=localhost book=10e7776a4e87c2babaaa80683a909b787bb350eb91761c1d48d6821fdd49f6ea sites=0 @@dorc@@\n'
# site:0 unresolvable-no-probe
# site:1 unresolvable-no-probe
# site:2 unresolvable-no-probe
# site:3 unresolvable-no-probe
# site:4 unresolvable-no-probe
# site:5 unresolvable-no-probe
printf 'dorc-records-end/1 nonce=dorc @@dorc@@\n'
#!/bin/sh
# dorc apply: the book, with already-converged/dead lines elided (value-preserving stand-in).

