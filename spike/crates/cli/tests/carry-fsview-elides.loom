-- book.sh --
#!/bin/sh
# 27C §4(a) pure-predicate carry (27O): chroot shifts fs-view; KernelParam is invariant:fs-view and
# the verdict is read-set-closed, so the ambient measurement carries the wrapped check UNFLAGGED.
chroot /mnt kp ip_forward 1

-- chroot.oracle.sh --
# dorc-lang/v0.2
# chroot: fs-view wrapper, NO __enter form ⇒ entry degrades to the carry fallback (27C §4(a)).
chroot__predict() {
   shift
   "$@"
}
chroot__lend_map() {
   printf '%s\n' "$1"   : lends fs-view
   : lends user
   : lends netns
   shift
   "$@"
}

-- kp.oracle.sh --
# dorc-lang/v0.2
# kp verdict reads ONLY the marked KernelParam cell + argv (read-set-closed, 27C §4(a)-(B)).
kp__is_converged() {
   kp check "$1" "$2"   : sm.dorc.KernelParam:"$1"
}
sm_dorc_KernelParam__state_stored_only_in() {
   printf 'kernel-sysctls\n'   : stored-in kernel
   : undivided-by-transit-across fs-view
}

