-- book.sh --
#!/bin/sh
# emit30-assigned-load-is-not-absorbable (`30Pc:bug-assignment-bearing-dot-is-inlineable`) — the
# whole-product half of the assignment repair: a `.` carrying a LEADING ASSIGNMENT is outside
# `floor30-inline-dot-boundary`'s measured shape, so the single stream is unavailable and `auto`
# falls back and SAYS SO rather than substituting bundle bytes for the whole command node.
#
# CFG SHAPE: one top-level `Simple` whose `assigns` is non-empty and whose word 1 is the load
# operand. `ImportEdit::Inline` replaces the COMMAND node, and `MODE=prod` is part of that node —
# so an inlining engine drops it and the absorbed top level reads an environment the authored `.`
# would never have had. What this case observes is the apply block still carrying `MODE=prod`
# ahead of an UNREWRITTEN `.`: with the gate removed, the assignment disappears from these bytes
# and the bundle's own text stands in its place.
#
# NO `mocks/`, for the reason `emit30-multipart-publishes-its-dependency` records: `.` is a
# special builtin, so a non-interactive shell that cannot find what it sources EXITS, and the exec
# rail's cwd is an empty throwaway sandbox.
#
# `hork` is unmodeled and walls, so the site below it guards rather than elides — which puts a
# guard on the apply surface and keeps the run non-vacuous. Its BODY is NOT in a preamble: this
# form carries no dependency at all, so no position exists for the engine to stand the package's
# bytes at, and the guard resolves through the book's own `.` exactly as its mutation does
# (`30Qb:rul-a-loaded-definitions-placement-is-its-load-position`, the residual).
MODE=prod . ./wombat.dorc.sh
hork provision
wombat sync a.conf

-- wombat.dorc.sh --
# dorc-lang/v0.2
# The contracted package the book sources under an assignment. Its bytes are a bundle candidate
# like any other; what the assignment costs is the FORM, not the bundling.
wombat__is_converged() {
   case "${1-}" in
   sync) wombat status --conf -- "${2-}" : sm.dorc.Conf:"$2"@synced ;;
   *) return 2 ;;
   esac
}

-- probe-results.txt --
# The one measured site: the vouched `wombat sync`. It sits PAST `hork`'s wall, so it GUARDS
# rather than elides, which is what puts the vouching body in the artifact's preamble.
site 2 effect=holds

-- replay --
$ dorc --book=book.sh --results - < probe-results.txt
#!/bin/sh
# dorc probe (read-only): checks per-SITE convergence, mutates nothing.
# When run, emits one results-record per site on stdout (the return channel):
#   site <leafid> effect=<holds|absent|cant-tell> rc=<n>
# effect is derived from the probe command's rc (0=holds, 1=absent, else cant-tell);
# rc is the raw PROBE-command status (opaque to Dorc -- the record is the out-of-band lane).

printf 'dorc-records/1 nonce=dorc attempt=1 host=localhost book=ba2a27643560420bcd9ce87c48428b6cf50992d67b56a2eda09b190188831ae7 sites=1 @@dorc@@\n'
# site 2: dorc-auto:wombat@converged
wombat__is_converged() {
   case "${1-}" in
   sync) wombat status --conf -- "${2-}" ;;
   *) return 2 ;;
   esac
}
wombat__is_converged 'sync' 'a.conf'; _rc=$?; if [ "$_rc" -eq 0 ]; then _e=holds; elif [ "$_rc" -eq 1 ]; then _e=absent; else _e=cant-tell; fi; printf 'dorc site 2 effect=%s rc=%s @@dorc@@\n' "$_e" "$_rc"
# site:0 unresolvable-no-probe
# site:1 unresolvable-no-probe
printf 'dorc-records-end/1 nonce=dorc @@dorc@@\n'
probe: note[site-unresolvable]: sm 1 site run unprobed (no read-only check could
be shipped): `hork provision` -- run `dorc why` for the per-site detail (the
apply runs each anyway, to stay safe)
      [ book.sh:24:1
   24 | hork provision
      | \____________/

   = help:  sm site runs `hork provision`
why: site 2 guard [dorc-auto:wombat] -- licensed by the dorc-auto:wombat oracle's vouch (at wombat.dorc.sh:6) that it is already satisfied; the original bytes survive and the check re-runs live at apply (to stay safe)
hint: 'hork' (line 24) is unmodeled: it is the first wall -- an oracle vouching its convergence would elide it when converged, and un-wall 1 downstream site
dorc: run `dorc why` for the per-site cause-chains, or `dorc why book.sh:N` to query a source line
#!/bin/sh
# dorc apply: the book, with already-converged/dead lines elided (value-preserving stand-in).

#!/bin/sh
# emit30-assigned-load-is-not-absorbable (`30Pc:bug-assignment-bearing-dot-is-inlineable`) — the
# whole-product half of the assignment repair: a `.` carrying a LEADING ASSIGNMENT is outside
# `floor30-inline-dot-boundary`'s measured shape, so the single stream is unavailable and `auto`
# falls back and SAYS SO rather than substituting bundle bytes for the whole command node.
#
# CFG SHAPE: one top-level `Simple` whose `assigns` is non-empty and whose word 1 is the load
# operand. `ImportEdit::Inline` replaces the COMMAND node, and `MODE=prod` is part of that node —
# so an inlining engine drops it and the absorbed top level reads an environment the authored `.`
# would never have had. What this case observes is the apply block still carrying `MODE=prod`
# ahead of an UNREWRITTEN `.`: with the gate removed, the assignment disappears from these bytes
# and the bundle's own text stands in its place.
#
# NO `mocks/`, for the reason `emit30-multipart-publishes-its-dependency` records: `.` is a
# special builtin, so a non-interactive shell that cannot find what it sources EXITS, and the exec
# rail's cwd is an empty throwaway sandbox.
#
# `hork` is unmodeled and walls, so the site below it guards rather than elides — which puts a
