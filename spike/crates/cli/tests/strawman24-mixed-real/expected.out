#!/bin/sh
# dorc probe (read-only): checks per-SITE convergence, mutates nothing.
# When run, emits one results-record per site on stdout (the return channel):
#   site <leafid> effect=<holds|absent|cant-tell> rc=<n>
# effect is derived from the probe command's rc (0=holds, 1=absent, else cant-tell);
# rc is the raw PROBE-command status (opaque to Dorc -- the record is the out-of-band lane).

printf 'dorc-records/1 nonce=dorc attempt=1 host=localhost book=eebc1ebfc971f4d3f6235568253b36ca946636db7edef7538ff5356fb3ca0f61 sites=5 @@dorc@@\n'
# site 0: sm.dorc.PkgState:nginx@installed
dpkg__predict() {
   case $1 in -s) shift ;; esac
   pkg="$1"
   dpkg -s -- "$pkg" >/dev/null 2>&1
}
dpkg__predict '-s' 'nginx'; _rc=$?; if [ "$_rc" -eq 0 ]; then _e=holds; elif [ "$_rc" -eq 1 ]; then _e=absent; else _e=cant-tell; fi; printf 'dorc site 0 effect=%s rc=%s @@dorc@@\n' "$_e" "$_rc"
# site 1: sm.dorc.Package:nginx@installed
apt_get__predict() {
   while [ "${1#-}" != "$1" ]; do shift; done
   verb=$1; shift
   while [ "${1#-}" != "$1" ]; do shift; done
   pkg="$1"
   if [ "${2-}" = "" ]; then
      case $verb in
         install) dpkg-query -W "$pkg" >/dev/null 2>&1 ;;
         purge) dpkg-query -W "$pkg" >/dev/null 2>&1 ;;
      esac
   fi
}
apt_get__predict 'install' '-y' 'nginx'; _rc=$?; if [ "$_rc" -eq 0 ]; then _e=holds; elif [ "$_rc" -eq 1 ]; then _e=absent; else _e=cant-tell; fi; printf 'dorc site 1 effect=%s rc=%s @@dorc@@\n' "$_e" "$_rc"
# site 2: sm.dorc.Package:curl@installed
apt_get__predict 'install' '-y' 'curl'; _rc=$?; if [ "$_rc" -eq 0 ]; then _e=holds; elif [ "$_rc" -eq 1 ]; then _e=absent; else _e=cant-tell; fi; printf 'dorc site 2 effect=%s rc=%s @@dorc@@\n' "$_e" "$_rc"
# site 3: sm.dorc.Package:oldpkg@installed
apt_get__predict 'install' '-y' 'oldpkg'; _rc=$?; if [ "$_rc" -eq 0 ]; then _e=holds; elif [ "$_rc" -eq 1 ]; then _e=absent; else _e=cant-tell; fi; printf 'dorc site 3 effect=%s rc=%s @@dorc@@\n' "$_e" "$_rc"
# site 5: sm.dorc.Package:vim@installed
apt_get__predict 'install' '-y' 'vim'; _rc=$?; if [ "$_rc" -eq 0 ]; then _e=holds; elif [ "$_rc" -eq 1 ]; then _e=absent; else _e=cant-tell; fi; printf 'dorc site 5 effect=%s rc=%s @@dorc@@\n' "$_e" "$_rc"
# site:4 unresolvable-no-probe
printf 'dorc-records-end/1 nonce=dorc @@dorc@@\n'
#!/bin/sh
# dorc apply: the book, with already-converged/dead lines elided (value-preserving stand-in).

# strawman24-mixed-real (plans/240 Stage-1 — the "looks like a real book" composite; the family's
true || :   # dorc: elided [dpkg -s nginx >/dev/null 2>&1; apt-get install -y nginx] (already converged / dead branch)
# apt-get install -y curl   # dorc: elided (already converged / dead branch)
apt-get install -y oldpkg
hork wombat
apt-get install -y vim
