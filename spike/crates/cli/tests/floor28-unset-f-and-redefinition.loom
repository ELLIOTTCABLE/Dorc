-- book.sh --
#!/bin/sh
# floor28-unset-f-and-redefinition — the differential battery's `unset -f` shape (`28K` §10 bitem8).
#
# `unset -f` is the one construct `28K` §1 rul-silent-shadowing-refuses BLESSES with communicative
# semantics: written textually between two definitions it spells the intent that makes an override
# licit. `28K` §1's one-exception check-in argues the blessing is safe to layer precisely because
# its runtime meaning is modeled faithfully — which is a claim about shells, so it is measured.
#
# Three measurements, each isolated in its own subshell:
#   1. removal really removes — a call after `unset -f` finds no function;
#   2. a redefinition after the unset takes effect from that point;
#   3. `unset -f` of a name that was never defined is not an error (the idiom is written
#      unconditionally in blessing position, so a shell that objected would make it unusable).
( . ./defs-a.sh; unset -f hork__is_converged; hork__is_converged 2>/dev/null || printf 'gone\n' )
( . ./defs-a.sh; unset -f hork__is_converged; . ./defs-b.sh; hork__is_converged )
( unset -f hork__is_converged && printf 'unset-of-absent-is-fine\n' )

-- defs-a.sh --
hork__is_converged() { printf 'a\n' ;}

-- defs-b.sh --
hork__is_converged() { printf 'b\n' ;}

-- expected.emitted --
gone
b
unset-of-absent-is-fine

-- expected.ran --

-- replay --
$ dorc --book=book.sh
#!/bin/sh
# dorc probe (read-only): checks per-SITE convergence, mutates nothing.
# When run, emits one results-record per site on stdout (the return channel):
#   site <leafid> effect=<holds|absent|cant-tell> rc=<n>
# effect is derived from the probe command's rc (0=holds, 1=absent, else cant-tell);
# rc is the raw PROBE-command status (opaque to Dorc -- the record is the out-of-band lane).

printf 'dorc-records/1 nonce=dorc attempt=1 host=localhost book=5ebcecd725e0abc397e9bff70a1694b50e7e407e2d2ea3799a9203c063ed186d sites=0 @@dorc@@\n'
# site:0 unresolvable-no-probe
# site:1 unresolvable-no-probe
# site:2 unresolvable-no-probe
# site:3 unresolvable-no-probe
# site:4 unresolvable-no-probe
# site:5 unresolvable-no-probe
# site:6 unresolvable-no-probe
# site:7 unresolvable-no-probe
# site:8 unresolvable-no-probe
# site:9 unresolvable-no-probe
printf 'dorc-records-end/1 nonce=dorc @@dorc@@\n'
#!/bin/sh
# dorc apply: the book, with already-converged/dead lines elided (value-preserving stand-in).

