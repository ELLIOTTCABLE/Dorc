-- book.sh --
#!/bin/sh
# pin28-helper-package-entrypoints-discarded (`28M` §7/§8, the COMMISSIONED package shape) — half
# TWO of two, and the half that decides whether the packaging is worth anything.
#
# Half one proved the package's own entrypoints lift with their cross-file helper closure intact.
# This one proves the OTHER direction the human asked for: that an admin can discard or swap the
# entrypoints file and keep the helpers' function. If that fails, the split is decoration — the
# thin file is only worth being thin if replacing it is cheap.
#
# The spelling here is the bluntest of the three the design offers (`unset -f` per member, not
# sourcing it, or supplying your own): the entrypoints file is simply NOT LOADED. Only
# `wombat-helpers.oracle.sh` is on the command line, and this book supplies its own
# `wombat__is_converged` over that package's helpers — the replacement is not even an oracle file,
# just a function in a runbook.
#
# THAT IS THE SPELLING THIS CELL PINS AS DE-LICENSED. The book's entrypoint is a first-class
# definition source (`28K` §2a: an in-book role function is an ordinary oracle, recognized by name
# alone), but a BOOK mints no speaker — not by co-loading, and not by sourcing either
# (`rul-speaker-minting-is-oracle-sourcing-only`). So its reach into a DIFFERENT author's helpers
# file leaves its own custody and the vouch suspends: the site runs, attributed, and the mocks
# record the book's own `wombat sync`.
#
# The commissioned property survives in the spelling the ruling leaves: an admin who wants their own
# entrypoints writes them in a file that SOURCES the helpers, which takes custody. Wanting somebody
# else's helpers under your own vouch is exactly the act of authoring an oracle.
#
# The no-contest property is unaffected and still worth the cell: the helpers carry no `__` names,
# so nothing the package ships can collide with what the admin wrote.
#
# Note the definition sits ABOVE its site, which the full-positional regime requires
# (`28K` §2 rul-visibility-is-full-positional): a definition below licenses nothing above it.
wombat__is_converged() {
   _wombat_same "$2"
}

hork provision
wombat sync a.conf

-- wombat-helpers.oracle.sh --
# dorc-lang/v0.2
# THE SAME HELPERS FILE as half one, byte-for-byte in substance: the bulk of the package under
# non-role names. The admin kept this and threw the entrypoints away.
WOMBAT_ROOT=/etc/wombat

_wombat_dest() {
   printf '%s\n' "$WOMBAT_ROOT/$1"
}

_wombat_same() {
   wombat cmp -- "$1" "$(_wombat_dest "$1")"
}

-- probe-results.txt --
# No records: the suspended vouch ships no check, so the probe has nothing to ask and the site runs.

-- mocks/.log --
# newline-safe argv logger for the inert mock shims (slice-4). Sourced by each shim via
# `. "${0%/*}/.log"` (the shim's own dir); a DOTFILE so gate-5/gate-6's `ls`-derived shimset
# never lists it. Shims run under PATH=mocks-only ⇒ BUILTINS ONLY (no sed/awk).
_dorc_logged() {
  _dl_out="ran: ${0##*/}"
  for _dl_a in "$@"; do
    _dl_o=""                                          # pass 1: \ -> \\
    while case $_dl_a in *\\*) true ;; *) false ;; esac; do
      _dl_o="$_dl_o${_dl_a%%\\*}\\\\"; _dl_a=${_dl_a#*\\}
    done
    _dl_a="$_dl_o$_dl_a"
    _dl_o=""                                          # pass 2: newline -> \n
    while case $_dl_a in *"$_DL_NL"*) true ;; *) false ;; esac; do
      _dl_o="$_dl_o${_dl_a%%"$_DL_NL"*}\\n"; _dl_a=${_dl_a#*"$_DL_NL"}
    done
    _dl_out="$_dl_out $_dl_o$_dl_a"
  done
  printf '%s\n' "$_dl_out" >>"$DORC_LOG"
}
_DL_NL='
'

-- mocks/hork --
#!/bin/sh
# INERT mock for the unmodeled wall command.
. "${0%/*}/.log"; _dorc_logged "$@"
exit 0

-- mocks/wombat --
#!/bin/sh
# INERT mock. Reached through the discarded-entrypoint path: the BOOK's own role function into the
# package's helpers. An unresolved cross-author helper makes this rc 127 and the run-log stays empty.
. "${0%/*}/.log"; _dorc_logged "$@"
exit 0

-- expected.ran --
ran: hork provision
ran: wombat sync a.conf

