-- book.sh --
#!/bin/sh
# 27C §8 babby-sudo (27N): an ambient `hork install` + a sudo-WRAPPED one, answered in two contexts.
# Unwrapped FIRST so its ambient elision is independent of the wrapped mutator's downstream wall
# (the context-blind Stage-1 wall is a disclosed 27N limitation). `hork`/`sudo` are inert mocks.
hork install wombat
sudo hork install frob

-- hork.oracle.sh --
# dorc-lang/v0.2
# hork: an inert package-manager stub; `: safe-across user` vouches read-only under a user shift
# (27C §2), so a sudo-wrapped `hork install` may probe in the root context.
hork__is_converged() {
   : safe-across user
   case "$1" in
   install) hork query "$2" ;;
   *) return 2 ;;
   esac
}

-- sudo.oracle.sh --
# dorc-lang/v0.2
# A coherent sudo wrapper (273 + 27C §3): predict env-scrubs + execs the guest; lend_map maps user
# and full-lends fs-view + netns (enumerate-every-dimension); the entry form re-runs sudo `-n`
# (non-interactive by construction). Authoring `sudo__enter` IS the traversal vouch.
sudo__predict() {
   while [ "${1#-}" != "$1" ]; do case "$1" in -u) shift 2 ;; *) shift ;; esac; done
   env -i HOME=/root "$@"
}
sudo__lend_map() {
   target=root
   while [ "${1#-}" != "$1" ]; do case "$1" in -u) target="$2"; shift 2 ;; *) shift ;; esac; done
   printf '%s\n' "$target" : lends user
   : lends fs-view
   : lends netns
   "$@"
}
sudo__enter() {
   sudo -n "$@"
}

-- probe-results.txt --
site 0 effect=holds rc=0
site 1 effect=absent rc=1

-- mocks/.log --
# newline-safe argv logger for the inert mock shims (slice-4). Sourced by each shim via
# `. "${0%/*}/.log"` (the shim's own dir); a DOTFILE so gate-5/gate-6's `ls`-derived shimset
# never lists it. Replaces the old inline `printf 'ran: %s %s\n' "${0##*/}" "$*"` — an arg with
# an embedded NEWLINE would split the `ran:` line and silently break every line-based compare
# (exec_check, gate-5, gate-6). Shims run under PATH=mocks-only ⇒ BUILTINS ONLY (no sed/awk).
#
# GRAMMAR (what expected.ran goldens carry): one `ran: <name> <arg>…` line per invocation; each
# arg is encoded — a literal backslash as `\\`, an embedded newline as the two chars `\n`. The
# two passes run in THIS order (backslash first) so a newline's encoded `\n` backslash is not
# re-doubled. A newline-free, backslash-free argv encodes to itself ⇒ byte-identical to the old
# format (per-arg space-join == the old `"$*"` join) ⇒ zero golden churn.
_dorc_logged() {
  _dl_out="ran: ${0##*/}"
  for _dl_a in "$@"; do
    _dl_o=""                                          # pass 1: \ -> \\
    while case $_dl_a in *\\*) true ;; *) false ;; esac; do
      _dl_o="$_dl_o${_dl_a%%\\*}\\\\"; _dl_a=${_dl_a#*\\}
    done
    _dl_a="$_dl_o$_dl_a"
    _dl_o=""                                          # pass 2: newline -> \n
    while case $_dl_a in *"$_DL_NL"*) true ;; *) false ;; esac; do
      _dl_o="$_dl_o${_dl_a%%"$_DL_NL"*}\\n"; _dl_a=${_dl_a#*"$_DL_NL"}
    done
    _dl_out="$_dl_out $_dl_o$_dl_a"
  done
  printf '%s\n' "$_dl_out" >>"$DORC_LOG"
}
_DL_NL='
'

-- mocks/hork --
#!/bin/sh
# INERT mock: `query frob` (sudo-context) is ABSENT (rc 1) ⇒ wrapped site diverges/runs; `query
# wombat` (ambient) HOLDS (rc 0) ⇒ elides. Two contexts, two answers, real in-context probe.
. "${0%/*}/.log"; _dorc_logged "$@"
[ "$1 $2" = "query frob" ] && exit 1
exit 0

-- mocks/sudo --
#!/bin/sh
# INERT mock: `sudo -n <guest>` (27C probe entry) EXECs the guest for the real in-context check;
# plain `sudo <guest>` (apply escalation) logs and exits (guest not re-run).
. "${0%/*}/.log"; _dorc_logged "$@"
_passthru=
[ "${1:-}" = "-n" ] && _passthru=1
while [ "${1#-}" != "$1" ]; do case "$1" in -u) shift 2 ;; *) shift ;; esac; done
[ -n "$_passthru" ] && exec "$@"
exit 0

-- expected.ran --
ran: sudo hork install frob

-- replay --
$ dorc --book=book.sh --pre-source hork.oracle.sh --pre-source sudo.oracle.sh --results - < probe-results.txt
escalation: note[escalation-policy]: escalation policy: probe re-uses connection
authority (root) for `tolerates:`-vouched functions only (default); entry forms:
sudo -n. Forbid with --no-probe-escalation; widen with --escalate-any-probe.
#!/bin/sh
# dorc probe (read-only): checks per-SITE convergence, mutates nothing.
# When run, emits one results-record per site on stdout (the return channel):
#   site <leafid> effect=<holds|absent|cant-tell> rc=<n>
# effect is derived from the probe command's rc (0=holds, 1=absent, else cant-tell);
# rc is the raw PROBE-command status (opaque to Dorc -- the record is the out-of-band lane).

printf 'dorc-records/1 nonce=dorc attempt=1 host=localhost book=a6779a8a0ea16c0a9cad5522a00beb7b0ef7bf3d86bf38b0dcacf5ec6c9e2afb sites=2 @@dorc@@\n'
# site 0: dorc-auto:hork@converged
hork__is_converged() {
   :
   case "$1" in
   install) hork query "$2" ;;
   *) return 2 ;;
   esac
}
hork__is_converged 'install' 'wombat'; _rc=$?; if [ "$_rc" -eq 0 ]; then _e=holds; elif [ "$_rc" -eq 1 ]; then _e=absent; else _e=cant-tell; fi; printf 'dorc site 0 effect=%s rc=%s @@dorc@@\n' "$_e" "$_rc"
# site 1: dorc-auto:hork@converged
sudo__enter() {
   sudo -n "$@"
}
sudo__enter hork__is_converged 'install' 'frob'; _rc=$?; if [ "$_rc" -eq 0 ]; then _e=holds; elif [ "$_rc" -eq 1 ]; then _e=absent; else _e=cant-tell; fi; printf 'dorc site 1 effect=%s rc=%s @@dorc@@\n' "$_e" "$_rc"
printf 'dorc-records-end/1 nonce=dorc @@dorc@@\n'
dorc: run `dorc why` for the per-site cause-chains, or `dorc why book.sh:N` to query a source line
#!/bin/sh
