-- book.sh --
#!/bin/sh
# floor28-funcdef-as-or-operand — the differential battery's parse question (`28K` §10 bitem8).
#
# The polyfill idiom has a terse spelling that puts a function DEFINITION in the right-hand operand
# of `||`. POSIX makes a function definition a compound command, and whether one may sit there at
# all is a parse question no amount of reasoning settles — so it is measured, which is the only
# reason this case exists.
#
# THE RULING IS UNCHANGED BY THE ANSWER, and that ordering matters: the `if` form
# (floor28-define-if-absent-polyfill) is canonical regardless. This case DOCUMENTS; it never
# LICENSES. If the two floor binaries had disagreed, gate-9's own verdict would have been that the
# construct is outside the base dialect (`276:rul-spec-two-binary-floor`) and the case would be red
# rather than quietly authoritative — which is why the measurement is safe to take.
#
# Measured, both agreeing: the form PARSES, and it also behaves as the idiom intends — the
# definition lands only in a free slot, and an existing definition is left alone.
( command -v hork__is_converged >/dev/null 2>&1 || hork__is_converged() { printf 'polyfill\n' ;}
  hork__is_converged )
( . ./real.sh
  command -v hork__is_converged >/dev/null 2>&1 || hork__is_converged() { printf 'polyfill\n' ;}
  hork__is_converged )

-- real.sh --
hork__is_converged() { printf 'real\n' ;}

-- expected.emitted --
polyfill
real

-- expected.ran --

-- replay --
$ dorc --book=book.sh --results -
#!/bin/sh
# dorc probe (read-only): checks per-SITE convergence, mutates nothing.
# When run, emits one results-record per site on stdout (the return channel):
#   site <leafid> effect=<holds|absent|cant-tell> rc=<n>
# effect is derived from the probe command's rc (0=holds, 1=absent, else cant-tell);
# rc is the raw PROBE-command status (opaque to Dorc -- the record is the out-of-band lane).

printf 'dorc-records/1 nonce=dorc attempt=1 host=localhost book=b9720386c26c89c34004cfb774566c9ecb75e7ad43dcdd3f6cfed1c89b98b821 sites=0 @@dorc@@\n'
# site:0 unresolvable-no-probe
# site:1 unresolvable-no-probe
# site:2 unresolvable-no-probe
# site:3 unresolvable-no-probe
# site:4 unresolvable-no-probe
printf 'dorc-records-end/1 nonce=dorc @@dorc@@\n'
#!/bin/sh
# dorc apply: the book, with already-converged/dead lines elided (value-preserving stand-in).

