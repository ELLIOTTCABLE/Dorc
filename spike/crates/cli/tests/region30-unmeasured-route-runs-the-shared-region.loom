-- book.sh --
#!/bin/sh
# ONE route measured; the other could not be answered at all (a >=2 sink landing, so cant-tell).
# The shared region RUNS: `30L:rul-shared-region-needs-universal-must` demands every route hold at
# `Must`, and one route's convergence buys the region nothing.
#
# Nor does the guard valve reach it. A DIVERGED route is a measurement — the world answered "not
# yet" — so a converged sibling makes a shared check worth paying for. An UNKNOWN route is the
# ABSENCE of an answer, and paying a check to discover what the probe could not is the unsure
# direction (`inv-kfail`). The sibling's own CALL still elides on its own aggregate license: a
# different decision, about a different identity.
install_pkg() {
   apt-get install -y "$1"
}

install_pkg nginx
install_pkg curl

-- pkgindex-predict.oracle.sh --
#!/usr/bin/env dorc-sh
# dorc-lang/v0.2
apt_get__predict() {
   while [ "${1#-}" != "$1" ]; do shift; done
   verb=$1; shift
   while [ "${1#-}" != "$1" ]; do shift; done
   pkg : sm.dorc.Package = "$1"
   if [ "${2-}" = "" ]; then
      case $verb in
         install) dpkg-query -W "$pkg" >/dev/null 2>&1 : sm.dorc.Package:"$pkg"@installed ;;
      esac
   fi
}

-- pkgindex-verdict.oracle.sh --
#!/usr/bin/env dorc-sh
# dorc-lang/v0.2
apt_get__is_converged() {
   while [ "${1#-}" != "$1" ]; do shift; done
   verb=$1; shift
   while [ "${1#-}" != "$1" ]; do shift; done
   case $verb in
      install) aptcheck -q -- "$1" ;;
      *) return 2 ;;
   esac
}

-- probe-results.txt --
# nginx is installed; the check could not answer for curl at all (a >=2 sink landing).
site 0.0 effect=holds rc=0
site 1.0 effect=cant-tell rc=2

-- mocks/.log --
_dorc_logged() {
   _dl_out="ran: ${0##*/}"
   for _dl_arg in "$@"; do _dl_out="$_dl_out $_dl_arg"; done
   printf '%s\n' "$_dl_out" >>"$DORC_LOG"
}

-- mocks/apt-get --
#!/bin/sh
. "${0%/*}/.log"; _dorc_logged "$@"
exit 0

-- mocks/aptcheck --
#!/bin/sh
. "${0%/*}/.log"; _dorc_logged "$@"
case ${3-} in curl) exit 2 ;; esac
exit 0

-- mocks/dpkg-query --
#!/bin/sh
. "${0%/*}/.log"; _dorc_logged "$@"
exit 0

-- expected.ran --
ran: apt-get install -y curl

-- replay --
$ dorc --book=book.sh --pre-source pkgindex-predict.oracle.sh --pre-source pkgindex-verdict.oracle.sh --results - < probe-results.txt
#!/bin/sh
# dorc probe (read-only): checks per-SITE convergence, mutates nothing.
# When run, emits one results-record per site on stdout (the return channel):
#   site <leafid> effect=<holds|absent|cant-tell> rc=<n>
# effect is derived from the probe command's rc (0=holds, 1=absent, else cant-tell);
# rc is the raw PROBE-command status (opaque to Dorc -- the record is the out-of-band lane).

printf 'dorc-records/1 nonce=dorc attempt=1 host=localhost book=ec2caaa284760c9682e3b320e1d1a7ac29fbdeb1d1ac7a248fcdf3f83885732b sites=2 @@dorc@@\n'
# site 0.0: sm.dorc.Package:nginx@installed
apt_get__is_converged() {
   while [ "${1#-}" != "$1" ]; do shift; done
   verb=$1; shift
   while [ "${1#-}" != "$1" ]; do shift; done
   case $verb in
      install) aptcheck -q -- "$1" ;;
      *) return 2 ;;
   esac
}
apt_get__is_converged 'install' '-y' 'nginx'; _rc=$?; if [ "$_rc" -eq 0 ]; then _e=holds; elif [ "$_rc" -eq 1 ]; then _e=absent; else _e=cant-tell; fi; printf 'dorc site 0.0 effect=%s rc=%s @@dorc@@\n' "$_e" "$_rc"
# site 1.0: sm.dorc.Package:curl@installed
apt_get__is_converged 'install' '-y' 'curl'; _rc=$?; if [ "$_rc" -eq 0 ]; then _e=holds; elif [ "$_rc" -eq 1 ]; then _e=absent; else _e=cant-tell; fi; printf 'dorc site 1.0 effect=%s rc=%s @@dorc@@\n' "$_e" "$_rc"
printf 'dorc-records-end/1 nonce=dorc @@dorc@@\n'
classify: note[cmdsub-operand-top]: operand 3 is an unresolvable positional
parameter (`$@`/`$*`/`$N`), so Dorc cannot know its value until the command runs
on the host -- there is nothing to resolve and no read-only probe to check. Dorc
elides a command only when it can prove the command's effect is already in
place, so this one is left to run on every apply.
      [ book.sh:12:23
   12 |    apt-get install -y "$1"
      |                       \__/

   = repair:  Give the operand a value Dorc can resolve statically -- a literal,
              or a variable assigned from one -- so Dorc can probe it and elide
              the command once it has converged. If the value must stay dynamic,
              load an oracle that vouches for this command's convergence, and
              Dorc will guard the command instead of running it every time.
why: ran because operand 3 is a command-substitution `$(...)` or runtime-dynamic value -- its value couldn't be resolved (first seen at 12:4 `apt-get install -y "$1"`); so dorc runs it, to stay safe (when unsure, run). to skip it, make the operand a literal Dorc can resolve+probe [resolve-dynamism]
dorc: run `dorc why` for the per-site cause-chains, or `dorc why book.sh:N` to query a source line
#!/bin/sh
# dorc apply: the book, with already-converged/dead lines elided (value-preserving stand-in).

