#!/bin/sh
# dorc apply: the book, with already-converged/dead lines elided (value-preserving stand-in).

# dorc guard preamble: the vouching oracle's own verdict body, shipped strip-only
# (dialect annotations removed, nothing else changed -- rul-ternary-verdict: the
# authored bytes verbatim, no engine-synthesized sh).
apt_get__is_converged() {
   while [ "${1#-}" != "$1" ]; do shift; done
   verb=$1; shift
   while [ "${1#-}" != "$1" ]; do shift; done
   case $verb in
      install) dpkg-query -W "$1" >/dev/null 2>&1 ;;
      *) return 2 ;;
   esac
}

# dorc: end of lifted material; the book follows, in its authored order.

# strawman24-survive-multiwall (plans/240 Stage 2): a fact surviving TWO footprinted walls, then
apt-get install -y oldpkg
apt-get install -y badpkg
# apt-get install -y nginx   # dorc: elided (already converged / dead branch)
apt-get purge -y gonepkg
( apt_get__is_converged install -y curl ) || apt-get install -y curl   # dorc: guard [sm.dorc.Package converged-vouch; probe: holds]
