-- book.sh --
# fix-ladder-all-holds-folds-all (`26H` §4 W-C, the headline): an N=3 guarded-install ladder
# over three distinct entities, every guard holding. Pre-fixpoint exactly ONE rung folded —
# rung 1's install statically invalidated rung 2's guard, and the fold never re-ran to notice
# that install was itself proven dead. All three fold now; a silent disable shows up here as a
# non-empty run-set, because rungs 2 and 3 would render verbatim and their guards would run.
set -e
dpkg -s alpha >/dev/null 2>&1 || apt-get install -y alpha
dpkg -s beta >/dev/null 2>&1 || apt-get install -y beta
dpkg -s gamma >/dev/null 2>&1 || apt-get install -y gamma

-- package.oracle.sh --
#!/usr/bin/env dorc-sh
# dorc-lang/v0.2
# minimal package oracle (apt/dpkg), lifted statically by dorc.
apt_get__predict() {
   while [ "${1#-}" != "$1" ]; do shift; done
   verb=$1; shift
   while [ "${1#-}" != "$1" ]; do shift; done
   pkg : sm.dorc.Package = "$1"
   if [ "${2-}" = "" ]; then
      case $verb in
         install) dpkg-query -W "$pkg" >/dev/null 2>&1 : sm.dorc.Package:"$pkg"@installed ;;
         purge) dpkg-query -W "$pkg" >/dev/null 2>&1 :! sm.dorc.Package:"$pkg"@installed ;;
      esac
   fi
}

-- pkgstate.oracle.sh --
#!/usr/bin/env dorc-sh
# dorc-lang/v0.2
# package-status QUERY oracle (the DESIGN `dpkg -s nginx || apt-get install` idiom).
dpkg__predict() {
   case $1 in -s) shift ;; esac
   pkg : sm.dorc.PkgState = "$1"
   dpkg -s -- "$pkg" >/dev/null 2>&1 :? sm.dorc.PkgState:"$pkg"@installed
}

-- probe-results.txt --
# probe-results (`26H` §4 W-C). Sites 1/3/5 are the pkgstate Query guards — all VALID at round 1
# only for site 1; sites 3 and 5 become valid once the fixpoint erases the installs above them,
# at which point their already-measured rcs (recorded here, never re-probed) become fold-usable.
# Sites 2/4/6 are the package install establishes (effect-only; rc firewalled from the fold).
# `set -e` is site 0 (MustRun, no record).
site 1 effect=holds rc=0
site 2 effect=holds
site 3 effect=holds rc=0
site 4 effect=holds
site 5 effect=holds rc=0
site 6 effect=holds

-- mocks/.log --
# newline-safe argv logger for the inert mock shims (slice-4). Sourced by each shim via
# `. "${0%/*}/.log"` (the shim's own dir); a DOTFILE so gate-5/gate-6's `ls`-derived shimset
# never lists it. Replaces the old inline `printf 'ran: %s %s\n' "${0##*/}" "$*"` — an arg with
# an embedded NEWLINE would split the `ran:` line and silently break every line-based compare
# (exec_check, gate-5, gate-6). Shims run under PATH=mocks-only ⇒ BUILTINS ONLY (no sed/awk).
#
# GRAMMAR (what expected.ran goldens carry): one `ran: <name> <arg>…` line per invocation; each
# arg is encoded — a literal backslash as `\\`, an embedded newline as the two chars `\n`. The
# two passes run in THIS order (backslash first) so a newline's encoded `\n` backslash is not
# re-doubled. A newline-free, backslash-free argv encodes to itself ⇒ byte-identical to the old
# format (per-arg space-join == the old `"$*"` join) ⇒ zero golden churn.
_dorc_logged() {
  _dl_out="ran: ${0##*/}"
  for _dl_a in "$@"; do
    _dl_o=""                                          # pass 1: \ -> \\
    while case $_dl_a in *\\*) true ;; *) false ;; esac; do
      _dl_o="$_dl_o${_dl_a%%\\*}\\\\"; _dl_a=${_dl_a#*\\}
    done
    _dl_a="$_dl_o$_dl_a"
    _dl_o=""                                          # pass 2: newline -> \n
    while case $_dl_a in *"$_DL_NL"*) true ;; *) false ;; esac; do
      _dl_o="$_dl_o${_dl_a%%"$_DL_NL"*}\\n"; _dl_a=${_dl_a#*"$_DL_NL"}
    done
    _dl_out="$_dl_out $_dl_o$_dl_a"
  done
  printf '%s\n' "$_dl_out" >>"$DORC_LOG"
}
_DL_NL='
'

-- mocks/apt-get --
#!/bin/sh
# INERT shim for `apt-get` — the three mutators. Every one is fold-dead on this host, so NONE
# may appear in the apply run-set; each logs only if it wrongly runs.
. "${0%/*}/.log"; _dorc_logged "$@"
exit 0

-- mocks/dpkg --
#!/bin/sh
# INERT shim for `dpkg` — the pkgstate guard, run both as the probe's stripped check
# (`dpkg -s -- <pkg>`) and, in the BARE book, as the admin's own guard. All three entities are
# installed on this host, so every guard exits 0 ⇒ every `||` install is dead-in-fact.
. "${0%/*}/.log"; _dorc_logged "$@"
pkg=$2; [ "$pkg" = "--" ] && pkg=$3
case $pkg in
  alpha|beta|gamma) exit 0 ;;
  *) exit 1 ;;
esac

-- mocks/dpkg-query --
#!/bin/sh
# INERT shim for `dpkg-query` — the package kind's install-establish probe. Consistent with the
# guard host: all three installed. The installs are OMITTED by the fold regardless (the fold
# reads the GUARD's rc), but the probe still ships these checks, so gate-1 parity needs them.
. "${0%/*}/.log"; _dorc_logged "$@"
exit 0

