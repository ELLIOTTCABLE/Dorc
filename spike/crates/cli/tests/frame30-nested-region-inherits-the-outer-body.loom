-- book.sh --
#!/bin/sh
# frame30-nested-region-inherits-the-outer-body (`28Q` §1) — frames STACK, they do not reset.
#
# `floor30-subshell-nesting-and-removal-scope` measured the shell half: a nested subshell inherits
# its parent subshell's re-source rather than starting from the ambient prefix. The frame model has
# to agree, and the failure mode it rules out is subtle — an engine that reset at each `(` would
# answer the inner site from the ORACLE while the shell answers it from the outer region's body,
# which is a measurement of a different author's judgment reported under this site's name
# (`271:rul-sin-ordering`, pope-sin tier, and invisible in the apply artifact).
#
# So the pin is the probe: the inner site must ship the OUTER REGION's body, and the site after both
# parens must ship the oracle's.
#
# ANTI-MASKING: the two bodies invoke DIFFERENT check commands, so the probe alone says which
# answered where.
(
foobar__is_converged() {
   foobar regional-check --certs "$2"
}
( foobar sync-certs /etc/nginx/certs )
)
foobar sync-certs /etc/nginx/certs

-- foobar.oracle.sh --
foobar__is_converged() {
   verb="$1"; shift
   case "$verb" in
   sync-certs) foobar status --certs-current -- "$1" ;;
   *) return 2 ;;
   esac
}

-- probe-results.txt --
# Both sites converged: the nested one measured by the OUTER region's body, the trailing one by the
# oracle's.
site 0 effect=holds
site 1 effect=holds rc=0

-- mocks/.log --
# newline-safe argv logger for the inert mock shims (slice-4). Sourced by each shim via
# `. "${0%/*}/.log"` (the shim's own dir); a DOTFILE so gate-5/gate-6's `ls`-derived shimset
# never lists it. Shims run under PATH=mocks-only ⇒ BUILTINS ONLY (no sed/awk).
_dorc_logged() {
  _dl_out="ran: ${0##*/}"
  for _dl_a in "$@"; do
    _dl_o=""                                          # pass 1: \ -> \\
    while case $_dl_a in *\\*) true ;; *) false ;; esac; do
      _dl_o="$_dl_o${_dl_a%%\\*}\\\\"; _dl_a=${_dl_a#*\\}
    done
    _dl_a="$_dl_o$_dl_a"
    _dl_o=""                                          # pass 2: newline -> \n
    while case $_dl_a in *"$_DL_NL"*) true ;; *) false ;; esac; do
      _dl_o="$_dl_o${_dl_a%%"$_DL_NL"*}\\n"; _dl_a=${_dl_a#*"$_DL_NL"}
    done
    _dl_out="$_dl_out $_dl_o$_dl_a"
  done
  printf '%s\n' "$_dl_out" >>"$DORC_LOG"
}
_DL_NL='
'

-- mocks/foobar --
#!/bin/sh
# INERT mock: logs that it ran, mutates NOTHING, exits 0.
. "${0%/*}/.log"; _dorc_logged "$@"
exit 0

