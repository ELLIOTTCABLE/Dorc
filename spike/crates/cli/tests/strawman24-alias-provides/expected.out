#!/bin/sh
# dorc probe (read-only): checks per-SITE convergence, mutates nothing.
# When run, emits one results-record per site on stdout (the return channel):
#   site <leafid> effect=<holds|absent|cant-tell> rc=<n>
# effect is derived from the probe command's rc (0=holds, 1=absent, else cant-tell);
# rc is the raw PROBE-command status (opaque to Dorc — the record is the out-of-band lane).

printf 'dorc-records/1 nonce=dorc attempt=1 host=localhost book=cba7ae2ef3ea8a99 sites=2 @@dorc@@\n'
# site 0: sm.dorc.Package:nginx@installed
apt_get__predict() {
   while [ "${1#-}" != "$1" ]; do shift; done
   verb=$1; shift
   while [ "${1#-}" != "$1" ]; do shift; done
   pkg="$1"
   if [ "${2-}" = "" ]; then
      case $verb in
         install) dpkg-query -W "$pkg" >/dev/null 2>&1 ;;
      esac
   fi
}
apt_get__predict 'install' 'nginx'; _rc=$?; if [ "$_rc" -eq 0 ]; then _e=holds; elif [ "$_rc" -eq 1 ]; then _e=absent; else _e=cant-tell; fi; printf 'dorc site 0 effect=%s rc=%s @@dorc@@\n' "$_e" "$_rc"
# site 1: sm.dorc.Package:nginx-full@installed
apt_get__predict 'install' 'nginx-full'; _rc=$?; if [ "$_rc" -eq 0 ]; then _e=holds; elif [ "$_rc" -eq 1 ]; then _e=absent; else _e=cant-tell; fi; printf 'dorc site 1 effect=%s rc=%s @@dorc@@\n' "$_e" "$_rc"
# dorc resolver-probe (read-only, 24F §3): owner-declared identity canonicalization. Each
# resolver-bearing coordinate runs its kind's <kind>.resolve() with the entity; when run it
# prints the canonical form (or a dangling marker), re-keyed by the coordinate:
#   resolv <kind:entity> canon=<canonical>   |   resolv <kind:entity> dangling
# The engine canonicalizes both footprint and backing coords through this before disjoint.

# resolv sm.dorc.Package:nginx via sm.dorc.Package.resolve()
sm_dorc_Package__resolve() {
   dpkg-query -W -f '${Package}\n' -- "$1" 2>/dev/null || printf '%s\n' "$1"
}
_c=$(sm_dorc_Package__resolve 'nginx' 2>/dev/null); _rr=$?; if [ "$_rr" -eq 0 ] && [ -n "$_c" ]; then printf 'dorc resolv sm.dorc.Package:nginx canon=%s @@dorc@@\n' "$_c"; else printf 'dorc resolv sm.dorc.Package:nginx dangling @@dorc@@\n'; fi
# resolv sm.dorc.Package:nginx-full via sm.dorc.Package.resolve()
_c=$(sm_dorc_Package__resolve 'nginx-full' 2>/dev/null); _rr=$?; if [ "$_rr" -eq 0 ] && [ -n "$_c" ]; then printf 'dorc resolv sm.dorc.Package:nginx-full canon=%s @@dorc@@\n' "$_c"; else printf 'dorc resolv sm.dorc.Package:nginx-full dangling @@dorc@@\n'; fi
printf 'dorc-records-end/1 nonce=dorc @@dorc@@\n'
#!/bin/sh
# dorc apply: the book, with already-converged/dead lines elided (value-preserving stand-in).

# strawman24-alias-provides (24F Stage 5 — the aliasing-closure flagship). The wall and the victim
apt-get install nginx
apt-get install nginx-full
