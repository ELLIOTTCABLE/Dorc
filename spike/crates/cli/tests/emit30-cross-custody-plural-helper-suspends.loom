---
run: round-trip
fixpoint: executed
exit: 16
expect-diagnostic:
  - helper-declaration-contested
  - unannounced-cross-custody-call
  - vouched-composition-not-present
---
-- book.sh --
#!/bin/sh
# emit30-cross-custody-plural-helper-suspends (`28R:rul-mixed-custody-suspends-vouch`, the custody
# predicate `rul-vouch-reaches-own-custody-only`, and the v0 refusal
# `30I:rul-unannounced-cross-custody-fails-before-network`) — the SUSPEND half of
# pin28-contested-helper-resolves-by-last-wins, and what v0 now does about it.
#
# Same plurality, one difference that decides everything: the declaration a shell would bind sits in
# a THIRD author's file, not in the file whose `wombat__is_converged` vouches. The vouch does not
# attach — no elide, no guard — and because nothing in the voucher's own file SOURCED, guarded, or
# `command`-routed that name, the oracle set is invalid contracted input at v0: the run refuses
# before any host is contacted and before any mutation-authorizing plan exists.
#
# CROSSING CUSTODY IS THE WHOLE REASON, and by itself. The plurality here is incidental colour — a
# lone declaration in another author's co-loaded file lands in exactly the same place as three do,
# because naming files together on a command line is ingestion and composes no custody. The way to
# reach another file's helpers under your own vouch is to SOURCE it
# (`rul-speaker-minting-is-oracle-sourcing-only`), or to guard it with that package's own sentinel
# (`30I:rul-guarded-source-mints-exact-speaker-edge`) — each an act of authorship rather than an
# accident of invocation.
#
# What to read in the transcript: `sites=0` (a check that cannot carry its composition ships
# nothing), and NO apply artifact behind it — the read-only probe is all a refused run emits.
wombat sync a.conf

-- a-entry.oracle.sh --
# dorc-lang/v0.2
# THE VOUCHER. Its verdict body reaches `_wombat_dest` and says nothing about which one.
wombat__is_converged() {
   _wombat_dest "$2"
}

-- b-helper.oracle.sh --
# dorc-lang/v0.2
# One answer, loaded second.
_wombat_dest() {
   wombat cmp -- "$1" "/etc/wombat/$1"
}

-- c-helper.oracle.sh --
# dorc-lang/v0.2
# A DIFFERENT answer, loaded third — so this is the one a shell binds, and it is not the voucher's.
_wombat_dest() {
   wombat cmp --strict -- "$1" "/etc/wombat/$1"
}

-- replay --
$ dorc --book=book.sh --pre-source a-entry.oracle.sh --pre-source b-helper.oracle.sh --pre-source c-helper.oracle.sh --results -
#!/bin/sh
# dorc probe (read-only): checks per-SITE convergence, mutates nothing.
# When run, emits one results-record per site on stdout (the return channel):
#   site <leafid> effect=<holds|absent|cant-tell> rc=<n>
# effect is derived from the probe command's rc (0=holds, 1=absent, else cant-tell);
# rc is the raw PROBE-command status (opaque to Dorc -- the record is the out-of-band lane).

printf 'dorc-records/1 nonce=dorc attempt=1 host=localhost book=a47657611e75913d87b2f54bb87166f46056030d011e306c0f0eebf00ac0a4bd sites=0 @@dorc@@\n'
# site:0 unresolvable-no-probe
printf 'dorc-records-end/1 nonce=dorc @@dorc@@\n'
