-- book.sh --
#!/bin/sh
# emit30-cross-custody-plural-helper-suspends (`28R:rul-mixed-custody-suspends-vouch`, the custody
# predicate `rul-vouch-reaches-own-custody-only`) — the SUSPEND half of
# pin28-contested-helper-resolves-by-last-wins.
#
# Same plurality, one difference that decides everything: the declaration a shell would bind sits in
# a THIRD author's file, not in the file whose `wombat__is_converged` vouches. The vouch does not
# attach: no elide, no guard, the site runs verbatim.
#
# CROSSING CUSTODY IS THE WHOLE REASON, and by itself. The plurality here is incidental colour — a
# lone declaration in another author's co-loaded file suspends this vouch exactly as three do,
# because naming files together on a command line is ingestion and composes no custody. The way to
# reach another file's helpers under your own vouch is to SOURCE it
# (`rul-speaker-minting-is-oracle-sourcing-only`), which is an act of authorship rather than an
# accident of invocation.
#
# What to read in the transcript: `sites=0` (a check that cannot carry its composition ships nothing)
# and an apply that is the book byte for byte.
wombat sync a.conf

-- a-entry.oracle.sh --
# dorc-lang/v0.2
# THE VOUCHER. Its verdict body reaches `_wombat_dest` and says nothing about which one.
wombat__is_converged() {
   _wombat_dest "$2"
}

-- b-helper.oracle.sh --
# dorc-lang/v0.2
# One answer, loaded second.
_wombat_dest() {
   wombat cmp -- "$1" "/etc/wombat/$1"
}

-- c-helper.oracle.sh --
# dorc-lang/v0.2
# A DIFFERENT answer, loaded third — so this is the one a shell binds, and it is not the voucher's.
_wombat_dest() {
   wombat cmp --strict -- "$1" "/etc/wombat/$1"
}

-- replay --
$ dorc --book=book.sh --pre-source a-entry.oracle.sh --pre-source b-helper.oracle.sh --pre-source c-helper.oracle.sh --results -
loading: warning[helper-declaration-contested]: Two differing declarations of
`_wombat_dest` are loaded (the earlier at b-helper.oracle.sh:3), and nothing can
choose between same-named helpers, so Dorc withholds them all and the sites
needing `_wombat_dest` run -- load a single source, or take custody of a merged
copy.
      [ c-helper.oracle.sh:3:1
   3 | _wombat_dest() {
     | \______________/
   4 |    wombat cmp --strict -- "$1" "/etc/wombat/$1"
     | \_____________________________________________/
   5 | }
     | ^
vouching: warning[vouched-composition-not-present]: [unwritten:
vouched-composition-not-present]
      [ a-entry.oracle.sh:3:1
   3 | wombat__is_converged() {
     | \__________________/
