-- book.sh --
#!/bin/sh
# whygallery-webhost-whole: the whole why-surface on one USER_STORY-shaped webhost book — a
# famous-oracle elision, the admin's own hand-guard, a diverged modeled wall whose `disturbs`
# claim lets a converged line survive it under --risk-faultless-skips, an unmodeled `hork` wall, a
# modeled site downstream of that wall (the guard tier), and an `unsound` classed decline.
# Every tool named here is an INERT mock; nothing mutates. NB no `set -e`: errexit makes every
# line's status consumed, which defeats elision outright (strawman24-errexit-defeats measures it).

dpkg -s nginx >/dev/null 2>&1 || apt-get install -y nginx
ufw allow 80/tcp
systemctl enable nginx
apt-get install -y oldpkg
ufw allow 443/tcp
hork tune --profile web
systemctl start nginx
sysctl vm.drop_caches
echo "web1 up"

-- firewall.oracle.sh --
#!/usr/bin/env dorc-sh
# dorc-lang/v0.2
# The famous firewall oracle (ufw): `ufw allow <rule>` establishes Firewall:<rule>@allowed, and
# `ufw status <rule>` is the read-only check both the probe and the verdict member re-run.
ufw__predict() {
   verb=$1; shift
   rule : sm.dorc.Firewall = "$1"
   case $verb in
      allow) ufw status "$rule" >/dev/null 2>&1 : sm.dorc.Firewall:"$rule"@allowed ;;
      deny) ufw status "$rule" >/dev/null 2>&1 :! sm.dorc.Firewall:"$rule"@allowed ;;
   esac
}

ufw__is_converged() {
   verb=$1; shift
   case $verb in
      allow) ufw status "$1" >/dev/null 2>&1 ;;
      *) return 2 ;;
   esac
}

-- package.oracle.sh --
#!/usr/bin/env dorc-sh
# dorc-lang/v0.2
# The famous package oracle (apt-get). Its `disturbs` member is the at-most claim the survival
# tier reads when an `install` line runs as a wall: this author says the install touches the
# Package cell it names, and nothing else.
apt_get__predict() {
   while [ "${1#-}" != "$1" ]; do shift; done
   verb=$1; shift
   while [ "${1#-}" != "$1" ]; do shift; done
   pkg : sm.dorc.Package = "$1"
   if [ "${2-}" = "" ]; then
      case $verb in
         install) dpkg-query -W "$pkg" >/dev/null 2>&1 : sm.dorc.Package:"$pkg"@installed ;;
         purge) dpkg-query -W "$pkg" >/dev/null 2>&1 :! sm.dorc.Package:"$pkg"@installed ;;
      esac
   fi
}

apt_get__disturbs() {
   while [ "${1#-}" != "$1" ]; do shift; done
   verb=$1; shift
   while [ "${1#-}" != "$1" ]; do shift; done
   case $verb in
      install|purge) printf '%s\n' "$1" : disturbs sm.dorc.Package ;;
   esac
}

apt_get__is_converged() {
   while [ "${1#-}" != "$1" ]; do shift; done
   verb=$1; shift
   while [ "${1#-}" != "$1" ]; do shift; done
   case $verb in
      install) dpkg-query -W "$1" >/dev/null 2>&1 ;;
      *) return 2 ;;
   esac
}

-- pkgstate.oracle.sh --
#!/usr/bin/env dorc-sh
# dorc-lang/v0.2
# package-status QUERY oracle — the DESIGN `dpkg -s nginx || apt-get install` idiom. It models
# only the READ, so the admin's own hand-written guard is recognized (argv lifts through this
# argparse) rather than re-guarded.
dpkg__predict() {
   case $1 in -s) shift ;; esac
   pkg : sm.dorc.PkgState = "$1"
   dpkg -s -- "$pkg" >/dev/null 2>&1 :? sm.dorc.PkgState:"$pkg"@installed
}

-- service.oracle.sh --
#!/usr/bin/env dorc-sh
# dorc-lang/v0.2
# The famous service oracle (systemctl). `start` gates Service:<unit>@active and `enable` gates
# Service:<unit>@enabled; the verdict member is what ships as a guard when a site sits past a wall.
systemctl__predict() {
   verb=$1; shift
   svc : sm.dorc.Service = "$1"
   case $verb in
      start)   systemctl is-active  -- "$svc" : sm.dorc.Service:"$svc"@active ;;
      enable)  systemctl is-enabled -- "$svc" : sm.dorc.Service:"$svc"@enabled ;;
   esac
}

systemctl__is_converged() {
   verb=$1; shift
   case $verb in
      start)  systemctl is-active  -- "$1" >/dev/null 2>&1 ;;
      enable) systemctl is-enabled -- "$1" >/dev/null 2>&1 ;;
      *) return 2 ;;
   esac
}

-- sysctl.oracle.sh --
#!/usr/bin/env dorc-sh
# dorc-lang/v0.2
# sysctl oracle. Some keys are not state at all — writing them is the whole point — so the
# verdict member DECLINES them, and classes the decline on the reached arm.
sysctl__is_converged() {
   key=$1
   case $key in
   vm.drop_caches|vm.compact_memory)
      # A write-only trigger: reading it back says nothing about whether it fired, so no
      # answer here could honestly license keeping the line out of the plan.
      printf 'decline unsound %s is a write-only trigger key\n' "$key" >>"${DREP_V1:-/dev/null}"
      return 2 ;;
   *) sysctl -n -- "$key" >/dev/null 2>&1 ;;
   esac
}

-- probe-results.txt --
# probe-results: site-keyed records (the records the rendered probe emits; effect from the
# probe command's rc). Site numbers are the leaf ids the probe render prints above each block.
# 0 = the admin's own `dpkg -s nginx` read (holds ⇒ their `||` guard holds ⇒ the install is dead)
# 1 = Package:nginx (the dead install's own fact) · 2 = Firewall:80/tcp · 3 = Service:nginx@enabled
# 4 = Package:oldpkg ABSENT ⇒ diverged ⇒ that install RUNS: the modeled wall
# 5 = Firewall:443/tcp holds ⇒ converged, and survives the wall under --risk-faultless-skips
# 7 = Service:nginx@active holds ⇒ converged, but sits past the unmodeled `hork` wall ⇒ guard
site 0 effect=holds rc=0
site 1 effect=holds rc=0
site 2 effect=holds rc=0
site 3 effect=holds rc=0
site 4 effect=absent rc=1
site 5 effect=holds rc=0
site 7 effect=holds rc=0

-- mocks/.log --
# newline-safe argv logger for the inert mock shims (slice-4). Sourced by each shim via
# `. "${0%/*}/.log"` (the shim's own dir); a DOTFILE so gate-5/gate-6's `ls`-derived shimset
# never lists it. Replaces the old inline `printf 'ran: %s %s\n' "${0##*/}" "$*"` — an arg with
# an embedded NEWLINE would split the `ran:` line and silently break every line-based compare
# (exec_check, gate-5, gate-6). Shims run under PATH=mocks-only ⇒ BUILTINS ONLY (no sed/awk).
#
# GRAMMAR (what expected.ran goldens carry): one `ran: <name> <arg>…` line per invocation; each
# arg is encoded — a literal backslash as `\\`, an embedded newline as the two chars `\n`. The
# two passes run in THIS order (backslash first) so a newline's encoded `\n` backslash is not
# re-doubled. A newline-free, backslash-free argv encodes to itself ⇒ byte-identical to the old
# format (per-arg space-join == the old `"$*"` join) ⇒ zero golden churn.
_dorc_logged() {
  _dl_out="ran: ${0##*/}"
  for _dl_a in "$@"; do
    _dl_o=""                                          # pass 1: \ -> \\
    while case $_dl_a in *\\*) true ;; *) false ;; esac; do
      _dl_o="$_dl_o${_dl_a%%\\*}\\\\"; _dl_a=${_dl_a#*\\}
    done
    _dl_a="$_dl_o$_dl_a"
    _dl_o=""                                          # pass 2: newline -> \n
    while case $_dl_a in *"$_DL_NL"*) true ;; *) false ;; esac; do
      _dl_o="$_dl_o${_dl_a%%"$_DL_NL"*}\\n"; _dl_a=${_dl_a#*"$_DL_NL"}
    done
    _dl_out="$_dl_out $_dl_o$_dl_a"
  done
  printf '%s\n' "$_dl_out" >>"$DORC_LOG"
}
_DL_NL='
'

-- mocks/apt-get --
#!/bin/sh
# INERT mock: logs its argv, mutates nothing.
. "${0%/*}/.log"; _dorc_logged "$@"
exit 0

-- mocks/dpkg --
#!/bin/sh
# INERT probe shim for `dpkg -s <pkg>` (the PkgState query the admin's own hand-guard spells).
# HOST: nginx IS installed ⇒ rc 0 ⇒ the admin's `||` guard holds ⇒ its install is a dead branch.
. "${0%/*}/.log"; _dorc_logged "$@"
exit 0

-- mocks/dpkg-query --
#!/bin/sh
# INERT probe shim for `dpkg-query -W <pkg>` (the Package kind's probe). HOST: nginx installed
# (rc 0 ⇒ converged); oldpkg ABSENT (rc 1 ⇒ diverged ⇒ its install RUNS, the modeled wall).
. "${0%/*}/.log"; _dorc_logged "$@"
case $* in
  *oldpkg*) exit 1 ;;
esac
exit 0

-- mocks/hork --
#!/bin/sh
# INERT mock for the UNMODELED wall. No oracle describes `hork`, so its effect is ⊤: everything
# downstream of it loses its elision license and falls back to the guard tier.
. "${0%/*}/.log"; _dorc_logged "$@"
exit 0

-- mocks/systemctl --
#!/bin/sh
# INERT mock. HOST: nginx is both enabled and active ⇒ rc 0 for `is-enabled` and `is-active`.
# This same body re-runs at apply as the guard for the site past the hork wall.
. "${0%/*}/.log"; _dorc_logged "$@"
exit 0

-- mocks/sysctl --
#!/bin/sh
# INERT mock. The verdict member declines vm.drop_caches without running anything, so this is
# invoked only by the apply.
. "${0%/*}/.log"; _dorc_logged "$@"
exit 0

-- mocks/ufw --
#!/bin/sh
# INERT mock. HOST: both rules are already allowed ⇒ rc 0 ⇒ both `ufw allow` lines converged.
. "${0%/*}/.log"; _dorc_logged "$@"
exit 0

