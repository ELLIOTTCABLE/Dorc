      enable) systemctl is-enabled -- "$1" >/dev/null 2>&1 ;;
      *) return 2 ;;
   esac
}
systemctl__is_converged 'enable' 'nginx'; _rc=$?; if [ "$_rc" -eq 0 ]; then _e=holds; elif [ "$_rc" -eq 1 ]; then _e=absent; else _e=cant-tell; fi; printf 'dorc site 3 effect=%s rc=%s @@dorc@@\n' "$_e" "$_rc"
# site 4: sm.dorc.Package:oldpkg@installed
apt_get__is_converged 'install' '-y' 'oldpkg'; _rc=$?; if [ "$_rc" -eq 0 ]; then _e=holds; elif [ "$_rc" -eq 1 ]; then _e=absent; else _e=cant-tell; fi; printf 'dorc site 4 effect=%s rc=%s @@dorc@@\n' "$_e" "$_rc"
# site 5: sm.dorc.Firewall:443/tcp@allowed
ufw__is_converged 'allow' '443/tcp'; _rc=$?; if [ "$_rc" -eq 0 ]; then _e=holds; elif [ "$_rc" -eq 1 ]; then _e=absent; else _e=cant-tell; fi; printf 'dorc site 5 effect=%s rc=%s @@dorc@@\n' "$_e" "$_rc"
# site 7: sm.dorc.Service:nginx@active
systemctl__is_converged 'start' 'nginx'; _rc=$?; if [ "$_rc" -eq 0 ]; then _e=holds; elif [ "$_rc" -eq 1 ]; then _e=absent; else _e=cant-tell; fi; printf 'dorc site 7 effect=%s rc=%s @@dorc@@\n' "$_e" "$_rc"
# site:6 unresolvable-no-probe
# site:8 unresolvable-no-probe
# site:9 unresolvable-no-probe
printf 'dorc-records-end/1 nonce=dorc @@dorc@@\n'
#!/bin/sh
# dorc apply: the book, with already-converged/dead lines elided (value-preserving stand-in).

# dorc guard preamble: the vouching oracle's own verdict body, shipped strip-only
# (dialect annotations removed, nothing else changed -- rul-ternary-verdict: the
# authored bytes verbatim, no engine-synthesized sh).
systemctl__is_converged() {
   verb=$1; shift
   case $verb in
      start)  systemctl is-active  -- "$1" >/dev/null 2>&1 ;;
      enable) systemctl is-enabled -- "$1" >/dev/null 2>&1 ;;
      *) return 2 ;;
   esac
}

#!/bin/sh
# whygallery-webhost-whole: the whole why-surface on one USER_STORY-shaped webhost book — a
# famous-oracle elision, the admin's own hand-guard, a diverged modeled wall whose `disturbs`
# claim lets a converged line survive it under --risk-faultless-skips, an unmodeled `hork` wall, a
# modeled site downstream of that wall (the guard tier), and an `unsound` classed decline.
# Every tool named here is an INERT mock; nothing mutates. NB no `set -e`: errexit makes every
# line's status consumed, which defeats elision outright (strawman24-errexit-defeats measures it).

true || :   # dorc: elided [dpkg -s nginx >/dev/null 2>&1; apt-get install -y nginx] (already converged / dead branch)
# ufw allow 80/tcp   # dorc: elided (already converged / dead branch)
# systemctl enable nginx   # dorc: elided (already converged / dead branch)
apt-get install -y oldpkg
# ufw allow 443/tcp   # dorc: elided (already converged / dead branch)
hork tune --profile web
( systemctl__is_converged start nginx ) || systemctl start nginx   # dorc: guard [sm.dorc.Service converged-vouch; probe: holds]
sysctl vm.drop_caches
echo "web1 up"

