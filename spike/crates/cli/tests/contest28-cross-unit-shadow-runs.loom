-- book.sh --
#!/bin/sh
# contest28-cross-unit-shadow-runs (`28K` §1 rul-silent-shadowing-refuses) — CELL 1, the case the
# refusal exists for. The book redefines a role function the loaded oracle already bound, and
# nothing anywhere spells which of the two should govern, so the whole `foobar` FAMILY goes
# unlicensed: no probe ships, no guard is inserted, the site runs verbatim. Runtime behaviour is
# untouched — the book still defines what it defines and still calls what it calls.
#
# The blessed sibling is contest28-unset-f-blesses-elision: the identical two definitions with one
# `unset -f` between them, which elides.
foobar__is_converged() {
   foobar status --certs-current -- "$2"
}
foobar sync-certs /etc/nginx/certs

-- foobar.oracle.sh --
foobar__is_converged() {
   verb="$1"; shift
   case "$verb" in
   sync-certs) foobar status --certs-current -- "$1" ;;
   *) return 2 ;;
   esac
}

-- probe-results.txt --
# NO records: the family is withheld, so no site ships a check and nothing measures.

-- mocks/.log --
# newline-safe argv logger for the inert mock shims (slice-4). Sourced by each shim via
# `. "${0%/*}/.log"` (the shim's own dir); a DOTFILE so gate-5/gate-6's `ls`-derived shimset
# never lists it. Shims run under PATH=mocks-only ⇒ BUILTINS ONLY (no sed/awk).
_dorc_logged() {
  _dl_out="ran: ${0##*/}"
  for _dl_a in "$@"; do
    _dl_o=""                                          # pass 1: \ -> \\
    while case $_dl_a in *\\*) true ;; *) false ;; esac; do
      _dl_o="$_dl_o${_dl_a%%\\*}\\\\"; _dl_a=${_dl_a#*\\}
    done
    _dl_a="$_dl_o$_dl_a"
    _dl_o=""                                          # pass 2: newline -> \n
    while case $_dl_a in *"$_DL_NL"*) true ;; *) false ;; esac; do
      _dl_o="$_dl_o${_dl_a%%"$_DL_NL"*}\\n"; _dl_a=${_dl_a#*"$_DL_NL"}
    done
    _dl_out="$_dl_out $_dl_o$_dl_a"
  done
  printf '%s\n' "$_dl_out" >>"$DORC_LOG"
}
_DL_NL='
'

-- mocks/foobar --
#!/bin/sh
# INERT mock: logs that it ran, mutates NOTHING, exits 0.
. "${0%/*}/.log"; _dorc_logged "$@"
exit 0

-- expected.ran --
ran: foobar sync-certs /etc/nginx/certs

-- replay --
$ dorc --book=book.sh --pre-source foobar.oracle.sh --results - < probe-results.txt
reserved: warning[reserved-namespace-squat]: Book function
`foobar__is_converged` sits in the `__is_converged` namespace reserved for
oracle functions; Dorc treats it as ordinary shell and runs it verbatim, but a
shipped oracle preamble defining the same name would collide with it. Rename it
to stay clear of `*__is_converged`.
      [ book.sh:10:1
   10 | foobar__is_converged() {
      | \__________________/
loading: warning[role-family-contested]: This `foobar__is_converged` overrides
the definition at foobar.oracle.sh:1 with nothing spelling the choice, so Dorc
withholds every license from the `foobar` family and its sites run -- an `unset
-f foobar__is_converged` between the two spells the override as chosen.
      [ book.sh:10:1
   10 | foobar__is_converged() {
      | \__________________/
#!/bin/sh
# dorc probe (read-only): checks per-SITE convergence, mutates nothing.
# When run, emits one results-record per site on stdout (the return channel):
#   site <leafid> effect=<holds|absent|cant-tell> rc=<n>
# effect is derived from the probe command's rc (0=holds, 1=absent, else cant-tell);
# rc is the raw PROBE-command status (opaque to Dorc -- the record is the out-of-band lane).

printf 'dorc-records/1 nonce=dorc attempt=1 host=localhost book=d22d309ba20de543a3201346282434b7a25de4c40926edde9d79ae70534396e1 sites=0 @@dorc@@\n'
# site:0 unresolvable-no-probe
printf 'dorc-records-end/1 nonce=dorc @@dorc@@\n'
classify: note[cmdsub-operand-top]: operand 4 is an unresolvable positional
parameter (`$@`/`$*`/`$N`), so Dorc cannot know its value until the command runs
on the host -- there is nothing to resolve and no read-only probe to check. Dorc
elides a command only when it can prove the command's effect is already in
place, so this one is left to run on every apply.
      [ book.sh:11:37
   11 |    foobar status --certs-current -- "$2"
      |                                     \__/

   = repair:  Give the operand a value Dorc can resolve statically -- a literal,
              or a variable assigned from one -- so Dorc can probe it and elide
              the command once it has converged. If the value must stay dynamic,
              load an oracle that vouches for this command's convergence, and
              Dorc will guard the command instead of running it every time.
probe: note[site-unresolvable]: sm 1 site run unprobed (no read-only check could
be shipped): `foobar sync-certs /etc/nginx/certs` -- run `dorc why` for the
per-site detail (the apply runs each anyway, to stay safe)
      [ book.sh:13:1
   13 | foobar sync-certs /etc/nginx/certs
      | \________________________________/

   = help:  sm site runs `foobar sync-certs /etc/nginx/certs`
why: ran because operand 4 is a command-substitution `$(...)` or runtime-dynamic value -- its value couldn't be resolved (first seen at 11:4 `foobar status --certs-current -- "$2"`); so dorc runs it, to stay safe (when unsure, run). to skip it, make the operand a literal Dorc can resolve+probe [resolve-dynamism]
hint: 'foobar' (line 13) is unmodeled: it is the first wall -- an oracle vouching its convergence would elide it when converged
dorc: run `dorc why` for the per-site cause-chains, or `dorc why book.sh:N` to query a source line
