---
xfail: p-x-book-exports-meet-oracle-envelopes
---
-- book.sh --
#!/bin/sh
export VERBOSE=true
wombat ensure alpha
snipe ensure gamma
AWS_PROFILE=staging grebe ensure web1
AWS_PROFILE=prod grebe ensure web1
export PATH="/opt/fake:$PATH"
wombat ensure beta

-- grebe.oracle.sh --
#!/usr/bin/env dorc-sh
# dorc-lang/v0.2
grebe__predict() {
   verb=$1; shift
   ent : test.dorc.Widget = "$1"
   if [ "${2-}" = "" ]; then
      case $verb in
         ensure) grebecheck -q -- "$ent" : test.dorc.Widget:"$ent"@converged ;;
      esac
   fi
}

grebe__is_converged() {
   [ "$1" = ensure ] || return 2
   grebe status -- "$2"
}

-- snipe.oracle.sh --
#!/usr/bin/env dorc-sh
# dorc-lang/v0.2
snipe__predict() {
   verb=$1; shift
   ent : test.dorc.Widget = "$1"
   if [ "${2-}" = "" ]; then
      case $verb in
         ensure) snipecheck -q -- "$ent" : test.dorc.Widget:"$ent"@converged ;;
      esac
   fi
}

snipe__is_converged() {
   [ "$1" = ensure ] || return 2
   snipe status -- "$2"
}

-- wombat.oracle.sh --
#!/usr/bin/env dorc-sh
# dorc-lang/v0.2
wombat__predict() {
   verb=$1; shift
   ent : test.dorc.Widget = "$1"
   if [ "${2-}" = "" ]; then
      case $verb in
         ensure) wombatcheck -q -- "$ent" : test.dorc.Widget:"$ent"@converged ;;
      esac
   fi
}

wombat__is_converged() {
   [ "$1" = ensure ] || return 2
   env -i PATH=/usr/bin:/bin wombat status -- "$2"
}

-- probe-results.txt --
# Five oracled sites in book order: wombat/alpha (1), snipe/gamma (2), grebe/web1-staging (3),
# grebe/web1-prod (4), wombat/beta (6). The two `export` lines (0, 5) mint no site of their own.
site 1 effect=holds rc=0
site 2 effect=holds rc=0
site 3 effect=holds rc=0
site 4 effect=absent rc=1
site 6 effect=holds rc=0

-- mocks/.log --
_dorc_logged() {
   _dl_out="ran: ${0##*/}"
   for _dl_arg in "$@"; do _dl_out="$_dl_out $_dl_arg"; done
   printf '%s\n' "$_dl_out" >>"$DORC_LOG"
}

-- mocks/grebe --
#!/bin/sh
. "${0%/*}/.log"; _dorc_logged "$@"
case "$1" in
   status)
      shift
      [ "$1" = "--" ] && shift
      case "$1" in
         web1) exit 0 ;;
         *) exit 1 ;;
      esac
      ;;
   *) exit 0 ;;
esac

-- mocks/grebecheck --
#!/bin/sh
. "${0%/*}/.log"; _dorc_logged "$@"
exit 0

