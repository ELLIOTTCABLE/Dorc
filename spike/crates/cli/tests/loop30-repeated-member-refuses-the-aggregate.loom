-- book.sh --
#!/bin/sh
# NO-DEDUP, HONOURED CONSERVATIVELY. `for x in a a` is TWO evaluations — dash iterates the list,
# not a set — so the census mints two member routes and never one (`30N` section 2, the `20S`
# member commitments).
#
# CFG shape: a top-level `for` over two IDENTICAL literal words; its body holds one call; the
# spliced body holds one command leaf. One region, one lowered `cfg_node`, two member routes.
#
# Both members resolve `$1` to the same operand, so both establish ONE cell at ONE site. The
# aggregate identity is the exact ordered `(site, fact)` population and it rejects duplicates, so
# the whole region takes the run floor rather than erasing two executions against one vouched
# establish (`rul-every-erased-establish-is-vouched`: identity- AND cardinality-matched). This is
# a deliberate value forfeit in a shape that has no per-member variation to lose, and it is the
# safe direction — the alternative is a proof identity that cannot count its own executions.
install_pkg() {
   apt-get install -y "$1"
}

for pkg in nginx nginx; do
   install_pkg "$pkg"
done

-- pkgindex-predict.oracle.sh --
#!/usr/bin/env dorc-sh
# dorc-lang/v0.2
apt_get__predict() {
   while [ "${1#-}" != "$1" ]; do shift; done
   verb=$1; shift
   while [ "${1#-}" != "$1" ]; do shift; done
   pkg : sm.dorc.Package = "$1"
   if [ "${2-}" = "" ]; then
      case $verb in
         install) dpkg-query -W "$pkg" >/dev/null 2>&1 : sm.dorc.Package:"$pkg"@installed ;;
      esac
   fi
}

-- pkgindex-verdict.oracle.sh --
#!/usr/bin/env dorc-sh
# dorc-lang/v0.2
apt_get__is_converged() {
   while [ "${1#-}" != "$1" ]; do shift; done
   verb=$1; shift
   while [ "${1#-}" != "$1" ]; do shift; done
   case $verb in
      install) aptcheck -q -- "$1" ;;
      *) return 2 ;;
   esac
}

-- probe-results.txt --
# Both members are the same package, so both members' records name ONE cell. Converged or not, the
# aggregate identity refuses the duplicate and the region runs.
site 0.0 effect=holds rc=0
site 0.1 effect=holds rc=0

-- mocks/.log --
_dorc_logged() {
   _dl_out="ran: ${0##*/}"
   for _dl_arg in "$@"; do _dl_out="$_dl_out $_dl_arg"; done
   printf '%s\n' "$_dl_out" >>"$DORC_LOG"
}

-- mocks/apt-get --
#!/bin/sh
. "${0%/*}/.log"; _dorc_logged "$@"
exit 0

-- mocks/aptcheck --
#!/bin/sh
. "${0%/*}/.log"; _dorc_logged "$@"
case ${3-} in curl) exit 1 ;; esac
exit 0

-- mocks/dpkg-query --
#!/bin/sh
. "${0%/*}/.log"; _dorc_logged "$@"
exit 0

-- expected.ran --
ran: apt-get install -y nginx
ran: apt-get install -y nginx

