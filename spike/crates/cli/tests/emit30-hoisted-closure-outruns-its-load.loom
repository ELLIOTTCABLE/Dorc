-- book.sh --
#!/bin/sh
# A file-level oracle CONSTANT is not hoisted above a book line that observes the same name
# (`30Qb:rul-a-loaded-definitions-placement-is-its-load-position`).
#
# CFG SHAPE: one top-level `Simple` (`hork stage`) whose only argument is a parameter expansion of
# `WOMBAT_ROOT`, standing ABOVE the top-level `.` that binds that name. Three top-level `Simple`s
# follow: the unmodeled wall, and the described `wombat sync` whose vouching body reaches the
# constant through a helper.
#
# WHAT IT OBSERVES: `ran: hork stage unset` — the value the book's own text gives that line. The
# hoist this pin was minted against put `WOMBAT_ROOT=/etc/wombat` ahead of that read, so the line
# received a value the authored program never gave it, and the engine's own counterfactual rail
# called the difference an unattributable delta. The artifact already carries this oracle's bytes AT
# THE `.`, because a book-sited dorc-lang root is placed there by the bundle, so the closure needs no
# hoist at all and the preamble carries only what has nowhere else to be.
hork stage "${WOMBAT_ROOT-unset}"
. ./wombat.dorc.sh
hork provision
wombat sync a.conf

-- wombat.dorc.sh --
# dorc-lang/v0.2
# The ordinary two-part closure shape (`pin28-closure-travels-with-the-definition`): a file-level
# constant and a helper the role body delegates to. Both are top-level declarations the funcdef span
# does not cover, so both travel with the pinned definition — and the constant is what collides with
# the book's own read.
WOMBAT_ROOT=/etc/wombat

_wombat_dest() {
   wombat cmp -- "$1" "$WOMBAT_ROOT/$1"
}

wombat__is_converged() {
   _wombat_dest "$2"
}

-- probe-results.txt --
# Site numbering today (leaves in book order): 0 the `hork stage` read, 1 the `.`, 2 the unmodeled
# wall, 3 the described `wombat sync`. Only site 3 is described; it sits past `hork`'s wall, so a
# `holds` cell mints a GUARD rather than an elision — which is what puts the pinned definition and
# its closure on the apply surface, where the placement is readable.
site 3 effect=holds

-- mocks/.log --
_dorc_logged() {
   _dl_out="ran: ${0##*/}"
   for _dl_arg do _dl_out="$_dl_out $_dl_arg"; done
   printf '%s\n' "$_dl_out" >>"$DORC_LOG"
}

-- mocks/hork --
#!/bin/sh
# INERT mock: logs that it ran, mutates NOTHING, exits 0. `hork` is a non-functional stub name —
# under the harness's mocks-only PATH this file is the only thing an executed artifact can reach.
. "${0%/*}/.log"; _dorc_logged "$@"
exit 0

-- mocks/wombat --
#!/bin/sh
# INERT mock: logs that it ran, mutates NOTHING, exits 0. `wombat` is a non-functional stub name —
# under the harness's mocks-only PATH this file is the only thing an executed artifact can reach.
. "${0%/*}/.log"; _dorc_logged "$@"
exit 0

-- expected.ran --
ran: hork stage unset
ran: hork provision
ran: wombat cmp -- a.conf /etc/wombat/a.conf

