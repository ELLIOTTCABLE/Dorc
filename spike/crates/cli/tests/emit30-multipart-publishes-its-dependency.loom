---
run: round-trip
fixpoint: executed
flags: --artifact-dir=out
---
-- book.sh --
#!/bin/sh
# emit30-multipart-publishes-its-dependency (`30I` §7.1 mode 2 · §7.5) — the whole-product half of
# the emission planner: a book that SOURCES a contracted package, run with an artifact stream of its
# own, takes the multipart form and publishes the package beside its plan.
#
# WHAT MAKES THIS THE COMPOUND CASE rather than a unit test. The mirroring rule, the placement
# refusals and the selector are each pinned natively at their seat (`cli::artifact`); what only a
# whole run can show is that the form reaches the REAL binary — the selector runs pre-network from
# authored inputs, the plan projection is bound to the settled form, and the publication happens at
# the edge, in that order, with the ordinary probe-then-apply stdout contract untouched.
#
# THE STDOUT BYTES ARE THE POINT OF COMPARISON: `--artifact-dir` moves the artifact SET off stdout,
# and the plan projection still goes to stdout exactly as it always has (`stdout-contract`), so this
# transcript is byte-for-byte what the same book emits without the flag. A form is about where the
# generated files LIVE, never about what the plan says.
#
# NO `mocks/`, for the reason `pin28-variable-resolved-source-loads` records: `.` is a special
# builtin, so a non-interactive shell that cannot find what it sources EXITS, and the exec rail's
# cwd is an empty throwaway sandbox.
#
# `hork` is unmodeled and walls, so the site below it guards rather than elides — which puts the
# vouching body on the apply surface and makes the run non-vacuous.
. ./wombat.dorc.sh
hork provision
wombat sync a.conf

-- wombat.dorc.sh --
# dorc-lang/v0.2
# The contracted package the book sources. Under the multipart form its STRIPPED bytes are
# published at this same relative path, so the book's own `. ./wombat.dorc.sh` resolves on the
# target with nothing rewritten (`30I` §7.4).
wombat__is_converged() {
   case "${1-}" in
   sync) wombat status --conf -- "${2-}" : sm.dorc.Conf:"$2"@synced ;;
   *) return 2 ;;
   esac
}

-- probe-results.txt --
# The one measured site: the vouched `wombat sync`. It sits PAST `hork`'s wall, so it GUARDS rather
# than elides, which is what puts the vouching body in the artifact's preamble and makes the run
# non-vacuous — a form that carried no oracle material at all would prove nothing about placement.
site 2 effect=holds

-- replay --
$ dorc --book=book.sh --artifact-dir=out --results - < probe-results.txt
#!/bin/sh
# dorc probe (read-only): checks per-SITE convergence, mutates nothing.
# When run, emits one results-record per site on stdout (the return channel):
#   site <leafid> effect=<holds|absent|cant-tell> rc=<n>
# effect is derived from the probe command's rc (0=holds, 1=absent, else cant-tell);
# rc is the raw PROBE-command status (opaque to Dorc -- the record is the out-of-band lane).

printf 'dorc-records/1 nonce=dorc attempt=1 host=localhost book=dc624cd3feac59ec1e048bf6dd12bb114296e3c8c1444b5e7389cf7ab74232db sites=1 @@dorc@@\n'
# site 2: dorc-auto:wombat@converged
wombat__is_converged() {
   case "${1-}" in
   sync) wombat status --conf -- "${2-}" ;;
   *) return 2 ;;
   esac
}
wombat__is_converged 'sync' 'a.conf'; _rc=$?; if [ "$_rc" -eq 0 ]; then _e=holds; elif [ "$_rc" -eq 1 ]; then _e=absent; else _e=cant-tell; fi; printf 'dorc site 2 effect=%s rc=%s @@dorc@@\n' "$_e" "$_rc"
# site:0 unresolvable-no-probe
# site:1 unresolvable-no-probe
printf 'dorc-records-end/1 nonce=dorc @@dorc@@\n'
#!/bin/sh
# dorc apply: the book, with already-converged/dead lines elided (value-preserving stand-in).

# dorc guard preamble: the vouching oracle's own verdict body, shipped strip-only
# (dialect annotations removed, nothing else changed -- rul-ternary-verdict: the
# authored bytes verbatim, no engine-synthesized sh).
wombat__is_converged() {
   case "${1-}" in
   sync) wombat status --conf -- "${2-}" ;;
   *) return 2 ;;
   esac
}

#!/bin/sh
# emit30-multipart-publishes-its-dependency (`30I` §7.1 mode 2 · §7.5) — the whole-product half of
# the emission planner: a book that SOURCES a contracted package, run with an artifact stream of its
# own, takes the multipart form and publishes the package beside its plan.
#
# WHAT MAKES THIS THE COMPOUND CASE rather than a unit test. The mirroring rule, the placement
# refusals and the selector are each pinned natively at their seat (`cli::artifact`); what only a
# whole run can show is that the form reaches the REAL binary — the selector runs pre-network from
# authored inputs, the plan projection is bound to the settled form, and the publication happens at
# the edge, in that order, with the ordinary probe-then-apply stdout contract untouched.
#
# THE STDOUT BYTES ARE THE POINT OF COMPARISON: `--artifact-dir` moves the artifact SET off stdout,
# and the plan projection still goes to stdout exactly as it always has (`stdout-contract`), so this
# transcript is byte-for-byte what the same book emits without the flag. A form is about where the
# generated files LIVE, never about what the plan says.
#
# NO `mocks/`, for the reason `pin28-variable-resolved-source-loads` records: `.` is a special
# builtin, so a non-interactive shell that cannot find what it sources EXITS, and the exec rail's
# cwd is an empty throwaway sandbox.
#
# `hork` is unmodeled and walls, so the site below it guards rather than elides — which puts the
# vouching body on the apply surface and makes the run non-vacuous.
. ./wombat.dorc.sh
hork provision
( wombat__is_converged sync a.conf ) || wombat sync a.conf   # dorc: guard [dorc-auto:wombat converged-vouch; probe: holds]
