---
run: round-trip
fixpoint: executed
artifact-set: published
expect-diagnostic: plan-import-rewritten
---
-- book.sh --
#!/bin/sh
# emit30-multipart-publishes-its-dependency (`30Ng:rul-bundle-at-dorc-lang-boundaries` · `30I` §7.5)
# — the whole-product half of the emission planner: a book that SOURCES a contracted package, run
# with an artifact stream of its own, publishes that package as a BUNDLE and says so in its own
# import line.
#
# WHAT MAKES THIS THE COMPOUND CASE rather than a unit test. The bundling rule, the placement
# refusals and the selector are each pinned natively at their seat (`cli::artifact`); what only a
# whole run can show is that the form reaches the REAL binary — the selector runs pre-network from
# authored inputs, the plan projection is bound to the settled form, the import edit lands as a
# decided plan edit rather than a post-process, and the publication happens at the edge, in that
# order, with the ordinary probe-then-apply stdout contract untouched.
#
# WHAT THE GATES SEE, and it is the whole point of the case: the published tree really holds
# `wombat.dorc-bundle.sh`, and the apply block's `. './wombat.dorc-bundle.sh'` really names it. A
# case that asserted stdout alone could not tell this form from any other, which is exactly how the
# multipart form once shipped having never placed a file (`30Nf:fnd-multipart-never-placed-anything-in-production`).
#
# NO `mocks/`, for the reason `pin28-variable-resolved-source-loads` records: `.` is a special
# builtin, so a non-interactive shell that cannot find what it sources EXITS, and the exec rail's
# cwd is an empty throwaway sandbox.
#
# `hork` is unmodeled and walls, so the site below it guards rather than elides — which puts a
# guard on the apply surface and makes the run non-vacuous. The guard's BODY is NOT in a
# preamble: the artifact carries this package at the author's own `.`, and hoisting a second
# copy above the book is what `30Qb:rul-a-loaded-definitions-placement-is-its-load-position`
# closed.
. ./wombat.dorc.sh
hork provision
wombat sync a.conf

-- wombat.dorc.sh --
# dorc-lang/v0.2
# The contracted package the book sources. It is the point at which this book's dependencies become
# dorc-lang, so it is where the default bundles: its STRIPPED bytes are published as a GENERATED
# file under a generated name, and the plan's import is re-said to name that file rather than this
# one (`30Ng:rul-bundle-at-dorc-lang-boundaries`). The authored file itself is never written.
wombat__is_converged() {
   case "${1-}" in
   sync) wombat status --conf -- "${2-}" : sm.dorc.Conf:"$2"@synced ;;
   *) return 2 ;;
   esac
}

-- probe-results.txt --
# The one measured site: the vouched `wombat sync`. It sits PAST `hork`'s wall, so it GUARDS rather
# than elides, which is what puts the vouching body in the artifact's preamble and makes the run
# non-vacuous — a form that carried no oracle material at all would prove nothing about placement.
site 2 effect=holds

-- replay --
$ dorc --book=book.sh --artifact-dir=$ARTIFACT_DIR --results - < probe-results.txt
#!/bin/sh
# dorc probe (read-only): checks per-SITE convergence, mutates nothing.
# When run, emits one results-record per site on stdout (the return channel):
#   site <leafid> effect=<holds|absent|cant-tell> rc=<n>
# effect is derived from the probe command's rc (0=holds, 1=absent, else cant-tell);
# rc is the raw PROBE-command status (opaque to Dorc -- the record is the out-of-band lane).

printf 'dorc-records/1 nonce=dorc attempt=1 host=localhost book=3b687147140841296a36cb518b03820ffc717a2db5238dd3f918d450f1a68385 sites=1 @@dorc@@\n'
# site 2: dorc-auto:wombat@converged
wombat__is_converged() {
   case "${1-}" in
   sync) wombat status --conf -- "${2-}" ;;
   *) return 2 ;;
   esac
}
wombat__is_converged 'sync' 'a.conf'; _rc=$?; if [ "$_rc" -eq 0 ]; then _e=holds; elif [ "$_rc" -eq 1 ]; then _e=absent; else _e=cant-tell; fi; printf 'dorc site 2 effect=%s rc=%s @@dorc@@\n' "$_e" "$_rc"
# site:0 unresolvable-no-probe
# site:1 unresolvable-no-probe
printf 'dorc-records-end/1 nonce=dorc @@dorc@@\n'
#!/bin/sh
# dorc apply: the book, with already-converged/dead lines elided (value-preserving stand-in).

#!/bin/sh
# emit30-multipart-publishes-its-dependency (`30Ng:rul-bundle-at-dorc-lang-boundaries` · `30I` §7.5)
# — the whole-product half of the emission planner: a book that SOURCES a contracted package, run
# with an artifact stream of its own, publishes that package as a BUNDLE and says so in its own
# import line.
#
# WHAT MAKES THIS THE COMPOUND CASE rather than a unit test. The bundling rule, the placement
# refusals and the selector are each pinned natively at their seat (`cli::artifact`); what only a
# whole run can show is that the form reaches the REAL binary — the selector runs pre-network from
# authored inputs, the plan projection is bound to the settled form, the import edit lands as a
# decided plan edit rather than a post-process, and the publication happens at the edge, in that
# order, with the ordinary probe-then-apply stdout contract untouched.
#
# WHAT THE GATES SEE, and it is the whole point of the case: the published tree really holds
# `wombat.dorc-bundle.sh`, and the apply block's `. './wombat.dorc-bundle.sh'` really names it. A
# case that asserted stdout alone could not tell this form from any other, which is exactly how the
# multipart form once shipped having never placed a file (`30Nf:fnd-multipart-never-placed-anything-in-production`).
#
# NO `mocks/`, for the reason `pin28-variable-resolved-source-loads` records: `.` is a special
# builtin, so a non-interactive shell that cannot find what it sources EXITS, and the exec rail's
# cwd is an empty throwaway sandbox.
#
# `hork` is unmodeled and walls, so the site below it guards rather than elides — which puts a
# guard on the apply surface and makes the run non-vacuous. The guard's BODY is NOT in a
# preamble: the artifact carries this package at the author's own `.`, and hoisting a second
# copy above the book is what `30Qb:rul-a-loaded-definitions-placement-is-its-load-position`
# closed.
. './wombat.dorc-bundle.sh'
hork provision
( wombat__is_converged sync a.conf ) || wombat sync a.conf   # dorc: guard [dorc-auto:wombat converged-vouch; probe: holds]
