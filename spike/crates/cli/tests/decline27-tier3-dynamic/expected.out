#!/bin/sh
# dorc probe (read-only): checks per-SITE convergence, mutates nothing.
# When run, emits one results-record per site on stdout (the return channel):
#   site <leafid> effect=<holds|absent|cant-tell> rc=<n>
# effect is derived from the probe command's rc (0=holds, 1=absent, else cant-tell);
# rc is the raw PROBE-command status (opaque to Dorc — the record is the out-of-band lane).

printf 'dorc-records/1 nonce=dorc attempt=1 host=localhost book=4e5cc5b68f963fcd sites=0 @@dorc@@\n'
# site:0 unresolvable-no-probe
printf 'dorc-records-end/1 nonce=dorc @@dorc@@\n'
#!/bin/sh
# dorc apply: the book, with already-converged/dead lines elided (value-preserving stand-in).

#!/bin/sh
# decline27-tier3-dynamic (`27W` §3 tier-3): the book calls a sysctl write-only trigger key. The
# oracle's is_converged declines it, but its `decline <class>` emission is built from a DYNAMIC
# format string, so the STATIC inventory cannot read the class (class None). The class is recovered
# at RUNTIME: the probe's report-drain (or, here, an injected report-lane record) carries
# `decline unsound …`, and the tier-3 pairing folds it onto the site's decline evidence — so the
# class + emitting-arm file:line surface on the why-lens. No vouch ⇒ the site RUNS.
sysctl vm.drop_caches
