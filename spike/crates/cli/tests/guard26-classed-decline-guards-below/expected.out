#!/bin/sh
# dorc probe (read-only): checks per-SITE convergence, mutates nothing.
# When run, emits one results-record per site on stdout (the return channel):
#   site <leafid> effect=<holds|absent|cant-tell> rc=<n>
# effect is derived from the probe command's rc (0=holds, 1=absent, else cant-tell);
# rc is the raw PROBE-command status (opaque to Dorc -- the record is the out-of-band lane).

printf 'dorc-records/1 nonce=dorc attempt=1 host=localhost book=44a8a19228e6ea62fcc00c8904c98736ea1ae226cedc2a3c8daff2ca467d71e6 sites=2 @@dorc@@\n'
# site 1: sm.dorc.File:/etc/a.conf@content
wombat__is_converged() {
   dst="$2"
   wombat cmp -- "$1" "$dst"
}
wombat__is_converged 'a.conf' '/etc/a.conf'; _rc=$?; if [ "$_rc" -eq 0 ]; then _e=holds; elif [ "$_rc" -eq 1 ]; then _e=absent; else _e=cant-tell; fi; printf 'dorc site 1 effect=%s rc=%s @@dorc@@\n' "$_e" "$_rc"
# site 2: sm.dorc.File:/etc/b.conf@content
wombat__is_converged 'b.conf' '/etc/b.conf'; _rc=$?; if [ "$_rc" -eq 0 ]; then _e=holds; elif [ "$_rc" -eq 1 ]; then _e=absent; else _e=cant-tell; fi; printf 'dorc site 2 effect=%s rc=%s @@dorc@@\n' "$_e" "$_rc"
# site:0 unresolvable-no-probe
printf 'dorc-records-end/1 nonce=dorc @@dorc@@\n'
#!/bin/sh
# dorc apply: the book, with already-converged/dead lines elided (value-preserving stand-in).

# dorc guard preamble: the vouching oracle's own verdict body, shipped strip-only
# (dialect annotations removed, nothing else changed -- rul-ternary-verdict: the
# authored bytes verbatim, no engine-synthesized sh).
wombat__is_converged() {
   dst="$2"
   wombat cmp -- "$1" "$dst"
}

#!/bin/sh
# guard26-classed-decline-guards-below — the FUTURE-pin twin of `guard26-classed-decline-demotes-guard`
# (same three command lines, same oracles, same all-holds records; only the header differs). That
# case's golden records what the engine does TODAY — both drops ship verbatim, the known defect.
# THIS case's goldens record what the repaired engine SHOULD do: both drops GUARD, exactly as in
# `guard26-unmodeled-wall-guards-below`, because the declined verdict-bearing `hork` still RUNS,
# and the drops' evidence (a reached vouch + `holds` on their own authored cells) is byte-identical
# to the evidence that guards them below an unmodeled wall.
#
# XFAIL until the guard-tier ruling lands (`fnd-classed-decline-unwalls-guard-tier`, TODO-ADDTL /
# LIVING_STATUS): today the guard rung is reachable only from `EstablishWritten`, and a modeled
# running wall no longer ⊤-poisons the classify tier, so the wall walk's Replace→Run-only demotion
# leaves these sites with neither elide nor guard. When the repair lands, this case goes XPASS (or
# head-expected.ran screams on any run-set move) — promote it and retire the defect twin's golden.
# Evidence: `trial/r26/predictions.md` §7 · `notes/26F`.
hork provision
( wombat__is_converged a.conf /etc/a.conf ) || wombat a.conf /etc/a.conf   # dorc: guard [sm.dorc.File converged-vouch; probe: holds]
( wombat__is_converged b.conf /etc/b.conf ) || wombat b.conf /etc/b.conf   # dorc: guard [sm.dorc.File converged-vouch; probe: holds]
