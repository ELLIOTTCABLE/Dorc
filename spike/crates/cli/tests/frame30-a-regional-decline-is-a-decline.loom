-- book.sh --
#!/bin/sh
# frame30-a-regional-decline-is-a-decline (`28K` §6 rej-decline-fallthrough-cascade) — the
# expedient's end-to-end grave.
#
# A scan for the first definition that RESOLVES is strictly worse than first-in-load-order: it
# reaches PAST the live body into a shadowed one's arms whenever the live body declines, and then
# reports a measurement from an author no shell would have called. The retired cascade did exactly
# that, and this book is the smallest world that tells the two apart — the region's own body
# declines every argv, and the oracle's would have answered the very same one.
#
# So the in-region site must RUN on its own bytes. `return 2` is ordinary control flow
# (`rul-vouch-is-verdict-authoring`): no vouch, no license. The trailing site, where the oracle's
# definition is live again, keeps its check.
#
# ANTI-MASKING: the oracle's body invokes `foobar status`, so `expected.ran` showing that command
# TWICE would mean the declining region borrowed the oracle's answer.
(
foobar__is_converged() {
   return 2
}
foobar sync-certs /etc/nginx/certs
)
foobar sync-certs /etc/nginx/certs

-- foobar.oracle.sh --
foobar__is_converged() {
   verb="$1"; shift
   case "$verb" in
   sync-certs) foobar status --certs-current -- "$1" ;;
   *) return 2 ;;
   esac
}

-- probe-results.txt --
# Only the post-region site is measured; the in-region one has a declining body and nothing else may
# answer for it.
site 1 effect=holds rc=0

-- mocks/.log --
# newline-safe argv logger for the inert mock shims (slice-4). Sourced by each shim via
# `. "${0%/*}/.log"` (the shim's own dir); a DOTFILE so gate-5/gate-6's `ls`-derived shimset
# never lists it. Shims run under PATH=mocks-only ⇒ BUILTINS ONLY (no sed/awk).
_dorc_logged() {
  _dl_out="ran: ${0##*/}"
  for _dl_a in "$@"; do
    _dl_o=""                                          # pass 1: \ -> \\
    while case $_dl_a in *\\*) true ;; *) false ;; esac; do
      _dl_o="$_dl_o${_dl_a%%\\*}\\\\"; _dl_a=${_dl_a#*\\}
    done
    _dl_a="$_dl_o$_dl_a"
    _dl_o=""                                          # pass 2: newline -> \n
    while case $_dl_a in *"$_DL_NL"*) true ;; *) false ;; esac; do
      _dl_o="$_dl_o${_dl_a%%"$_DL_NL"*}\\n"; _dl_a=${_dl_a#*"$_DL_NL"}
    done
    _dl_out="$_dl_out $_dl_o$_dl_a"
  done
  printf '%s\n' "$_dl_out" >>"$DORC_LOG"
}
_DL_NL='
'

-- mocks/foobar --
#!/bin/sh
# INERT mock: logs that it ran, mutates NOTHING, exits 0.
. "${0%/*}/.log"; _dorc_logged "$@"
exit 0

-- expected.ran --
ran: foobar sync-certs /etc/nginx/certs
ran: foobar status --certs-current -- /etc/nginx/certs

-- replay --
$ dorc --book=book.sh -o foobar.oracle.sh < probe-results.txt
#!/bin/sh
# dorc probe (read-only): checks per-SITE convergence, mutates nothing.
# When run, emits one results-record per site on stdout (the return channel):
#   site <leafid> effect=<holds|absent|cant-tell> rc=<n>
# effect is derived from the probe command's rc (0=holds, 1=absent, else cant-tell);
# rc is the raw PROBE-command status (opaque to Dorc -- the record is the out-of-band lane).

printf 'dorc-records/1 nonce=dorc attempt=1 host=localhost book=55348e8d7f773329c6414acbb935951ba8b3bfacaf191e462ebd97df05328af0 sites=1 @@dorc@@\n'
# site 1: dorc-auto:foobar@converged
foobar__is_converged() {
   verb="$1"; shift
   case "$verb" in
   sync-certs) foobar status --certs-current -- "$1" ;;
   *) return 2 ;;
   esac
}
foobar__is_converged 'sync-certs' '/etc/nginx/certs'; _rc=$?; if [ "$_rc" -eq 0 ]; then _e=holds; elif [ "$_rc" -eq 1 ]; then _e=absent; else _e=cant-tell; fi; printf 'dorc site 1 effect=%s rc=%s @@dorc@@\n' "$_e" "$_rc"
# site:0 unresolvable-no-probe
printf 'dorc-records-end/1 nonce=dorc @@dorc@@\n'
#!/bin/sh
# dorc apply: the book, with already-converged/dead lines elided (value-preserving stand-in).

# dorc guard preamble: the vouching oracle's own verdict body, shipped strip-only
# (dialect annotations removed, nothing else changed -- rul-ternary-verdict: the
# authored bytes verbatim, no engine-synthesized sh).
foobar__is_converged() {
   verb="$1"; shift
   case "$verb" in
   sync-certs) foobar status --certs-current -- "$1" ;;
   *) return 2 ;;
   esac
}

#!/bin/sh
# frame30-a-regional-decline-is-a-decline (`28K` §6 rej-decline-fallthrough-cascade) — the
# expedient's end-to-end grave.
#
# A scan for the first definition that RESOLVES is strictly worse than first-in-load-order: it
# reaches PAST the live body into a shadowed one's arms whenever the live body declines, and then
# reports a measurement from an author no shell would have called. The retired cascade did exactly
# that, and this book is the smallest world that tells the two apart — the region's own body
# declines every argv, and the oracle's would have answered the very same one.
#
# So the in-region site must RUN on its own bytes. `return 2` is ordinary control flow
# (`rul-vouch-is-verdict-authoring`): no vouch, no license. The trailing site, where the oracle's
# definition is live again, keeps its check.
#
# ANTI-MASKING: the oracle's body invokes `foobar status`, so `expected.ran` showing that command
# TWICE would mean the declining region borrowed the oracle's answer.
(
foobar__is_converged() {
   return 2
}
foobar sync-certs /etc/nginx/certs
)
( foobar__is_converged sync-certs /etc/nginx/certs ) || foobar sync-certs /etc/nginx/certs   # dorc: guard [dorc-auto:foobar converged-vouch; probe: holds]
