-- book.sh --
#!/bin/sh
# floor30-subshell-nesting-and-removal-scope — the definition-fixtures battery's nesting shape
# (`28Q` §8 stage-i: ground truth minted before the conversion that will consume it).
#
# `28K` §1 rul-scope-by-subshell-resource sells sh's own scoping as Dorc's whole answer to "I want a
# different oracle for this region", and the frame model the conversion builds has to get two
# less-obvious halves right: a NESTED subshell inherits its parent subshell's re-source (frames
# stack, they do not reset), and an in-subshell `unset -f` dies at the `)` exactly like a definition
# does — removal is frame-local, never a global erasure.
#
# Four measurements: the variant body inside the region, the same body one level deeper, the name
# after an in-subshell `unset -f` (absent there, so the `||` tail speaks), and the base body once
# both regions have closed. Engine agreement over these cells activates at the definition-factoring
# conversion; the answers committed here are the shells' own.
. ./base.sh
( . ./variant.sh; hork__is_converged; ( hork__is_converged ) )
( unset -f hork__is_converged; hork__is_converged 2>/dev/null || printf 'gone\n' )
hork__is_converged

-- base.sh --
hork__is_converged() { printf 'base\n' ;}

-- variant.sh --
hork__is_converged() { printf 'variant\n' ;}

-- expected.emitted --
variant
variant
gone
base

-- expected.ran --

