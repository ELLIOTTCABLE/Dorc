-- book.sh --
#!/bin/sh
# floor28-load-order-last-definition-wins — the differential battery's first shape
# (`28K` §10 bitem8; §5's model-calibration under `KNOBS:kVERIFY`).
#
# `28K` §1 rul-sh-loads-dorc-reads says the oracle answering a site is exactly the definition a
# shell would have live, last-definition-wins. That is a claim ABOUT SHELLS, so it is measured
# against them rather than asserted: this manifest is a which-am-I emitter, run under every
# base-dialect floor binary (`276:rul-spec-two-binary-floor` — `posh 0.14.1` ∩ `dash 0.5.12`), and
# gate-9 requires them to agree with each other and with the committed bytes.
#
# Both orders, each inside its own subshell so the two are independent measurements rather than a
# sequence: sourcing A then B, and sourcing B then A. The engine's model says the answer is the
# LAST one loaded in both, which is `b` and then `a`.
( . ./defs-a.sh; . ./defs-b.sh; hork__is_converged ) || exit 1
( . ./defs-b.sh; . ./defs-a.sh; hork__is_converged ) || exit 1

-- defs-a.sh --
hork__is_converged() { printf 'a\n' ;}

-- defs-b.sh --
hork__is_converged() { printf 'b\n' ;}

-- expected.emitted --
b
a

-- expected.ran --

-- replay --
$ dorc --book=book.sh --results -
#!/bin/sh
# dorc probe (read-only): checks per-SITE convergence, mutates nothing.
# When run, emits one results-record per site on stdout (the return channel):
#   site <leafid> effect=<holds|absent|cant-tell> rc=<n>
# effect is derived from the probe command's rc (0=holds, 1=absent, else cant-tell);
# rc is the raw PROBE-command status (opaque to Dorc -- the record is the out-of-band lane).

printf 'dorc-records/1 nonce=dorc attempt=1 host=localhost book=17a2dbf86d75843db47624b8d61614f4cfb4871760672b862797afa21f6eff77 sites=0 @@dorc@@\n'
# site:0 unresolvable-no-probe
# site:1 unresolvable-no-probe
# site:2 unresolvable-no-probe
# site:3 unresolvable-no-probe
# site:4 unresolvable-no-probe
# site:5 unresolvable-no-probe
# site:6 unresolvable-no-probe
# site:7 unresolvable-no-probe
printf 'dorc-records-end/1 nonce=dorc @@dorc@@\n'
#!/bin/sh
# dorc apply: the book, with already-converged/dead lines elided (value-preserving stand-in).

