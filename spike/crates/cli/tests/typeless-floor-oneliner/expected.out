#!/bin/sh
# dorc probe (read-only): checks per-SITE convergence, mutates nothing.
# When run, emits one results-record per site on stdout (the return channel):
#   site <leafid> effect=<holds|absent|cant-tell> rc=<n>
# effect is derived from the probe command's rc (0=holds, 1=absent, else cant-tell);
# rc is the raw PROBE-command status (opaque to Dorc -- the record is the out-of-band lane).

printf 'dorc-records/1 nonce=dorc attempt=1 host=localhost book=0ba58bf79806c2910b9d73116f202724bb7441c30ae4d1b6812a331d46088ef5 sites=1 @@dorc@@\n'
# site 0: dorc-auto:mycmd@converged
mycmd__is_converged() { mycmd --dry-run "$@" ;}
mycmd__is_converged 'apply-config' '/etc/mycmd.conf'; _rc=$?; if [ "$_rc" -eq 0 ]; then _e=holds; elif [ "$_rc" -eq 1 ]; then _e=absent; else _e=cant-tell; fi; printf 'dorc site 0 effect=%s rc=%s @@dorc@@\n' "$_e" "$_rc"
printf 'dorc-records-end/1 nonce=dorc @@dorc@@\n'
#!/bin/sh
# dorc apply: the book, with already-converged/dead lines elided (value-preserving stand-in).

#!/bin/sh
# typeless-floor-oneliner (DESIGN.md's founding oracle one-liner — `mycmd.is_converged() { mycmd
# --dry-run "$@" ;}`). The markerless delegation vouches (quoted "$@" resolves), and a converged
# probe elides the site. Pins the founding example: it MUST license, and never silently regress.
# mycmd apply-config /etc/mycmd.conf   # dorc: elided (already converged / dead branch)
