-- book.sh --
#!/bin/sh
# floor28-define-if-absent-polyfill — the differential battery's polyfill shape (`28K` §10 bitem8),
# and the shell half of the decidable-condition fold's two worlds (`28M` §9; ledger `28P`).
#
# The fold decides `command -v <a literal name the unit DEFINES>` and masks the arm it proves dead.
# Its two worlds are textual orders of the same two files:
#   P1 — the polyfill is loaded FIRST, so its guard finds a free slot and its body lands; the real
#        oracle then overrides it unconditionally, and the polyfill's definition binds nowhere;
#   P2 — the real oracle is loaded FIRST, so the polyfill's guard finds the slot taken and defines
#        nothing at all.
# `28K` §1 calls the guarded incoming definition exempt "as a consequence, not a blessing": under
# plain sh it cannot override. That is the sentence this manifest measures — in BOTH orders the
# winner must be the real oracle, and the polyfill must never be the answer.
( . ./polyfill.sh; . ./real.sh; hork__is_converged )
( . ./real.sh; . ./polyfill.sh; hork__is_converged )

-- polyfill.sh --
# The define-if-absent idiom, in the canonical `if` form (`28K` §10 bitem8: the `||` operand form
# is a separate parse question and is never canonical).
if ! command -v hork__is_converged >/dev/null 2>&1; then
   hork__is_converged() { printf 'polyfill\n' ;}
fi

-- real.sh --
hork__is_converged() { printf 'real\n' ;}

-- expected.emitted --
real
real

-- expected.ran --

-- replay --
$ dorc --book=book.sh
#!/bin/sh
# dorc probe (read-only): checks per-SITE convergence, mutates nothing.
# When run, emits one results-record per site on stdout (the return channel):
#   site <leafid> effect=<holds|absent|cant-tell> rc=<n>
# effect is derived from the probe command's rc (0=holds, 1=absent, else cant-tell);
# rc is the raw PROBE-command status (opaque to Dorc -- the record is the out-of-band lane).

printf 'dorc-records/1 nonce=dorc attempt=1 host=localhost book=d5b3f03314e3be01b31e8e7d4172b84f5f99de66cbf927134845122b43980ae8 sites=0 @@dorc@@\n'
# site:0 unresolvable-no-probe
# site:1 unresolvable-no-probe
# site:2 unresolvable-no-probe
# site:3 unresolvable-no-probe
# site:4 unresolvable-no-probe
# site:5 unresolvable-no-probe
printf 'dorc-records-end/1 nonce=dorc @@dorc@@\n'
#!/bin/sh
# dorc apply: the book, with already-converged/dead lines elided (value-preserving stand-in).

