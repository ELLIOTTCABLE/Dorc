-- book.sh --
#!/bin/sh
# emit30-two-live-verdicts-under-one-name — the MEASUREMENT cell for whether the hash-munge
# emission tier (`plan/CLAUDE.md pinned-definitions-are-the-artifact's-binding`, rule 3) is
# reachable at all. `28Q` §1 records it as UNWITNESSED and points at subshell regions
# (`307c:fnd-written-establishes-in-a-region-ship-no-check`) as the obstacle; this cell takes the
# other route — the `unset -f` blessing at TOP level, where a written establish does ship and does
# guard.
#
# `hork` is unmodeled and walls, so both `foobar` sites GUARD rather than elide, which is what puts
# two pinned definitions on the apply surface. The site above the blessing resolves to the ORACLE's
# case body; the site below resolves to the BOOK's straight-line body. One name, two distinct live
# bodies, one artifact.
hork provision
foobar sync-certs /etc/nginx/certs
unset -f foobar__is_converged
foobar__is_converged() {
   foobar status --certs-current -- "$2"
}
foobar sync-certs /etc/other/certs

-- foobar.oracle.sh --
foobar__is_converged() {
   verb="$1"; shift
   case "$verb" in
   sync-certs) foobar status --certs-current -- "$1" ;;
   *) return 2 ;;
   esac
}

-- probe-results.txt --
# Both guarded sites answer converged, so both mint their guard.
site 1 effect=holds rc=0
site 3 effect=holds rc=0

-- mocks/.log --
# newline-safe argv logger for the inert mock shims (slice-4). Sourced by each shim via
# `. "${0%/*}/.log"` (the shim's own dir); a DOTFILE so gate-5/gate-6's `ls`-derived shimset
# never lists it. Shims run under PATH=mocks-only ⇒ BUILTINS ONLY (no sed/awk).
_dorc_logged() {
  _dl_out="ran: ${0##*/}"
  for _dl_a in "$@"; do
    _dl_o=""                                          # pass 1: \ -> \\
    while case $_dl_a in *\\*) true ;; *) false ;; esac; do
      _dl_o="$_dl_o${_dl_a%%\\*}\\\\"; _dl_a=${_dl_a#*\\}
    done
    _dl_a="$_dl_o$_dl_a"
    _dl_o=""                                          # pass 2: newline -> \n
    while case $_dl_a in *"$_DL_NL"*) true ;; *) false ;; esac; do
      _dl_o="$_dl_o${_dl_a%%"$_DL_NL"*}\\n"; _dl_a=${_dl_a#*"$_DL_NL"}
    done
    _dl_out="$_dl_out $_dl_o$_dl_a"
  done
  printf '%s\n' "$_dl_out" >>"$DORC_LOG"
}
_DL_NL='
'

-- mocks/hork --
#!/bin/sh
# INERT mock for the unmodeled wall command.
. "${0%/*}/.log"; _dorc_logged "$@"
exit 0

-- mocks/foobar --
#!/bin/sh
# INERT mock. Both guards' checks answer rc 0, so neither `sync-certs` mutation runs.
. "${0%/*}/.log"; _dorc_logged "$@"
exit 0

