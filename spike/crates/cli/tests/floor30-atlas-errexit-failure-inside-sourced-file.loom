-- book.sh --
#!/bin/sh
# floor30-atlas-errexit-failure-inside-sourced-file — QUESTION: the CALLER has errexit on and a
# command in the MIDDLE of the sourced file fails. Does the whole script end there, does only the
# file stop, or neither?
#
# Why the inclusion design needs it: this is the errexit half of "textual inclusion is exact". If a
# mid-file failure kills the script, a bundled dependency's ordinary defensive line — one whose
# non-zero status its author meant nothing by — becomes fatal at a position that author never wrote.
set -e
printf 'book-before\n'
. ./failure.sh
printf 'book-after-dot\n'

-- failure.sh --
printf 'file-before-false\n'
false
printf 'file-after-false\n'

-- expected.emitted --
book-before
file-before-false

-- expected.ran --

-- replay --
$ dorc --book=book.sh --results -
#!/bin/sh
# dorc probe (read-only): checks per-SITE convergence, mutates nothing.
# When run, emits one results-record per site on stdout (the return channel):
#   site <leafid> effect=<holds|absent|cant-tell> rc=<n>
# effect is derived from the probe command's rc (0=holds, 1=absent, else cant-tell);
# rc is the raw PROBE-command status (opaque to Dorc -- the record is the out-of-band lane).

printf 'dorc-records/1 nonce=dorc attempt=1 host=localhost book=f8f6051d6e41b6df7ff0c490aaa2d3af60b2e646f11ff0358f6e14733a537f14 sites=0 @@dorc@@\n'
# site:0 unresolvable-no-probe
# site:1 unresolvable-no-probe
# site:2 unresolvable-no-probe
# site:3 unresolvable-no-probe
printf 'dorc-records-end/1 nonce=dorc @@dorc@@\n'
#!/bin/sh
# dorc apply: the book, with already-converged/dead lines elided (value-preserving stand-in).

#!/bin/sh
# floor30-atlas-errexit-failure-inside-sourced-file — QUESTION: the CALLER has errexit on and a
# command in the MIDDLE of the sourced file fails. Does the whole script end there, does only the
# file stop, or neither?
#
# Why the inclusion design needs it: this is the errexit half of "textual inclusion is exact". If a
# mid-file failure kills the script, a bundled dependency's ordinary defensive line — one whose
# non-zero status its author meant nothing by — becomes fatal at a position that author never wrote.
set -e
printf 'book-before\n'
. ./failure.sh
printf 'book-after-dot\n'
