-- book.sh --
#!/bin/sh
# floor30-atlas-return-inside-compound-in-sourced-file — QUESTION: at a sourced file's top level, a
# `return` inside `( … )`, inside `{ … }`, and inside `if … fi` — which of the three leave the FILE,
# and which leave only the enclosing subshell?
#
# Why the inclusion design needs it: the paste-exclusion set is stated as "a top-level `return`", and
# whether a `return` nested one compound deep still counts as top-level is precisely the boundary a
# scanner would have to draw. Three separate sourced files, so a cell that ends its own file cannot
# hide the next: a missing `*-file-tail` line IS that cell's answer.
. ./sub.sh
printf 'book: after-sub-file status=[%s]\n' "$?"
. ./brace.sh
printf 'book: after-brace-file status=[%s]\n' "$?"
. ./ifc.sh
printf 'book: after-if-file status=[%s]\n' "$?"
printf 'book-tail\n'

-- sub.sh --
( printf 'sub-in\n'; return 3; printf 'sub-after-return\n' )
printf 'sub-file-tail status=[%s]\n' "$?"

-- brace.sh --
{ printf 'brace-in\n'; return 4; printf 'brace-after-return\n'; }
printf 'brace-file-tail\n'

-- ifc.sh --
if true; then printf 'if-in\n'; return 5; printf 'if-after-return\n'; fi
printf 'if-file-tail\n'

-- expected.emitted --
sub-in
sub-file-tail status=[3]
book: after-sub-file status=[0]
brace-in
book: after-brace-file status=[4]
if-in
book: after-if-file status=[5]
book-tail

-- expected.ran --

-- replay --
$ dorc --book=book.sh --results -
loading: warning[load-carriage-withheld-under-unknown-cwd]: [unwritten:
