---
run: round-trip
fixpoint: executed
---
-- book.sh --
#!/bin/sh
# floor30-atlas-dollar-zero-inside-sourced-file — QUESTION: inside a sourced file, does `$0` name the
# BOOK (the sourcer) or the sourced file? And therefore does `${0%/*}` inside a dependency point at
# the book's directory or at its own?
#
# Why the inclusion design needs it: `principle-load-operands-evaluate-over-controller-known-inputs`
# resolves a `.` operand from the book's own path, and a nested load spelling `${0%/*}` inside a
# dependency has to resolve from the SAME path or the model is wrong one level down. POSIX says `.`
# does not rebind `$0`; this is that claim measured rather than cited.
#
# Every cell COMPARES rather than prints: the harness runs the manifest from a throwaway scratch
# directory, so emitting `$0` itself would commit a path that changes every run. A cell asking about
# `$0`'s SHAPE was removed for a stronger reason — it was minted `[yes]` under WSL and went red
# `[no]` on the Windows leg, because the rail passes the script path with the platform's own
# separator (`gap-dollar-zero-shape-is-platform-bound`, stated in full in
# `floor30-atlas-dollar-zero-spellings`). What survives here is the relation between the two `$0`s,
# which is a dialect fact rather than a harness one.
book_zero=$0
book_dir=${0%/*}
. ./zeroer.sh
printf 'book-tail\n'

-- zeroer.sh --
if [ "$0" = "$book_zero" ]; then
   printf 'file: zero-same-as-book=[yes]\n'
else
   printf 'file: zero-same-as-book=[no]\n'
fi
if [ "${0%/*}" = "$book_dir" ]; then
   printf 'file: zero-dir-same-as-book=[yes]\n'
else
   printf 'file: zero-dir-same-as-book=[no]\n'
fi
case $0 in
*zeroer.sh) printf 'file: zero-names-this-file=[yes]\n' ;;
*) printf 'file: zero-names-this-file=[no]\n' ;;
esac

-- expected.emitted --
file: zero-same-as-book=[yes]
file: zero-dir-same-as-book=[yes]
file: zero-names-this-file=[no]
book-tail

-- expected.ran --

-- replay --
$ dorc --book=book.sh --results -
#!/bin/sh
# dorc probe (read-only): checks per-SITE convergence, mutates nothing.
# When run, emits one results-record per site on stdout (the return channel):
#   site <leafid> effect=<holds|absent|cant-tell> rc=<n>
# effect is derived from the probe command's rc (0=holds, 1=absent, else cant-tell);
# rc is the raw PROBE-command status (opaque to Dorc -- the record is the out-of-band lane).

printf 'dorc-records/1 nonce=dorc attempt=1 host=localhost book=d4c06a7c4a700e0acf64f0c1a746c08a86d5d7a8b1086c56bbaf40e83ad865ac sites=0 @@dorc@@\n'
# site:0 unresolvable-no-probe
# site:1 unresolvable-no-probe
# site:2 unresolvable-no-probe
# site:3 unresolvable-no-probe
printf 'dorc-records-end/1 nonce=dorc @@dorc@@\n'
#!/bin/sh
# dorc apply: the book, with already-converged/dead lines elided (value-preserving stand-in).

#!/bin/sh
