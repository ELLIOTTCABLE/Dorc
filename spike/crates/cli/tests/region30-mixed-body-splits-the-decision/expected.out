#!/bin/sh
# dorc probe (read-only): checks per-SITE convergence, mutates nothing.
# When run, emits one results-record per site on stdout (the return channel):
#   site <leafid> effect=<holds|absent|cant-tell> rc=<n>
# effect is derived from the probe command's rc (0=holds, 1=absent, else cant-tell);
# rc is the raw PROBE-command status (opaque to Dorc -- the record is the out-of-band lane).

printf 'dorc-records/1 nonce=dorc attempt=1 host=localhost book=b4bb662c36418e8325a79b43dd57761f8d0def8a5d2490c5962c0b414c2820d8 sites=2 @@dorc@@\n'
# site 0.0: sm.dorc.Package:nginx@installed
apt_get__is_converged() {
   while [ "${1#-}" != "$1" ]; do shift; done
   verb=$1; shift
   while [ "${1#-}" != "$1" ]; do shift; done
   case $verb in
      install) aptcheck -q -- "$1" ;;
      *) return 2 ;;
   esac
}
apt_get__is_converged 'install' '-y' 'nginx'; _rc=$?; if [ "$_rc" -eq 0 ]; then _e=holds; elif [ "$_rc" -eq 1 ]; then _e=absent; else _e=cant-tell; fi; printf 'dorc site 0.0 effect=%s rc=%s @@dorc@@\n' "$_e" "$_rc"
# site 0.2: sm.dorc.Package:curl@installed
apt_get__is_converged 'install' '-y' 'curl'; _rc=$?; if [ "$_rc" -eq 0 ]; then _e=holds; elif [ "$_rc" -eq 1 ]; then _e=absent; else _e=cant-tell; fi; printf 'dorc site 0.2 effect=%s rc=%s @@dorc@@\n' "$_e" "$_rc"
printf 'dorc-records-end/1 nonce=dorc @@dorc@@\n'
#!/bin/sh
# dorc apply: the book, with already-converged/dead lines elided (value-preserving stand-in).

# dorc guard preamble: the vouching oracle's own verdict body, shipped strip-only
# (dialect annotations removed, nothing else changed -- rul-ternary-verdict: the
# authored bytes verbatim, no engine-synthesized sh).
apt_get__is_converged() {
   while [ "${1#-}" != "$1" ]; do shift; done
   verb=$1; shift
   while [ "${1#-}" != "$1" ]; do shift; done
   case $verb in
      install) aptcheck -q -- "$1" ;;
      *) return 2 ;;
   esac
}

# dorc: end of lifted material; the book follows, in its authored order.

#!/bin/sh
# THE MOTIVATING SHAPE (`plans/30L` §1): the whole book wrapped in one function, with one live
# command in the middle. Under the all-or-nothing CALL license a single unmodeled `hork` forfeited
# the ENTIRE body; region decisions forfeit only the region that failed.
#
# What this pins: three different answers inside ONE definition, decided independently.
#   nginx  converged, nothing before it            => Replace, at the authored region
#   hork   unmodeled                               => Run (it is the wall)
#   curl   converged, but past hork's running wall => Guard (re-decides live; rul-ternary-verdict)
# and `main "$@"` stays a CALL, untouched (`30L:rul-edit-authored-definition-once`).
main() {
   true   # dorc: elided [apt-get install -y nginx] (already converged / dead branch)
   hork tune-packages
   ( apt_get__is_converged install -y curl ) || apt-get install -y curl   # dorc: guard [sm.dorc.Package converged-vouch; probe: holds]
}

main "$@"
