#!/bin/sh
# dorc probe (read-only): checks per-SITE convergence, mutates nothing.
# When run, emits one results-record per site on stdout (the return channel):
#   site <leafid> effect=<holds|absent|cant-tell> rc=<n>
# effect is derived from the probe command's rc (0=holds, 1=absent, else cant-tell);
# rc is the raw PROBE-command status (opaque to Dorc -- the record is the out-of-band lane).

printf 'dorc-records/1 nonce=dorc attempt=1 host=localhost book=c1a77673be13cf18b196d23939272485d3d1c0d704e766b2c650bf6b8bf098ad sites=0 @@dorc@@\n'
# site:0 unresolvable-no-probe
printf 'dorc-records-end/1 nonce=dorc @@dorc@@\n'
#!/bin/sh
# dorc apply: the book, with already-converged/dead lines elided (value-preserving stand-in).

#!/bin/sh
# wrapper-dual-peel-incoherent-fails-fast (273 §5): the loaded wrapper oracle's __predict and
# __lend_map peel to DIFFERENT tail positions (predict shifts the verb, lend_map does not) — static
# incoherence ⇒ dorc fast-fails (exit 11, EXIT_WRAPPER_INCOHERENT). The artifact still ships; the
# book's own `hork setup` site is unrelated and walls (unmodeled). Pins the fail-fast is loud + the
# artifact is emitted (declarations-genuinely-contradict, pre-network).
hork setup
