-- book.sh --
#!/bin/sh
# dorc-lang/v0.2
# frame30-two-live-predicts-key-two-cells (`308:cr-license-chain-untested-end-to-end`) — the frame
# answer driven all the way through fact-mint, probe, and disposition.
#
# The frame differential proves which DEFINITION the environment names; the `frame30-*` verdict cells
# prove which BODY ships. Neither drives two live `__predict` definitions whose argparse arms and
# typed cells DIFFER, which is where the chimera would show as a wrong coordinate rather than a wrong
# body: identity resolved through one author's arms while cells are read from another's.
#
# Two sites, one role name, two live definitions declaring DIFFERENT kinds. The region's body binds a
# Service and asserts `@active`; the oracle's binds a Package and asserts `@installed`. Same book
# argv at both sites.
#
# ANTI-MASKING, three ways, all visible in the probe artifact: the per-site cell comment names the
# coordinate each site keyed, the shipped bodies invoke different check commands (`widget probe
# --svc` vs `widget query --pkg`), and the two sites are fed CONFLICTING facts, so their dispositions
# must differ. A single cell name across both sites, or one body answering both, means the frame
# lookup collapsed back to a whole-unit winner.
(
widget__predict() {
   verb=$1; shift
   svc : sm.dorc.Service = "$1"
   case $verb in
      sync) widget probe --svc "$svc"   : sm.dorc.Service:"$svc"@active ;;
   esac
}
widget sync alpha
)
widget sync alpha

-- widget.oracle.sh --
# dorc-lang/v0.2
widget__predict() {
   verb=$1; shift
   pkg : sm.dorc.Package = "$1"
   case $verb in
      sync) widget query --pkg "$pkg"   : sm.dorc.Package:"$pkg"@installed ;;
   esac
}
widget__is_converged() {
   verb=$1; shift
   case $verb in
      sync) widget query --pkg "$1" ;;
   esac
}

-- probe-results.txt --
# CONFLICTING by design, keyed per SITE (`inv-site-keyed-results`): the in-region site's Service cell
# holds, the trailing site's Package cell does not. Two frames, two cells, two dispositions.
#
# `probe-results: authored` is why gate-1 accepts that: the inert `widget` mock exits 0 for every
# invocation, so a world where one cell diverges cannot be produced by running the shims — it can
# only be described. The FACTS here are the host's answer, not a prediction the check should have
# made, so this is not an anti-masking exemption.
site 0 effect=holds rc=0
site 1 effect=absent rc=1

-- mocks/.log --
# newline-safe argv logger for the inert mock shims (slice-4). Sourced by each shim via
# `. "${0%/*}/.log"` (the shim's own dir); a DOTFILE so gate-5/gate-6's `ls`-derived shimset
# never lists it. Shims run under PATH=mocks-only ⇒ BUILTINS ONLY (no sed/awk).
_dorc_logged() {
  _dl_out="ran: ${0##*/}"
  for _dl_a in "$@"; do
    _dl_o=""                                          # pass 1: \ -> \\
    while case $_dl_a in *\\*) true ;; *) false ;; esac; do
      _dl_o="$_dl_o${_dl_a%%\\*}\\\\"; _dl_a=${_dl_a#*\\}
    done
    _dl_a="$_dl_o$_dl_a"
    _dl_o=""                                          # pass 2: newline -> \n
    while case $_dl_a in *"$_DL_NL"*) true ;; *) false ;; esac; do
      _dl_o="$_dl_o${_dl_a%%"$_DL_NL"*}\\n"; _dl_a=${_dl_a#*"$_DL_NL"}
    done
    _dl_out="$_dl_out $_dl_o$_dl_a"
  done
  printf '%s\n' "$_dl_out" >>"$DORC_LOG"
}
_DL_NL='
'

-- mocks/widget --
#!/bin/sh
# INERT mock: logs that it ran, mutates NOTHING, exits 0.
. "${0%/*}/.log"; _dorc_logged "$@"
exit 0

-- expected.ran --
ran: widget sync alpha

-- replay --
$ dorc --book=book.sh -o widget.oracle.sh < probe-results.txt
#!/bin/sh
# dorc probe (read-only): checks per-SITE convergence, mutates nothing.
# When run, emits one results-record per site on stdout (the return channel):
#   site <leafid> effect=<holds|absent|cant-tell> rc=<n>
# effect is derived from the probe command's rc (0=holds, 1=absent, else cant-tell);
# rc is the raw PROBE-command status (opaque to Dorc -- the record is the out-of-band lane).

printf 'dorc-records/1 nonce=dorc attempt=1 host=localhost book=aa7202f633ea0a4e7d6ad1ce1f41bae94fb57c2e61d9f523206c7bf6ed039cf4 sites=2 @@dorc@@\n'
# site 0: sm.dorc.Service:alpha@active
widget__is_converged() {
   verb=$1; shift
   case $verb in
      sync) widget query --pkg "$1" ;;
   esac
}
widget__is_converged 'sync' 'alpha'; _rc=$?; if [ "$_rc" -eq 0 ]; then _e=holds; elif [ "$_rc" -eq 1 ]; then _e=absent; else _e=cant-tell; fi; printf 'dorc site 0 effect=%s rc=%s @@dorc@@\n' "$_e" "$_rc"
# site 1: sm.dorc.Package:alpha@installed
widget__is_converged 'sync' 'alpha'; _rc=$?; if [ "$_rc" -eq 0 ]; then _e=holds; elif [ "$_rc" -eq 1 ]; then _e=absent; else _e=cant-tell; fi; printf 'dorc site 1 effect=%s rc=%s @@dorc@@\n' "$_e" "$_rc"
printf 'dorc-records-end/1 nonce=dorc @@dorc@@\n'
#!/bin/sh
# dorc apply: the book, with already-converged/dead lines elided (value-preserving stand-in).

