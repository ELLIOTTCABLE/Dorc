#!/bin/sh
# dorc probe (read-only): checks per-SITE convergence, mutates nothing.
# When run, emits one results-record per site on stdout (the return channel):
#   site <leafid> effect=<holds|absent|cant-tell> rc=<n>
# effect is derived from the probe command's rc (0=holds, 1=absent, else cant-tell);
# rc is the raw PROBE-command status (opaque to Dorc — the record is the out-of-band lane).

printf 'dorc-records/1 nonce=dorc attempt=1 host=localhost book=f8060f47c5706ea9beb2796e9a18474a89ddbf1eb825b68c0fecf1d1bfe0c364 sites=2 @@dorc@@\n'
# site 0: sm.dorc.Package:nginx@tuned
hork__predict() {
   verb=$1; shift
   pkg="$1"
   case $verb in tune) dpkg-query -W "$pkg" >/dev/null 2>&1 ;; esac
}
hork__predict 'tune' 'nginx'; _rc=$?; if [ "$_rc" -eq 0 ]; then _e=holds; elif [ "$_rc" -eq 1 ]; then _e=absent; else _e=cant-tell; fi; printf 'dorc site 0 effect=%s rc=%s @@dorc@@\n' "$_e" "$_rc"
# site 1: sm.dorc.File:/etc/nginx/nginx.conf@present
installfile__predict() {
   f="$1"
   stat -- "$1" >/dev/null 2>&1
}
installfile__predict '/etc/nginx/nginx.conf'; _rc=$?; if [ "$_rc" -eq 0 ]; then _e=holds; elif [ "$_rc" -eq 1 ]; then _e=absent; else _e=cant-tell; fi; printf 'dorc site 1 effect=%s rc=%s @@dorc@@\n' "$_e" "$_rc"
# dorc reach-probe (read-only, 24G §4): owner-declared reaches() expansion. Each dynamic
# reaches() arm of a reach-bearing footprint coord runs with the ENTITY; when run it prints
# the RAW ENTITIES it drags (its stdout lines), re-keyed by the coord AND the arm index:
#   reach <kind:entity> arm=<n> entity=<reached>
# The controller joins arm->kind statically (the kind is fixed at lift — never host-minted).

# reach sm.dorc.Package:nginx via sm.dorc.Package.reaches() arm 0
sm_dorc_Package__disturbance_reaches_only_0() { dpkg -L "$1" ; }
sm_dorc_Package__disturbance_reaches_only_0 'nginx' | while IFS= read -r _re; do printf 'dorc reach sm.dorc.Package:nginx arm=0 entity=%s @@dorc@@\n' "$_re"; done
printf 'dorc-records-end/1 nonce=dorc @@dorc@@\n'
#!/bin/sh
# dorc apply: the book, with already-converged/dead lines elided (value-preserving stand-in).

hork tune nginx
installfile /etc/nginx/nginx.conf
