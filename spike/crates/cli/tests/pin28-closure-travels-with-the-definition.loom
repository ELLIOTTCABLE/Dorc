-- book.sh --
#!/bin/sh
# pin28-closure-travels-with-the-definition (`28K` §4 rul-pin-by-definition-bytes) — a verdict body
# that is NOT self-contained, end to end.
#
# The oracle's `wombat__is_converged` calls a helper and reads a file-level constant, and neither
# travels with the funcdef span. Before this pass, both lanes shipped the funcdef ALONE: the probe
# ran a body whose `_wombat_dest` was undefined (rc 127 ⇒ cant-tell) and the apply preamble hoisted
# the same broken body. Usually that fails safe, but not reliably — a body that ignores a helper's
# status and answers 0 from a later test reports converged off a helper that never ran, which is
# the priority-1 under-execute. So the pinned unit is the definition PLUS its closure.
#
# What to read in the transcript: the helper and the constant appear ONCE in the probe (above the
# check) and ONCE in the apply preamble (above the book), and the guard invokes the plain authored
# name — the single-definition case, byte-identical to strip.
#
# `hork` is unmodeled, so it WALLS: the site below it is an `EstablishWritten` with a reached vouch
# and a `holds` record, which mints a guard rather than an elision. That is what puts the pinned
# definition on the apply surface where it can be read.
hork provision
wombat sync a.conf

-- wombat.oracle.sh --
# dorc-lang/v0.2
# The two-part shape the closure exists for: a file-level constant (`28K` §2a calls these a
# must-have) and a helper the role body delegates to. Both are top-level declarations the funcdef
# span does not cover, and both are provably inert to load, which is what licenses hoisting them.
WOMBAT_ROOT=/etc/wombat

_wombat_dest() {
   wombat cmp -- "$1" "$WOMBAT_ROOT/$1"
}

wombat__is_converged() {
   _wombat_dest "$2"
}

-- probe-results.txt --
# The walled site's own auto-cell: rc 0 ⇒ converged ⇒ its guard is minted.
site 1 effect=holds rc=0

-- mocks/.log --
# newline-safe argv logger for the inert mock shims (slice-4). Sourced by each shim via
# `. "${0%/*}/.log"` (the shim's own dir); a DOTFILE so gate-5/gate-6's `ls`-derived shimset
# never lists it. Shims run under PATH=mocks-only ⇒ BUILTINS ONLY (no sed/awk).
_dorc_logged() {
  _dl_out="ran: ${0##*/}"
  for _dl_a in "$@"; do
    _dl_o=""                                          # pass 1: \ -> \\
    while case $_dl_a in *\\*) true ;; *) false ;; esac; do
      _dl_o="$_dl_o${_dl_a%%\\*}\\\\"; _dl_a=${_dl_a#*\\}
    done
    _dl_a="$_dl_o$_dl_a"
    _dl_o=""                                          # pass 2: newline -> \n
    while case $_dl_a in *"$_DL_NL"*) true ;; *) false ;; esac; do
      _dl_o="$_dl_o${_dl_a%%"$_DL_NL"*}\\n"; _dl_a=${_dl_a#*"$_DL_NL"}
    done
    _dl_out="$_dl_out $_dl_o$_dl_a"
  done
  printf '%s\n' "$_dl_out" >>"$DORC_LOG"
}
_DL_NL='
'

-- mocks/hork --
#!/bin/sh
# INERT mock for the unmodeled wall command.
. "${0%/*}/.log"; _dorc_logged "$@"
exit 0

-- mocks/wombat --
#!/bin/sh
# INERT mock. It answers for BOTH roles: the probe's `wombat cmp -- …` (reached THROUGH the
# closure's helper, which is the whole point — an unshipped helper would make this rc 127) and the
# guard's live re-check at apply. Mutates nothing; the run-log is the whole observable.
. "${0%/*}/.log"; _dorc_logged "$@"
exit 0

-- expected.ran --
ran: hork provision
ran: wombat cmp -- a.conf /etc/wombat/a.conf

-- replay --
$ dorc --book=book.sh --pre-source wombat.oracle.sh --results - < probe-results.txt
#!/bin/sh
# dorc probe (read-only): checks per-SITE convergence, mutates nothing.
# When run, emits one results-record per site on stdout (the return channel):
#   site <leafid> effect=<holds|absent|cant-tell> rc=<n>
# effect is derived from the probe command's rc (0=holds, 1=absent, else cant-tell);
# rc is the raw PROBE-command status (opaque to Dorc -- the record is the out-of-band lane).

printf 'dorc-records/1 nonce=dorc attempt=1 host=localhost book=6a7afc5c76a1dc8599c973abec0ceda4b3867d2cbcd93d49005cb4f615e2833b sites=1 @@dorc@@\n'
# site 1: dorc-auto:wombat@converged
WOMBAT_ROOT=/etc/wombat
_wombat_dest() {
   wombat cmp -- "$1" "$WOMBAT_ROOT/$1"
}
wombat__is_converged() {
   _wombat_dest "$2"
}
wombat__is_converged 'sync' 'a.conf'; _rc=$?; if [ "$_rc" -eq 0 ]; then _e=holds; elif [ "$_rc" -eq 1 ]; then _e=absent; else _e=cant-tell; fi; printf 'dorc site 1 effect=%s rc=%s @@dorc@@\n' "$_e" "$_rc"
# site:0 unresolvable-no-probe
printf 'dorc-records-end/1 nonce=dorc @@dorc@@\n'
#!/bin/sh
# dorc apply: the book, with already-converged/dead lines elided (value-preserving stand-in).

# dorc guard preamble: the vouching oracle's own verdict body, shipped strip-only
# (dialect annotations removed, nothing else changed -- rul-ternary-verdict: the
# authored bytes verbatim, no engine-synthesized sh).
WOMBAT_ROOT=/etc/wombat
_wombat_dest() {
   wombat cmp -- "$1" "$WOMBAT_ROOT/$1"
}
wombat__is_converged() {
   _wombat_dest "$2"
}

#!/bin/sh
# pin28-closure-travels-with-the-definition (`28K` §4 rul-pin-by-definition-bytes) — a verdict body
# that is NOT self-contained, end to end.
#
# The oracle's `wombat__is_converged` calls a helper and reads a file-level constant, and neither
# travels with the funcdef span. Before this pass, both lanes shipped the funcdef ALONE: the probe
# ran a body whose `_wombat_dest` was undefined (rc 127 ⇒ cant-tell) and the apply preamble hoisted
# the same broken body. Usually that fails safe, but not reliably — a body that ignores a helper's
# status and answers 0 from a later test reports converged off a helper that never ran, which is
# the priority-1 under-execute. So the pinned unit is the definition PLUS its closure.
#
# What to read in the transcript: the helper and the constant appear ONCE in the probe (above the
# check) and ONCE in the apply preamble (above the book), and the guard invokes the plain authored
# name — the single-definition case, byte-identical to strip.
#
# `hork` is unmodeled, so it WALLS: the site below it is an `EstablishWritten` with a reached vouch
# and a `holds` record, which mints a guard rather than an elision. That is what puts the pinned
# definition on the apply surface where it can be read.
hork provision
( wombat__is_converged sync a.conf ) || wombat sync a.conf   # dorc: guard [dorc-auto:wombat converged-vouch; probe: holds]
