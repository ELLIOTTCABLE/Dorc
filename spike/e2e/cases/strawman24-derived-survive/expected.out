#!/bin/sh
# dorc probe (read-only): checks per-SITE convergence, mutates nothing.
# When run, emits one results-record per site on stdout (the return channel):
#   site <leafid> effect=<holds|absent|cant-tell> rc=<n>
# effect is derived from the probe command's rc (0=holds, 1=absent, else cant-tell);
# rc is the raw PROBE-command status (opaque to Dorc — the record is the out-of-band lane).

# site 0: package:oldpkg#installed
apt_get__predict() {
   while [ "${1#-}" != "$1" ]; do shift; done
   verb=$1; shift
   while [ "${1#-}" != "$1" ]; do shift; done
   pkg="$1"
   if [ "$2" = "" ]; then
      case $verb in
         install) dpkg-query -W "$pkg" >/dev/null 2>&1 ;;
      esac
   fi
}
apt_get__predict 'install' '-y' 'oldpkg'; _rc=$?; if [ "$_rc" -eq 0 ]; then _e=holds; elif [ "$_rc" -eq 1 ]; then _e=absent; else _e=cant-tell; fi; printf 'site 0 effect=%s rc=%s\n' "$_e" "$_rc"
# site 1: package:nginx#installed
apt_get__predict 'install' '-y' 'nginx'; _rc=$?; if [ "$_rc" -eq 0 ]; then _e=holds; elif [ "$_rc" -eq 1 ]; then _e=absent; else _e=cant-tell; fi; printf 'site 1 effect=%s rc=%s\n' "$_e" "$_rc"
# dorc derivation-probe (read-only, 24E §2): payload-bound footprints the static
# tracer could not resolve. Each escalated wall-candidate ships its touches() body
# strip-only; when run it prints its footprint coordinates, re-keyed per site:
#   deriv <leafid> coord=<kind:entity>
# (the SAME leaf-id the apply plan assigns — inv-site-keyed-results).

# deriv 0: apt-get (host-derivation via apt-get.touches())
apt_get__touches() {                              # PAYLOAD-BOUND footprint (24E §2/§14): DERIVED via a PIPE
   while [ "${1#-}" != "$1" ]; do shift; done
   verb=$1; shift
   while [ "${1#-}" != "$1" ]; do shift; done
   case $verb in
   install|purge)
      printf 'package:%s\n' "$1"                 # the wall's own establish coordinate (coherence)
      dpkg -L "$1" | sed 's|^|file:|'            # the NATURAL idiom: a PIPE ⇒ NonPrintfCommand ⊤ ⇒ escalate
      ;;
   esac
}
apt_get__touches 'install' '-y' 'oldpkg' | while IFS= read -r _c; do printf 'deriv 0 coord=%s\n' "$_c"; done
# deriv 1: apt-get (host-derivation via apt-get.touches())
apt_get__touches 'install' '-y' 'nginx' | while IFS= read -r _c; do printf 'deriv 1 coord=%s\n' "$_c"; done
#!/bin/sh
# dorc apply: the book, with already-converged/dead lines elided (value-preserving stand-in).

# strawman24-derived-survive (24E Stage 4 — the DERIVED-footprint flagship; sibling to
# strawman24-survive-simple, which uses an AUTHORED footprint). The apt oracle's touches() is now
# PAYLOAD-BOUND: it derives its footprint via the NATURAL pipe idiom `dpkg -L "$1" | sed 's|^|file:|'`
# (24E §14 — the parser ACCEPTS the pipe, the tracer ⊤s on it ⇒ escalate), so the footprint is
# DERIVED at probe time (24E §2) instead of authored statically.
#   site 0  apt-get install oldpkg — DIVERGED (absent) ⇒ RUNS. A running modeled mutator IS a
#           wall — but its touches() ESCALATED (NonPrintfCommand ⊤ on the pipeline), shipped to
#           the probe lane byte-exact, ran read-only, and its stdout derived the footprint
#           {package:oldpkg, file:/etc/oldpkg.conf} (the printf package coord + `dpkg -L | sed` files).
#   site 1  apt-get install nginx — CONVERGED (holds), PAST the running oldpkg wall. Its backing
#           (package:nginx) is DISJOINT from the DERIVED footprint (package:oldpkg — same kind,
#           different entity; and file:/etc/oldpkg.conf — a different kind) ⇒ under
#           --trust-footprints it ELIDES past the running wall (the frame rule, dynamic frame).
#           The yardstick goes 0->1 vs the honest baseline (the UNFLAGGED sibling); the why-lens
#           names the licensor AND its DERIVED provenance (24E §9). Differential: expected.ran +
#           the dual-rail judge pin the run-set; the elision is licensed by a probe-DERIVED footprint.
apt-get install -y oldpkg
true   # dorc: elided [apt-get install -y nginx] (already converged / dead branch)
