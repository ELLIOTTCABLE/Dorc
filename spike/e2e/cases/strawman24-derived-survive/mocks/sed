#!/bin/sh
# INERT strawman mock — the `sed 's|^|file:|'` stage of the derivation pipe (24E §14): prepend
# `file:` to each stdin line. A canned transform for THIS fixture (the expression arg is not
# interpreted — a spike mock, ru-26). Read-only; logs its args for symmetry. Pure-sh (no real sed
# under PATH=mocks-only).
. "${0%/*}/.log"; _dorc_logged "$@"
while IFS= read -r _l; do printf 'file:%s\n' "$_l"; done
