#!/bin/sh
# INERT strawman deriver (never a real mutator): prints <pkg>'s footprint coordinates on stdout,
# one kind:entity per line — the derived (payload-bound) footprint the touches() body emits. The
# derivation-probe pipes this stdout into `deriv <leafid> coord=…` records. Read-only; logs for symmetry.
. "${0%/*}/.log"; _dorc_logged "$@"
printf 'package:%s\nfile:/etc/%s.conf\n' "$1" "$1"
