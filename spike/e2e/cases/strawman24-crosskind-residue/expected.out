#!/bin/sh
# dorc probe (read-only): checks per-SITE convergence, mutates nothing.
# When run, emits one results-record per site on stdout (the return channel):
#   site <leafid> effect=<holds|absent|cant-tell> rc=<n>
# effect is derived from the probe command's rc (0=holds, 1=absent, else cant-tell);
# rc is the raw PROBE-command status (opaque to Dorc — the record is the out-of-band lane).

# site 0: package:nginx#installed
apt_get__predict() {
   while [ "${1#-}" != "$1" ]; do shift; done
   verb=$1; shift
   while [ "${1#-}" != "$1" ]; do shift; done
   pkg="$1"
   if [ "$2" = "" ]; then
      case $verb in
         install) dpkg-query -W "$pkg" >/dev/null 2>&1 ;;
         purge) dpkg-query -W "$pkg" >/dev/null 2>&1 ;;
      esac
   fi
}
apt_get__predict 'install' '-y' 'nginx'; _rc=$?; if [ "$_rc" -eq 0 ]; then _e=holds; elif [ "$_rc" -eq 1 ]; then _e=absent; else _e=cant-tell; fi; printf 'site 0 effect=%s rc=%s\n' "$_e" "$_rc"
# site 1: service:nginx#enabled
systemctl__predict() {
   verb=$1; shift
   svc="$1"
   case $verb in
      enable)  systemctl is-enabled -- "$svc" ;;
      start)   systemctl is-active  -- "$svc" ;;
      disable) systemctl is-enabled -- "$svc" ;;
   esac
}
systemctl__predict 'enable' 'nginx'; _rc=$?; if [ "$_rc" -eq 0 ]; then _e=holds; elif [ "$_rc" -eq 1 ]; then _e=absent; else _e=cant-tell; fi; printf 'site 1 effect=%s rc=%s\n' "$_e" "$_rc"
#!/bin/sh
# dorc apply: the book, with already-converged/dead lines elided (value-preserving stand-in).

# strawman24-crosskind-residue (plans/240 Stage 2 — the adequacy-seed / GREEN documenting case):
# footprints do NOT cross kinds unaided (23M cross-kind boundary), and this case DISCLOSES that
# residue rather than papering it.
#   site 0  apt-get install nginx — DIVERGED wall, footprint package:nginx (an at-most claim over
#           the PACKAGE kind only).
#   site 1  systemctl enable nginx — CONVERGED (service:nginx#enabled). Backing service:nginx is a
#           DIFFERENT KIND from the footprint's package:nginx ⇒ disjoint ⇒ it SURVIVES ⇒ ELIDES.
# THE RESIDUE (Stage-5 bridge territory, horizon-priced — NOT bridged here): nginx's postinst
# could enable nginx's service — a package→service CROSS-KIND effect. Entity-granular poisoning
# stays WITHIN the package kind, so it does NOT reach service:nginx, and the enable survives. This
# is real, disclosed, and priced at the professed horizon ("past here you trust authors' at-most
# claims"); the footprint-expansion bridge (touching package REACHES its service) is the Stage-5
# non-blunt fix. Behaviour here: the other-kind fact SURVIVES — that is the point.
apt-get install -y nginx
# systemctl enable nginx   # dorc: elided (already converged / dead branch)
