#!/bin/sh
# dorc probe (read-only): checks per-SITE convergence, mutates nothing.
# When run, emits one results-record per site on stdout (the return channel):
#   site <leafid> effect=<holds|absent|cant-tell> rc=<n>
# effect is derived from the probe command's rc (0=holds, 1=absent, else cant-tell);
# rc is the raw PROBE-command status (opaque to Dorc — the record is the out-of-band lane).

# site 1: package:nginx#installed
apt_get__predict() {
   while [ "${1#-}" != "$1" ]; do shift; done
   verb=$1; shift
   while [ "${1#-}" != "$1" ]; do shift; done
   pkg="$1"
   if [ "$2" = "" ]; then
      case $verb in
         install) dpkg-query -W "$pkg" >/dev/null 2>&1 ;;
         purge) dpkg-query -W "$pkg" >/dev/null 2>&1 ;;
      esac
   fi
}
apt_get__predict 'install' '-y' 'nginx'; _rc=$?; if [ "$_rc" -eq 0 ]; then _e=holds; elif [ "$_rc" -eq 1 ]; then _e=absent; else _e=cant-tell; fi; printf 'site 1 effect=%s rc=%s\n' "$_e" "$_rc"
# site 2: service:nginx#enabled
systemctl__predict() {
   verb=$1; shift
   svc="$1"
   case $verb in
      enable)  systemctl is-enabled -- "$svc" ;;
      start)   systemctl is-active  -- "$svc" ;;
      disable) systemctl is-enabled -- "$svc" ;;
   esac
}
systemctl__predict 'enable' 'nginx'; _rc=$?; if [ "$_rc" -eq 0 ]; then _e=holds; elif [ "$_rc" -eq 1 ]; then _e=absent; else _e=cant-tell; fi; printf 'site 2 effect=%s rc=%s\n' "$_e" "$_rc"
# site 3: package:curl#installed
apt_get__predict 'install' '-y' 'curl'; _rc=$?; if [ "$_rc" -eq 0 ]; then _e=holds; elif [ "$_rc" -eq 1 ]; then _e=absent; else _e=cant-tell; fi; printf 'site 3 effect=%s rc=%s\n' "$_e" "$_rc"
# site:0 skip-unresolvable
#!/bin/sh
# dorc apply: the book, with already-converged/dead lines elided (value-preserving stand-in).

# strawman24-errexit-defeats (plans/240 Stage-1 yardstick — a KNOWN cost, newly MEASURED, NOT a
# defect pin). Byte-identical to strawman24-all-converged-clean PLUS `set -e` at the top. Every
# site is CONVERGED and would elide (elide-fr 1.00 there); but under errexit each mutator's exit
# STATUS is consumed (the errexit region reads every command's rc), and a mutator's rc is ⊤
# (fork-mutator-rc: only its Effect/convergence arrives from the probe, never a fabricated 0). A
# consumed ⊤ status blocks the elide (inv-probe-sourced-values / consumption-coverage), so the
# converged mutators RUN — elide-fr collapses toward 0.00. This is the `206 §2` headline cost
# (the 20V doors are its named recovery program — door-3 landed; the rest is the golden-hill
# program), here QUANTIFIED as a family row so the strawman axis carries book-IDIOM quality
# (does the book open `set -eu`?) alongside oracle-coverage quality. The USER_STORY flagship book
# opens `set -eu`, so its stage-1 render depends on this program maturing.
set -e
apt-get install -y nginx
systemctl enable nginx
apt-get install -y curl
