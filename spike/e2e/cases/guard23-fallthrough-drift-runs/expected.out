#!/bin/sh
# dorc probe (read-only): checks per-SITE convergence, mutates nothing.
# When run, emits one results-record per site on stdout (the return channel):
#   site <leafid> effect=<holds|absent|cant-tell> rc=<n>
# effect is derived from the probe command's rc (0=holds, 1=absent, else cant-tell);
# rc is the raw PROBE-command status (opaque to Dorc — the record is the out-of-band lane).

# site:0 skip-unresolvable
# site 1: package:nginx#installed
package_installed__check() { dpkg-query -W "$1" >/dev/null 2>&1; }
package_installed__check 'nginx'; _rc=$?; if [ "$_rc" -eq 0 ]; then _e=holds; elif [ "$_rc" -eq 1 ]; then _e=absent; else _e=cant-tell; fi; printf 'site 1 effect=%s rc=%s\n' "$_e" "$_rc"
# site:2 skip-unresolvable
#!/bin/sh
# dorc apply: the book, with already-converged/dead lines elided (value-preserving stand-in).
# dorc guard preamble: the vouching oracle's own check body, shipped strip-only
# (annotations removed, `name.check()` -> `name_check()`, nothing else changed --
# rul-ternary-verdict: the same authored bytes the probe lane self-vouches).
apt_get__check() {
   while [ "${1#-}" != "$1" ]; do shift; done
   verb=$1; shift
   while [ "${1#-}" != "$1" ]; do shift; done
   pkg="$1"
   if [ "$2" = "" ]; then dpkg-query -W "$pkg" >/dev/null 2>&1; fi
}

# guard23-fallthrough-drift-runs (the guard's OWN kFAIL-perform; XFAIL until the guard tier
# lands). One vouched site past an opaque wall, converged AT PLAN TIME (probe: holds), so
# the witness mints a guard — but the WORLD DRIFTS before apply: the dpkg-query mock exits
# 1 (nginx gone; the "hork-catching" the TOCTOU ruling's 2026-07-02 clarifier deliberately
# admits — an IDENTIFIED, in-book, potentially-responsible cause: hork). Desired: the
# shipped check re-reads the LIVE host, fails, and the `||` falls through — the original
# mutator runs, then the book continues (marker). The plan's stale verdict never suppresses
# the mutation; the guard decides fresh, at position (rul-divergence-proceed: proceed-and-
# flag, no abort). A guard that does not fall through here is wrong-elision one storey
# down — this is the single most safety-critical pin in the guard set.
hork wombat
apt_get__check install -y nginx || apt-get install -y nginx   # dorc: guard [package converged-vouch; probe: holds]
marker done
