#!/bin/sh
# dorc probe (read-only): checks per-SITE convergence, mutates nothing.
# When run, emits one results-record per site on stdout (the return channel):
#   site <leafid> effect=<holds|absent|cant-tell> rc=<n>
# effect is derived from the probe command's rc (0=holds, 1=absent, else cant-tell);
# rc is the raw PROBE-command status (opaque to Dorc — the record is the out-of-band lane).

# site:0 skip-unresolvable
# site:1 skip-unresolvable
#!/bin/sh
# dorc apply: the book, with already-converged/dead lines elided (value-preserving stand-in).

# guard23-cmdsub-position-runs (substitution positions are ratified refuse-homes, human
# ruling 2026-07-02 — a PASSING floor). The install sits INSIDE a command-substitution:
# its stdout IS the captured value, so a guard's short-circuit would hand the assignment
# the check's (empty/foreign) bytes instead of the tool's — silent value corruption. The
# site is structurally not even a leaf the render may edit (arch-4: cmdsub bodies are
# non-leaf); converged-vouched bait or not, the line runs verbatim, forever. (The eventual
# loud-refusal disclosure for this home is pinned representatively by
# guard23-heredoc-refuses-loudly; here the pin is the RUN.)
out=$(apt-get install -y nginx)
echo "$out"
