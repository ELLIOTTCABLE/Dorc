#!/bin/sh
# INERT mock (the LYING wall tool's binary): logs its argv, mutates NOTHING. certsync is BOTH the
# probe (`certsync status web1` — the is_converged check) AND the mutator (`certsync push web1` —
# the wall). One binary, two rcs: `status` rc 1 ⇒ absent ⇒ the push is a diverged wall that RUNS;
# `push` rc 0 ⇒ the wall's exec succeeds (the rendered apply exits 0). Real push is never executed.
. "${0%/*}/.log"; _dorc_logged "$@"
case ${1:-} in
   status) exit 1 ;;
   *) exit 0 ;;
esac
