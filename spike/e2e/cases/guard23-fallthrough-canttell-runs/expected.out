#!/bin/sh
# dorc probe (read-only): checks per-SITE convergence, mutates nothing.
# When run, emits one results-record per site on stdout (the return channel):
#   site <leafid> effect=<holds|absent|cant-tell> rc=<n>
# effect is derived from the probe command's rc (0=holds, 1=absent, else cant-tell);
# rc is the raw PROBE-command status (opaque to Dorc — the record is the out-of-band lane).

# site 1: package:nginx#installed
apt_get__predict() {
   while [ "${1#-}" != "$1" ]; do shift; done
   verb=$1; shift
   while [ "${1#-}" != "$1" ]; do shift; done
   pkg="$1"
   if [ "$2" = "" ]; then
      case $verb in
         install) dpkg-query -W "$pkg" >/dev/null 2>&1 ;;
         purge) dpkg-query -W "$pkg" >/dev/null 2>&1 ;;
      esac
   fi
}
apt_get__predict 'install' '-y' 'nginx'; _rc=$?; if [ "$_rc" -eq 0 ]; then _e=holds; elif [ "$_rc" -eq 1 ]; then _e=absent; else _e=cant-tell; fi; printf 'site 1 effect=%s rc=%s\n' "$_e" "$_rc"
# site:0 skip-unresolvable
# site:2 skip-unresolvable
#!/bin/sh
# dorc apply: the book, with already-converged/dead lines elided (value-preserving stand-in).

# dorc guard preamble: the vouching oracle's own verdict body, shipped strip-only
# (annotations removed, `name.is_converged()` -> `name__is_converged()`, nothing else
# changed -- rul-ternary-verdict: the authored bytes verbatim, no engine-synthesized sh).
apt_get__is_converged() {
   while [ "${1#-}" != "$1" ]; do shift; done
   verb=$1; shift
   while [ "${1#-}" != "$1" ]; do shift; done
   case $verb in
      install) dpkg-query -W "$1" >/dev/null 2>&1 ;;
   esac
}

# guard23-fallthrough-canttell-runs (the conservative third outcome; XFAIL until the guard
# tier lands). Identical to guard23-fallthrough-drift-runs except the predict's apply-time
# answer is CANT-TELL (dpkg-query mock exits 2), not a clean divergence. Desired: any
# non-zero check rc falls through — `holds(0)` skips, `absent(1)` runs, `cant-tell(2+)`
# RUNS (when unsure, act: inv-kfail's apply direction). The `||` form gives this for free;
# the pin exists to catch any future rewrite (an `if`-form, an rc-classifying wrapper)
# that quietly treats "can't tell" as anything other than "run the mutator". The two
# sibling cases differ ONLY in the mock's exit code — that difference is the pin.
hork wombat
( apt_get__is_converged install -y nginx ) || apt-get install -y nginx   # dorc: guard [package converged-vouch; probe: holds]
marker done
