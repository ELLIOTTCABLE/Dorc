#!/bin/sh
# dorc probe (read-only): checks per-SITE convergence, mutates nothing.
# When run, emits one results-record per site on stdout (the return channel):
#   site <leafid> effect=<holds|absent|cant-tell> rc=<n>
# effect is derived from the probe command's rc (0=holds, 1=absent, else cant-tell);
# rc is the raw PROBE-command status (opaque to Dorc — the record is the out-of-band lane).

# site 0: package:oldpkg#installed
apt_get__predict() {
   while [ "${1#-}" != "$1" ]; do shift; done
   verb=$1; shift
   while [ "${1#-}" != "$1" ]; do shift; done
   pkg="$1"
   if [ "$2" = "" ]; then
      case $verb in
         install) dpkg-query -W "$pkg" >/dev/null 2>&1 ;;
         purge) dpkg-query -W "$pkg" >/dev/null 2>&1 ;;
      esac
   fi
}
apt_get__predict 'install' '-y' 'oldpkg'; _rc=$?; if [ "$_rc" -eq 0 ]; then _e=holds; elif [ "$_rc" -eq 1 ]; then _e=absent; else _e=cant-tell; fi; printf 'site 0 effect=%s rc=%s\n' "$_e" "$_rc"
# site 1: package:nginx#installed
apt_get__predict 'install' '-y' 'nginx'; _rc=$?; if [ "$_rc" -eq 0 ]; then _e=holds; elif [ "$_rc" -eq 1 ]; then _e=absent; else _e=cant-tell; fi; printf 'site 1 effect=%s rc=%s\n' "$_e" "$_rc"
#!/bin/sh
# dorc apply: the book, with already-converged/dead lines elided (value-preserving stand-in).

# tiedown-survive-statebearing (24B §3 — a flavour-C tie-down for the round-24 chronology net).
# Same survival shape as strawman24-survive-simple, but the mocks are STATE-BEARING: dpkg-query
# reads a per-run package DB (./state) seeded from S0 (nginx installed, oldpkg not), and apt-get
# writes it. So gate-1 validates the probe against a FAITHFUL file-backed mini-world (not a
# hardcoded rc table), and gate-6 cross-checks the survival elision's run-set against real dash —
# tying the in-memory hostsim model (set-membership + apply_delta) to reality on a real chronology.
#   site 0  apt-get install oldpkg — DIVERGED (absent in the DB) ⇒ RUNS; footprint package:oldpkg.
#   site 1  apt-get install nginx — CONVERGED (present in the DB), PAST the running oldpkg wall.
#           Backing package:nginx is DISJOINT from footprint package:oldpkg ⇒ under
#           --trust-footprints it ELIDES (the frame rule). gate-6 attributes the elided install
#           to its replace license; the probe is mock-reproducible FROM STATE ⇒ NOT authored.
apt-get install -y oldpkg
# apt-get install -y nginx   # dorc: elided (already converged / dead branch)
