#!/bin/sh
# dorc probe (read-only): checks per-SITE convergence, mutates nothing.
# When run, emits one results-record per site on stdout (the return channel):
#   site <leafid> effect=<holds|absent|cant-tell> rc=<n>
# effect is derived from the probe command's rc (0=holds, 1=absent, else cant-tell);
# rc is the raw PROBE-command status (opaque to Dorc — the record is the out-of-band lane).

# site 0: tool:nginx#present
command__predict() {
   case $1 in -v) shift ;; esac
   tool="$1"
   command -v -- "$tool" >/dev/null 2>&1
}
command__predict '-v' 'nginx'; _rc=$?; if [ "$_rc" -eq 0 ]; then _e=holds; elif [ "$_rc" -eq 1 ]; then _e=absent; else _e=cant-tell; fi; printf 'site 0 effect=%s rc=%s\n' "$_e" "$_rc"
# site 1: package:nginx#installed
apt_get__predict() {
   while [ "${1#-}" != "$1" ]; do shift; done
   verb=$1; shift
   while [ "${1#-}" != "$1" ]; do shift; done
   pkg="$1"
   if [ "$2" = "" ]; then
      case $verb in
         install) dpkg-query -W "$pkg" >/dev/null 2>&1 ;;
         purge) dpkg-query -W "$pkg" >/dev/null 2>&1 ;;
      esac
   fi
}
apt_get__predict 'install' '-y' 'nginx'; _rc=$?; if [ "$_rc" -eq 0 ]; then _e=holds; elif [ "$_rc" -eq 1 ]; then _e=absent; else _e=cant-tell; fi; printf 'site 1 effect=%s rc=%s\n' "$_e" "$_rc"
#!/bin/sh
# dorc apply: the book, with already-converged/dead lines elided (value-preserving stand-in).

# fold-oror-guard-omits (the canonical idempotency idiom): a read-only QUERY guard
# short-circuits the mutator. `command -v nginx` is now a first-class Query (task-D2);
# its OWN probed rc (0 when nginx is on PATH) is fold-usable as the guard's Status
# (rule-query-validity passes — nothing mutates upstream), so the fold proves the
# `|| apt-get install` branch DEAD and OMITS the install. The guard itself mutates
# nothing and its rc is known + `||`-consumed, so it is value-preservingly substituted
# by its stand-in `true` (rc 0). The whole line collapses to `true`; nothing runs
# (expected.ran is empty). The DESIGN `dpkg -s nginx || apt-get install nginx` idiom,
# with `command -v` as the guard. (An un-probed/⊤ guard rc would NOT fold — the
# kFAIL-perform floor; and an invalid guard, below a mutator, runs for real — see
# exec-query-after-mutator-runs.)
true || :   # dorc: elided [command -v nginx >/dev/null 2>&1; apt-get install -y nginx] (already converged / dead branch)
