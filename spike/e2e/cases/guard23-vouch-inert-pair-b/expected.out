#!/bin/sh
# dorc probe (read-only): checks per-SITE convergence, mutates nothing.
# When run, emits one results-record per site on stdout (the return channel):
#   site <leafid> effect=<holds|absent|cant-tell> rc=<n>
# effect is derived from the probe command's rc (0=holds, 1=absent, else cant-tell);
# rc is the raw PROBE-command status (opaque to Dorc — the record is the out-of-band lane).

# site 0: package:nginx#installed
apt_get__predict() {
   while [ "${1#-}" != "$1" ]; do shift; done
   verb=$1; shift
   while [ "${1#-}" != "$1" ]; do shift; done
   pkg="$1"
   if [ "$2" = "" ]; then
      case $verb in
         install) dpkg-query -W "$pkg" >/dev/null 2>&1 ;;
         purge) dpkg-query -W "$pkg" >/dev/null 2>&1 ;;
      esac
   fi
}
apt_get__predict 'install' '-y' 'nginx'; _rc=$?; if [ "$_rc" -eq 0 ]; then _e=holds; elif [ "$_rc" -eq 1 ]; then _e=absent; else _e=cant-tell; fi; printf 'site 0 effect=%s rc=%s\n' "$_e" "$_rc"
# site 1: service:nginx#enabled
systemctl__predict() {
   verb=$1; shift
   svc="$1"
   case $verb in
      enable)  systemctl is-enabled -- "$svc" ;;
   esac
}
systemctl__predict 'enable' 'nginx'; _rc=$?; if [ "$_rc" -eq 0 ]; then _e=holds; elif [ "$_rc" -eq 1 ]; then _e=absent; else _e=cant-tell; fi; printf 'site 1 effect=%s rc=%s\n' "$_e" "$_rc"
#!/bin/sh
# dorc apply: the book, with already-converged/dead lines elided (value-preserving stand-in).

# guard23-vouch-inert-pair-b (rul-guard-license: the vouch NEVER enters the fact-plane and
# is inadmissible in any other site's elide/poison reasoning — a PASSING floor, one half of
# a two-case differential). The -a and -b cases are byte-identical except the package and
# service oracles in -b carry the strawman converged-vouch; their expected.out goldens are
# byte-identical TOO apart from this case-name line, and must stay so forever: a vouch is guard-tier-only input — it may
# never change WHICH sites elide, poison, or run (a vouch softening poison would launder a
# local skip-judgment into a global non-interference claim, rebuilding plans/233 §0 one
# storey up). [PART B — 24D §3, the elide-weld] Both sites elided VOUCHLESSLY at HEAD, but a full
# skip now DEMANDS a reached vouch, and NEITHER half carries a real is_converged (pair-b's
# "vouch" stayed comment-only), so both now RUN in both halves — the a=b pin still holds, but its
# "a vouch may never change WHICH sites elide" rationale is SUPERSEDED (a REAL is_converged in -b
# would elide where -a runs; re-authoring this differential for Part B is a human call). The
# fact-plane clause above STANDS (the vouch is consumed as a tier-check, never becomes a fact —
# TC-tier-3). NB the (now-moot-here) service elision rode the KNOWN 233 §0 ambient hole.
# Reviewers: diff the two cases' goldens.
apt-get install -y nginx
systemctl enable nginx
