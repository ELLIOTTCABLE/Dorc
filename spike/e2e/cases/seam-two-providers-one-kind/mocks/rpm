#!/bin/sh
# INERT probe shim (gate-1 parity, R3): the yum provider's `package` check ships `rpm -q
# <pkg>` (the cross-oracle seam's per-provider probe — apt uses dpkg-query, yum uses rpm).
# The fixture reports the cell as `holds` (httpd installed), so this shim exits 0 ⇒ the
# `yum__check` wrapper maps rc 0 → `holds`, reproducing probe-results.txt. Mutates nothing
# (read-only query); logs for symmetry with the apply shims. Inert under the pre-R3 probe
# (which used dpkg-query for both providers); R3's per-provider probe invokes it.
. "${0%/*}/.log"; _dorc_logged "$@"
exit 0
