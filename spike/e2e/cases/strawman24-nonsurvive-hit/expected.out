#!/bin/sh
# dorc probe (read-only): checks per-SITE convergence, mutates nothing.
# When run, emits one results-record per site on stdout (the return channel):
#   site <leafid> effect=<holds|absent|cant-tell> rc=<n>
# effect is derived from the probe command's rc (0=holds, 1=absent, else cant-tell);
# rc is the raw PROBE-command status (opaque to Dorc — the record is the out-of-band lane).

# site 0: package:oldpkg#installed
apt_get__predict() {
   while [ "${1#-}" != "$1" ]; do shift; done
   verb=$1; shift
   while [ "${1#-}" != "$1" ]; do shift; done
   pkg="$1"
   if [ "$2" = "" ]; then
      case $verb in
         install) dpkg-query -W "$pkg" >/dev/null 2>&1 ;;
         purge) dpkg-query -W "$pkg" >/dev/null 2>&1 ;;
      esac
   fi
}
apt_get__predict 'install' '-y' 'oldpkg'; _rc=$?; if [ "$_rc" -eq 0 ]; then _e=holds; elif [ "$_rc" -eq 1 ]; then _e=absent; else _e=cant-tell; fi; printf 'site 0 effect=%s rc=%s\n' "$_e" "$_rc"
# site 1: package:nginx#installed
apt_get__predict 'install' '-y' 'nginx'; _rc=$?; if [ "$_rc" -eq 0 ]; then _e=holds; elif [ "$_rc" -eq 1 ]; then _e=absent; else _e=cant-tell; fi; printf 'site 1 effect=%s rc=%s\n' "$_e" "$_rc"
#!/bin/sh
# dorc apply: the book, with already-converged/dead lines elided (value-preserving stand-in).

# strawman24-nonsurvive-hit (plans/240 Stage 2): the honest NON-disjoint direction — a footprint
# that INTERSECTS the downstream backing demotes EVEN flagged (entity-granular hit).
#   site 0  apt-get install oldpkg — DIVERGED wall. Its touches() over-claims (STRAWMAN): it emits
#           package:oldpkg (its own) AND package:nginx — "installing oldpkg also touched nginx".
#   site 1  apt-get install nginx  — CONVERGED, EstablishAmbient (oldpkg's cell ≠ nginx's). Under
#           --trust-footprints the survival test runs, but backing package:nginx HITS the wall's
#           footprint (same kind, same entity) ⇒ NOT disjoint ⇒ DEMOTES (runs). The flag is on and
#           the wall runs, yet the elision is correctly refused — disjointness is the gate, not the
#           flag. Both lines run.
apt-get install -y oldpkg
apt-get install -y nginx
