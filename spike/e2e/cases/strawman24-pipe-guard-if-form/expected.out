#!/bin/sh
# dorc probe (read-only): checks per-SITE convergence, mutates nothing.
# When run, emits one results-record per site on stdout (the return channel):
#   site <leafid> effect=<holds|absent|cant-tell> rc=<n>
# effect is derived from the probe command's rc (0=holds, 1=absent, else cant-tell);
# rc is the raw PROBE-command status (opaque to Dorc — the record is the out-of-band lane).

printf 'dorc-records/1 nonce=dorc attempt=1 host=localhost book=9e92b016c512a034 sites=1 @@dorc@@\n'
# site 1: sm.dorc.GrepMatch:0.155.0#matched
otelcol__predict() {
   case $1 in
      --version)
         collector="otelcol"
         otelcol --version
         ;;
   esac
}
grep__predict() {
   while [ "${1#-}" != "$1" ]; do shift; done
   pat="$1"
   grep -q -- "$pat"
}
otelcol__predict '--version' | grep__predict '-q' '0.155.0'; _rc=$?; if [ "$_rc" -eq 0 ]; then _e=holds; elif [ "$_rc" -eq 1 ]; then _e=absent; else _e=cant-tell; fi; printf 'dorc site 1 effect=%s rc=%s @@dorc@@\n' "$_e" "$_rc"
# site:2 skip-unresolvable
# site:3 skip-unresolvable
printf 'dorc-records-end/1 nonce=dorc @@dorc@@\n'
#!/bin/sh
# dorc apply: the book, with already-converged/dead lines elided (value-preserving stand-in).

# strawman24-pipe-guard-if-form (24J beautification-robustness). The SAME connected check-pipe as
if ! : | true; then : | :; fi   # dorc: elided [otelcol --version; grep -q "0.155.0"; curl -sL https://example.com/otelcol.tar.gz; tar xz] (already converged / dead branch)
