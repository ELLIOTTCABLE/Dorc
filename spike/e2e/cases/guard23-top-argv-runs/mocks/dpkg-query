#!/bin/sh
# INERT shim for `dpkg-query -W <pkg>` — nginx ABSENT (rc 1). NOTHING invokes it at HEAD (the
# TOP-argv site runs bare; the probe is empty — both sites unresolvable). It is a TRIPWIRE
# (conv-2 / 23C-fd6): if a build wrongly keys the vouch on the PROVIDER and guards this
# unresolvable site, the guard's check calls `dpkg-query -W nginx` (PKG resolves to nginx via
# `cat /etc/pkg`), which now LOGS an extra run-set line ⇒ the exec gate reds — instead of
# 127-ing invisibly into a byte-identical log that only the (bless-rewritable) content diff
# could catch. kFAIL-perform: an unknown-identity site must never guard, and this makes a
# wrong guard visible on either rc.
. "${0%/*}/.log"; _dorc_logged "$@"
exit 1
