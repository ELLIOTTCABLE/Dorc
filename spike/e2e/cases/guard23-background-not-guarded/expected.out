#!/bin/sh
# dorc probe (read-only): checks per-SITE convergence, mutates nothing.
# When run, emits one results-record per site on stdout (the return channel):
#   site <leafid> effect=<holds|absent|cant-tell> rc=<n>
# effect is derived from the probe command's rc (0=holds, 1=absent, else cant-tell);
# rc is the raw PROBE-command status (opaque to Dorc — the record is the out-of-band lane).

# site 0: package:nginx#installed
apt_get__check() {
   while [ "${1#-}" != "$1" ]; do shift; done
   verb=$1; shift
   while [ "${1#-}" != "$1" ]; do shift; done
   pkg="$1"
   if [ "$2" = "" ]; then
      case $verb in
         install) dpkg-query -W "$pkg" >/dev/null 2>&1 ;;
         purge) dpkg-query -W "$pkg" >/dev/null 2>&1 ;;
      esac
   fi
}
apt_get__check 'install' '-y' 'nginx'; _rc=$?; if [ "$_rc" -eq 0 ]; then _e=holds; elif [ "$_rc" -eq 1 ]; then _e=absent; else _e=cant-tell; fi; printf 'site 0 effect=%s rc=%s\n' "$_e" "$_rc"
# site:1 skip-unresolvable
#!/bin/sh
# dorc apply: the book, with already-converged/dead lines elided (value-preserving stand-in).

# guard23-background-not-guarded (backgrounded commands are ratified refuse-homes, human
# ruling 2026-07-02 — a PASSING floor). `cmd &` is outside the modeled subset entirely
# (inv-top-reject: async lowers to TOP, declared below in expected-diagnostics), so the
# site is un-probeable, un-elidable — and un-guardable: a guard's `||` would change the
# async job's shape, and no witness can form on a TOP site. Vouch present, still TOP,
# still runs. The pin: the vouch must not soften a TOP-reject (a build that uses the vouch
# to model its way past the async wall has broken two fences at once).
apt-get install -y nginx &
wait
