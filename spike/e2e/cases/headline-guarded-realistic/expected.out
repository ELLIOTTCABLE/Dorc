#!/bin/sh
# dorc probe (read-only): checks per-SITE convergence, mutates nothing.
# When run, emits one results-record per site on stdout (the return channel):
#   site <leafid> effect=<holds|absent|cant-tell> rc=<n>
# effect is derived from the probe command's rc (0=holds, 1=absent, else cant-tell);
# rc is the raw PROBE-command status (opaque to Dorc — the record is the out-of-band lane).

# site 1: sm.dorc.PkgState:ca-certificates#installed
dpkg__predict() {
   case $1 in -s) shift ;; esac
   pkg="$1"
   dpkg -s -- "$pkg" >/dev/null 2>&1
}
dpkg__predict '-s' 'ca-certificates'; _rc=$?; if [ "$_rc" -eq 0 ]; then _e=holds; elif [ "$_rc" -eq 1 ]; then _e=absent; else _e=cant-tell; fi; printf 'site 1 effect=%s rc=%s\n' "$_e" "$_rc"
# site 2: sm.dorc.PkgState:nginx#installed
dpkg__predict '-s' 'nginx'; _rc=$?; if [ "$_rc" -eq 0 ]; then _e=holds; elif [ "$_rc" -eq 1 ]; then _e=absent; else _e=cant-tell; fi; printf 'site 2 effect=%s rc=%s\n' "$_e" "$_rc"
# site 3: sm.dorc.Package:nginx#installed
apt_get__predict() {
   while [ "${1#-}" != "$1" ]; do shift; done
   verb=$1; shift
   while [ "${1#-}" != "$1" ]; do shift; done
   pkg="$1"
   if [ "${2-}" = "" ]; then
      case $verb in
         install) dpkg-query -W "$pkg" >/dev/null 2>&1 ;;
         purge) dpkg-query -W "$pkg" >/dev/null 2>&1 ;;
      esac
   fi
}
apt_get__predict 'install' '-y' 'nginx'; _rc=$?; if [ "$_rc" -eq 0 ]; then _e=holds; elif [ "$_rc" -eq 1 ]; then _e=absent; else _e=cant-tell; fi; printf 'site 3 effect=%s rc=%s\n' "$_e" "$_rc"
# site 4: sm.dorc.PkgIndex#fresh
apt_get__predict() {
   verb=$1; shift
   case $verb in
      update) idx=; test -n fresh ;;
   esac
}
apt_get__predict 'update'; _rc=$?; if [ "$_rc" -eq 0 ]; then _e=holds; elif [ "$_rc" -eq 1 ]; then _e=absent; else _e=cant-tell; fi; printf 'site 4 effect=%s rc=%s\n' "$_e" "$_rc"
# site 5: sm.dorc.Package:curl#installed
apt_get__predict() {
   while [ "${1#-}" != "$1" ]; do shift; done
   verb=$1; shift
   while [ "${1#-}" != "$1" ]; do shift; done
   pkg="$1"
   if [ "${2-}" = "" ]; then
      case $verb in
         install) dpkg-query -W "$pkg" >/dev/null 2>&1 ;;
         purge) dpkg-query -W "$pkg" >/dev/null 2>&1 ;;
      esac
   fi
}
apt_get__predict 'install' '-y' 'curl'; _rc=$?; if [ "$_rc" -eq 0 ]; then _e=holds; elif [ "$_rc" -eq 1 ]; then _e=absent; else _e=cant-tell; fi; printf 'site 5 effect=%s rc=%s\n' "$_e" "$_rc"
# site 6: sm.dorc.Package:htop#installed
apt_get__predict 'install' '-y' 'htop'; _rc=$?; if [ "$_rc" -eq 0 ]; then _e=holds; elif [ "$_rc" -eq 1 ]; then _e=absent; else _e=cant-tell; fi; printf 'site 6 effect=%s rc=%s\n' "$_e" "$_rc"
# site 7: sm.dorc.Service:nginx#enabled
systemctl__predict() {
   verb=$1; shift
   svc="$1"
   case $verb in
      enable)  systemctl is-enabled -- "$svc" ;;
      start)   systemctl is-active  -- "$svc" ;;
      disable) systemctl is-enabled -- "$svc" ;;
   esac
}
systemctl__predict 'enable' 'nginx'; _rc=$?; if [ "$_rc" -eq 0 ]; then _e=holds; elif [ "$_rc" -eq 1 ]; then _e=absent; else _e=cant-tell; fi; printf 'site 7 effect=%s rc=%s\n' "$_e" "$_rc"
# site 8: sm.dorc.Service:nginx#active
systemctl__predict 'start' 'nginx'; _rc=$?; if [ "$_rc" -eq 0 ]; then _e=holds; elif [ "$_rc" -eq 1 ]; then _e=absent; else _e=cant-tell; fi; printf 'site 8 effect=%s rc=%s\n' "$_e" "$_rc"
# site 9: sm.dorc.PkgState:vim#installed
dpkg__predict '-s' 'vim'; _rc=$?; if [ "$_rc" -eq 0 ]; then _e=holds; elif [ "$_rc" -eq 1 ]; then _e=absent; else _e=cant-tell; fi; printf 'site 9 effect=%s rc=%s\n' "$_e" "$_rc"
# site 10: sm.dorc.Package:vim#installed
apt_get__predict 'install' '-y' 'vim'; _rc=$?; if [ "$_rc" -eq 0 ]; then _e=holds; elif [ "$_rc" -eq 1 ]; then _e=absent; else _e=cant-tell; fi; printf 'site 10 effect=%s rc=%s\n' "$_e" "$_rc"
# site 11: sm.dorc.Firewall:80/tcp#allowed
ufw__predict() {
   verb=$1; shift
   rule="$1"
   case $verb in
      allow) ufw status "$rule" >/dev/null 2>&1 ;;
      deny) ufw status "$rule" >/dev/null 2>&1 ;;
   esac
}
ufw__predict 'allow' '80/tcp'; _rc=$?; if [ "$_rc" -eq 0 ]; then _e=holds; elif [ "$_rc" -eq 1 ]; then _e=absent; else _e=cant-tell; fi; printf 'site 11 effect=%s rc=%s\n' "$_e" "$_rc"
# site:0 skip-unresolvable
#!/bin/sh
# dorc apply: the book, with already-converged/dead lines elided (value-preserving stand-in).

#!/bin/sh
# pi-webhost provision — a scrappy real book (the lazy admin lets dorc do idempotency).
set -e

# dpkg -s ca-certificates >/dev/null 2>&1   # dorc: elided (already converged / dead branch)

false || apt-get install -y nginx   # dorc: elided [dpkg -s nginx >/dev/null 2>&1] (already converged / dead branch)

apt-get update
apt-get install -y curl
apt-get install -y htop

systemctl enable nginx
systemctl start nginx

dpkg -s vim >/dev/null 2>&1 || apt-get install -y vim

ufw allow 80/tcp
