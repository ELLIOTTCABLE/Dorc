#!/bin/sh
# dorc probe (read-only): checks per-SITE convergence, mutates nothing.
# When run, emits one results-record per site on stdout (the return channel):
#   site <leafid> effect=<holds|absent|cant-tell> rc=<n>
# effect is derived from the probe command's rc (0=holds, 1=absent, else cant-tell);
# rc is the raw PROBE-command status (opaque to Dorc — the record is the out-of-band lane).

# site 0: pkgstate:nginx#installed
dpkg__predict() {
   case $1 in -s) shift ;; esac
   pkg="$1"
   dpkg -s -- "$pkg" >/dev/null 2>&1
}
dpkg__predict '-s' 'nginx'; _rc=$?; if [ "$_rc" -eq 0 ]; then _e=holds; elif [ "$_rc" -eq 1 ]; then _e=absent; else _e=cant-tell; fi; printf 'site 0 effect=%s rc=%s\n' "$_e" "$_rc"
# site 1: package:nginx#installed
apt_get__predict() {
   while [ "${1#-}" != "$1" ]; do shift; done
   verb=$1; shift
   while [ "${1#-}" != "$1" ]; do shift; done
   pkg="$1"
   if [ "$2" = "" ]; then
      case $verb in
         install) dpkg-query -W "$pkg" >/dev/null 2>&1 ;;
         purge) dpkg-query -W "$pkg" >/dev/null 2>&1 ;;
      esac
   fi
}
apt_get__predict 'install' '-y' 'nginx'; _rc=$?; if [ "$_rc" -eq 0 ]; then _e=holds; elif [ "$_rc" -eq 1 ]; then _e=absent; else _e=cant-tell; fi; printf 'site 1 effect=%s rc=%s\n' "$_e" "$_rc"
# site 2: package:curl#installed
apt_get__predict 'install' '-y' 'curl'; _rc=$?; if [ "$_rc" -eq 0 ]; then _e=holds; elif [ "$_rc" -eq 1 ]; then _e=absent; else _e=cant-tell; fi; printf 'site 2 effect=%s rc=%s\n' "$_e" "$_rc"
# site 3: package:oldpkg#installed
apt_get__predict 'install' '-y' 'oldpkg'; _rc=$?; if [ "$_rc" -eq 0 ]; then _e=holds; elif [ "$_rc" -eq 1 ]; then _e=absent; else _e=cant-tell; fi; printf 'site 3 effect=%s rc=%s\n' "$_e" "$_rc"
# site:4 skip-unresolvable
# site:5 skip-unresolvable
#!/bin/sh
# dorc apply: the book, with already-converged/dead lines elided (value-preserving stand-in).

# strawman24-mixed-real (plans/240 Stage-1 — the "looks like a real book" composite; the family's
# most honest single number). Five lines exercising the whole gradient at once:
#   site 0/1  dpkg -s nginx || apt-get install nginx — the idempotency query-guard idiom (the
#            shimmable `dpkg -s` form, mirroring exec-query-guard-composition's shape but kept
#            gate-6-differential-active). nginx installed ⇒ the guard (site 0) holds ⇒ it value-
#            substitutes to `true` (elide) and the `|| install nginx` (site 1) is fold-dead (omit).
#   site 2   apt-get install curl — converged ⇒ elides.
#   site 3   apt-get install oldpkg — DIVERGED ⇒ runs.
#   site 4   hork wombat — un-oracled ⇒ Opaque ⇒ runs (a wall).
#   site 5   apt-get install vim — past the hork wall ⇒ runs.
# The converged sites sit BEFORE the wall (else fd10 would bite — see strawman24-modeled-wall).
# NB: no `set -e` — errexit forces converged MUTATORS to run (206 §2 cost), which would mask the
# curl elision; that interaction is its own axis (see the yardstick strain ledger).
true || :   # dorc: elided [dpkg -s nginx >/dev/null 2>&1; apt-get install -y nginx] (already converged / dead branch)
true   # dorc: elided [apt-get install -y curl] (already converged / dead branch)
apt-get install -y oldpkg
hork wombat
apt-get install -y vim
