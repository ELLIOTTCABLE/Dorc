#!/bin/sh
# dorc probe (read-only): checks per-SITE convergence, mutates nothing.
# When run, emits one results-record per site on stdout (the return channel):
#   site <leafid> effect=<holds|absent|cant-tell> rc=<n>
# effect is derived from the probe command's rc (0=holds, 1=absent, else cant-tell);
# rc is the raw PROBE-command status (opaque to Dorc — the record is the out-of-band lane).

# site 0: package:nginx#installed
apt_get__predict() {
   while [ "${1#-}" != "$1" ]; do shift; done
   verb=$1; shift
   while [ "${1#-}" != "$1" ]; do shift; done
   pkg="$1"
   if [ "$2" = "" ]; then
      case $verb in
         install) dpkg-query -W "$pkg" >/dev/null 2>&1 ;;
         purge) dpkg-query -W "$pkg" >/dev/null 2>&1 ;;
      esac
   fi
}
apt_get__predict 'install' '-y' 'nginx'; _rc=$?; if [ "$_rc" -eq 0 ]; then _e=holds; elif [ "$_rc" -eq 1 ]; then _e=absent; else _e=cant-tell; fi; printf 'site 0 effect=%s rc=%s\n' "$_e" "$_rc"
# site 1: service:nginx#enabled
systemctl__predict() {
   verb=$1; shift
   svc="$1"
   case $verb in
      enable)  systemctl is-enabled -- "$svc" ;;
   esac
}
systemctl__predict 'enable' 'nginx'; _rc=$?; if [ "$_rc" -eq 0 ]; then _e=holds; elif [ "$_rc" -eq 1 ]; then _e=absent; else _e=cant-tell; fi; printf 'site 1 effect=%s rc=%s\n' "$_e" "$_rc"
#!/bin/sh
# dorc apply: the book, with already-converged/dead lines elided (value-preserving stand-in).

# guard23-vouch-gates-elision (rul-guard-license + the Part-B elide-weld, 24D §3): a vouch now
# GATES elision. Under the weld a converged mutator elides ONLY IF a reached vouch licenses it,
# so the vouch is the sole difference between eliding and running. Two converged sites (probe:
# both hold), no poison wall between them:
#   apt-get install -y nginx — apt oracle carries a converged-vouch (apt-get.is_converged,
#                              rul24-vouch-is-verdict-authoring) ⇒ ELIDES (`true # dorc: elided …`).
#   systemctl enable nginx   — service oracle carries NO vouch ⇒ RUNS bare.
# Same convergence, same (absent) wall, opposite verdict — the vouch is the whole difference,
# shown inside one case. Contrast guard23-no-vouch-runs (no vouch ANYWHERE ⇒ every converged
# site runs; the weld closed the old vouchless-elide gap). This floor reds if a build elides the
# un-vouched systemctl site, or runs the vouched apt site.
# apt-get install -y nginx   # dorc: elided (already converged / dead branch)
systemctl enable nginx
